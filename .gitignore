# Compiled transpiler binary and debug symbols
/beguiler
*.dSYM/

# Transpiler output (.inf / .z5 / .ulx / .blb)
output/

# Transpiler output emitted next to sources (test corpora, bindings, ad-hoc runs).
# Already-tracked fixtures are unaffected (e.g. tests/run/out/*.transpiled.inf stays tracked).
*.transpiled.inf
*.transpiled.inf.map

# Bindings scratch-build output + debug bundle written into the tests tree
/beguiLib/bindings/out/
/tests/gameinfo.dbg

# Test-runner artifacts (debug-bundle fixtures write here)
tests/debug/out/

# Obsidian vault settings for the docs folder
docs/.obsidian/

# macOS
.DS_Store

# Per-object build artifacts and header depfiles
/build/

# Release announcement drafts. These are posted to the forum and kept elsewhere; a copy
# left in docs/ gets bundled into every release archive, since release.yml copies the
# whole directory. Nothing here is matched by the four real documents.
/docs/*preview*post*.md
/docs/*release*post*.md
