/*
    _test_ref_requires_bind.bgl  (negative)
    A `ref` slot names an instance owned elsewhere and has no storage of its own, so it
    is bound, never copied into. `=` on one is rejected — that is what keeps a bind
    readable at the call site, rather than depending on a declaration elsewhere.
*/
#beguilerSettings { informName = "none"; }

class Box { int x = 0; }
object b1 : Box { x = 1; }
object holder { ref Box slot; }

void f() {
    holder.slot = b1;
}
// EXPECT_ERROR: 'holder.slot' is a 'ref' slot, which binds rather than copies
// EXPECT_ERROR: holder.slot := 
