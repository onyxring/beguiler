// Negative test: a struct a method returns is a copy, so assigning to one of its fields changes nothing.
// EXPECT_ERROR: returns a copy of a 'Pt', so assigning to its 'x' changes nothing
#beguilerSettings { target = z5; informName = "none"; }
struct Pt { int x; }
class Shelf { Pt at; Pt get() { return at; } }
Shelf sh;
void main() { sh.get().x = 99; }
