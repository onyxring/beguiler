/*  A plain `.` after a `?.` in the same chain is rejected.

    `?.` is a run-time test, and it guards only the step it is attached to: `x?.a.b` lowers to
    `if (x ~= nothing) { t = x.a; t = t.b; }`, so a null `x.a` still reaches `.b`. I6 answers that
    with "[** Programming error: nothing (object number 0) has no property b to read **]" and then
    carries on with a garbage value, which is why this had to become an error rather than a
    warning. The author writes `x?.a?.b` to guard the second step, or `x.a?.b` when the receiver
    is always present.  */
// EXPECT_ERROR: follows '?.' in the same chain
#beguilerSettings { target = z5; informName = "none"; }

class node : object { object a; int b = 7; }
object n1 : node { }
object n2 : node { a = n1; }

void main(){
    int v = n2?.a.b;
    print(v);
}
