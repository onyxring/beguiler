/* extend ... inject of a global int variable */
// EXPECT_ERROR: 'g' is a variable, and the initial elements of 'nums' are fixed when the program is compiled
#beguilerSettings { target = z5; informName = "none"; outputPath = "tests/output"; }
#include <array>
array<int> nums = { 1 };
int g = 5;
extend nums { inject g; }
void main(){ print(nums[0]); }
