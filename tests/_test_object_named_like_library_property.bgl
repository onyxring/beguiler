/* an object can't take the name of an I6 library property */
// EXPECT_ERROR: object 'initial' has the same name as the library's property 'initial'
#beguilerSettings { target = z5; informName = "none"; outputPath = "tests/output"; includePaths = "../../inform6/stdlib"; }
#include <bindings/i6StandardLibrary>
#includeI6 "parser"
#includeI6 "verblib"
object roomA { short_name = "Room A"; attributes = {light}; }
object initial { int n = 4; }
bool Initialise() { location = roomA; print(initial.n); rfalse; }
#includeI6 "grammar"
