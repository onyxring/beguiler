// _test_array_char_copy_needs_buf.bgl — the byte copy behind `dst = src` on an array<char> is
// <buf>'s; without it the only copy is array<T>'s word copy, which would corrupt byte data.
//
// EXPECT_ERROR: needs #include <buf>

#beguilerSettings {
    target = z5;
    informName = "none";
    outputPath = "tests/output";
}

#include <array>

array<char> srcC = "hi";
array<char> dstC[16];

void main(){
    dstC = srcC;
}
