/*  Field trial — exercises the Beguile compiler against the Inform 6 standard library.
    A hardening test: not a game, not an example, not for reuse.  */

// Exercises: a twenty-eighth PunyInform program, written plainly: two rooms (Room A with a bench, a
// tap, a watering can and a seed packet, Room B to the east with three pots, a heater and a
// gardener) and OPTIONAL_SCORED; a `Plant` class with an enum stage, a kind string, a growth count
// and a struct `Gauge` member for its water, its description a routine with a `switch` over the
// stage and a `switch` with a range and a guard case over the water; a `Pot` class whose `before`
// takes `Receive` (plants only, one at a time) and whose `after` takes `LetGo`; a struct `Gauge`
// (`operator ()`, `=` from int, `+=`, `-=`, two methods) with a capped maximum; a switchable heater
// whose `after` takes `SwitchOn`/`SwitchOff` and starts or stops a grower daemon; a `fill NOUN` verb
// at the tap, a `water NOUN` verb pouring from the can into a plant's gauge through a `ref`
// parameter, a `sow NOUN in NOUN` verb running `Insert.perform`, and a `pick NOUN` verb recording a
// weight; a gardener with `life` (Ask through NextWord, Give of a flower) and `orders`; `<linq>`
// chains (`filter`, `count`, `orderBy` with a comparator, `any`, `all`) over
// `bgl.world.instances`; an `array<int>` of picked weights with `+=`, `sort` and `indexOf`; a
// `stringObj` log built with interpolated strings; `for`, `for … in` over a range and over children,
// `while` and `do`/`until` loops; and meta verbs reporting state.

#beguilerSettings {
    target = z5;
    includePaths = "../../../inform6/puny/lib";
}

#defineI6 OPTIONAL_SCORED

const int    MAX_SCORE              = 3;
const object INITIAL_LOCATION_VALUE = roomA;

#includeI6 "globals"
#include <bindings/punyInform>
#include <linq>
#include <string>

#includeI6 "puny"

#using bgl.printRules;

extend extern class object {
    string description;
    ref object e_to;
    ref object w_to;
}

// --- shared state -----------------------------------------------------------------------------------

enum eStage { seed, sprout, bud, flower }

array<string> stageNames = {"seed", "sprout", "bud", "flower"};

const int GAUGE_MAX    = 4;
const int CAN_MAX      = 6;
const int GROW_TURNS   = 2;

struct Gauge {
    int _level = 0;

    int  operator ()         { return _level; }
    void operator = (int v) {
        if (v < 0) v = 0;
        if (v > GAUGE_MAX) v = GAUGE_MAX;
        _level = v;
    }
    void operator += (int v) {
        _level = _level + v;
        if (_level > GAUGE_MAX) _level = GAUGE_MAX;
    }
    void operator -= (int v) {
        _level = _level - v;
        if (_level < 0) _level = 0;
    }

    bool dry() {
        return _level == 0;
    }

    int room() {
        return GAUGE_MAX - _level;
    }
}

stringObj logText;
int  logCount     = 0;
int  sownCount    = 0;
int  wateredCount = 0;
int  pickedCount  = 0;
int  growTurns    = 0;
bool firstSow     = false;
bool firstFlower  = false;

array<int> weights[8];

void jot(string what, int n = -1) {
    logCount++;
    if (n < 0) logText += $"{logCount}. {what}. ";
    else logText += $"{logCount}. {what} {n}. ";
}

string stageName(eStage s) {
    return stageNames[(int)s - 1];
}

// Pours up to `amount` into a gauge and returns how much went in.
int pour(ref Gauge g, int amount) {
    int taken = amount;
    if (taken > g.room()) taken = g.room();
    g += taken;
    return taken;
}

// --- plants -----------------------------------------------------------------------------------------

class Plant : object {
    eStage stage = eStage.seed;
    string kind = "plant";
    int growth = 0;
    int weight = 1;
    Gauge water;

    void description() {
        switch (stage) {
            case eStage.seed:   print($"A {kind} seed");
            case eStage.sprout: print($"A {kind} sprout");
            case eStage.bud:    print($"A {kind} in bud");
            case eStage.flower: print($"A {kind} in flower");
        }
        switch ((int)water) {
            case 0:      print(", dry");
            case 1 to 2: print(", damp");
            case >= 3:   print(", well watered");
        }
        printLine(".");
    }

    bool potted() {
        return parent != null && parent.is(Pot);
    }
}

int weightOrder(object a, object b) {
    return bgl.util.math.sign(((Plant)a).weight - ((Plant)b).weight);
}

// --- rooms ------------------------------------------------------------------------------------------

class Room : object {
    attributes = {light, proper};
}

Room roomA {
    "Room A";
    description = "Room A. A bench stands under a tap. Room B is east.";
    e_to = roomB;
}

Room roomB {
    "Room B";
    description = "Room B. Three pots stand in a row by a heater. Room A is west.";
    w_to = roomA;
}

// --- room A -----------------------------------------------------------------------------------------

object bench {
    "bench";
    parent = roomA;
    name = {.bench};
    description = "A wooden bench.";
    attributes = {supporter, static};
}

object tap {
    "tap";
    parent = roomA;
    name = {.tap};
    description = "A brass tap.";
    attributes = {static};
}

object can {
    "watering can";
    parent = bench;
    name = {.watering, .can};
    int water = 0;

    void description() {
        if (water == 0) printLine("An empty watering can.");
        else printLine($"A watering can holding {water} of {CAN_MAX}.");
    }
}

object packet {
    "seed packet";
    parent = bench;
    name = {.seed, .packet};
    description = "A paper seed packet.";
    attributes = {container, open};
}

Plant redSeed {
    "red seed";
    parent = packet;
    name = {.red, .seed};
    kind = "red";
    weight = 3;
}

Plant blueSeed {
    "blue seed";
    parent = packet;
    name = {.blue, .seed};
    kind = "blue";
    weight = 2;
}

Plant whiteSeed {
    "white seed";
    parent = packet;
    name = {.white, .seed};
    kind = "white";
    weight = 4;
}

// --- room B -----------------------------------------------------------------------------------------

class Pot : object {
    int label = 0;
    attributes = {container, open, static};

    void description() {
        if (children.length == 0) printLine($"Pot {label}. It is empty.");
        else printLine($"Pot {label}. It holds {a(child)}.");
    }

    bool before() {
        switch (action) {
            case Receive:
                if (!noun.is(Plant)) rtrue("Only seeds go in the pots.^");
                if (children.length > 0) rtrue($"Pot {label} already holds something.^");
        }
        rfalse;
    }

    bool after() {
        switch (action) {
            case LetGo:
                jot("unpotted", label);
        }
        rfalse;
    }
}

Pot pot1 {
    "pot 1";
    parent = roomB;
    name = {.pot, .one, .first};
    label = 1;
}

Pot pot2 {
    "pot 2";
    parent = roomB;
    name = {.pot, .two, .second};
    label = 2;
}

Pot pot3 {
    "pot 3";
    parent = roomB;
    name = {.pot, .three, .third};
    label = 3;
}

array<object> pots = {pot1, pot2, pot3};

object heater {
    "heater";
    parent = roomB;
    name = {.heater};
    attributes = {switchable, static};

    void description() {
        if (has(on)) printLine("A heater. It is on.");
        else printLine("A heater. It is off.");
    }

    bool after() {
        switch (action) {
            case SwitchOn:
                StartDaemon(grower);
                jot("heat on");
                rtrue("The heater hums.^");
            case SwitchOff:
                StopDaemon(grower);
                jot("heat off");
                rtrue("The heater goes quiet.^");
        }
        rfalse;
    }
}

object grower {
    "grower";

    void daemon() {
        growTurns++;
        for (object p in pots) {
            if (p.children.length == 0) continue;
            Plant pl = (Plant)p.child;
            if (pl.stage == eStage.flower) continue;
            if (pl.water.dry()) continue;
            pl.water -= 1;
            pl.growth++;
            if (pl.growth < GROW_TURNS) continue;
            pl.growth = 0;
            pl.stage = (eStage)((int)pl.stage + 1);
            jot(pl.kind, (int)pl.stage);
            if (pl.stage == eStage.flower && !firstFlower) {
                firstFlower = true;
                score++;
            }
            if (location == roomB) printLine($"The {pl.kind} plant in pot {((Pot)p).label} is now a {stageName(pl.stage)}.");
        }
    }
}

object gardener {
    "gardener";
    parent = roomB;
    name = {.gardener};
    description = "A gardener in an apron.";
    int asked = 0;
    int given = 0;
    attributes = {animate};

    bool life() {
        switch (action) {
            case Ask:
                asked++;
                wn = consult_from;
                dictionaryWord w = NextWord();
                if (w == .seed || w == .seeds) rtrue("The gardener says: one seed to a pot.^");
                if (w == .water) rtrue($"The gardener says: a pot holds {GAUGE_MAX} of water.^");
                if (w == .heater) rtrue("The gardener says: nothing grows while it is off.^");
                rtrue("The gardener has nothing to say about that.^");
            case Give:
                if (!noun.is(Plant)) rtrue("The gardener says: keep it.^");
                Plant pl = (Plant)noun;
                if (pl.stage != eStage.flower) rtrue($"The gardener says: {the(pl)} is not in flower.^");
                pl.parent = null;
                given++;
                jot("given", given);
                if (given == 2) score++;
                rtrue($"The gardener takes {the(pl)}.^");
        }
        rfalse;
    }

    bool orders() {
        switch (action) {
            case Wait:
                rtrue("The gardener waits.^");
        }
        rtrue("The gardener says: I am busy.^");
    }
}

// --- verbs ------------------------------------------------------------------------------------------

verb FillCan {
    grammar = {.fill, NOUN};
    void handler() {
        if (noun != can) {
            printLine("You can't fill that.");
            return;
        }
        if (location != roomA) {
            printLine("The tap is in Room A.");
            return;
        }
        if (can.water == CAN_MAX) {
            printLine("The watering can is already full.");
            return;
        }
        can.water = CAN_MAX;
        jot("filled");
        printLine("You fill the watering can at the tap.");
    }
}

verb WaterPlant {
    grammar = {.water, NOUN};
    void handler() {
        if (can.parent != player) {
            printLine("You are not holding the watering can.");
            return;
        }
        if (noun.is(Pot) && noun.children.length > 0) noun = noun.child;
        if (!noun.is(Plant)) {
            printLine("Only plants need water.");
            return;
        }
        Plant pl = (Plant)noun;
        if (!pl.potted()) {
            printLine($"{cThe(pl)} is not in a pot.");
            return;
        }
        if (can.water == 0) {
            printLine("The watering can is empty.");
            return;
        }
        int poured = pour(pl.water, can.water);
        if (poured == 0) {
            printLine($"{cThe(pl)} has all the water it can take.");
            return;
        }
        can.water -= poured;
        wateredCount++;
        jot("watered", poured);
        printLine($"You water {the(pl)} ({poured}). The can holds {can.water}.");
    }
}

verb Sow {
    grammar = {.sow, NOUN, .in, NOUN};
    void handler() {
        if (!noun.is(Plant) || ((Plant)noun).stage != eStage.seed) {
            printLine("Only seeds are sown.");
            return;
        }
        if (!second.is(Pot)) {
            printLine("Seeds are sown in pots.");
            return;
        }
        if (noun.parent != player) {
            printLine($"You need to hold {the(noun)}.");
            return;
        }
        Insert.perform(noun, second);
        if (noun.parent != second) return;
        sownCount++;
        jot("sown", ((Pot)second).label);
        if (!firstSow) {
            firstSow = true;
            score++;
        }
    }
}

verb Pick {
    grammar = {.pick, NOUN};
    void handler() {
        if (!noun.is(Plant)) {
            printLine("You can't pick that.");
            return;
        }
        Plant pl = (Plant)noun;
        if (pl.stage != eStage.flower) {
            printLine($"{cThe(pl)} is not in flower.");
            return;
        }
        if (pl.parent == player) {
            printLine($"You already have {the(pl)}.");
            return;
        }
        pl.parent = player;
        pickedCount++;
        weights += pl.weight;
        jot("picked", pl.weight);
        printLine($"You pick {the(pl)}.");
    }
}

verb Plants {
    meta = true;
    grammar = {.plants};
    void handler() {
        array<object> all[8];
        all = bgl.world.instances(Plant);
        int inPots = all.filter((object o) => ((Plant)o).potted()).count();
        int seeds = all.filter((object o) => ((Plant)o).stage == eStage.seed).count();
        printLine($"{all.length} plants: {inPots} potted, {seeds} still seeds.");
        array<object> byWeight[8];
        byWeight = all.filter((object o) => o.parent != null).orderBy(weightOrder);
        for (object o in byWeight) {
            Plant pl = (Plant)o;
            printLine($"{pl}: {stageName(pl.stage)}, water {(int)pl.water}, weight {pl.weight}, in {the(pl.parent)}.");
        }
        if (all.any((object o) => ((Plant)o).potted() && ((Plant)o).water.dry()))
            printLine("A potted plant is dry.");
        if (all.all((object o) => ((Plant)o).stage == eStage.flower))
            printLine("Every plant has flowered.");
    }
}

verb Stages {
    meta = true;
    grammar = {.stages};
    void handler() {
        for (int s in 1 to 4) {
            int n = 0;
            for (object o in bgl.world.instances(Plant)) {
                if ((int)((Plant)o).stage == s) n++;
            }
            printLine($"{stageName((eStage)s)}: {n}");
        }
    }
}

verb ListPots {
    meta = true;
    grammar = {.pots};
    void handler() {
        int i = 0;
        do {
            Pot p = (Pot)pots[i];
            if (p.children.length == 0) {
                printLine($"Pot {p.label}: empty");
            } else {
                for (object c in p.children) {
                    Plant pl = (Plant)c;
                    printLine($"Pot {p.label}: {pl.kind} {stageName(pl.stage)}, growth {pl.growth}");
                }
            }
            i++;
        } until (i == pots.length);
    }
}

verb Picked {
    meta = true;
    grammar = {.picked};
    void handler() {
        if (weights.length == 0) {
            printLine("Nothing picked.");
            return;
        }
        array<int> sorted[8];
        sorted = weights;
        sorted.sort();
        print("Picked:");
        for (int w in sorted) print($" {w}");
        int total = 0;
        int i = 0;
        while (i < weights.length) {
            total += weights[i];
            i++;
        }
        int heavy = weights.filter((int w) => w >= 3).count();
        printLine($". Total {total}, {heavy} heavy. The first pick was number {sorted.indexOf(weights[0]) + 1} by weight.");
    }
}

verb Status {
    meta = true;
    grammar = {.status};
    void handler() {
        string h = heater.has(on) ? "on" : "off";
        printLine($"Score {score} of {MAX_SCORE}. Heater {h}, {growTurns} warm turns. Can {can.water}.");
        printLine($"Sown {sownCount}, watered {wateredCount}, picked {pickedCount}, given {gardener.given}, gardener asked {gardener.asked}.");
    }
}

verb ReadLog {
    meta = true;
    grammar = {.log};
    void handler() {
        if (logText.length == 0) {
            printLine("The log is empty.");
            return;
        }
        printLine($"Log ({logCount}): {logText}");
    }
}

bool Initialise() {
    for (object o in bgl.world.instances(Plant)) {
        Plant pl = (Plant)o;
        pl.water = 0;
    }
    rfalse;
}
