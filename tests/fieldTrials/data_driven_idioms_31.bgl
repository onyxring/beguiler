/*  Field trial — exercises the Beguile compiler against the Inform 6 standard library.
    A hardening test: not a game, not an example, not for reuse.  */

// Exercises: a survey grid kept as value-class tables. A point value class with inline members, a copy
// operator, == / != / <=> (with < and >= derived), + and - returning inline values built from members,
// +=, a static factory and a method returning a swapped inline value; a mark subclass that re-lists the
// inherited members to put its own label first and chains the copy operator by cast; a box value class
// owning two point members, initialized globally with nested inline values and locally from operator
// results; a route value class owning an array of points built from Route{ { … } } with call results; an array
// of marks written as bare { … } rows, sorted by the inherited <=>, searched by the inherited ==,
// changed by += on a subscript and through a ref member bound with :=; ref locals bound to array
// elements and object members; ref parameters given object members and locals; value parameters given
// subclass values, with an inline-value default and named arguments; returns of inline values and of
// array elements; ?: choosing between value-class operands; == against an inline value; operator
// results read for members inside interpolation; a recursive routine keeping its value-class parameters
// per call; an object owning point and route members and a member array of points (contains, -=,
// insert, last); a reference class owning a point per object; a note value class holding a stringObj,
// kept in a capped array; a table of lambdas taking a point; <linq> filter / any / all / count / orderBy
// / first / last / take / skip / takeWhile / map over value-class arrays with lambdas capturing
// value-class locals and globals, and chain results captured into local value-class arrays.

#beguilerSettings {
    target = z5;
    includePaths = "../../../inform6/stdlib";
    // walk() recurses 11 deep with value-class parameters, each call taking frame-pool words.
    framePoolSize = 128;
}

#include <bindings/i6StandardLibrary>
#includeI6 "parser"
#includeI6 "verblib"
#include <array>
#include <linq>
#include <string>

//-- Constants -------------------------------------------------------------------

const int MARK_COUNT = 5;
const int TRAIL_MAX = 4;
const int NOTE_MAX = 3;
const int NONE = -1;

//-- Value classes ---------------------------------------------------------------


value class Pt {
    inline int x;
    inline int y;
    Pt operator = (Pt o) { x = o.x; y = o.y; return self; }
    bool operator == (Pt o) { return x == o.x && y == o.y; }
    bool operator != (Pt o) { return x != o.x || y != o.y; }
    int operator <=> (Pt o) {
        if (y != o.y) return y - o.y;
        return x - o.x;
    }
    Pt operator + (Pt o) { return Pt{ x + o.x, y + o.y }; }
    Pt operator - (Pt o) { return Pt{ x - o.x, y - o.y }; }
    Pt operator += (Pt o) { x += o.x; y += o.y; return self; }
    int dist(Pt o) { return gap(x, o.x) + gap(y, o.y); }
    Pt flip() { return Pt{ y, x }; }
    void into(ref stringObj s) { s += $"({x},{y})"; }
    static Pt at(int x, int y) { return Pt{ x, y }; }
}

// A mark puts its label ahead of the inherited x and y, then its weight.
value class Mark : Pt {
    inline string label;
    inline x;
    inline y;
    inline int weight;
    Mark operator = (Mark o) {
        (Pt)self = o;
        label = o.label;
        weight = o.weight;
        return self;
    }
}

value class Box {
    inline Pt lo;
    inline Pt hi;
    Box operator = (Box o) { lo = o.lo; hi = o.hi; return self; }
    bool holds(Pt p) { return p.x >= lo.x && p.x <= hi.x && p.y >= lo.y && p.y <= hi.y; }
    int area() {
        Pt d = hi - lo;
        return (d.x + 1) * (d.y + 1);
    }
    void clamp(ref Pt p) {
        if (p.x < lo.x) p.x = lo.x;
        if (p.x > hi.x) p.x = hi.x;
        if (p.y < lo.y) p.y = lo.y;
        if (p.y > hi.y) p.y = hi.y;
    }
    void into(ref stringObj s) {
        lo.into(s);
        s += "-";
        hi.into(s);
    }
}

value class Note {
    inline int mark;
    inline int at;
    stringObj text;
    Note operator = (Note o) { mark = o.mark; at = o.at; text = o.text; return self; }
}

// A planned route: a start, a midpoint and an end.
value class Route {
    inline array<Pt> stops[3];
    int cost;
    Route operator = (Route o) {
        stops.copyFrom(o.stops);
        cost = o.cost;
        return self;
    }
    int total() { return stops[0].dist(stops[1]) + stops[1].dist(stops[2]); }
}

//-- Tables ----------------------------------------------------------------------

//                     label     x  y  weight
array<Mark> marks = {
    { "post",  1, 1, 3 },
    { "well",  4, 2, 5 },
    { "gate",  6, 0, 2 },
    { "oak",   2, 4, 4 },
    { "cairn", 8, 3, 1 }
};

array<dictionaryWord> markWords = { .post, .well, .gate, .oak, .cairn };

Box field = Box{ Pt{ 0, 0 }, Pt{ 6, 4 } };

array<Note> notes[NOTE_MAX];

// Scoring rules over a point, picked by number.
array<func<int, Pt>> rules = {
    (Pt p) => p.x + p.y,
    (Pt p) => p.x * p.y,
    (Pt p) => p.dist(field.hi),
    (Pt p) => field.holds(p) ? 1 : 0
};
array<string> ruleNames = { "sum", "product", "to corner", "inside" };

//-- Objects ---------------------------------------------------------------------

extend extern class object {
    string description;
}

object roomA {
    "Room A";
    description = "Room A.";
    attributes = {light};
}

object surveyor {
    "surveyor";
    Pt pos = Pt{ 0, 0 };
    Pt home = Pt{ 0, 0 };
    ref Mark target;
    array<Pt> trail[TRAIL_MAX];
    int moves = 0;
    Route plan;

    void moveBy(Pt d) {
        pos += d;
        field.clamp(pos);
        if (trail.length == TRAIL_MAX) trail.remove(0);
        trail += pos;
        moves++;
    }
}

class Stake : object {
    inline Pt at;
    inline int code;
}

object stakeBag { "stake bag"; }

Stake stakeRed { Pt{ 2, 1 }, 1, "red stake"; parent = stakeBag; }
Stake stakeBlue { Pt{ 4, 2 }, 2, "blue stake"; parent = stakeBag; }
Stake stakeGray { Pt{ 7, 7 }, 3, "gray stake"; parent = stakeBag; }

//-- Parsing ---------------------------------------------------------------------

int parseMark() {
    int at = markWords.indexOf(NextWord());
    if (at == NONE) return -1;
    parsed_number = at;
    return 1;
}

//-- Helpers ---------------------------------------------------------------------

int gap(int a, int b) { return a > b ? a - b : b - a; }


void padTo(ref stringObj s, int w) {
    while (s.length < w) s += " ";
}

Pt mid(Pt a, Pt b) { return Pt{ (a.x + b.x) / 2, (a.y + b.y) / 2 }; }

void swapPts(ref Pt a, ref Pt b) {
    Pt t = a;
    a = b;
    b = t;
}

int nearestMark(Pt from) {
    int best = NONE;
    int bestD = 0;
    for (int i in 0 to marks.length - 1) {
        ref Mark m := marks[i];
        int d = m.dist(from);
        if (best == NONE || d < bestD) {
            best = i;
            bestD = d;
        }
    }
    return best;
}

// The mark farthest from a point, handed back as a plain point.
Pt farthest(Pt from) {
    int at = 0;
    for (int i in 1 to marks.length - 1)
        if (marks[i].dist(from) > marks[at].dist(from)) at = i;
    return marks[at];
}

int countIn(array<Mark> a, Box b) {
    return a.filter((Mark m) => b.holds(m)).count();
}

// Steps one square at a time toward goal; lists the squares on the way back out.
int walk(Pt at, Pt goal, ref stringObj s) {
    if (at == goal) {
        at.into(s);
        return 0;
    }
    Pt next = at;
    if (next.x != goal.x) next.x += next.x < goal.x ? 1 : -1;
    else next.y += next.y < goal.y ? 1 : -1;
    int n = walk(next, goal, s) + 1;
    s += "<";
    at.into(s);
    return n;
}

int distFrom(Pt m, Pt from = Pt{ 0, 0 }, int scale = 1) {
    return m.dist(from) * scale;
}

void routeInto(ref stringObj s, Route r) {
    r.stops[0].into(s);
    s += ">";
    r.stops[1].into(s);
    s += ">";
    r.stops[2].into(s);
    s += $" cost {r.cost}";
}

void markRow(ref stringObj row, Mark m) {
    row += m.label;
    padTo(row, 7);
    m.into(row);
    padTo(row, 14);
    row += $"w{m.weight}";
    padTo(row, 18);
    row += field.holds(m) ? "in" : "out";
}

//-- Verbs -----------------------------------------------------------------------

verb MarksTest {
    grammar = {.marks};
    void handler() {
        for (Mark m in marks) {
            stringObj row = "";
            markRow(row, m);
            row.print();
            print("^");
        }
        array<Mark> byPos[MARK_COUNT];
        byPos.copyFrom(marks);
        byPos.sort();
        stringObj line = "By position:";
        for (Mark m in byPos) line += $" {m.label}";
        line += ".";
        line.print();
        print("^");
        Mark heavy = marks.orderBy((Mark a, Mark b) => b.weight - a.weight).first();
        print($"Heaviest: {heavy.label} ({heavy.weight}).^");
        print($"In field: {countIn(marks, field)} of {marks.length}.^");
    }
}

verb PaceTest {
    grammar = {.pace, NUMBER, NUMBER};
    void handler() {
        Pt want = Pt.at((int)noun, (int)second);
        surveyor.moveBy(want - surveyor.pos);
        stringObj line = "At ";
        surveyor.pos.into(line);
        if (surveyor.pos != want) line += " (held at the edge)";
        line += ".";
        line.print();
        print("^");
    }
}

verb WhereTest {
    grammar = {.where};
    void handler() {
        Pt here = surveyor.pos;
        int n = nearestMark(here);
        stringObj line = "At ";
        here.into(line);
        line += $", {surveyor.moves} moves. Nearest: {marks[n].label}, {marks[n].dist(here)} away.";
        line.print();
        print("^");
        Pt far = farthest(here);
        Pt back = surveyor.home;
        Pt closer = far.dist(here) <= back.dist(here) ? far : back;
        line = "Far point ";
        far.into(line);
        line += "; closer of it and home: ";
        closer.into(line);
        line += ".";
        line.print();
        print("^");
        if (here == surveyor.home) print("At home.^");
        else print($"Offset from home: {(here - surveyor.home).x},{(here - surveyor.home).y}.^");
        if (here == Pt{ 0, 0 }) print("At the origin.^");
        if (marks.any((Mark m) => m == here)) print("On a mark.^");
    }
}

verb AimTest {
    grammar = {.aim, parseMark};
    void handler() {
        int i = (int)noun;
        surveyor.target := marks[i];
        stringObj line = $"Aimed at {surveyor.target.label} ";
        surveyor.target.into(line);
        line += ".";
        line.print();
        print("^");
    }
}

verb NudgeTest {
    grammar = {.nudge, NUMBER, NUMBER};
    void handler() {
        if (!surveyor.target) {
            print("No target.^");
            return;
        }
        surveyor.target += Pt{ (int)noun, (int)second };
        surveyor.target.weight++;
        int i = marks.indexOf(surveyor.target);
        stringObj row = "";
        markRow(row, marks[i]);
        row.print();
        print("^");
    }
}

verb TrailTest {
    grammar = {.trail};
    void handler() {
        if (surveyor.trail.length == 0) {
            print("No trail.^");
            return;
        }
        stringObj line = "Trail:";
        for (Pt p in surveyor.trail) {
            line += " ";
            p.into(line);
        }
        line.print();
        print("^");
        array<Pt> sorted[TRAIL_MAX] = surveyor.trail.orderBy((Pt a, Pt b) => a <=> b);
        line = "Sorted:";
        for (Pt p in sorted) {
            line += " ";
            p.into(line);
        }
        line.print();
        print("^");
        int h = surveyor.trail.indexOf(surveyor.home);
        if (h == NONE) print("Home is not on the trail.^");
        else print($"Home is step {h + 1}.^");
        bool rising = true;
        for (int i in 1 to surveyor.trail.length - 1)
            if (surveyor.trail[i] < surveyor.trail[i - 1]) rising = false;
        Pt last = surveyor.trail.last();
        int above = surveyor.trail.filter((Pt p) => p >= last).count();
        print($"Rising: {rising ? "yes" : "no"}; at or above the last step: {above}.^");
        Pt lowest = sorted.first();
        bool allIn = surveyor.trail.all((Pt p) => field.holds(p));
        print($"Lowest row {lowest.y}; all in field: {allIn ? "yes" : "no"}.^");
    }
}

verb RouteTest {
    grammar = {.route};
    void handler() {
        if (!surveyor.target) {
            print("No target.^");
            return;
        }
        stringObj path = "";
        int n = walk(surveyor.pos, surveyor.target, path);
        path.print();
        print($" ({n} steps)^");
    }
}

verb SwapTest {
    grammar = {.swap};
    void handler() {
        swapPts(surveyor.pos, surveyor.home);
        stringObj line = "Pos ";
        surveyor.pos.into(line);
        line += ", home ";
        surveyor.home.into(line);
        line += ".";
        line.print();
        print("^");
    }
}

verb FlipTest {
    grammar = {.flip};
    void handler() {
        Pt p = surveyor.pos;
        Pt once = p.flip();
        Pt twice = p.flip().flip();
        Pt sum = p + once + Pt{ 1, 1 };
        stringObj line = "";
        once.into(line);
        line += " ";
        twice.into(line);
        line += " ";
        sum.into(line);
        if (twice == p) line += " same";
        if ((p + once).x == sum.x - 1) line += " ok";
        line.print();
        print("^");
    }
}

verb BoxTest {
    grammar = {.box};
    void handler() {
        Box near = Box{ surveyor.pos - Pt{ 1, 1 }, surveyor.pos + Pt{ 1, 1 } };
        stringObj line = "Field ";
        field.into(line);
        line += $", area {field.area()}; near ";
        near.into(line);
        line += $", area {near.area()}.";
        line.print();
        print("^");
        Pt c = mid(near.lo, near.hi);
        if (c == surveyor.pos) print("Centered.^");
        array<Mark> close[MARK_COUNT] = marks.filter((Mark m) => near.holds(m));
        print($"Near marks: {countIn(close, near)}");
        for (Mark m in close) print($" {m.label}");
        print(".^");
        int sum = 0;
        for (var d in marks.map((Mark m) => m.dist(c))) sum += d;
        print($"Total distance from center: {sum}.^");
    }
}

verb StakesTest {
    grammar = {.stakes};
    void handler() {
        for (object o in stakeBag.children) {
            Stake st = (Stake)o;
            stringObj line = $"{st.code}: ";
            st.at.into(line);
            if (!field.holds(st.at)) line += " outside";
            if (marks.any((Mark m) => m.dist(st.at) <= 1)) line += " by a mark";
            Pt off = st.at - surveyor.pos;
            line += $" off {off.x},{off.y}";
            line.print();
            print("^");
        }
    }
}

verb NoteTest {
    grammar = {.note, parseMark};
    void handler() {
        int i = (int)noun;
        Note n;
        n.mark = i;
        n.at = surveyor.moves;
        n.text = $"{marks[i].label} seen";
        if (marks[i] == surveyor.pos) n.text += " close";
        if (notes.length == NOTE_MAX) notes.remove(0);
        notes += n;
        print($"Noted ({notes.length}).^");
    }
}

verb NotesTest {
    grammar = {.notes};
    void handler() {
        if (notes.length == 0) {
            print("No notes.^");
            return;
        }
        for (Note n in notes) {
            stringObj row = $"{n.at}: ";
            row += n.text;
            row += " ";
            marks[n.mark].into(row);
            row.print();
            print("^");
        }
    }
}

verb TradeTest {
    grammar = {.trade, parseMark, parseMark};
    void handler() {
        int a = (int)noun;
        int b = (int)second;
        swapPts(marks[a], marks[b]);
        stringObj row = "";
        markRow(row, marks[a]);
        row.print();
        print("^");
        row = "";
        markRow(row, a < b ? marks[b] : marks[a]);
        row.print();
        print("^");
    }
}

verb DriftTest {
    grammar = {.drift};
    void handler() {
        array<Mark> before[MARK_COUNT];
        before.copyFrom(marks);
        for (int i in 0 to marks.length - 1) {
            marks[i] += Pt{ 1, 0 };
            field.clamp(marks[i]);
        }
        int moved = 0;
        for (int i in 0 to marks.length - 1)
            if (marks[i] != before[i]) moved++;
        Mark stuck = marks.filter((Mark m) => m.x == field.hi.x).last();
        print($"Moved {moved}; last at the edge: {stuck.label}.^");
    }
}

verb TopTest {
    grammar = {.top};
    void handler() {
        array<Mark> top2[2] = marks.orderBy((Mark a, Mark b) => b.weight - a.weight).take(2);
        stringObj line = "Top:";
        for (Mark m in top2) line += $" {m.label} {distFrom(m)}/{distFrom(m, surveyor.pos)}/{distFrom(m, scale: 2)}";
        line += ".";
        line.print();
        print("^");
        Mark light = marks.orderBy((Mark a, Mark b) => b.weight - a.weight).last();
        Pt anchor = top2[0];
        array<Mark> nearTop[MARK_COUNT] = marks.skip(1).takeWhile((Mark m) => m.dist(anchor) < 8);
        print($"Lightest: {light.label}; near the top from the second on: {nearTop.length}.^");
    }
}

verb ScoreTest {
    grammar = {.score, NUMBER};
    void handler() {
        int r = (int)noun;
        if (r < 1 || r > rules.length) {
            print("No such rule.^");
            return;
        }
        func<int, Pt> f = rules[r - 1];
        int best = NONE;
        int bestScore = 0;
        for (int i in 0 to marks.length - 1) {
            int sc = f(marks[i]);
            if (best == NONE || sc > bestScore) {
                best = i;
                bestScore = sc;
            }
        }
        print($"{ruleNames[r - 1]}: here {f(surveyor.pos)}, best {marks[best].label} {bestScore}.^");
    }
}

verb PlantTest {
    grammar = {.plant, NUMBER};
    void handler() {
        for (object o in stakeBag.children) {
            Stake st = (Stake)o;
            if (st.code != (int)noun) continue;
            ref Pt h := surveyor.home;
            st.at = surveyor.pos;
            if (st.at == h) st.at += Pt{ 0, 1 };
            stringObj line = $"Stake {st.code} at ";
            st.at.into(line);
            line += ".";
            line.print();
            print("^");
            return;
        }
        print("No such stake.^");
    }
}

verb PlanTest {
    grammar = {.plan};
    void handler() {
        if (!surveyor.target) {
            print("No target.^");
            return;
        }
        Route r = Route{ { surveyor.pos, mid(surveyor.pos, surveyor.target), surveyor.target } };
        r.cost = r.total();
        surveyor.plan = r;
        r.stops[2] = r.stops[0];
        stringObj line = "Plan ";
        routeInto(line, surveyor.plan);
        line += $"; local copy ends at ({r.stops[2].x},{r.stops[2].y}).";
        line.print();
        print("^");
    }
}

verb UnhomeTest {
    grammar = {.unhome};
    void handler() {
        bool had = surveyor.trail.contains(surveyor.home);
        surveyor.trail -= surveyor.home;
        surveyor.trail.insert(0, Pt{ 9, 9 });
        print($"{had ? "Removed" : "Not found"}; trail now {surveyor.trail.length}, first ({surveyor.trail[0].x},{surveyor.trail[0].y}).^");
    }
}

bool Initialise() {
    location = roomA;
    rfalse;
}

#includeI6 "grammar"
