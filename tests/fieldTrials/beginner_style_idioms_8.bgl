/*  Field trial — exercises the Beguile compiler against the Inform 6 standard library.
    A hardening test: not a game, not an example, not for reuse.  */

// Exercises: an eighth first-time-programmer program, the one where the author reads the "odd corners"
// of the spec and tries each one. An enum and a bnum with emitter methods and emitter values (in the body
// and added by extend enum / extend bnum), used on bare members, on variables, on a class member and on a
// call's result, inside interpolation; an emitter value in an object body; extend extern class
// intLiteral and a method called on a string literal; raw strings with backslashes, ^ and ~ and an
// escaped quote; char literals with escapes counted in an array<char>; dictionary word literals singular
// and plural (a plural name on a class so "take stamps" takes them all, ask/tell topics compared with
// both forms); a named union of object and string with an extend member, a home-made print() overload,
// and the union as a member, a return type and an array element walked with for-in; var values switched
// on typeof; emitter classes with init/deinit as locals inside for, while, nested blocks, a switch case
// left by break, a lambda body and a function returning from inside two loops; a pooled class whose
// create() takes three arguments and which owns a value-class member with an inline-object starting value
// (reset by new); a value class with emitter operator switch cases; a static func<> member called
// directly and a static method stored as a func value; a getter/setter member made read-only on a
// subclass with hide and written through a base parameter and an upcast; postfix ? on noun and second;
// #startup and #message.

#beguilerSettings {
    target = z5;
    includePaths = "../../../inform6/stdlib";
}

#message "beginner_style_idioms_8: compiling"

// runs before everything else (the spec says this is for libraries but I wanted to see it)
#startup {
    print "(starting up)^";
}

#includeI6 "parser"
#includeI6 "verblib"
#include <bindings/i6StandardLibrary>

// ===== ENUMS WITH METHODS (I didn't know enums could have methods!) =====
enum shade {
    rust, moss, sky,
    emitter int code()       { ($self * 10) }
    emitter int plus(int n)  { ($self + $n) }
}

// I added one more later on
extend enum shade {
    emitter int doubled { ($self * 2) }
}

bnum perm { canRead, canWrite, canRun }

extend bnum perm {
    emitter bool hasWrite() { (($self & 2) ~= 0) }
    emitter int bits { ($self + 0) }
}

// ===== NUMBERS GET METHODS TOO =====
extend extern class intLiteral {
    emitter void twice() { print $val * 2; }
}

// ===== A THING OR SOME TEXT (a union with a name) =====
union nameable = object | string;

extend nameable {
    emitter bool isThing() { (metaclass($val) == Object) }
}

// my own print for it
void print(nameable v) {
    if (typeof(v) == eType.object) {
        print("the ");
        print((object)v);
    } else {
        print("~");
        print((string)v);
        print("~");
    }
}

// ===== A TRACKER (copied from how stringObj does init and deinit) =====
emitter class tracker {
    emitter void init()   { $self = 0; print "["; }
    emitter void deinit() { print "]"; }
}

// counts up and gives up early sometimes
int tracked(int n) {
    tracker t;
    if (n == 0) {
        return 0;
    }
    if (n > 5) {
        print("big");
        return 5;
    }
    print(n);
    return n;
}

// another one with different brackets so I can tell them apart
emitter class marker {
    emitter void init()   { $self = 0; print "<"; }
    emitter void deinit() { print ">"; }
}

// finds which row of a 3 by 3 grid the middle square is in
int findMiddle() {
    marker outerMark;
    for (int r = 0; r < 3; r++) {
        tracker rowTrack;
        for (int c = 0; c < 3; c++) {
            if (r * 3 + c == 4) {
                return r;
            }
        }
    }
    return -1;
}

// ===== MONEY =====
value class Coins {
    int cents;
    Coins operator = (Coins o) { cents = o.cents; return self; }
}

// ===== TOKENS (only two of them) =====
class Token[2] : object {
    Coins price = Coins{ cents = 3; };
    int a;
    int b;
    int c;
    void create(int x, int y, int z) {
        a = x;
        b = y;
        c = z;
    }
    void destroy() {
        print($"(token {a}{b}{c} gone)^");
    }
}

// ===== MARKS =====
value class Mark {
    int points;
    Mark operator = (Mark o) { points = o.points; return self; }
    // a case value is the tens of the points
    emitter eBool operator switch (int v) { ($self.points / 10 == $v) }
}

// ===== HELPERS IN A CLASS =====
class Helpers {
    static func<int, int> step;
    static int triple(int n) { return n * 3; }
    static int addOne(int n) { return n + 1; }
}

// ===== SIZES =====
value class dim {
    int _val = 0;
    int  operator ()        { return _val; }
    void operator = (int v) { _val = v; }
}

class board : object {
    dim width;
    dim height;
}

// a tall board can't have its height changed
class tallBoard : board {
    hide height.operator =;
}

board plainBoard { "plain board"; }
tallBoard sideBoard { "tall board"; }

// sets the height of any board (works on tall ones too because it takes a board)
void setHeight(board b, int h) {
    b.height = h;
}

// ===== ROOMS =====
attribute stamped;

object roomA {
    "Room A";
    string description = "Room A. Room B is to the east.";
    object e_to = roomB;
    attributes = {light};
}

object roomB {
    "Room B";
    string description = "Room B. Room A is to the west.";
    object w_to = roomA;
    attributes = {light};
}

// ===== STAMPS (three the same, so "stamps" means all of them) =====
class Stamp : object {
    rawArray<dictionaryWord> name = {.stamp, ..stamps};
    shade tint = rust;
    // who it belongs to (a person, or just a name written on it)
    nameable owner = "nobody";
}

Stamp redStamp   { "red stamp";   name = {.red};   parent = roomA; }
Stamp greenStamp { "green stamp"; name = {.green}; parent = roomA; tint = moss; }
Stamp blueStamp  { "blue stamp";  name = {.blue};  parent = roomA; tint = sky; owner = clerk; }

// some labels, some of them things
array<nameable> labels = {pad, "spare label", clerk};

// one of the labels
nameable pick(int i) {
    return labels[i];
}

// makes a permission (and says so)
perm makePerm(bool write) {
    print("(made)");
    if (write) {
        return canRead | canWrite;
    }
    return canRead;
}

object pad {
    "ink pad";
    name = {.ink, .pad};
    parent = roomA;
    attributes = {static};
}

// ===== THE CLERK =====
object clerk {
    "clerk";
    name = {.clerk};
    parent = roomB;
    attributes = {animate};
    string description = "A clerk.";
    // how many stamps the clerk sells (a value that is never stored)
    emitter int stampsForSale { 3 }
    bool life() {
        if (action == Ask) {
            dictionaryWord topic = (dictionaryWord)second;
            if (topic == .stamp) {
                print("~One stamp,~ says the clerk.^");
                rtrue;
            }
            if (topic == ..stamps) {
                print("~Stamps, plural,~ says the clerk.^");
                rtrue;
            }
            if (topic == .pad || topic == .ink) {
                print("~The pad is in Room A,~ says the clerk.^");
                rtrue;
            }
            print("~No idea,~ says the clerk.^");
            rtrue;
        }
        if (action == Tell) {
            if ((dictionaryWord)second == .tea) {
                print("~I like tea,~ says the clerk.^");
                rtrue;
            }
            print("The clerk nods.^");
            rtrue;
        }
        rfalse;
    }
}

bool Initialise() {
    location = roomA;
    Helpers.step = Helpers.addOne;
    rtrue;
}

#includeI6 "grammar"

// ===== VERBS =====

// STAMP X / STAMP X WITH Y
verb StampIt {
    grammar = {
        {.stamp, NOUN},
        {.stamp, NOUN, .with, HELD},
    };
    void handler() {
        if (!noun?) {
            print("Stamp what?^");
            return;
        }
        if (second?) {
            print($"You stamp the {noun} with the {second}.^");
        } else {
            print($"You stamp the {noun}.^");
        }
        noun.give(stamped);
    }
}

// SHADES - the enum methods
verb Shades {
    meta = true;
    grammar = {.shades};
    void handler() {
        print($"Codes: {rust.code()} {moss.code()} {sky.code()}.^");
        shade s = moss;
        print($"Moss plus 5: {s.plus(5)}. Sky doubled: {sky.doubled}. s doubled: {s.doubled}.^");
        perm p = canRead | canRun;
        perm q = canRead | canWrite;
        if (p.hasWrite() == false) {
            print("p can't write. ");
        }
        if (q.hasWrite()) {
            print("q can write. ");
        }
        print($"p is {p.bits}, q is {q.bits}, canRun alone is {canRun.bits}.^");
        print($"Stamp codes: {redStamp.tint.code()} {greenStamp.tint.code()} {blueStamp.tint.plus(1)}.^");
        if (makePerm(true).hasWrite()) {
            print(" writable^");
        }
        if (!makePerm(false).hasWrite()) {
            print(" read only^");
        }
        int forSale = clerk.stampsForSale;
        print($"The clerk sells {forSale} stamps, or {clerk.stampsForSale + 1} with the spare.^");
    }
}

// LITERALS - numbers, raw text, letters and words
verb Literals {
    meta = true;
    grammar = {.literals};
    void handler() {
        print("Twice 21: ");
        21.twice();
        print(". Twice 50: ");
        50.twice();
        print(".^");
        string path = @"C:\games\box^1~";
        print(path);
        print("^");
        print(@"He said \"hi\" to me.");
        print("^");
        // letters
        char slash = '\\';
        char quote = '\'';
        array<char> line = "a\\b'c";
        int slashes = 0;
        int quotes = 0;
        for (int i = 0; i < line.length; i++) {
            if (line[i] == slash) {
                slashes++;
            }
            if (line[i] == quote) {
                quotes = quotes + 1;
            }
        }
        print($"Letters: {line.length}, slashes: {slashes}, quotes: {quotes}.^");
        // words
        dictionaryWord w = .stamp;
        dictionaryWord w2 = ..stamps;
        print($"Words: {w}, {w2}.^");
        if (w != w2) {
            print("The two words are different.^");
        }
        "Done with literals.^".print();
    }
}

// KINDS - the union and var
verb Kinds {
    meta = true;
    grammar = {.kinds};
    void handler() {
        nameable n = pad;
        print(n);
        if (n.isThing()) {
            print(" is a thing.^");
        }
        n = "loose text";
        print(n);
        if (!n.isThing()) {
            print(" is not a thing.^");
        }
        int things = 0;
        for (nameable l in labels) {
            print(l);
            if (l.isThing()) {
                things++;
            }
            print("; ");
        }
        print($"{things} of {labels.length} are things.^");
        print(pick(1));
        print(" is the second label.^");
        redStamp.owner = "Room B";
        for (object o in roomA.children) {
            if (o.is(Stamp)) {
                Stamp st = (Stamp)o;
                print($"The {st} belongs to ");
                print(st.owner);
                print(".^");
            }
        }
        var stuff = clerk;
        sayKind(stuff);
        stuff = "a note";
        sayKind(stuff);
        stuff = null;
        sayKind(stuff);
    }
}

// says what kind of value something is
void sayKind(var v) {
    switch (typeof(v)) {
        case eType.object:
            print($"An object: {(object)v}.^");
        case eType.string:
            print($"Some text: {(string)v}.^");
        default:
            print("Nothing I know.^");
    }
}

// CYCLE - when do trackers start and stop?
verb Cycle {
    meta = true;
    grammar = {.cycle};
    void handler() {
        for (int i = 0; i < 5; i++) {
            tracker t;
            if (i == 1) {
                continue;
            }
            if (i == 3) {
                break;
            }
            print(i);
        }
        print("^");
        int k = 0;
        while (k < 2) {
            {
                tracker inner;
                print("in");
            }
            print("out");
            k++;
        }
        print("^");
        // (one at a time so I know which one prints first)
        int total = tracked(0);
        total = total + tracked(3);
        total = total + tracked(9);
        print($" total {total}^");
        for (int j = 0; j < 3; j++) {
            switch (j) {
                case 1:
                    tracker s;
                    print("one");
                    if (k == 2) {
                        break;
                    }
                    print("!");
                default:
                    print(j);
            }
        }
        print("^");
        int where = findMiddle();
        print($" row {where}^");
    }
}

// TOKENS - the pool
verb Tokens {
    meta = true;
    grammar = {.tokens};
    void handler() {
        Token one = new Token(1, 2, 3);
        Token two = new Token(4, 5, 6);
        Token three = new Token(7, 8, 9);
        if (three == null) {
            print("No third token.^");
        }
        one.price.cents += 5;
        print($"Token one costs {one.price.cents}, token two costs {two.price.cents}.^");
        delete one;
        Token again = new Token(0, 0, 1);
        if (again != null) {
            print($"The new token is {again.a}{again.b}{again.c} and costs {again.price.cents}.^");
            delete again;
        }
        delete two;
    }
}

// GRADE - switch on my own class
verb Grade {
    meta = true;
    grammar = {.grade};
    void handler() {
        Mark m;
        array<int> list = {5, 42, 77, 99};
        for (int i = 0; i < 4; i++) {
            m.points = list[i];
            print($"{m.points}: ");
            switch (m) {
                case 0:
                    print("low");
                case 4, 5:
                    print("middle");
                case 9:
                    print("top");
                default:
                    print("other");
            }
            print("^");
        }
    }
}

// FUNCS - functions kept in a class
verb Funcs {
    meta = true;
    grammar = {.funcs};
    void handler() {
        print($"Step 4: {Helpers.step(4)}.^");
        Helpers.step = Helpers.triple;
        print($"Step 4 now: {Helpers.step(4)}.^");
        func<int, int> f = Helpers.addOne;
        print($"Add one to 9: {f(9)}.^");
        func<int, int> g = (int n) => {
            tracker t;
            return n * 2;
        };
        print($"Doubled with a tracker: {g(5)}.^");
        Helpers.step = (int n) => n - 1;
        print($"Step 4 last: {Helpers.step(4)}.^");
    }
}

// DIMS - board sizes
verb Dims {
    meta = true;
    grammar = {.dims};
    void handler() {
        plainBoard.width = 3;
        plainBoard.height = 4;
        sideBoard.width = 2;
        setHeight(sideBoard, 8);
        ((board)sideBoard).height = sideBoard.height + 1;
        int area = plainBoard.width * plainBoard.height;
        print($"Plain board: {plainBoard.width} by {plainBoard.height}, area {area}.^");
        print($"Tall board: {sideBoard.width} by {sideBoard.height}.^");
    }
}
