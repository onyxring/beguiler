/*  Field trial — exercises the Beguile compiler against the Inform 6 standard library.
    A hardening test: not a game, not an example, not for reuse.  */

// Exercises: layout and lexical habits in an ordinary small program with two rooms, a bench of three
// plants that grow under a lamp, a watering can filled at a tap, and shears that prune. A plant class
// with positional members (`inline instanceName` re-listed, an `inline int` rate), an enum stage, a
// class-wide static counter, `default` methods and a fern subclass overriding them; a switch on the
// stage with a `default`, a switch on water with comparison guards mixed with a range, and a string
// switch on the kind; a can with an inline `auto { … }` level accessor clamped by `outer.capacity` and a
// `before` rule on the library's `Fill`; a lamp whose `after` rules start and stop a daemon that grows
// the plants on the bench and logs their total height in an `array<int>` kept with
// `append()`/`dequeue()`; a pour routine with a default parameter, called positionally and by name,
// that `throw`s an int code caught in the verb handler; a value class census returned from a routine
// and filled through a `ref` parameter; an `array<Plant>` read with <linq> (`filter`, `count`, `orderBy`
// with a comparator, `first`, `all`, `any`, `take`, `skip`) and an `array<int>` read with `distinct`; a
// `stringObj` label built with `+=`, captured output, `toUpper()` and `left()`; `while` and `do … until`
// loops; `#define` values tested by `#if`/`#else`; `NUMBER` grammar with alternation; hex and binary
// literals, a raw string; mixed-case keywords, Allman and K&R braces, comments between tokens and inside
// argument lists, a routine with no spaces and a declaration split over lines.

#beguilerSettings
{
    target       = z5 ;
    includePaths = "../../../inform6/stdlib" ;
}

#includeI6 "parser"
#includeI6 "verblib"
#include <bindings/i6StandardLibrary>
#include <string>
#include  <linq>

#using bgl.printRules ;

#define LOG_MAX     5
#define POUR_SIZE   2          // default pour

// ==== constants =======================================================================================

const int CAN_FULL  = $0C ;            // twelve
const int SOAKED    = 9 ;
CONST INT CUT_BACK  = $$11 ;           // three
Const int BUD_AT    = 6 ;
const int BLOOM_AT  = 10 ;

/// How far along a plant is.
enum eStage
{
    seed ,
    sprout ,
    bud ,
    bloom ,     // the end for herbs
    wilted
}

// ==== rooms ===========================================================================================

class Room : object { attributeList attributes = { light } ; string description ; }

Room roomA
{
    "Room A" ;
    description = "Room A. A bench and a lamp are here. Room B is north." ;
    object n_to = roomB ;
}

Room roomB {
    "Room B" ;
    description = @"Room B. A tap is set in the wall. Room A is south." ;
    object s_to = roomA ;
}

object bench
{
    "bench" ;
    parent     = roomA ;
    name       = { .bench } ;
    attributes = { supporter , static } ;
    string description = "A long bench." ;
}

// ==== plants ==========================================================================================

class Plant : object
{
    inline instanceName ;
    inline int rate = 2 ;              // height gained per turn
    eStage stage    = eStage.seed ;
    int    water    = 2 ;
    int    height   = 0 ;
    attributeList attributes = { static } ;
    string description = "A plant in a pot." ;

    static int blooms = 0 ;

    default string kind () { return "herb" ; }
    default eStage top  () { return eStage.bloom ; }

    /// One turn under the lamp; true when the stage changed.
    bool grow ()
    {
        if (stage == eStage.wilted) rfalse ;
        eStage was = stage ;
        if (water <= 0)
        {
            stage = eStage.wilted ;
            rtrue ;
        }
        water-- ;
        height += rate ;
        if (height >= BLOOM_AT && top() == eStage.bloom)   stage = eStage.bloom ;
        else if (height >= BUD_AT)                          stage = eStage.bud ;
        else if (height >= 2)                               stage = eStage.sprout ;
        if (stage == eStage.bloom && was != eStage.bloom) Plant.blooms++ ;
        return stage != was ;
    }

    string stageName ()
    {
        switch (stage)
        {
            case eStage.seed   : return "seed" ;
            case eStage.sprout : return "sprout" ;
            case eStage.bud    : return "bud" ;
            case eStage.bloom  : return "bloom" ;
            default            : return "wilted" ;
        }
    }
}

class Fern : Plant
{
    string kind () { return "fern" ; }
    eStage top () { return eStage.bud ; }     // ferns never bloom
}

Plant basil { "basil" , 2 ; parent = bench ; name = { .basil , .herb } ; }
Plant mint
{
    "mint" , 3 ;
    parent = bench ;
    name   = { .mint , .herb } ;
    water  = 1 ;
}
Fern fernPot { "fern" ; parent = bench ; name = { .fern } ; water = 4 ; }

array<Plant> plants = { basil , mint , fernPot } ;

string tip ( string k )
{
    switch (k)
    {
        case "fern"  : return "keep it damp" ;
        case "herb"  : return "pinch the tips" ;
        default      : return "none" ;
    }
}

string wetness(int w){switch(w){case<=0:return "dry";case 1 to 3:return "moist";case>=SOAKED:return "soaked";default:return "wet";}}

// ==== the can and the tap =============================================================================

object can
{
    "watering can" ;
    parent   = roomB ;
    name     = { .watering , .can } ;
    string description = "A tin watering can." ;
    int capacity = CAN_FULL ;

    auto level = {
        int _in = 0 ;
        int  operator () { return _in ; }
        void operator = ( int v )
        {
            if (v < 0)               v = 0 ;
            if (v > outer.capacity)  v = outer.capacity ;
            _in = v ;
        }
    }

    bool before ()
    {
        switch (action)
        {
            case Fill :
                if (location != roomB) rtrue("There is no tap here.^") ;
                if (level == capacity) rtrue("The can is already full.^") ;
                level = capacity ;
                rtrue($"You fill the can ({level}).^") ;
            case Empty , EmptyT :
                level = 0 ;
                rtrue("You tip the can out.^") ;
        }
        rfalse ;
    }
}

object tap
{
    "tap" ;
    parent     = roomB ;
    name       = { .tap } ;
    attributes = { static } ;
    string description = "A brass tap." ;

    bool before ()
    {
        Switch (action) {
            CASE Turn , SwitchOn :
                rtrue("Fill the can at the tap instead.^") ;
        }
        rfalse ;
    }
}

object shears
{
    "shears" ;
    parent     = roomB ;
    name       = { .shears } ;
    attributes = { pluralname } ;
    string description = "A pair of shears." ;
}

/// Pours from the can into a plant; throws 1 when the can is empty, 2 when not held.
int pour ( Plant p , int amount = POUR_SIZE )
{
    if (can.parent != player) throw 2 ;
    if (can.level == 0)       throw 1 ;
    if (amount > can.level) amount = can.level ;
    can.level = can.level - amount ;
    p.water += amount ;
    return amount ;
}

// ==== the lamp and the log ============================================================================

array<int> heights[LOG_MAX] ;

void logHeight ( int h )
{
    if (heights.length == LOG_MAX) heights.dequeue() ;
    heights.append(h) ;
}

object lamp
{
    "lamp" ;
    parent     = roomA ;
    name       = { .lamp } ;
    attributes = { switchable , static } ;
    string description = "A grow lamp over the bench." ;
    int turns  = 0 ;

    bool after ()
    {
        switch (action)
        {
            case SwitchOn  : StartDaemon(self) ;
                             rtrue("The lamp hums on.^") ;
            case SwitchOff : StopDaemon(self) ;
                             rtrue("The lamp goes dark.^") ;
        }
        rfalse ;
    }

    void daemon ()
    {
        turns++ ;
        int total = 0 ;
        for (object o in bench.children)
        {
            if (!(o.is(Plant))) continue ;
            Plant p = (Plant) o ;
            bool changed = p.grow() ;
            total += p.height ;
            if (changed && location == roomA)
                print($"^{cThe(p)} is now {p.stage == eStage.sprout ? "a " : (p.stage == eStage.wilted ? "" : "in ")}{p.stageName()}.^") ;
        }
        logHeight(total) ;
    }
}

// ==== census ==========================================================================================

value class Census
{
    int seeds ;
    int growing ;      // sprouts and buds
    int blooms ;
    int wilted ;
    Census operator = ( Census o ) { seeds = o.seeds ; growing = o.growing ; blooms = o.blooms ; wilted = o.wilted ; return self ; }
}

void count ( ref Census c , Plant p )
{
    switch (p.stage)
    {
        case eStage.seed              : c.seeds++ ;
        case eStage.sprout , eStage.bud : c.growing++ ;
        case eStage.bloom             : c.blooms++ ;
        default                       : c.wilted++ ;
    }
}

Census
takeCensus
    ()
{
    Census c ;
    for (Plant p in plants) count(c , p) ;
    return c ;
}

// ==== labels ==========================================================================================

/// `KIND/NAME` in capitals, the name cut to four letters.
stringObj label ( Plant p )
{
    stringObj nm ;
    nm.capture() ;
    print(p) ;
    nm.release() ;
    stringObj s = p.kind() ;
    s += '/' ;
    s += nm.left(4) ;
    return s.toUpper() ;
}

// ==== Initialise ======================================================================================

bool Initialise ()
{
    location = roomA ;
    rfalse ;
}

#includeI6 "grammar"

// ==== commands ========================================================================================

verb WaterPlant
{
    grammar = {
        { .water , NOUN } ,
        { ( .water | .soak ) , NOUN , .with , NUMBER } ,
    } ;
    void handler ()
    {
        if (!(noun.is(Plant))) { printLine("Only the plants need water.") ; return ; }
        Plant p = (Plant) noun ;
        int got = 0 ;
        try
        {
            if (second == null) got = pour(p) ;
            else                got = pour(p , amount: /* from the command */ (int) second) ;
        }
        CATCH (int why)
        {
            if (why == 2) printLine("You have no can.") ;
            else          printLine("The can is empty.") ;
            return ;
        }
        print($"You water {the(p)} ({got}); it is {wetness(p.water)}") ;
        if (can.level == 0) print(", and the can is empty") ;
        printLine(".") ;
    }
}

verb Measure
{
    grammar = { { ( .measure | .check ) , NOUN } } ;
    void handler ()
    {
        if (!(noun.is(Plant))) { printLine("Only the plants can be measured.") ; return ; }
        Plant p = (Plant) noun ;
        stringObj l = label(p) ;
        l.print() ;
        printLine($": {p.stageName()}, height {p.height}, {wetness(p.water)}. Tip: {tip(p.kind())}.") ;
    }
}

verb Prune
{
    grammar = { { .prune , NOUN } , { .cut , NOUN } } ;
    void handler ()
    {
        if (shears.parent != player) { printLine("You need the shears.") ; return ; }
        if (!(noun.is(Plant)))       { printLine("That needs no pruning.") ; return ; }
        Plant p = (Plant) noun ;
        if (p.height < CUT_BACK) { printLine($"{cThe(p)} is too short to prune.") ; return ; }
        p.height -= CUT_BACK ;
        if (p.stage == eStage.bloom) Plant.blooms-- ;
        if (p.stage != eStage.wilted)
        {
            if      (p.height >= BUD_AT) p.stage = eStage.bud ;
            else if (p.height >= 2)      p.stage = eStage.sprout ;
            else                         p.stage = eStage.seed ;
        }
        printLine($"You prune {the(p)} to {p.height} ({p.stageName()}).") ;
    }
}

verb Survey
{
    meta    = true ;
    grammar = { { .survey } , { .census } } ;
    void handler ()
    {
        Census c = takeCensus() ;
        print($"{c.seeds} seed{c.seeds == 1 ? "" : "s"}, {c.growing} growing, ") ;
        printLine($"{c.blooms} in bloom, {c.wilted} wilted; {Plant.blooms} bloomed so far.") ;
        Plant tall = plants.orderBy( (Plant a , Plant b) => b.height - a.height ).first() ;
        int thirsty = plants.filter((Plant p) => p.water <= 0 && p.stage != eStage.wilted).count() ;
        print($"Tallest: {the(tall)} ({tall.height}); {thirsty} thirsty") ;
        If (plants.all( (Plant p) => p.stage != eStage.seed )) print("; all up") ;
        if (plants.any((Plant p) => p.stage == eStage.wilted)) print("; one or more lost") ;
        printLine(".") ;
    }
}

verb Rows
{
    meta    = true ;
    grammar = { .rows } ;
    void handler ()
    {
        Print("First two:") ;
        for (Plant p in plants.take(2)) print($" {p}") ;
        print(". Rest:") ;
        for (Plant p in plants.skip(2)) print($" {p}") ;
        printLine(".") ;
    }
}

verb GrowLog
{
    meta    = TRUE ;
    grammar = { { .log } , { .heights } } ;
    void handler ()
    {
        if (heights.length == 0) { printLine("Nothing logged.") ; return ; }
        stringObj line ;
        int i = 0 ;
        while (i < heights.length)
        {
            if (i > 0) line += " " ;
            line += $"{heights[i]}" ;
            i++ ;
        }
        line.print() ;
        int kinds = heights.distinct().count() ;
        printLine($" ({heights.length} turn{heights.length == 1 ? "" : "s"}, {kinds} different).") ;
    }
}

verb LampHours
{
    meta    = true ;
    grammar = { .hours } ;
    void handler ()
    {
        int left = lamp.turns ;
        int dozens = 0 ;
        do
        {
            if (left >= 12) dozens++ ;
            left -= 12 ;
        } until (left < 12) ;
#if LOG_MAX > 4
        printLine($"Lamp turns: {lamp.turns} ({dozens} dozen), long log.") ;
#else
        printLine($"Lamp turns: {lamp.turns} ({dozens} dozen), short log.") ;
#endif
    }
}
