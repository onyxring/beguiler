/*  Field trial — exercises the Beguile compiler against the Inform 6 standard library.
    A hardening test: not a game, not an example, not for reuse.  */

// Exercises: a twenty-eighth first-time-programmer program, a small car park where cars wait in a
// queue, park in bays with meters that run down each turn, get a ticket when they stay too long past
// the meter, are cleared away, and the fines are collected at an office, written the way a beginner
// writes it after reading the spec once. Counts kept in int globals with consts for the meter's top,
// the queue size, the fine and the ticket book, bool flags, an enum for a bay's state kept in a class
// member and switched on, a named getter/setter accessor class (the meter, clamped by its setter)
// used as a class member and read, written, bumped with += and -- and read inside interpolation, a
// struct for a ticket (plate, bay, fine, paid) with a copy operator kept in an array of the value
// class sized by a const, plates waiting in an array used as a queue with enqueue / dequeue / peek,
// arrivals taken from two parallel arrays, a class of bays (label, meter, state, late turns, a method
// for the turns one coin buys, a feed method that throws when the meter is full, a before() for
// Examine and Take) with a subclass that replaces the coin method (one still calls the class's
// through a cast), a warden object with a daemon that walks the bays with for-in over a literal list,
// helper functions (one with a default argument, one called with a named argument, one with a ternary,
// one that throws when the ticket book is full, one overloaded for a string and a ticket), try / catch
// / throw, C-style for loops with break and continue, a while loop, a do/while, <linq> filter / count
// / any / all / orderBy with a comparator / first / last / map / take with lambdas (one capturing a
// local), array remove / clear / indexOf / contains / sort with a comparator, stringObj lines built
// with + and += and interpolation and changed with toUpper / toLower, replace, left / right,
// startsWith, contains, format and trim, a string switch, for-in over a range and an array, and verbs
// with no noun, one noun and a number (park, feed, clear, bays, queue, tickets, collect, fines,
// plate, report) that drive it.

#beguilerSettings {
    target = z5;
    includePaths = "../../../inform6/stdlib";
}

#includeI6 "parser"
#includeI6 "verblib"
#include <bindings/i6StandardLibrary>
#include <string>
#include <linq>

// ===== COUNTS =====

// the most turns a meter can hold
const int METER_MAX = 6;
// how many cars can wait in the queue
const int QUEUE_SIZE = 3;
// what one ticket costs
const int FINE = 5;
// how many tickets fit in the book
const int BOOK_SIZE = 3;
// how many turns past the meter before a ticket
const int GRACE = 2;
// how many coins we have for the meters
int coins = 6;
// how many coins the office has taken in fines
int finesTaken = 0;
// how many turns have gone by
int turnCount = 0;
// how many cars drove off because the queue was full
int drivenOff = 0;
// how many cars have parked
int parkedCount = 0;
// which car arrives next
int nextCar = 0;
// was the ticket book ever full?
bool bookWasFull = false;
// has anything been collected?
bool collectedAny = false;

// ===== BAY STATE =====

enum BayState { empty, parked, expired }

// ===== THE METER =====

// a meter that never goes below 0 or above METER_MAX
struct Meter {
    int _turns = 0;
    int operator () {
        return _turns;
    }
    void operator = (int v) {
        if (v < 0) {
            v = 0;
        }
        if (v > METER_MAX) {
            v = METER_MAX;
        }
        _turns = v;
    }
}

// ===== TICKETS =====

// one ticket in the book
struct Ticket {
    string plate;
    int bay;
    int fine;
    bool paid;
    Ticket operator = (Ticket o) {
        plate = o.plate;
        bay = o.bay;
        fine = o.fine;
        paid = o.paid;
        return self;
    }
}

// ===== LISTS =====

// the cars that come, in order
array<string> arrivalPlates = { "KT 101", "ZX 220", "AB 345", "KT 412", "MN 508", "ZX 613", "QR 777" };
// how many turns each of them wants to stay
array<int> arrivalStays = { 4, 9, 3, 10, 5, 2, 8 };

// the plates waiting for a bay
array<string> waiting[QUEUE_SIZE];
// how long each waiting car wants to stay (kept in step with waiting)
array<int> waitingStays[QUEUE_SIZE];

// the ticket book
array<Ticket> tickets[BOOK_SIZE];

// the plates that have left
array<string> gone[10];

// ===== HELPER FUNCTIONS =====

// prints "1 coin" or "3 coins"
void printCoins(int n, bool withWord = true) {
    print(n);
    if (withWord) {
        print((n == 1) ? " coin" : " coins");
    }
}

// "turn" or "turns"
string turnWord(int n) {
    if (n == 1) {
        return "turn";
    }
    return "turns";
}

// prints a plate in brackets
void showPlate(string plate) {
    print($"[{plate}]");
}

// prints a ticket's plate in brackets, with a star when it is paid
void showPlate(Ticket t) {
    showPlate(t.plate);
    if (t.paid) {
        print("*");
    }
}

// adds up the fines that are not paid yet
int unpaidTotal() {
    int total = 0;
    for (int i = 0; i < tickets.length; i++) {
        if (tickets[i].paid) {
            continue;
        }
        total += tickets[i].fine;
    }
    return total;
}

// takes a coin away; throws how many coins we have when there are none
void spendCoin() {
    if (coins < 1) {
        throw coins;
    }
    coins--;
}

// writes a ticket; throws how many tickets are in the book when it is full
void writeTicket(string plate, int bay) {
    if (tickets.length >= BOOK_SIZE) {
        bookWasFull = true;
        throw tickets.length;
    }
    Ticket t;
    t.plate = plate;
    t.bay = bay;
    t.fine = FINE;
    t.paid = false;
    tickets.append(t);
}

// a car comes; it waits in the queue or drives off
void arrive(bool quiet = false) {
    string plate = arrivalPlates[nextCar];
    int stay = arrivalStays[nextCar];
    nextCar++;
    if (nextCar >= arrivalPlates.length) {
        nextCar = 0;
    }
    if (waiting.length >= QUEUE_SIZE) {
        drivenOff++;
        if (!quiet) {
            print($"^A car ({plate}) sees the queue and drives off.^");
        }
        return;
    }
    waiting.enqueue(plate);
    waitingStays.enqueue(stay);
    if (!quiet) {
        print($"^A car ({plate}) joins the queue.^");
    }
}

// ===== BAYS =====

class Bay : object {
    // the word on the sign
    string label;
    // the number painted on the ground
    int number = 1;
    // what is in it
    BayState state = BayState.empty;
    // the plate of the car in it
    string plate;
    // how long the car wants to stay
    int stay = 0;
    // how many turns the car has been there
    int here = 0;
    // turns past the meter
    int late = 0;
    // the meter
    Meter meter;
    string description;

    // how many turns one coin buys
    int perCoin() {
        return 2;
    }

    // puts a coin in; throws the turns on the meter when it is (nearly) full
    void feed() {
        if (meter >= METER_MAX - 1) {
            throw meter;
        }
        meter += perCoin();
    }

    // prints what it is doing
    void sayState() {
        print($"Bay {number} ({label}): ");
        switch (state) {
            case BayState.empty: print("empty");
            case BayState.parked: print($"{plate}, meter {meter}");
            case BayState.expired: print($"{plate}, meter run out {late} {turnWord(late)} ago");
        }
        print(".^");
    }

    bool before() {
        if (action == Examine) {
            print($"Bay {number}. One coin buys {perCoin()} {turnWord(perCoin())}.^");
            sayState();
            rtrue;
        }
        if (action == Take) {
            rtrue("It is painted on the ground.^");
        }
        rfalse;
    }
}

// a wide bay's meter gives one more turn per coin
class WideBay : Bay {
    replace int perCoin() {
        return ((Bay)self).perCoin() + 1;
    }
}

// ===== ROOMS =====

object roomA {
    "Room A";
    string description = "Room A. The car park. The office is to the north.";
    object n_to = roomB;
    attributes = {light};
}

object roomB {
    "Room B";
    string description = "Room B. The office. The car park is to the south.";
    object s_to = roomA;
    attributes = {light};
}

// ===== THE BAYS =====

Bay bayRed {
    "red bay";
    parent = roomA;
    name = {.red, .bay};
    label = "red";
    number = 1;
    description = "A bay.";
    attributes = {static};
}

Bay bayBlue {
    "blue bay";
    parent = roomA;
    name = {.blue, .bay};
    label = "blue";
    number = 2;
    description = "A bay.";
    attributes = {static};
}

WideBay bayGreen {
    "green bay";
    parent = roomA;
    name = {.green, .wide, .bay};
    label = "green";
    number = 3;
    description = "A wide bay.";
    attributes = {static};
}

// ===== THE WARDEN AND THE CLERK =====

object warden {
    "warden";
    parent = roomA;
    name = {.warden};
    string description = "The warden.";
    attributes = {animate, static};
    void daemon() {
        turnCount++;
        for (Bay b in {bayRed, bayBlue, bayGreen}) {
            if (b.state == BayState.empty) {
                continue;
            }
            b.here++;
            if (b.here >= b.stay) {
                gone.append(b.plate);
                print($"^The car in the {b.label} bay ({b.plate}) drives away.^");
                b.state = BayState.empty;
                b.meter = 0;
                b.late = 0;
                continue;
            }
            if (b.state == BayState.parked) {
                b.meter--;
                if (b.meter == 0) {
                    b.state = BayState.expired;
                    b.late = 0;
                    print($"^The meter on the {b.label} bay runs out.^");
                }
                continue;
            }
            // the meter has run out
            b.late++;
            if (b.late == GRACE) {
                try {
                    writeTicket(b.plate, b.number);
                    print($"^The warden writes a ticket for {b.plate}.^");
                } catch (int full) {
                    print($"^The warden's book is full ({full} tickets).^");
                }
            }
        }
        if (turnCount % 3 == 0) {
            arrive();
        }
    }
}

object clerk {
    "clerk";
    parent = roomB;
    name = {.clerk};
    string description = "The clerk.";
    attributes = {animate, static};
}

bool Initialise() {
    location = roomA;
    arrive(quiet: true);
    arrive(quiet: true);
    StartDaemon(warden);
    rtrue;
}

#includeI6 "grammar"

// ===== MORE HELPERS (they use the bays) =====

// how many bays have a car in them
int baysInUse() {
    int n = 0;
    for (object o in roomA.children) {
        if (o.is(Bay)) {
            Bay b = (Bay)o;
            if (b.state != BayState.empty) {
                n++;
            }
        }
    }
    return n;
}

// the first empty bay, or null
Bay firstEmpty() {
    for (Bay b in {bayRed, bayBlue, bayGreen}) {
        if (b.state == BayState.empty) {
            return b;
        }
    }
    return null;
}

// a plate with the space taken out, in capitals
stringObj shortPlate(string plate) {
    stringObj s = plate;
    stringObj t = s.replace(" ", "");
    return t.toUpper();
}

// ===== VERBS =====

// PARK - the first car in the queue parks in the first empty bay
verb ParkCar {
    grammar = {.park};
    void handler() {
        if (location != roomA) {
            print("The bays are in Room A.^");
            return;
        }
        if (waiting.length == 0) {
            print("Nobody is waiting.^");
            return;
        }
        Bay b = firstEmpty();
        if (b == null) {
            print("Every bay is full.^");
            return;
        }
        b.plate = waiting.dequeue();
        b.stay = waitingStays.dequeue();
        b.here = 0;
        b.late = 0;
        b.meter = 0;
        b.state = BayState.expired;
        parkedCount++;
        print($"{b.plate} parks in the {b.label} bay. The meter is empty.^");
    }
}

// FEED <bay> - puts a coin in a bay's meter
verb FeedMeter {
    grammar = {.feed, NOUN};
    void handler() {
        if (!(noun.is(Bay))) {
            print("You can only feed a bay's meter.^");
            return;
        }
        Bay b = (Bay)noun;
        if (b.state == BayState.empty) {
            print($"There is no car in the {b.label} bay.^");
            return;
        }
        try {
            b.feed();
        } catch (int already) {
            print($"The meter is full ({already} {turnWord(already)}).^");
            return;
        }
        try {
            spendCoin();
        } catch (int have) {
            b.meter -= b.perCoin();
            print("You have no coins.^");
            return;
        }
        b.state = BayState.parked;
        b.late = 0;
        print($"The {b.label} meter shows {b.meter}. Coins: ");
        printCoins(coins, withWord: false);
        print(".^");
    }
}

// CLEAR <bay> - sends the car in a bay away
verb ClearBay {
    grammar = {.clear, NOUN};
    void handler() {
        if (!(noun.is(Bay))) {
            print("You can only clear a bay.^");
            return;
        }
        Bay b = (Bay)noun;
        if (b.state == BayState.empty) {
            print($"The {b.label} bay is already empty.^");
            return;
        }
        gone.append(b.plate);
        print($"{b.plate} leaves the {b.label} bay.^");
        b.state = BayState.empty;
        b.meter = 0;
        b.late = 0;
    }
}

// BAYS - every bay and what is in it
verb ShowBays {
    meta = true;
    grammar = {.bays};
    void handler() {
        for (Bay b in {bayRed, bayBlue, bayGreen}) {
            b.sayState();
        }
        print($"Bays in use: {baysInUse()}.^");
    }
}

// QUEUE - the cars waiting
verb ShowQueue {
    meta = true;
    grammar = {.queue};
    void handler() {
        if (waiting.length == 0) {
            print("Nobody is waiting.^");
            return;
        }
        for (int i in 1 to waiting.length) {
            stringObj line = $"{i}. ";
            line += waiting[i - 1];
            line = line + " for ";
            line += $"{waitingStays[i - 1]}";
            print(line);
            print("^");
        }
        print("Next: ");
        showPlate(waiting.peek());
        print("^");
        if (waiting.contains("QR 777")) {
            print("QR 777 is waiting.^");
        }
    }
}

// TICKETS - the ticket book, sorted by plate
verb ShowTickets {
    meta = true;
    grammar = {.tickets};
    void handler() {
        if (tickets.length == 0) {
            print("The book is empty.^");
            return;
        }
        array<Ticket> sorted[BOOK_SIZE];
        sorted = tickets.orderBy((Ticket a, Ticket b) => a.plate.compareTo(b.plate));
        for (Ticket t in sorted) {
            showPlate(t);
            print($" bay {t.bay}, {t.fine}^");
        }
        Ticket a = sorted.first();
        Ticket z = sorted.last();
        print($"First: {a.plate}. Last: {z.plate}.^");
        int unpaid = tickets.filter((Ticket t) => !t.paid).count();
        print($"Unpaid: {unpaid}. Owed: {unpaidTotal()}.^");
        if (tickets.all((Ticket t) => t.paid)) {
            print("All paid.^");
        }
        if (tickets.any((Ticket t) => t.bay == 3)) {
            print("The green bay has a ticket.^");
        }
    }
}

// COLLECT - the office takes the fines that are owed
verb CollectFines {
    grammar = {.collect};
    void handler() {
        if (location != roomB) {
            print("Fines are paid in Room B.^");
            return;
        }
        int owed = unpaidTotal();
        if (owed == 0) {
            print("Nothing is owed.^");
            return;
        }
        int n = 0;
        for (int i = 0; i < tickets.length; i++) {
            if (!tickets[i].paid) {
                tickets[i].paid = true;
                n++;
            }
        }
        finesTaken += owed;
        collectedAny = true;
        print($"The clerk takes {owed} for {n} ");
        print((n == 1) ? "ticket" : "tickets");
        print(".^");
    }
}

// FINES <number> - which tickets are for that bay
verb FinesFor {
    meta = true;
    grammar = {.fines, NUMBER};
    void handler() {
        int bayNo = (int)noun;
        if (bayNo < 1 || bayNo > 3) {
            print("There are three bays.^");
            return;
        }
        int found = tickets.filter((Ticket t) => t.bay == bayNo).count();
        print($"Bay {bayNo}: {found} ");
        print((found == 1) ? "ticket" : "tickets");
        print(".^");
        if (found > 0) {
            int firstTwo = tickets.take(2).filter((Ticket t) => t.bay == bayNo).count();
            print($"In the first two: {firstTwo}.^");
        }
    }
}

// PLATE <number> - the plate of an arrival, cut up
verb PlateInfo {
    meta = true;
    grammar = {.plate, NUMBER};
    void handler() {
        int at = (int)noun;
        if (at < 1 || at > arrivalPlates.length) {
            print($"There are {arrivalPlates.length} plates.^");
            return;
        }
        string p = arrivalPlates[at - 1];
        stringObj s = p;
        print($"{s.left(2)} / {s.right(3)}^");
        print(shortPlate(p));
        print("^");
        stringObj low = s.toLower();
        print(low);
        print("^");
        if (s.startsWith("KT")) {
            print("A KT plate.^");
        }
        if (s.contains("7")) {
            print("It has a 7.^");
        }
        switch (p) {
            case "QR 777": print("The last one.^");
            case "KT 101": print("The first one.^");
            default: print($"Stays {arrivalStays[at - 1]}.^");
        }
    }
}

// REPORT - how the car park is doing
verb ShowReport {
    meta = true;
    grammar = {.report};
    void handler() {
        stringObj word = "car park";
        stringObj coinText = $"{coins}";
        stringObj fineText = $"{finesTaken}";
        print(word.format("The $0: $1 coins, $2 in fines.", coinText, fineText));
        print("^");
        stringObj padded = "  turns  ";
        stringObj t = padded.trim();
        print($"{t}: {turnCount}^");
        print($"Parked: {parkedCount}. Driven off: {drivenOff}.^");
        if (gone.length > 0) {
            array<string> names[10];
            names = gone;
            names.sort((string a, string b) => a.compareTo(b));
            stringObj line = "Gone: ";
            int i = 0;
            do {
                line += names[i];
                i++;
                if (i < names.length) {
                    line += ", ";
                }
            } while (i < names.length);
            print(line);
            print("^");
            int kt = gone.filter((string g) => g.startsWith("KT")).count();
            print($"KT plates gone: {kt}.^");
        }
        // count bays until the first empty one
        int full = 0;
        for (Bay b in {bayRed, bayBlue, bayGreen}) {
            if (b.state == BayState.empty) {
                break;
            }
            full++;
        }
        print($"Bays before an empty one: {full}.^");
        int w = 0;
        int at = arrivalPlates.indexOf("MN 508");
        while (w < at) {
            w++;
        }
        print($"MN 508 is car {w + 1}.^");
        int longStays = arrivalStays.map((int s) => s > METER_MAX ? 1 : 0).filter((var x) => x == 1).count();
        print($"Long stays: {longStays}.^");
        if (bookWasFull) {
            print("The ticket book has been full.^");
        }
        if (collectedAny) {
            print("Fines have been collected.^");
        }
    }
}

// TEAR - tears the first paid ticket out of the book
verb TearTicket {
    grammar = {.tear};
    void handler() {
        int at = -1;
        for (int i = 0; i < tickets.length; i++) {
            if (tickets[i].paid) {
                at = i;
                break;
            }
        }
        if (at < 0) {
            print("No ticket is paid.^");
            return;
        }
        string p = tickets[at].plate;
        tickets.remove(at);
        print($"You tear out the ticket for {p}. {tickets.length} left.^");
        if (tickets.length == 0) {
            tickets.clear();
        }
    }
}
