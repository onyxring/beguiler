/*
    test_interpolation_unicode_glulx.bgl
    Regression: directly-typed smart quotes, accented characters, and the reverse tick inside an
    INTERPOLATED string ($"...") must translate the same as in a plain string literal — the two
    code paths had diverged, leaking raw UTF-8. Under Glulx the curly quotes become @{HHHH}
    Unicode escapes, the backtick stays literal, and accents map to I6 notation. The {x}
    interpolation expression must still emit. The captured baseline pins all of this.
*/
#beguilerSettings {
    target = glulx;
    informName = "none";
    outputPath = "tests/output";
}

void main() {
    int x = 5;
    print($"say “hi” café {x} ‘ok’ `t`");
}
