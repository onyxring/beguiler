// A lambda whose parameter types differ from its func<> type is an error (D1233).
// EXPECT_ERROR: Cannot assign value of type 'func<float,float,int>' to variable of type 'func<float,int,float>'
#beguilerSettings { target = glulx; informName = "none"; }
void main() { func<float, int, float> f = (float a, int i) => a + i; print(f(1, 2.0)); }
