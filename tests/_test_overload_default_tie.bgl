// Negative test: a call that fits two overloads differing only in a defaulted parameter is ambiguous (§6.4).
// EXPECT_ERROR: This call fits both 'F' overloads
#beguilerSettings { target = z5; informName = "none"; outputPath = "tests/output"; }
void F(int a) { print(a); }
void F(int a, int b = 0) { print(a + b); }
void main(){
    F(1, 2);
    F(1);
}
