object _bglStr
  with _bglText_new [unkStr retval lck;
    
            lck    = self._bglText_ambiguousLock(unkStr);
            retval = _bglStringPool._bglText_allocateString();
            if(_bglStrIs(unkStr)) retval._bglText_setFromStr(unkStr);
