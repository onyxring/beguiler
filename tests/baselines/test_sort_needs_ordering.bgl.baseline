            if(owner ofclass _bglBufferWrapper || _bglStrCapturing(b + 2 * WORDSIZE)){
                if(to ~= o){ dst = _bglStrHeap + to; dst-->0 = 0; dst-->1 = o - to - 3 * WORDSIZE; dst-->2 = 0; }
                to = o + n;
                if(n < step){ dst = _bglStrHeap + to; dst-->0 = 0; dst-->1 = step - n - 3 * WORDSIZE; dst-->2 = 0; to = o + step; }
                continue;
            }
            if(to ~= o){
                dst = _bglStrHeap + to;
                moved = dst + 2 * WORDSIZE;
                #Ifdef TARGET_ZCODE;
                    @copy_table b dst n;
                #Ifnot;
                    @mcopy n b dst;
                #Endif;
                _bglStrRetrack(b + 2 * WORDSIZE, moved);
                if(owner ofclass _bglString) owner._underlyingBuffer = moved;
                else owner._bglText_buf = moved;
