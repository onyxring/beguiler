    ! Move string `s`'s block to the end of the heap, sliding the blocks after it down: the two runs are
    ! swapped in place by three reversals, so no spare room is needed. False when a block after it can't
    ! move (a temporary, or one being captured into).
    [ _bglStrToEnd s  buf b n end o step bb owner moved nb;
        buf = s._bglText_getBuf();
        b = buf - 2 * WORDSIZE;
        n = _bglStrBlockBytes(buf-->(-1));
        end = _bglStrHeap + _bglStrHeapTop;
        if(b + n == end) rtrue;
        for(o = (b + n) - _bglStrHeap : o < _bglStrHeapTop : o = o + step){
            bb = _bglStrHeap + o;
            step = _bglStrBlockBytes(bb-->1);
            owner = bb-->0;
            if(owner ~= 0 && (owner ofclass _bglBufferWrapper || _bglStrCapturing(bb + 2 * WORDSIZE))) rfalse;
        }
