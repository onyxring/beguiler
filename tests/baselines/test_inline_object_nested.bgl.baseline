    head
;
[main;
    print (string)child.title;
    if(child.words provides print) child.words.print(); else print (name)child.words;
    print (string)w.head.title;
];
_bglClass_menu child
  with linkto root,
       title "a child",
       words 'foo' 'bar' 'baz' 
;
_bglClass_menu _bglanon4
