!% -G
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;

    Replace HandleGlkEvent _bglAuthorGlkEvent;

global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _glulx
;
[_bglSuspendLineInput buffer;
    return 0;
];
[_bglResumeLineInput buffer typed;
];
[_bglGlkEvent event context buffer target typed;
    if (_bgl_bglOpCodes_aload(event, 0) ~= 8) {
        return false;
    }
    target = _bgl_bglOpCodes_aload(event, 2);
    __glkHook(258, _bgl_bglOpCodes_aload(event, 1));
    if ((~~(metaclass(target) == Routine))) {
        return false;
    }
    typed = 0;
    if (context == 0) {
        typed=_bglsuspendlineinput(buffer);
    }
     target(); 
    if (context == 0) {
        _bglresumelineinput(buffer, typed);
    }
    return true;
];
[_bglCurrentWindow stream win;
    stream=__glkHook(72);
    win=__glkHook(32, 0, 0);
    while (win ~= 0) {
        if (__glkHook(44, win) == stream) {
            return win;
        }
        win=__glkHook(32, win, 0);
    }
    return 0;
];
object bgl
  with glulx _glulx
;
! test_inf_mode_class_in_island.inf — Slice 4: pre-scan walks .inf body for #bgl-island
! declarations so class/enum names register as types before Pass 2 grammar matching.
!
! Without Slice 4, `class counter {}` inside #bgl{} fails with "Near 'class': expected
! type name (in class declaration)" because the grammar rule `{"class", TYPE_NAME}`
! requires the class name to already be a registered type at match time.
!
! Cases exercised:
!   - #bglDecl declares a class; raw I6 below references the class via instance.
!   - #bgl auto-detects a class declaration and routes to declaration mode.
!   - Forward reference: a class declared in a LATER island, referenced earlier in the
!     .inf body via raw I6, resolves because pre-scan walks all islands first.

! Class declared via #bglDecl. Pre-scan registers `counter` as a type so the grammar
! rule {class, TYPE_NAME} matches in Pass 2.

class _bglClass_counter
  with
    value 0,
    increment[;
        self.value=self.value + 1;
        return self.value;
    ]
;


! Class declared via auto-detect #bgl. Same pre-scan path.

class _bglClass_doubler
  with
    factor 2,
    apply[n;
        return n * self.factor;
    ]
;


! File-scope instance of counter (Beguile-side declaration, but referenced from raw I6).

_bglClass_counter myCounter
;
_bglClass_doubler myDoubler
;


[ Main x;
    print "before bgl.^";

    mycounter.increment();
mycounter.increment();
x = mycounter.value;
x = mydoubler.apply(x);


    print "x = ", x, "^";
];

[_bgl_float__oplteqgt a b;
    
            if(_bglFloatLt(a, b)) return -1;
            if(_bglFloatGt(a, b)) return 1;
            return 0;
        
];

    [ HandleGlkEvent event context buffer;
        if (_bglGlkEvent(event, context, buffer)) return -1;
        if (_bglAuthorGlkEvent) return _bglAuthorGlkEvent(event, context, buffer);
        return 0;
    ];

[__glkHook _vararg_count api args retval;
    @copy sp api;
    args=_vararg_count - 1;
    @glk api args retval;
    return retval;
];
[_bglFloatGt x y;
     @jfgt x y ?yes; rfalse; .yes; rtrue; 
];
[_bglFloatLt x y;
     @jflt x y ?yes; rfalse; .yes; rtrue; 
];
[_bgl_bglOpCodes_aload addr idx result;
     @aload addr idx result; 
    return result;
];
