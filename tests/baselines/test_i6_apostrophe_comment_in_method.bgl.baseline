!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_Foo
  class object
  with
    probe[r;
        r = 0;
        
            ! lock self if it's currently free; don't touch it otherwise
            r = 1;
        
        return r;
    ]
;
_bglClass_Foo f
;
[main;
    print f.probe();
];
