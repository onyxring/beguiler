!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 1000;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
object _zcode
;
object _bglUtil
;
object bgl
  with zcode _zcode,
       bglUtil _bglutil
;
class foo
  class object
  with
    probe[r;
        r = 0;
        
            ! lock self if it's currently free; don't touch it otherwise
            r = 1;
        
        return r;
    ]
;
foo f
;
[main;
    print f.probe();
];
