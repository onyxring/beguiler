!% -G
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 1000;
#Ifdef beguiler;#Endif;

    Constant story    = "";
    Constant headline = "";


    replace main _oldmain;

global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
object _zcode
;
object _bglUtil
;
object bgl
  with zcode _zcode,
       bglUtil _bglutil
;
object quaff
  with handler [;
    print (string)"You quaff it.";
  ]
;
[quaffsub;
                quaff.handler();
            ];
verb 'quaff'
    * noun -> quaff;
object gaze
  with handler [;
    print (string)"You gaze.";
  ]
;
[gazesub;
                gaze.handler();
            ];
verb 'gaze'
    * noun -> gaze;
verb 'sip' 'swig' = 'quaff';
verb 'g//' 'peek' = 'gaze';

    [main; 
        bglInit();
        _oldmain();
    ];

