!% -G
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;

    Replace HandleGlkEvent _bglAuthorGlkEvent;


    Constant story    = "";
    Constant headline = "";

Replace banner;

        replace main _oldmain;
    
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _glulx
;
[_bglGlkEvent event context buffer target typed;
    if (_bgl_bglOpCodes_aload(event, 0) ~= 8) {
        return false;
    }
    target = _bgl_bglOpCodes_aload(event, 2);
    __glkHook(258, _bgl_bglOpCodes_aload(event, 1));
    if ((~~(metaclass(target) == Routine))) {
        return false;
    }
    typed = 0;
    if (context == 0) {
        typed=_bglsuspendlineinput(buffer);
    }
     target(); 
    if (context == 0) {
        _bglresumelineinput(buffer, typed);
    }
    return true;
];
[_bglCurrentWindow stream win;
    stream=__glkHook(72);
    win=__glkHook(32, 0, 0);
    while (win ~= 0) {
        if (__glkHook(44, win) == stream) {
            return win;
        }
        win=__glkHook(32, win, 0);
    }
    return 0;
];
object bgl
  with glulx _glulx
;
[Banner;
    print "^";
    style bold;
    print (string)story;
    style roman;
    print (string)headline;
    print "Release ";
    print _bglheader.release._opconv_int();
    print " / Serial number ";
    _bglheader.printserial();
    print "^";
    style underline;
    print "Written in";
    style roman;
    print " Beguile v";
    print 0;
    print ".";
    print 0;
    print ".";
    print 5;
    print "^";
    style underline;
    print "Compiled with";
    style roman;
    print " Inform v";
     inversion; 
    print " / Library v";
    print (string)librelease;
    print " ";
    
        #Ifdef STRICT_MODE; print "S"; #Endif;
        #Ifdef INFIX; print "X";
        #Ifnot; #Ifdef DEBUG; print "D"; #Endif; #Endif;
    
    print (string)"^";
];
object _bglVerb_quaff
  with handler [;
    print (string)"You quaff it.";
  ]
;
[quaffsub;
            _bglVerb_quaff.handler();
        ];
verb 'quaff'
    * noun -> quaff;
object _bglVerb_gaze
  with handler [;
    print (string)"You gaze.";
  ]
;
[gazesub;
            _bglVerb_gaze.handler();
        ];
verb 'gaze'
    * noun -> gaze;
verb 'sip' 'swig' = 'quaff';
verb 'g//' 'peek' = 'gaze';
[_bgl_float__oplteqgt a b;
    
            if(_bglFloatLt(a, b)) return -1;
            if(_bglFloatGt(a, b)) return 1;
            return 0;
        
];

    [ HandleGlkEvent event context buffer;
        if (_bglGlkEvent(event, context, buffer)) return -1;
        if (_bglAuthorGlkEvent) return _bglAuthorGlkEvent(event, context, buffer);
        return 0;
    ];


        Array _bglLineEvent --> 4;
        [ _bglSuspendLineInput buffer;
            glk_cancel_line_event(gg_mainwin, _bglLineEvent);
            return _bglLineEvent-->2;   ! characters typed so far; Glk left them in the buffer
        ];
        [ _bglResumeLineInput buffer typed;
            DrawStatusLine();
            L__M(##Prompt);
            glk_request_line_event(gg_mainwin, buffer + WORDSIZE, INPUT_BUFFER_LEN - WORDSIZE, typed);
        ];
    

        [main;
            bglInit();
            _oldmain();
        ];
    
[__glkHook _vararg_count api args retval;
    @copy sp api;
    args=_vararg_count - 1;
    @glk api args retval;
    return retval;
];
[_bglFloatGt x y;
     @jfgt x y ?yes; rfalse; .yes; rtrue; 
];
[_bglFloatLt x y;
     @jflt x y ?yes; rfalse; .yes; rtrue; 
];
class _bglaccessor3
  with
    _opconv_int[;
        return _bgl_bglOpCodes_aloads(52, 0);
    ]
;
_bglaccessor3 __bglheader_release;
object _bglHeader
  with release __bglheader_release,
       serialChar [i;
    return _bgl_bglOpCodes_aloadb(54, i);
  ],
       printSerial [i;
    i = 0;
    for (i = 0 : i < 6 : i++) {
        print (char)self.serialchar(i);
    }
  ]
;
[_bgl_bglOpCodes_aload addr idx result;
     @aload addr idx result; 
    return result;
];
[_bgl_bglOpCodes_aloadb addr idx result;
     @aloadb addr idx result; 
    return result;
];
[_bgl_bglOpCodes_aloads addr idx result;
     @aloads addr idx result; 
    return result;
];
