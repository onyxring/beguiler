!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_Container
  class object
;
class _bglClass_Box
  class _bglClass_Container
  with
    weight
;
_bglClass_Box g_box
;
[main;
    if ((g_box ofclass _bglClass_Container)) {
        print (string)"box is container";
    }
    if ((g_box ofclass _bglClass_Box)) {
        print (string)"box is box";
    }
    if ((g_box ofclass libdefinedclass)) {
        print (string)"box is libDefinedClass";
    }
];
