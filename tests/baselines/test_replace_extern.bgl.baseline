!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
Replace gameepilogue;
Replace drawstatusline _bgl_replaced_drawstatusline_0;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
[GameEpilogue;
    print (string)"my epilogue";
];
[DrawStatusLine;
    print (string)"before ";
    _bgl_replaced_drawstatusline_0();
    print (string)" after";
];
[_bgl_replaced_localonly_0;
    print (string)"first";
];
[main;
    gameepilogue();
    drawstatusline();
    localonly();
];
[localOnly;
    _bgl_replaced_localonly_0();
    print (string)"second";
];
