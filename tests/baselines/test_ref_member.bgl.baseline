!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_Payload
  with
    a,
    b
;
class _bglClass_Node
  with
    id,
    next,
    load,
    link[n p;
        self.next = n;
        self.load = p;
    ],
    nextId[;
        return self.next.id;
    ]
;
_bglClass_Node n1
;
_bglClass_Node n2
;
_bglClass_Payload pl
;
[main x y;
    n1.id = 1;
    n2.id = 2;
    pl.a = 10;
    n1.link(n2, pl);
    x=n1.nextid();
    y=n1.load.a;
];
