!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
[demo f;
];
[main c f;
    c = 1;
    f = 4;
    if (c==1) {
        print (string)"c is red";
    }
    if (f==4) {
        print (string)"f is also red";
    }
    c = 1;
    f = 4;
    demo(4);
];
