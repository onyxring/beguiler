!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 1000;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
object _zcode
;
object _bglUtil
;
object bgl
  with zcode _zcode,
       bglUtil _bglutil
;
[use s;
    clearscreen();
    s=chooseobjects(0,0);
    epilogue();
];
[Epilogue;
    print (string)"The End.^";
];
