!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
property hidden_flag;
object bar
  with isNorthBound [;
    return selected_direction == n_to;
  ],
       isHiddenCheck [;
    return selected_direction == hidden_flag;
  ]
;
[main;
    if (bar.isnorthbound()) {
        print (string)"north^";
    }
    if (bar.ishiddencheck()) {
        print (string)"hidden^";
    }
];
