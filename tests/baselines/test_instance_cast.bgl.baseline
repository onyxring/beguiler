!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_Room
  class object
  with
    lit
;
_bglClass_Room library
  with shelves 
;
class _bglClass_Bk
  class object
;
_bglClass_Bk b1 library
;
[main r a c same;
    r = parent(b1);
    a=(parent(b1)).shelves;
    c=(parent(b1)).lit;
    same=(library) == parent(b1);
];
