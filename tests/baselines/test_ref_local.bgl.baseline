!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_Box
  with
    x,
    y
;
_bglClass_Box boxSrc
;
[mkBox _l_x _l_y;
    boxsrc.x=_l_x;
    boxsrc.y=_l_y;
    return boxsrc;
];
class _bglClass_Window
  with
    w,
    h,
    _opeq[v;
        self.w=v.w;
        self.h=v.h;
        return self;
    ]
;
_bglClass_Window winSrc
;
[mkWin _l_w _l_h;
    winsrc.w=_l_w;
    winsrc.h=_l_h;
    return winsrc;
];
[main br bx br2 wr wH wv wvW;
    wv = _bglLocal_main_wv;
    _bglLocal_main_wv.w = 0;
    _bglLocal_main_wv.h = 0;
    br = mkbox(10,20);
    bx=br.x;
    br.x = 99;
    br2 = br;
    br2.y = 7;
    wr = mkwin(300,400);
    wH=wr.h;
    wv._opeq(mkwin(100,200));
    wvW=wv.w;
];
_bglClass_Window _bglLocal_main_wv;
