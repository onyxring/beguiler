!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_heightProxy
  with
    _val 0,
    _opconv_int[;
        return self._val;
    ],
    _opeq[v;
        self._val=v * 2;
    ]
;
class _bglClass_thing
  class object
  with
    height
;
_bglClass_heightProxy _t_height;
_bglClass_thing t
  with height _t_height
;
[main a b c;
    t.height._opeq(5);
    a=t.height._opconv_int();
    b=t.height._opconv_int();
    c=t.height._opconv_int() + 1;
    print t.height._opconv_int();
    print a;
    print b;
    print c;
];
