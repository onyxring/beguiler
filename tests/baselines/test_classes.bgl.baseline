!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
attribute light;
global _bgl_Animal_count = 0;
class _bglClass_Animal
  class object
  with
    short_name,
    description,
    maxAge 20,
    speak[;
    ]
;
class _bglClass_Dog
  class _bglClass_Animal
  with
    speak[;
    ]
;
class _bglClass_Flyer
  class object
  with
    altitude 0
;
class _bglClass_Swimmer
  class object
  with
    depth 0
;
class _bglClass_FlyingFish
  class _bglClass_Flyer _bglClass_Swimmer
  with
    species "exocoetidae"
;
class _bglClass_Alpha
  class object
  with
    valA 1
;
class _bglClass_Beta
  class _bglClass_Alpha
  with
    valB 2
;
class _bglClass_Gamma
  class _bglClass_Beta
  with
    valG 3
;
class _bglClass_Delta
  class _bglClass_Gamma
  with
    valD 4
;
_bglClass_Delta g_delta
;
class _bglClass_Box
  class object
  with
    capacity 0
;
_bglClass_Box g_box
;
global _bgl_Tally_total = 0;
class _bglClass_Tally
  class object
  with
    bump[;
        _bgl_Tally_total=_bgl_Tally_total + 1;
    ]
;
_bglClass_Tally g_tally
;
class _bglClass_Greeter
  class object
  with
    greet[;
        print (string)"howdy";
    ]
;
_bglClass_Greeter g_greeter
;
object myHelper
  with value 0,
       getValue [;
    return self.value;
  ]
;
place testRoom
  with short_name "Test Room",
       description "A room for testing."
  has light
;
_bglClass_FlyingFish g_ff
;
[main v a d total t;
    _bgl_animal_count=_bgl_animal_count + 1;
    v=myhelper.getvalue();
    print v;
    g_ff.altitude = 500;
    g_ff.depth = 20;
    a=g_ff.altitude;
    d=g_ff.depth;
    total=g_delta.vala + g_delta.valb + g_delta.valg + g_delta.vald;
    print total;
    g_box.capacity = 42;
    g_box.capacity = g_box.capacity * 2;
    print g_box.capacity;
    g_tally.bump();
    g_tally.bump();
    t=_bgl_tally_total;
    print t;
    g_greeter.greet();
];
