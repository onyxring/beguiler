!% -G
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;

    Replace HandleGlkEvent _bglAuthorGlkEvent;

global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _glulx
;
[_bglSuspendLineInput buffer;
    return 0;
];
[_bglResumeLineInput buffer typed;
];
[_bglGlkEvent event context buffer target typed;
    if (_bgl_bglOpCodes_aload(event, 0) ~= 8) {
        return false;
    }
    target = _bgl_bglOpCodes_aload(event, 2);
    __glkHook(258, _bgl_bglOpCodes_aload(event, 1));
    if ((~~(metaclass(target) == Routine))) {
        return false;
    }
    typed = 0;
    if (context == 0) {
        typed=_bglsuspendlineinput(buffer);
    }
     target(); 
    if (context == 0) {
        _bglresumelineinput(buffer, typed);
    }
    return true;
];
[_bglCurrentWindow stream win;
    stream=__glkHook(72);
    win=__glkHook(32, 0, 0);
    while (win ~= 0) {
        if (__glkHook(44, win) == stream) {
            return win;
        }
        win=__glkHook(32, win, 0);
    }
    return 0;
];
object bgl
  with glulx _glulx
;
class _bglClass_Room
  class object
  with
    visits 0
;
_bglClass_Room r1
;
_bglClass_Room r2
;
object plainObj1
;
object plainObj2
;
array g_nums table 10 20 30 40 50;
array g_sized table 8;
array g_flags table true false true;
array g_buf buffer 32;
array g_short buffer 8;
object inventory
  with slots 0 0 0 0 0 0 ,
       count 0
;
[main i b last first middle last_c firstSh lastSh c;
    bglinit();
    i= g_nums-->(0+1);
    b= g_flags-->(1+1);
    g_nums-->(0+1) = 42;
    g_flags-->(0+1) = false;
    g_sized-->(7+1) = 99;
    last= g_sized-->(7+1);
    g_buf->(0 + WORDSIZE) = 'H';
    g_buf->(1 + WORDSIZE) = 'e';
    g_buf->(15 + WORDSIZE) = 'X';
    g_buf->(31 + WORDSIZE) = '!';
    first= g_buf->(0 + WORDSIZE);
    middle= g_buf->(15 + WORDSIZE);
    last_c= g_buf->(31 + WORDSIZE);
    g_short->(0 + WORDSIZE) = 'a';
    g_short->(7 + WORDSIZE) = 'z';
    firstSh= g_short->(0 + WORDSIZE);
    lastSh= g_short->(7 + WORDSIZE);
    c=inventory.count;
];
[_bgl_float__oplteqgt a b;
    
            if(_bglFloatLt(a, b)) return -1;
            if(_bglFloatGt(a, b)) return 1;
            return 0;
        
];

    [ HandleGlkEvent event context buffer;
        if (_bglGlkEvent(event, context, buffer)) return -1;
        if (_bglAuthorGlkEvent) return _bglAuthorGlkEvent(event, context, buffer);
        return 0;
    ];

[__glkHook _vararg_count api args retval;
    @copy sp api;
    args=_vararg_count - 1;
    @glk api args retval;
    return retval;
];
[_bglFloatGt x y;
     @jfgt x y ?yes; rfalse; .yes; rtrue; 
];
[_bglFloatLt x y;
     @jflt x y ?yes; rfalse; .yes; rtrue; 
];
[_bgl_bglOpCodes_aload addr idx result;
     @aload addr idx result; 
    return result;
];
