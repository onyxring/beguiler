!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_Room
  class object
  with
    visits 0,
    visit[;
        self.visits=self.visits + 1;
    ],
    getVisits[;
        return self.visits;
    ]
;
_bglClass_Room r1
;
_bglClass_Room r2
;
array g_rooms table r1 r2;
[main v v2;
     g_rooms-->(0+1) .visit();
    v=( g_rooms-->(0+1) ).visits;
    v2=( g_rooms-->(0+1) ).getvisits();
     g_rooms-->(1+1) .visit();
];
