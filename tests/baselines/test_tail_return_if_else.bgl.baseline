[pick a;
    if (a) {
        "yes";

    }
    else {
        "no";

    }
];
[pickNested n;
    if (n == 1) {
        "one";

    }
    else {
        if (n == 2) {
            "two";

        }
        else {
            "many";

        }
    }
];
[pickOpen a;
    if (a) {
        "only";

    }
    rtrue;
];
[main;
    pick(true);
    picknested(2);
    pickopen(false);
    rtrue;
];
