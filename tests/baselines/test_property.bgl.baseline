!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
property hidden_flag;
property additive my_hooks;
class _bglClass_Box
  class object
  with
    weight,
    description
;
class _bglClass_Crate
  class object
  with
    volume
;
_bglClass_Box g_box
;
_bglClass_Crate g_crate
;
[main;
    if (g_box provides weight) {
        print (string)"box has weight";
    }
    if (g_box provides volume) {
        print (string)"box may have volume";
    }
    if (g_box provides hidden_flag) {
        print (string)"box has hidden_flag";
    }
    if (g_box provides libdefinedprop) {
        print (string)"box has libDefinedProp";
    }
];
