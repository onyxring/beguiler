object _zcode
;
object bgl
  with zcode _zcode
;
array task_scores buffer 5 10 5 10 5 5 5 5 10 5 10 5 5 5 10;
array greeting buffer 'H' 'i';
[sumFirstThree;
    return  task_scores->(0 + WORDSIZE) + task_scores->(1 + WORDSIZE) + task_scores->(2 + WORDSIZE) ;
];
[writeAndRead v;
    task_scores->(0 + WORDSIZE) = 99;
