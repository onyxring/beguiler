!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_Room
  class object
;
_bglClass_Room room1
;
_bglClass_Room room2
;
object w room1
  with capacity 4
;
object other room2
;
[sink o;
];
[getW;
    return w;
];
[localCheck o;
    if (parent(o) == room1) {
        rtrue;
    }
    sink(parent(o));
    rfalse;
];
class _bglClass_Widget
  class object
  with
    inRoom[flag;
        if (parent(self) == room1) {
            rtrue;
        }
        if (flag == 1 && parent(self) == room2) {
            rtrue;
        }
        sink(parent(self));
        rfalse;
    ],
    grandparent[;
        return parent(parent(self));
    ]
;
_bglClass_Widget gadget room1
;
[main p q;
    _bglMoveTo(w, room2);
    p = parent(w);
    if (parent(w) == room1) {
        p = room1;
    }
    if (parent(w) ~= room1) {
        p = room2;
    }
    q=w.capacity;
    if (parent(w) == parent(other)) {
        p = room1;
    }
    if (parent(w) == room1||parent(other) ~= room2) {
        p = room2;
    }
    if ((parent(w) == room1)) {
        p = room1;
    }
    else {
        p = room2;
    }
    switch (parent(w)) {
        room1:
            p = room2;
    }
    sink(parent(w));
    if (parent(w) == nothing) {
        p = room1;
    }
    p = parent(parent(w));
    p = parent(parent(parent(w)));
    if (parent(parent(w)) == room1) {
        p = room2;
    }
    p = parent(getw());
    p = parent(parent(getw()));
    if (parent(getw()) == room1) {
        p = room2;
    }
    if ((parent(w) ofclass _bglClass_Room)) {
        p = room1;
    }
    if ((parent(getw()) ofclass _bglClass_Room)) {
        p = room2;
    }
    localcheck(w);
    if (gadget.inroom(1)) {
        p = room1;
    }
    sink(gadget.grandparent());
];
[_bglMoveTo o p;
     if (p) move o to p; else remove o; 
];
