!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_statBlock
  with
    strength 10,
    agility 7
;
_bglClass_statBlock _player_stats;
object player
  with stats _player_stats
;
[main;
    print player.stats.strength;
    player.stats.agility = 12;
    print player.stats.agility;
];
