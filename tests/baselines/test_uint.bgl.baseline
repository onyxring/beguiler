!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
[testInit a i b j;
    a = 42;
    i = 100;
    b=i;
    j=a;
];
[testArithmetic a b sum diff prod quot rem;
    a = 12;
    b = 10;
    sum=a + b;
    diff=a - b;
    prod=a * b;
    quot=_bglUnsignedDiv(a, b);
    rem=_bglUnsignedMod(a, b);
];
[testBitwise a b and_ or_ xor_;
    a = 12;
    b = 10;
    and_=a & b;
    or_=a | b;
    xor_=(a | b) - (a & b);
    a = a & 15;
    b = b | 4;
    a = ((a | 3) - (a & 3));
];
[testComparison x y eq neq lt lte gt gte;
    x = 5;
    y = 10;
    eq=x == y;
    neq=x ~= y;
    lt=_bglUnsignedCompare(x, y) < 0;
    lte=_bglUnsignedCompare(x, y) <= 0;
    gt=_bglUnsignedCompare(x, y) > 0;
    gte=_bglUnsignedCompare(x, y) >= 0;
];
[testCompound n;
    n = 10;
    n = n + 5;
    n = n - 2;
    n = n * 3;
    n = _bglUnsignedDiv(n, 4);
    n = _bglUnsignedMod(n, 7);
];
[testIncDec i;
    i = 0;
     i++ ;
     i-- ;
     i++ ;
     i-- ;
];
[testPrint a maxU mid;
    a = 42;
    _bglPrintUint(a);
    maxU=-1;
    _bglPrintUint(maxU);
    mid=-32768;
    _bglPrintUint(mid);
];
[testUint;
    testinit();
    testarithmetic();
    testbitwise();
    testcomparison();
    testcompound();
    testincdec();
    testprint();
];
[_bglPrintUint v;
    if (v >= 0) {
        print v;
        return;
    }
    print _bglunsigneddiv(v,10);
    print _bglunsignedmod(v,10);
];
[_bglUnsignedCompare x y u v;
    if (x == y) {
        return 0;
    }
    if (x < 0 && y >= 0) {
        return 1;
    }
    if (x >= 0 && y < 0) {
        return -1;
    }
    u=x & 32767;
    v=y & 32767;
    if (u > v) {
        return 1;
    }
    return -1;
];
[_bglUnsignedDiv a b lowHalf hq hr combined;
    if (b == 0) {
        return 0;
    }
    if (a >= 0 && b > 0) {
        return a / b;
    }
    if (b < 0) {
        if (_bglunsignedcompare(a,b) >= 0) {
            return 1;
        }
        return 0;
    }
    lowHalf=a & 32767;
    hq=32767 / b;
    hr=32767 % b + 1;
    if (hr >= b) {
        hq=hq + 1;
        hr=hr - b;
    }
    combined=lowhalf + hr;
    if (combined >= 0) {
        return hq + combined / b;
    }
    return hq + _bglunsigneddiv(combined,b);
];
[_bglUnsignedMod a b;
    if (b == 0) {
        return 0;
    }
    if (a >= 0 && b > 0) {
        return a % b;
    }
    return a - _bglunsigneddiv(a,b) * b;
];
