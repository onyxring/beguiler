!% -G
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;

    Replace HandleGlkEvent _bglAuthorGlkEvent;

global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _glulx
;
[_bglSuspendLineInput buffer;
    return 0;
];
[_bglResumeLineInput buffer typed;
];
[_bglGlkEvent event context buffer target typed;
    if (_bgl_bglOpCodes_aload(event, 0) ~= 8) {
        return false;
    }
    target = _bgl_bglOpCodes_aload(event, 2);
    __glkHook(258, _bgl_bglOpCodes_aload(event, 1));
    if ((~~(metaclass(target) == Routine))) {
        return false;
    }
    typed = 0;
    if (context == 0) {
        typed=_bglsuspendlineinput(buffer);
    }
     target(); 
    if (context == 0) {
        _bglresumelineinput(buffer, typed);
    }
    return true;
];
[_bglCurrentWindow stream win;
    stream=__glkHook(72);
    win=__glkHook(32, 0, 0);
    while (win ~= 0) {
        if (__glkHook(44, win) == stream) {
            return win;
        }
        win=__glkHook(32, win, 0);
    }
    return 0;
];
object bgl
  with glulx _glulx
;
! test_inf_mode_bgl_autodetect.inf — plain #bgl auto-detects between declaration
! mode and statement mode by inspecting the first token(s).
!
! Per the rule "no local variable declarations in statement islands", any
! `Type ident` shape (function form `Type ident(`, variable form `Type ident;`
! or `Type ident = ...`) elevates to declaration mode — there is no typed-local
! form in stmt-mode #bgl{} blocks.
!
! Cases exercised:
!   - #bgl{ typed function }         → declaration mode; registers global routine
!   - #bgl{ typed variable = ... }   → declaration mode; elevates to global
!   - #bgl{ assignment / call }      → statement mode
!   - #bgl single-line               → always statement mode
!
! Mixed-content blocks (decl-shaped first line followed by bare statements) are
! covered by the negative test _test_inf_mode_bgl_mixed_content.inf.

! Auto-detected as declaration mode (typed function): doubled() registers globally
! and is callable from raw I6 below.

[doubled n;
    return n * 2;
];


! Auto-detected as declaration mode (typed function): tripled() registers globally too.

[tripled n;
    return n * 3;
];


! Auto-detected as declaration mode (typed variable): elevates to a global int.

global counter = 0;


[ Main x;
    x = 5;
    print "before bgl.^";

    ! Auto-detected as statement mode (assignment): runs as loose statements.
    x = doubled(x);
counter=counter + 1;


    ! Single-line #bgl is always statement-mode.
    x = tripled(x);


    print "x = ", x, "^";
];

[_bgl_float__oplteqgt a b;
    
            if(_bglFloatLt(a, b)) return -1;
            if(_bglFloatGt(a, b)) return 1;
            return 0;
        
];

    [ HandleGlkEvent event context buffer;
        if (_bglGlkEvent(event, context, buffer)) return -1;
        if (_bglAuthorGlkEvent) return _bglAuthorGlkEvent(event, context, buffer);
        return 0;
    ];

[__glkHook _vararg_count api args retval;
    @copy sp api;
    args=_vararg_count - 1;
    @glk api args retval;
    return retval;
];
[_bglFloatGt x y;
     @jfgt x y ?yes; rfalse; .yes; rtrue; 
];
[_bglFloatLt x y;
     @jflt x y ?yes; rfalse; .yes; rtrue; 
];
[_bgl_bglOpCodes_aload addr idx result;
     @aload addr idx result; 
    return result;
];
