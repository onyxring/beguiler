!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_Flyer
  class object
  with
    altitude 0,
    takeoff[;
        self.altitude = 100;
    ]
;
class _bglClass_Swimmer
  class object
  with
    depth 0,
    dive[;
        self.depth = 10;
    ]
;
class _bglClass_FlyingFish
  class _bglClass_Flyer _bglClass_Swimmer
  with
    species "exocoetidae",
    describe[a d;
        a=self.altitude;
        d=self.depth;
    ]
;
_bglClass_FlyingFish g_ff
;
[main;
    g_ff.describe();
];
