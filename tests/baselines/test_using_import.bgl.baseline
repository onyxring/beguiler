!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 1000;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
object _zcode
;
object _bglUtil
;
object bgl
  with zcode _zcode,
       bglUtil _bglutil
;
object engine
  with counter 0,
       increment [;
    self.counter=self.counter + 1;
    return self.counter;
  ]
;
object app
  with eng engine
;
[main n;
    n=engine.increment();
];
