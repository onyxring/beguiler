!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglaccessor4
  with
    _raw 0,
    _opconv_int[;
        return self._raw;
    ],
    _opeq[v;
        self._raw = v * gadget.scale;
    ]
;
_bglaccessor4 _gadget_level;
object gadget
  with scale 3,
       level _gadget_level
;
[main a;
    gadget.level._opeq(4);
    a=gadget.level._opconv_int();
    print a;
];
