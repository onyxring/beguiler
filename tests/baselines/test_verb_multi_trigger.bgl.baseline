object _zcode
;
object bgl
;
object _bglVerb_typenum
  with priority 10,
       handler [;
    print "type num";
  ]
;
[typenumsub;
            _bglVerb_typenum.handler();
        ];
verb 'typo'
    * number 'into'/'in'/'on'/'onto' noun -> typenum;
verb 'entrz'
    * number 'into'/'in'/'on'/'onto' noun -> typenum;
verb 'putz'
    * number 'into'/'in'/'on'/'onto' noun -> typenum;
object _bglVerb_toggle
  with priority 10,
       handler [;
    print "toggle";
  ]
;
[togglesub;
            _bglVerb_toggle.handler();
        ];
verb 'flip'
    * noun -> toggle
    * noun 'twice' -> toggle;
verb 'flop'
    * noun -> toggle
    * noun 'twice' -> toggle;
object _bglVerb_beep
  with priority 10,
       handler [;
    print "beep";
  ]
;
[beepsub;
            _bglVerb_beep.handler();
        ];
verb 'beep'
    * noun -> beep
    * noun -> chirp;
object _bglVerb_chirp
  with priority 10,
       handler [;
    print "chirp";
  ]
;
[chirpsub;
            _bglVerb_chirp.handler();
        ];
verb 'chirp'
    * noun -> chirp;
verb 'tweet'
    * noun -> chirp;
object _bglVerb_squelch
  with priority 10,
       handler [;
    print "squelch";
  ]
;
[squelchsub;
            _bglVerb_squelch.handler();
        ];
verb 'squelch'
    * noun -> squelch
    * noun 'firmly' -> squelch;
verb 'mash'
    * noun -> squelch;
verb 'squish'
    * noun -> squelch;
verb 'crush'
    * noun 'firmly' -> squelch;
verb 'grind'
    * noun 'firmly' -> squelch;
[main;
];

    #Ifndef LIBRARY_VERSION;
