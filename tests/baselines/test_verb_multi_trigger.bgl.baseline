!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;

    Constant story    = "";
    Constant headline = "";

Replace banner;

        replace main _oldmain;
    
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
[Banner;
    print "^";
    style bold;
    print (string)story;
    style roman;
    print (string)headline;
    print "Release ";
    print _bglheader.release._opconv_int();
    print " / Serial number ";
    _bglheader.printserial();
    print "^";
    style underline;
    print "Written in";
    style roman;
    print " Beguile v";
    print 0;
    print ".";
    print 0;
    print ".";
    print 5;
    print "^";
    style underline;
    print "Compiled with";
    style roman;
    print " Inform v";
     inversion; 
    print " / Library v";
    print (string)librelease;
    print " ";
    
        #Ifdef STRICT_MODE; print "S"; #Endif;
        #Ifdef INFIX; print "X";
        #Ifnot; #Ifdef DEBUG; print "D"; #Endif; #Endif;
    
    print (string)"^";
];
object _bglVerb_typenum
  with handler [;
    print (string)"type num";
  ]
;
[typenumsub;
            _bglVerb_typenum.handler();
        ];
verb 'typo'
    * number 'into'/'in'/'on'/'onto' noun -> typenum;
verb 'entrz'
    * number 'into'/'in'/'on'/'onto' noun -> typenum;
verb 'putz'
    * number 'into'/'in'/'on'/'onto' noun -> typenum;
object _bglVerb_toggle
  with handler [;
    print (string)"toggle";
  ]
;
[togglesub;
            _bglVerb_toggle.handler();
        ];
verb 'flip'
    * noun -> toggle
    * noun 'twice' -> toggle;
verb 'flop'
    * noun -> toggle
    * noun 'twice' -> toggle;
object _bglVerb_beep
  with handler [;
    print (string)"beep";
  ]
;
[beepsub;
            _bglVerb_beep.handler();
        ];
verb 'beep'
    * noun -> beep
    * noun -> chirp;
object _bglVerb_chirp
  with handler [;
    print (string)"chirp";
  ]
;
[chirpsub;
            _bglVerb_chirp.handler();
        ];
verb 'chirp'
    * noun -> chirp;
verb 'tweet'
    * noun -> chirp;
object _bglVerb_squelch
  with handler [;
    print (string)"squelch";
  ]
;
[squelchsub;
            _bglVerb_squelch.handler();
        ];
verb 'squelch'
    * noun -> squelch
    * noun 'firmly' -> squelch;
verb 'mash'
    * noun -> squelch;
verb 'squish'
    * noun -> squelch;
verb 'crush'
    * noun 'firmly' -> squelch;
verb 'grind'
    * noun 'firmly' -> squelch;
[main;
];

        [main;
            bglInit();
            _oldmain();
        ];
    
class _bglaccessor3
  with
    _opconv_int[;
        return _bgl_bglOpCodes_loadw(2, 0) & 1023;
    ]
;
_bglaccessor3 __bglheader_release;
object _bglHeader
  with release __bglheader_release,
       serialChar [i;
    return _bgl_bglOpCodes_loadb(18, i);
  ],
       printSerial [i;
    i = 0;
    for (i = 0 : i < 6 : i++) {
        print (char)self.serialchar(i);
    }
  ]
;
[_bgl_bglOpCodes_loadb arr idx result;
     @loadb arr idx -> result; 
    return result;
];
[_bgl_bglOpCodes_loadw arr idx result;
     @loadw arr idx -> result; 
    return result;
];
