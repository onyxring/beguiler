!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
array _buf table 2;
[main viaAmp viaCast slot0 slot1 a b band land;
    bglinit();
    viaAmp=_buf;
    viaCast=_buf;
    slot0=_buf + WORDSIZE;
    slot1=_buf + 2 * WORDSIZE;
    a = 12;
    b = 10;
    band=a & b;
    land=(a > 0) && (b > 0);
    print viaAmp;
    print viaCast;
    print slot0;
    print slot1;
    print band;
    if (land) {
        print 1;
    }
];
