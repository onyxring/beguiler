!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
object bar
  with before [;
    if (noun~=0) {
        forwardobj.field = forwardobj.field + 2;
    }
  ],
       afterCheck [flag;
    flag=false;
    if (~~flag) {
        anotherforward.field = anotherforward.field + 3;
    }
  ]
;
object forwardObj
  with field 0
;
object anotherForward
  with field 0
;
[main;
    bar.before();
    bar.aftercheck();
];
