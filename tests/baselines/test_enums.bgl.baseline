!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
global g_facing;
global g_state;
[setFacing dir;
    g_facing = dir;
];
[getFacing;
    return g_facing;
];
[isFacing dir;
    if (g_facing==dir) {
        return true;
    }
    return false;
];
[describeDirection dir;
    switch (dir) {
        1:
            print (string)"north";
        2:
            print (string)"south";
        3:
            print (string)"east";
        4:
            print (string)"west";
        default:
            print (string)"other";
    }
];
[main f;
    setfacing(1);
    g_state = 1;
    f=isfacing(1);
    describedirection(g_facing);
];
