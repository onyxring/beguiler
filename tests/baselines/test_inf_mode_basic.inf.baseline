!% -G
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;

    Replace HandleGlkEvent _bglAuthorGlkEvent;

global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _glulx
;
[_bglSuspendLineInput buffer;
    return 0;
];
[_bglResumeLineInput buffer typed;
];
[_bglGlkEvent event context buffer target typed;
    if (_bgl_bglOpCodes_aload(event, 0) ~= 8) {
        return false;
    }
    target = _bgl_bglOpCodes_aload(event, 2);
    __glkHook(258, _bgl_bglOpCodes_aload(event, 1));
    if ((~~(metaclass(target) == Routine))) {
        return false;
    }
    typed = 0;
    if (context == 0) {
        typed=_bglsuspendlineinput(buffer);
    }
     target(); 
    if (context == 0) {
        _bglresumelineinput(buffer, typed);
    }
    return true;
];
[_bglCurrentWindow stream win;
    stream=__glkHook(72);
    win=__glkHook(32, 0, 0);
    while (win ~= 0) {
        if (__glkHook(44, win) == stream) {
            return win;
        }
        win=__glkHook(32, win, 0);
    }
    return 0;
];
object bgl
  with glulx _glulx
;
! test_inf_mode_basic.inf — .inf-as-input mode positive baseline.
!
! Exercises the full .inf-mode pipeline:
!   1. The whole file is read as raw I6 (this comment passes through verbatim).
!   2. The Beguile Language Runtime auto-loads at the top of the output, so types
!      and emitters are available inside #bgl{} blocks.
!   3. Multi-line #bgl{...} blocks compile as Beguile statements (loose mode), then
!      splice back into the I6 stream where they appeared in source.
!   4. Single-line `#bgl stmt;` form (terminated by newline) also works.
!   5. Beguile-side identifier resolution finds Runtime symbols (bglInit, etc.)
!      and Beguile enum values (Glulx of eTarget) from inside the #bgl block.
!   6. EOF terminates the implicit raw-I6 region naturally — no missing-brace error.
!
! Per the rule "no local variable declarations in statement islands", any `Type ident`
! shape elevates to decl mode. This test stays in pure statement mode by referencing
! the enum value directly (Glulx) instead of declaring a typed local.

[ Main x;
    print "hello from raw I6.^";

    ! Multi-line #bgl block — pure statement mode: assigns a Beguile enum value
    ! to an I6 local and calls a Runtime function.
    x = glulx;
bglinit();


    ! Single-line form — this writes one statement that emits inline.
    x = x+1;


    print "x = ", x, "^";
    print "back in raw I6.^";
];

[_bgl_float__oplteqgt a b;
    
            if(_bglFloatLt(a, b)) return -1;
            if(_bglFloatGt(a, b)) return 1;
            return 0;
        
];

    [ HandleGlkEvent event context buffer;
        if (_bglGlkEvent(event, context, buffer)) return -1;
        if (_bglAuthorGlkEvent) return _bglAuthorGlkEvent(event, context, buffer);
        return 0;
    ];

[__glkHook _vararg_count api args retval;
    @copy sp api;
    args=_vararg_count - 1;
    @glk api args retval;
    return retval;
];
[_bglFloatGt x y;
     @jfgt x y ?yes; rfalse; .yes; rtrue; 
];
[_bglFloatLt x y;
     @jflt x y ?yes; rfalse; .yes; rtrue; 
];
[_bgl_bglOpCodes_aload addr idx result;
     @aload addr idx result; 
    return result;
];
