!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
constant _bglWorldBufSize = 128;
constant MAX_ROOMS = 20;
constant MAX_ITEMS = 10;
constant TITLE = "test";
global _bglWorldBufIdx = -1;
global g_isInactive;
global g_score = 0;
global g_moves;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
object _zcode
;
object bgl
  with zcode _zcode
;
global g_isActive = true;
global g_scratch;
array g_roomexits table 6;
array g_itemids table 10;
array g_primes table 2 3 5 7 11;
array g_fibonacci table 1 1 2 3 5 8;
[main first total;
    bglinit();
    g_score = 0;
    g_moves = 0;
    g_scratch = 42;
    first =  g_primes-->(0+1) ;
    total =  g_primes-->(0+1) ;
];
