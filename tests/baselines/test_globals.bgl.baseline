constant TITLE = "test";
global _bglWorldBufIdx = -1;
global g_isInactive;
global g_score = 0;
global g_moves;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
    #Ifdef TARGET_GLULX; @setiosys 2 0; #Endif;
];
 Constant NO_ATTRIBUTE 0; 
object _zcode
;
object bgl
  with zcode _zcode
;
global g_isActive = true;
global g_scratch;
array g_roomexits table 6;
array g_itemids table 10;
array g_primes table 2 3 5 7 11;
array g_fibonacci table 1 1 2 3 5 8;
[main first total;
    bglinit();
    g_score = 0;
    g_moves = 0;
    g_scratch = 42;
    first =  _bglAt(g_primes, 0, 0)-->0 ;
    total =  _bglAt(g_primes, 0, 0)-->0 ;
];
[_bglAt arr i w n;
    n = 0;
    
        n = arr-->0;
        #Ifdef _BGL_TRACKED_ARRAYS;
            if(n > 1 && arr-->n == $9084) n = n - 2;
        #Endif;
        if(i >= 0 && i < n) return arr + (i + 1) * WORDSIZE;
        return _bglOutOfRange(i, n, w);
    
];
[_bglOutOfRange i n w;
    
        print "^[Beguile run-time error: array index ", i, " is outside the ", n, " element";
        if(n ~= 1) print "s";
        print " it ";
        if(w) print "can hold"; else print "holds";
        print "; the ";
        if(w) print "write"; else print "read";
        print " is skipped]^";
        _bglSink-->0 = 0;
        return _bglSink;
    
];
array _bglsink --> 1;
