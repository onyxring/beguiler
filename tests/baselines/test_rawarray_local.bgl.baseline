!% -G
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
Constant _BGL_TRACKED_ARRAYS;
   Array _bglFramePool --> 64;
   Global _bglFrameTop = 0;
   Global _bglRetHold = 0;   ! a return value read before the frame it came from is freed
   [ _bglFrameAlloc size r;
      if (_bglFrameTop + size > 64) {
         print "^[Beguile runtime error: frame pool exhausted]^";
         quit;
      }
      r = _bglFrameTop;
      _bglFrameTop = _bglFrameTop + size;
      return _bglFramePool + (r * WORDSIZE);
   ];
   ! A routine's spilled locals start at 0, as real locals do: the pool holds earlier frames' words.
   [ _bglFrameAllocZ size r i;
      r = _bglFrameAlloc(size);
      for (i = 0: i < size: i++) r-->i = 0;
      return r;
   ];
   [ _bglFrameFree size;
      _bglFrameTop = _bglFrameTop - size;
   ];
   [ _bglArrayLocalAlloc size r i;
      r = _bglFrameAlloc(size + 3);
      r-->0 = size + 2;
      for (i = 1: i <= size: i++) r-->i = 0;
      r-->(size + 1) = 0;
      r-->(size + 2) = $9084;
      return r;
   ];
   Global _bglFrameTaken = 0;
   Global _bglFrameSrc = 0;
   ! A local array with room for src's n elements: `cur` when it has room, else a new block. When src
   ! is a returned local lying in freed frame space at or above the top, its elements are moved down
   ! into the new block (forward, so none is overwritten before it is read) and _bglFrameSrc names
   ! the block to copy from instead.
   [ _bglArrayLocalCopyAlloc n src cur top i;
      _bglFrameTaken = 0;
      _bglFrameSrc = src;
      if (cur ~= 0 && cur-->(cur-->0) == $9084 && cur-->0 - 2 >= n) return cur;
      top = _bglFramePool + _bglFrameTop * WORDSIZE;
      if (src < top || src >= _bglFramePool + 64 * WORDSIZE) {
         _bglFrameTaken = n + 3;
         return _bglArrayLocalAlloc(n);
      }
      if (_bglFrameTop + n + 3 > 64) {
         print "^[Beguile runtime error: frame pool exhausted]^";
         quit;
      }
      _bglFrameTop = _bglFrameTop + n + 3;
      for (i = 1: i <= n: i++) top-->i = src-->i;
      top-->0 = n + 2;
      top-->(n + 1) = n;
      top-->(n + 2) = $9084;
      _bglFrameTaken = n + 3;
      _bglFrameSrc = top;
      return top;
   ];
   [ _bglArrayLocalAllocPlain size r i;
      r = _bglFrameAlloc(size + 1);
      r-->0 = size;
      for (i = 1: i <= size: i++) r-->i = 0;
      return r;
   ];
   [ _bglRawArrayLocalAlloc size r i;
      r = _bglFrameAlloc(size);
      for (i = 0: i < size: i++) r-->i = 0;
      return r;
   ];
   [ _bglByteArrayLocalAlloc nbytes words r i;
      words = 2 + ((nbytes + WORDSIZE - 1) / WORDSIZE);
      r = _bglFrameAlloc(words);
      for (i = 0: i < words: i++) r-->i = 0;
      r-->0 = nbytes;
      r-->1 = nbytes;   ! the length: a buffer starts full, as I6's does
      return r + WORDSIZE;
   ];
   [ _bglByteArrayLocalFree nbytes;
      _bglFrameFree(2 + ((nbytes + WORDSIZE - 1) / WORDSIZE));
   ];
   [ _bglByteArrayLocalCopy dst src i;
      for (i = 0: i < src-->0: i++) dst->(WORDSIZE + i) = src->(WORDSIZE + i);
      dst-->0 = src-->0;
   ];

    Replace HandleGlkEvent _bglAuthorGlkEvent;

constant _bglWorldBufSize = 128;
global _bglWorldBufIdx = -1;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
    #Ifdef TARGET_GLULX; @setiosys 2 0; #Endif;
];
 Constant NO_ATTRIBUTE 0; 
object _glulx
;
[_bglSuspendLineInput buffer;
    return 0;
];
[_bglResumeLineInput buffer typed;
];
[_bglGlkEvent event context buffer _l_target known n typed;
    if (_bgl_bglOpCodes_aload(event, 0) ~= 8) {
        return false;
    }
    _l_target = _bgl_bglOpCodes_aload(event, 2);
    __glkHook(258, _bgl_bglOpCodes_aload(event, 1));
    known=false;
    n = 0;
     for (n = _bglLinkRoutines-->0 : n > 0 : n--) if (_bglLinkRoutines-->n == _l_target) known = true; 
    if (~~known) {
        return false;
    }
    typed = 0;
    if (context == 0) {
        typed=_bglsuspendlineinput(buffer);
    }
     _l_target(); 
    if (context == 0) {
        _bglresumelineinput(buffer, typed);
    }
    return true;
];
[_bglCurrentWindow stream win;
    stream=__glkHook(72);
    win=__glkHook(32, 0, 0);
    while (win ~= 0) {
        if (__glkHook(44, win) == stream) {
            return win;
        }
        win=__glkHook(32, win, 0);
    }
    return 0;
];
object bgl
  with glulx _glulx
;
[_bglArrayCompareAsc lhs rhs;
    
        if(lhs < rhs) return -1;
        if(lhs > rhs) return 1;
        return 0;
    
];
[probe _bglret ev;
    ev = _bglRawArrayLocalAlloc(4);
    ev-->0 = 2;
    ev-->1 = 640;
    ev-->2 = 106;
    ev-->3 = 0;
    _bglret =  ev-->0 ;
    _bglFrameFree(4);
    return _bglret;
];
[_bgl_float__oplteqgt a b;
    
            if(_bglFloatLt(a, b)) return -1;
            if(_bglFloatGt(a, b)) return 1;
            return 0;
        
];

    [ HandleGlkEvent event context buffer;
        if (_bglGlkEvent(event, context, buffer)) return -1;
        if (_bglAuthorGlkEvent) return _bglAuthorGlkEvent(event, context, buffer);
        return 0;
    ];


    Array _bglLinkRoutines --> 33;   ! count, then up to 32 routines

[__glkHook _vararg_count api args retval;
    @copy sp api;
    args=_vararg_count - 1;
    @glk api args retval;
    return retval;
];
[_bglFloatGt x y;
     @jfgt x y ?yes; rfalse; .yes; rtrue; 
];
[_bglFloatLt x y;
     @jflt x y ?yes; rfalse; .yes; rtrue; 
];
[_bgl_bglOpCodes_aload addr idx result;
     @aload addr idx result; 
    return result;
];
