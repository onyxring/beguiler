!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
object widget
  with count 0,
       bump [;
    self.count=self.count + 1;
    return self.count;
  ]
;
[takesAnyObject o;
];
[main x w y;
    x=widget.bump();
    w = widget;
    y=w.bump();
    takesanyobject(widget);
];
