!% -v5
!% -E1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;

    Constant story    = "";
    Constant headline = "";

Replace banner;

        replace main _oldmain;
    
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;

! test_inf_mode_forward_emitter.inf — emitter functions declared inside a `#bgl{}`
! island must be reachable as forward calls from earlier members. This requires
! three pieces working together:
!   (1) preScanBglIslandContent keeps functionDef stubs for the second pass
!       (otherwise the stub is erased and forward-call lookup fails).
!   (2) The emitter qualifier is propagated to the stub's `isEmitter` field.
!   (3) The emitter's I6 body is captured during prescan so the call site can
!       inline it (without a body, dispatch falls back to verbatim emission).


[Banner;
    print "^";
    style bold;
    print (string)story;
    style roman;
    print (string)headline;
    print "Release ";
    print _bglheader.release._opconv_int();
    print " / Serial number ";
    _bglheader.printserial();
    print "^";
    style underline;
    print "Written in";
    style roman;
    print " Beguile v";
    print 0;
    print ".";
    print 0;
    print ".";
    print 5;
    print "^";
    style underline;
    print "Compiled with";
    style roman;
    print " Inform v";
     inversion; 
    print " / Library v";
    print (string)librelease;
    print " ";
    
        #Ifdef STRICT_MODE; print "S"; #Endif;
        #Ifdef INFIX; print "X";
        #Ifnot; #Ifdef DEBUG; print "D"; #Endif; #Endif;
    
    print (string)"^";
];
object myObj
;
[caller;
    print (the)myobj;
];



        [main;
            bglInit();
            _oldmain();
        ];
    
class _bglaccessor3
  with
    _opconv_int[;
        return _bgl_bglOpCodes_loadw(2, 0) & 1023;
    ]
;
_bglaccessor3 __bglheader_release;
object _bglHeader
  with release __bglheader_release,
       serialChar [i;
    return _bgl_bglOpCodes_loadb(18, i);
  ],
       printSerial [i;
    i = 0;
    for (i = 0 : i < 6 : i++) {
        print (char)self.serialchar(i);
    }
  ]
;
[_bgl_bglOpCodes_loadb arr idx result;
     @loadb arr idx -> result; 
    return result;
];
[_bgl_bglOpCodes_loadw arr idx result;
     @loadw arr idx -> result; 
    return result;
];
end;
