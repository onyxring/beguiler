!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
[main lo hi c s r p3 p7 u ul ur;
    lo=_bglMin(3, 7);
    hi=_bglMax(3, 7);
    c=_bglClamp(15, 0, 10);
    s=_bglSign(-4);
    print lo;
    print hi;
    print c;
    print s;
    random(-42);
    r=random(6);
    print r;
    p3=random(10, 20, 30);
    p7=random(1, 2, 3, 4, 5, 6, 7);
    print p3;
    print p7;
    u=200;
    ul=_bglShiftLeft(u, 2);
    ur=_bglUnsignedShiftRight(u, 1);
    ul = _bglShiftLeft(ul, 1);
    ur = _bglUnsignedShiftRight(ur, 1);
    print ul;
    print ur;
];
[_bglClamp v lo hi;
    if (v < lo) {
        return lo;
    }
    if (v > hi) {
        return hi;
    }
    return v;
];
[_bglMax a b;
    if (a > b) {
        return a;
    }
    return b;
];
[_bglMin a b;
    if (a < b) {
        return a;
    }
    return b;
];
[_bglShiftLeft i numBits;
    return i * _bglpow(2,numbits);
];
[_bglSign v;
    if (v < 0) {
        return -1;
    }
    if (v > 0) {
        return 1;
    }
    return 0;
];
[_bglUnsignedShiftRight i numBits;
    return _bglunsigneddiv(i,_bglpow(2,numbits));
];
[_bglPow i p retval t;
    if (p == 0) {
        return 1;
    }
    retval=i;
    if (p < 0) {
        for (t = 0 : t < (-p) - 1 : t++) {
            retval=retval / i;
        }
        return retval;
    }
    for (t = 0 : t < p - 1 : t++) {
        retval=retval * i;
    }
    return retval;
];
[_bglUnsignedDiv a b lowHalf hq hr combined;
    if (b == 0) {
        return 0;
    }
    if (a >= 0 && b > 0) {
        return a / b;
    }
    if (b < 0) {
        if (_bglunsignedcompare(a,b) >= 0) {
            return 1;
        }
        return 0;
    }
    lowHalf=a & 32767;
    hq=32767 / b;
    hr=32767 % b + 1;
    if (hr >= b) {
        hq=hq + 1;
        hr=hr - b;
    }
    combined=lowhalf + hr;
    if (combined >= 0) {
        return hq + combined / b;
    }
    return hq + _bglunsigneddiv(combined,b);
];
[_bglUnsignedCompare x y u v;
    if (x == y) {
        return 0;
    }
    if (x < 0 && y >= 0) {
        return 1;
    }
    if (x >= 0 && y < 0) {
        return -1;
    }
    u=x & 32767;
    v=y & 32767;
    if (u > v) {
        return 1;
    }
    return -1;
];
