!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 1000;
#Ifdef beguiler;#Endif;
Constant _BGL_WORLD_BUFSIZE = 128;
global _bgl_catch_cookie;
global _bgl_cv0;
global _bgl_cvs0;
global _bgl_cv1;
global _bgl_cvs1;
global _bgl_cv2;
global _bgl_cvs2;
global _bgl_cv3;
global _bgl_cvs3;
global _bgl_cv4;
global _bgl_cvs4;
global _bgl_cv5;
global _bgl_cvs5;
global _bgl_cv6;
global _bgl_cvs6;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
object _zcode
;
object bgl
  with zcode _zcode
;
[_bglArrayCompareAsc lhs rhs;
    
        if(lhs < rhs) return -1;
        if(lhs > rhs) return 1;
        return 0;
    
    return 0;
];
object _bglArray
  with rawGet [addr slot;
     return addr-->slot; 
    return 0;
  ],
       rawSet [addr slot v;
     addr-->slot = v; 
  ],
       get [obj prop n;
    
            if(metaclass(obj)==object) return obj.&prop-->n;
            return obj-->(n+1);
        
    return 0;
  ],
       set [obj prop n v;
    
            if(metaclass(obj)==object){ obj.&prop-->n = v; return; }
            obj-->(n+1) = v;
        
  ],
       copy [dobj dprop sobj sprop n cap i;
    n=self.length(sobj,sprop);
    cap=self.size(dobj,dprop);
    if (n > cap) {
        n = cap;
    }
    for (i = 0 : i < n : i++) {
        self.set(dobj, dprop, i, self.get(sobj,sprop,i));
    }
    self.setlength(dobj, dprop, n);
  ],
       isTracked [obj prop hdr;
     if(metaclass(obj)==object) rfalse; 
    hdr = self.rawget(obj,0);
    return self.rawget(obj,hdr)==36996&&self.rawget(obj,hdr-1)>=0;
  ],
       size [obj prop;
     if(metaclass(obj)==object) return obj.#prop/WORDSIZE; 
    if (self.istracked(obj,prop)) {
        return self.rawget(obj,0)-2;
    }
    return self.rawget(obj,0);
  ],
       length [obj prop;
     if(metaclass(obj)==object) return obj.#prop/WORDSIZE; 
    if (self.istracked(obj,prop)) {
        return self.rawget(obj,self.rawget(obj,0)-1);
    }
    return self.rawget(obj,0);
  ],
       setLength [obj prop n;
     if(metaclass(obj)==object) return; 
    if (self.istracked(obj,prop)) {
        if (n < 0) {
            print (string)"^[Beguile runtime error: setLength value exceeds signed range (max 32767 on Z, 2^31-1 on Glulx)]^";
             quit; 
        }
        self.set(obj, prop, self.size(obj,prop), n);
    }
  ],
       indexOf [obj prop val sz t;
    sz=self.size(obj,prop);
    for (t = 0 : t < sz : t++) {
        if (self.get(obj,prop,t)==val) {
            return t;
        }
    }
    return -1;
  ],
       clear [obj prop sz t;
    sz=self.size(obj,prop);
    for (t = 0 : t < sz : t++) {
        self.set(obj, prop, t, 0);
    }
    self.setLength(obj, prop, 0);
  ],
       swap [obj prop pos1 pos2 tmp;
    tmp = self.get(obj,prop,pos1);
    self.set(obj, prop, pos1, self.get(obj,prop,pos2));
    self.set(obj, prop, pos2, tmp);
  ],
       reverse [obj prop len half i;
    len=self.length(obj,prop);
    half=len / 2;
    for (i = 0 : i < half : i++) {
        self.swap(obj, prop, i, len - 1 - i);
    }
  ],
       append [obj prop val len;
    len=self.length(obj,prop);
    if (len >= self.size(obj,prop)) {
        return false;
    }
    self.set(obj, prop, len, val);
    self.setLength(obj, prop, len + 1);
    return true;
  ],
       insert [obj prop pos val len i;
    len=self.length(obj,prop);
    if (len >= self.size(obj,prop)) {
        return false;
    }
    if (pos < 0 || pos > len) {
        return false;
    }
    for (i = len : i > pos : i--) {
        self.set(obj, prop, i, self.get(obj,prop,i - 1));
    }
    self.set(obj, prop, pos, val);
    self.setLength(obj, prop, len + 1);
    return true;
  ],
       prepend [obj prop val;
    return self.insert(obj,prop,0,val);
  ],
       remove [obj prop pos len i;
    len=self.length(obj,prop);
    if (pos < 0 || pos >= len) {
        return;
    }
    for (i = pos : i < len - 1 : i++) {
        self.set(obj, prop, i, self.get(obj,prop,i + 1));
    }
    self.set(obj, prop, len - 1, 0);
    self.setLength(obj, prop, len - 1);
  ],
       removeValue [obj prop val pos len;
    pos = 0;
    len=self.length(obj,prop);
    while (pos < len) {
        if (self.get(obj,prop,pos)==val) {
            self.remove(obj, prop, pos);
            len = self.length(obj,prop);
        }
        else {
             pos++ ;
        }
    }
  ],
       push [obj prop val;
    self.insert(obj, prop, 0, val);
  ],
       pop [obj prop v;
    if (self.length(obj,prop) == 0) {
        return 0;
    }
    v = self.get(obj,prop,0);
    self.remove(obj, prop, 0);
    return v;
  ],
       dequeue [obj prop;
    return self.pop(obj,prop);
  ],
       enqueue [obj prop val;
    self.append(obj, prop, val);
  ],
       peek [obj prop;
    if (self.length(obj,prop) == 0) {
        return 0;
    }
    return self.get(obj,prop,0);
  ],
       peekEnd [obj prop len;
    len=self.length(obj,prop);
    if (len == 0) {
        return 0;
    }
    return self.get(obj,prop,len - 1);
  ],
       popEnd [obj prop len v;
    len=self.length(obj,prop);
    if (len == 0) {
        return 0;
    }
    v = self.get(obj,prop,len - 1);
    self.remove(obj, prop, len - 1);
    return v;
  ],
       sort [obj prop compare len i key j;
    len=self.length(obj,prop);
    for (i = 1 : i < len : i++) {
        key = self.get(obj,prop,i);
        j=i - 1;
        while (j >= 0 && compare(self.get(obj,prop,j),key) > 0) {
            self.set(obj, prop, j + 1, self.get(obj,prop,j));
             j-- ;
        }
        self.set(obj, prop, j + 1, key);
    }
  ]
;
global _bglWorldBufIdx = -1;
[risky x;
    if (x > 10) {
        if (_bgl_catch_cookie == 0) {
            print "^[Unhandled exception]^";
            quit;
        }
        @throw x _bgl_catch_cookie;
    }
];
[doubleRisky x inner;
    _bgl_cvs0 = _bgl_catch_cookie;
    @catch -> _bgl_cv0;
    if (_bgl_catch_cookie == _bgl_cv0) {
        _bgl_catch_cookie = _bgl_cv0;
        if (x > 20) {
            if (_bgl_catch_cookie == 0) {
                print "^[Unhandled exception]^";
                quit;
            }
            @throw 99 _bgl_catch_cookie;
        }
        _bgl_catch_cookie = _bgl_cvs0;
    } else {
        _bgl_catch_cookie = _bgl_cvs0;
        inner = _bgl_cv0;
        if (_bgl_catch_cookie == 0) {
            print "^[Unhandled exception]^";
            quit;
        }
        @throw inner _bgl_catch_cookie;
    }
];
[deep;
    if (_bgl_catch_cookie == 0) {
        print "^[Unhandled exception]^";
        quit;
    }
    @throw 7 _bgl_catch_cookie;
];
[middle;
    deep();
];
class risk
  class object
  with
    n 0,
    trigger[;
        if (self.n == 0) {
            if (_bgl_catch_cookie == 0) {
                print "^[Unhandled exception]^";
                quit;
            }
            @throw 101 _bgl_catch_cookie;
        }
    ]
;
risk g_risk;
[main e a b c d e5;
    _bgl_cvs1 = _bgl_catch_cookie;
    @catch -> _bgl_cv1;
    if (_bgl_catch_cookie == _bgl_cv1) {
        _bgl_catch_cookie = _bgl_cv1;
        risky(5);
        risky(15);
        _bgl_catch_cookie = _bgl_cvs1;
    } else {
        _bgl_catch_cookie = _bgl_cvs1;
        e = _bgl_cv1;
    }
    _bgl_cvs2 = _bgl_catch_cookie;
    @catch -> _bgl_cv2;
    if (_bgl_catch_cookie == _bgl_cv2) {
        _bgl_catch_cookie = _bgl_cv2;
        _bgl_cvs3 = _bgl_catch_cookie;
        @catch -> _bgl_cv3;
        if (_bgl_catch_cookie == _bgl_cv3) {
            _bgl_catch_cookie = _bgl_cv3;
            if (_bgl_catch_cookie == 0) {
                print "^[Unhandled exception]^";
                quit;
            }
            @throw 42 _bgl_catch_cookie;
            _bgl_catch_cookie = _bgl_cvs3;
        } else {
            _bgl_catch_cookie = _bgl_cvs3;
            a = _bgl_cv3;
            if (_bgl_catch_cookie == 0) {
                print "^[Unhandled exception]^";
                quit;
            }
            @throw a _bgl_catch_cookie;
        }
        _bgl_catch_cookie = _bgl_cvs2;
    } else {
        _bgl_catch_cookie = _bgl_cvs2;
        b = _bgl_cv2;
    }
    _bgl_cvs4 = _bgl_catch_cookie;
    @catch -> _bgl_cv4;
    if (_bgl_catch_cookie == _bgl_cv4) {
        _bgl_catch_cookie = _bgl_cv4;
        middle();
        _bgl_catch_cookie = _bgl_cvs4;
    } else {
        _bgl_catch_cookie = _bgl_cvs4;
        c = _bgl_cv4;
    }
    _bgl_cvs5 = _bgl_catch_cookie;
    @catch -> _bgl_cv5;
    if (_bgl_catch_cookie == _bgl_cv5) {
        _bgl_catch_cookie = _bgl_cv5;
        risky(3);
        _bgl_catch_cookie = _bgl_cvs5;
    } else {
        _bgl_catch_cookie = _bgl_cvs5;
        d = _bgl_cv5;
    }
    _bgl_cvs6 = _bgl_catch_cookie;
    @catch -> _bgl_cv6;
    if (_bgl_catch_cookie == _bgl_cv6) {
        _bgl_catch_cookie = _bgl_cv6;
        if (g_risk ~= nothing) {
        g_risk.trigger();
        }
        _bgl_catch_cookie = _bgl_cvs6;
    } else {
        _bgl_catch_cookie = _bgl_cvs6;
        e5 = _bgl_cv6;
    }
];
