!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
Constant _BGL_FORIN_SCRATCH_CAP = 31;

    Array _bglScratchStack --> (_BGL_FORIN_SCRATCH_CAP + 3);   ! word 0 is set by _bglScratchMake
    Global _bglScratchTop = 0;
    [ _bglScratchPush v;
        if(_bglScratchTop >= _BGL_FORIN_SCRATCH_CAP){
            print "^[Beguile runtime error: for-in literal-list scratch exhausted]^";
            quit;
        }
        _bglScratchTop++;
        _bglScratchStack-->_bglScratchTop = v;
    ];
    [ _bglScratchMake count a;
        a = _bglScratchStack;
        #Ifdef _BGL_TRACKED_ARRAYS;
            a-->0 = _BGL_FORIN_SCRATCH_CAP + 2;              ! capacity, in a table's count word
            a-->(_BGL_FORIN_SCRATCH_CAP + 2) = $9084;       ! magic marker
            a-->(_BGL_FORIN_SCRATCH_CAP + 1) = count;       ! length
        #Ifnot;
            a-->0 = count;                                  ! the core reads length here
        #Endif;
        _bglScratchTop = 0;
        return a;
    ];

global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_Room
  class object
  with
    visits 0
;
_bglClass_Room r1
;
_bglClass_Room r2
;
_bglClass_Room r3
;
[main total x _bglfia1 _bglfi2 m n y _bglfia3 _bglfi4 seen r _bglfia5 _bglfi6;
    total = 0;
       _bglScratchPush(1);
       _bglScratchPush(2);
       _bglScratchPush(3);
       _bglfia1 = _bglScratchMake(3);
       _bglfi2 = 0;
       for (: _bglfi2 < _bglfia1-->0 : _bglfi2++) {
          x = _bglfia1-->(_bglfi2+1);
        total=total + x;
       }
    print total;
    m = 4;
    n = 5;
       _bglScratchPush(m);
       _bglScratchPush(n);
       _bglScratchPush(m * n);
       _bglfia3 = _bglScratchMake(3);
       _bglfi4 = 0;
       for (: _bglfi4 < _bglfia3-->0 : _bglfi4++) {
          y = _bglfia3-->(_bglfi4+1);
        total=total + y;
       }
    print total;
    seen = 0;
       _bglScratchPush(r1);
       _bglScratchPush(r2);
       _bglScratchPush(r3);
       _bglfia5 = _bglScratchMake(3);
       _bglfi6 = 0;
       for (: _bglfi6 < _bglfia5-->0 : _bglfi6++) {
          r = _bglfia5-->(_bglfi6+1);
        seen=seen + 1;
       }
    print seen;
];
