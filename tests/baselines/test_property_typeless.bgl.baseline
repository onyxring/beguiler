!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
property additive hook;
property plain;
class _bglClass_Base
  with
    hook 1 2 
;
_bglClass_Base leaf
  with hook 3 
;
class _bglClass_Other
  with
    hook 'aa' 'bb' 
;
_bglClass_Other otherInst
;
[main;
    bglinit();
];
