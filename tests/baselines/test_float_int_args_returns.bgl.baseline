!% -G
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;

    Replace HandleGlkEvent _bglAuthorGlkEvent;

global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _glulx
;
[_bglSuspendLineInput buffer;
    return 0;
];
[_bglResumeLineInput buffer typed;
];
[_bglGlkEvent event context buffer target typed;
    if (_bgl_bglOpCodes_aload(event, 0) ~= 8) {
        return false;
    }
    target = _bgl_bglOpCodes_aload(event, 2);
    __glkHook(258, _bgl_bglOpCodes_aload(event, 1));
    if ((~~(metaclass(target) == Routine))) {
        return false;
    }
    typed = 0;
    if (context == 0) {
        typed=_bglsuspendlineinput(buffer);
    }
     target(); 
    if (context == 0) {
        _bglresumelineinput(buffer, typed);
    }
    return true;
];
[_bglCurrentWindow stream win;
    stream=__glkHook(72);
    win=__glkHook(32, 0, 0);
    while (win ~= 0) {
        if (__glkHook(44, win) == stream) {
            return win;
        }
        win=__glkHook(32, win, 0);
    }
    return 0;
];
object bgl
  with glulx _glulx
;
[takesFloat x;
    _bglFloatPrintDecimal(x);
];
[fromInt n;
    return _bglFloatNumtof(n);
];
[fromLiteral;
    return _bglFloatNumtof(7);
];
object meter
  with level ,
       set [v;
    self.level = v;
  ]
;
[main n a b f;
    n = 5;
    takesfloat(_bglFloatNumtof(n));
    takesfloat(_bglFloatNumtof(7));
    meter.set(_bglFloatNumtof(n));
    a = fromint(3);
    b = fromliteral();
    f = $+2.5;
    takesfloat(f);
];
[_bgl_float__oplteqgt a b;
    
            if(_bglFloatLt(a, b)) return -1;
            if(_bglFloatGt(a, b)) return 1;
            return 0;
        
];

    [ HandleGlkEvent event context buffer;
        if (_bglGlkEvent(event, context, buffer)) return -1;
        if (_bglAuthorGlkEvent) return _bglAuthorGlkEvent(event, context, buffer);
        return 0;
    ];

[__glkHook _vararg_count api args retval;
    @copy sp api;
    args=_vararg_count - 1;
    @glk api args retval;
    return retval;
];
[_bglFloatGt x y;
     @jfgt x y ?yes; rfalse; .yes; rtrue; 
];
[_bglFloatLt x y;
     @jflt x y ?yes; rfalse; .yes; rtrue; 
];
[_bglFloatNumtof n r;
     @numtof n r; 
    return r;
];
[_bglFloatPrintDecimal v isNeg ipart frac fdigits;
    isNeg=_bglfloatlt(v,_bglFloatNumtof(0));
    if (isNeg) {
        v = _bglFloatFsub(_bglFloatNumtof(0), v);
    }
    v = _bglFloatFadd(v, $+0.00005);
    ipart=_bglFloatFtonumz(v);
    frac = _bglFloatFsub(v, _bglFloatNumtof(ipart));
    fdigits=_bglFloatFtonumz((_bglFloatFmul(frac, _bglFloatNumtof(10000))));
    if (fdigits < 0) {
        fdigits=-fdigits;
    }
    if (fdigits > 9999) {
        fdigits = 9999;
    }
    if (isneg && (ipart ~= 0 || fdigits ~= 0)) {
        print (string)"-";
    }
    print ipart;
    print (string)".";
    if (fdigits < 1000) {
        print (string)"0";
    }
    if (fdigits < 100) {
        print (string)"0";
    }
    if (fdigits < 10) {
        print (string)"0";
    }
    print fdigits;
];
[_bgl_bglOpCodes_aload addr idx result;
     @aload addr idx result; 
    return result;
];
[_bglFloatFadd x y r;
     @fadd x y r; 
    return r;
];
[_bglFloatFmul x y r;
     @fmul x y r; 
    return r;
];
[_bglFloatFsub x y r;
     @fsub x y r; 
    return r;
];
[_bglFloatFtonumz f r;
     @ftonumz f r; 
    return r;
];
