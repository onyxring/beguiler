!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
object hook
;
[helperRoutine a;
    return a + 1;
];
class _bglClass_Money
  with
    cents
;
class _bglClass_Widget
  class object
  with
    count,
    refresh[;
        self.count=self.count + 1;
    ]
;
[main w;
    print helperroutine(5);
    print (w has light);
    print 0+(hook);
    print 0+(_bglClass_Widget);
    print (w.count);
    print (w.refresh());
    print _bgl_Money_scale_1_int(5);
    print _bgl_Money_scale_2_int_int(3, 4);
    print _bgl_bglOpCodes_readChar(1);
];
[_bgl_Money_scale_2_int_int a b;
    return a * b;
];
[_bgl_Money_scale_1_int a;
    return a * 2;
];
[_bgl_bglOpCodes_readChar dev c;
     @read_char dev -> c; 
    return c;
];
