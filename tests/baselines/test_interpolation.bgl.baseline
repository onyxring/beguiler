object _zcode
;
object bgl
;
class _bglClass_Score
  class object
  with
    value 0,
    get[;
        return self.value;
    ]
;
_bglClass_Score g_pts
  with value 42
;
[main pts bonus _bgl_tempL0;
    pts = 42;
    bonus = 8;
    print "Score: ";
    print pts;
    print "^";
    print "Use {braces} for interpolation.^";
    print "Debug pts=";
    print pts;
    print "^";
    print "Total: ";
    print pts + bonus;
    print "^";
    print "Product: ";
    print pts * 2;
    print "^";
    print "Final: ";
    print g_pts.get();
    print "^";
    print "Grade: ";
    if (pts > 50) { _bgl_tempL0 = 1; } else { _bgl_tempL0 = 0; }
    print _bgl_tempL0;
    print "^";
    print pts;
    print " plus ";
    print bonus;
    print " is ";
    print pts + bonus;
    print "^";
];

