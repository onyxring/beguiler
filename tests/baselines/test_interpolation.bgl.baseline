!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bgl_temp0;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_Score
  class object
  with
    value 0,
    get[;
        return self.value;
    ]
;
_bglClass_Score g_pts
  with value 42
;
[main pts bonus;
    pts = 42;
    bonus = 8;
    print "Score: ";
    print pts;
    print "^";
    print "Use {braces} for interpolation.^";
    print "Debug pts=";
    print pts;
    print "^";
    print "Total: ";
    print pts + bonus;
    print "^";
    print "Product: ";
    print pts * 2;
    print "^";
    print "Final: ";
    print g_pts.get();
    print "^";
    print "Grade: ";
    if (pts > 50) { _bgl_temp0 = 1; } else { _bgl_temp0 = 0; }
    print _bgl_temp0;
    print "^";
    print pts;
    print " plus ";
    print bonus;
    print " is ";
    print pts + bonus;
    print "^";
];

#Ifndef debug_flag;
Global debug_flag;
#Endif;
#Ifndef workflag;
Attribute workflag;
#Endif;
#Ifndef DebugAttribute;
[ DebugAttribute a; print "(attribute ", a, ")"; ];
#Endif;
