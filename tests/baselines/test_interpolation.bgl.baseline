object _zcode
;
object bgl
;
class _bglClass_Score
  class object
  with
    value 0,
    get[;
        return self.value;
    ]
;
_bglClass_Score g_pts
  with value 42
;
[main pts bonus _bgl_tempL0;
    pts = 42;
    bonus = 8;
    print "Score: ";
    print pts;
    print "^Use {braces} for interpolation.^Debug pts=";


    print pts;
    print "^Total: ";

    print pts + bonus;
    print "^Product: ";

    print pts * 2;
    print "^Final: ";

    print g_pts.get();
    print "^Grade: ";

    if (pts > 50) {
        print 1;
    }
    else {
        print 0;
    }
    print "^";
    print pts;
    print " plus ";
    print bonus;
    print " is ";
    print pts + bonus;
    print "^";
    rtrue;
];

