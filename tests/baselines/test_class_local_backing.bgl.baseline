!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_Window
  with
    width,
    height,
    _opeq[v;
        self.width=v.width;
        self.height=v.height;
        return self;
    ]
;
_bglClass_Window source
;
[mkWin w h;
    source.width=w;
    source.height=h;
    return source;
];
class _bglClass_Tag
  with
    n
;
_bglClass_Tag tagSrc
;
[mkTag _l_n;
    tagsrc.n=_l_n;
    return tagsrc;
];
class _bglClass_Room
  class object
  with
    visits 0
;
_bglClass_Room r1
;
_bglClass_Room r2
;
[main boxA boxB aw ah bw bh boxC cw t1 tn here there;
    boxA = _bglLocal_main_boxa;
    _bglLocal_main_boxa.width = 0;
    _bglLocal_main_boxa.height = 0;
    boxB = _bglLocal_main_boxb;
    _bglLocal_main_boxb.width = 0;
    _bglLocal_main_boxb.height = 0;
    boxC = _bglLocal_main_boxc;
    _bglLocal_main_boxc.width = 0;
    _bglLocal_main_boxc.height = 0;
    t1 = _bglLocal_main_t1;
    _bglLocal_main_t1.n = 0;
    boxA._opeq(mkwin(100,200));
    boxB._opeq(mkwin(300,400));
    aw=boxa.width;
    ah=boxa.height;
    bw=boxb.width;
    bh=boxb.height;
    boxa.height=boxa.width;
    boxC._opeq(mkwin(500,600));
    cw=boxc.width;
    t1.n = mktag(42).n;
    tn=t1.n;
    here = r1;
    here = r2;
    there = r1;
];
_bglClass_Window _bglLocal_main_boxa;
_bglClass_Window _bglLocal_main_boxb;
_bglClass_Window _bglLocal_main_boxc;
_bglClass_Tag _bglLocal_main_t1;
