        ! On the Z-machine Inform 6 holds values in its globals and arrays, which follow the object tables (their
        ! encoded text could pass for an address).
        #Ifdef TARGET_ZCODE;
            p = 0-->6; last = 0-->7;
        #Ifnot;
            p = 0-->2; last = 0-->4;
        #Endif;
        a = (_bglHeap-->0) + 5 * WORDSIZE;
        for(last = last - WORDSIZE : _bglUnsignedCompare(p, last) <= 0 : p++){
            if(p == _bglHeap){ p = _bglHeap + (_bglHeap-->5) * WORDSIZE - 1; continue; }
            w = p-->0;
            o = w - a;
            if(o < 0 || o >= _bglHeap-->1) continue;
            b = _bglHeapBlockOf(w);
            if(b == 0 || (b-->2 & 3) ~= 1) continue;
            print "^[Beguile debug: the array at ", w, " is still referred to from address ", p,
                  ", which the collector doesn't track; it is kept]^";
            _bglHeapMark(w);
            found = true;
        }
        return found;
    
];
array _bglheaptracelevel --> 1;

[ _bglGcRoots o i;
    o = 0; i = 0;
    if(widget provides nums) for(i = 0 : i < widget.#nums / WORDSIZE : i++) _bglHeapMark((widget.&nums)-->i);
    objectloop(o ofclass _bglClass_gadget)
        if(o provides readings) for(i = 0 : i < o.#readings / WORDSIZE : i++) _bglHeapMark((o.&readings)-->i);
    for(i = 0 : i < _bglFrameTop : i++) _bglHeapMark(_bglFramePool-->i);
];
