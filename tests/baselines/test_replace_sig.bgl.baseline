!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
Release 1;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
[_bgl_replaced_add_0 a b;
    return a + b;
];
[_bgl_replaced_add_1 x;
    return _bgl_replaced_add_0(x,10);
];
[add;
    return _bgl_replaced_add_1(42);
];
[main result;
    result=add();
];
