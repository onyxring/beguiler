!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_Counter
  class object
  with
    value 0,
    _opeqeq[other;
        return self.value == other.value;
    ],
    _opadd[n;
        return self.value + n;
    ]
;
_bglClass_Counter ctrA
  with value 5
;
_bglClass_Counter ctrB
  with value 5
;
class _bglClass_Temperature
  class object
  with
    celsius 0
;
class _bglClass_Distance
  class object
  with
    meters 0
;
_bglClass_Temperature t
  with celsius 20
;
_bglClass_Distance d
  with meters 100
;
[main sum c doubled m;
    if (ctra._opeqeq(ctrb)) {
        print (string)"equal";
    }
    sum=ctra._opadd(10);
    c=t.celsius;
    doubled=t.celsius + t;
    m=d.meters;
];
