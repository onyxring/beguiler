!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
Constant _BGL_TRACKED_ARRAYS;
   Array _bglFramePool --> 64;
   Global _bglFrameTop = 0;
   Global _bglRetHold = 0;   ! a return value read before the frame it came from is freed
   [ _bglFrameAlloc size r;
      if (_bglFrameTop + size > 64) {
         print "^[Beguile runtime error: frame pool exhausted]^";
         quit;
      }
      r = _bglFrameTop;
      _bglFrameTop = _bglFrameTop + size;
      return _bglFramePool + (r * WORDSIZE);
   ];
   [ _bglFrameFree size;
      _bglFrameTop = _bglFrameTop - size;
   ];
   [ _bglArrayLocalAlloc size r i;
      r = _bglFrameAlloc(size + 3);
      r-->0 = size + 2;
      for (i = 1: i <= size: i++) r-->i = 0;
      r-->(size + 1) = 0;
      r-->(size + 2) = $9084;
      return r;
   ];
   Global _bglFrameTaken = 0;
   Global _bglFrameSrc = 0;
   ! A local array with room for src's n elements: `cur` when it has room, else a new block. When src
   ! is a returned local lying in freed frame space at or above the top, its elements are moved down
   ! into the new block (forward, so none is overwritten before it is read) and _bglFrameSrc names
   ! the block to copy from instead.
   [ _bglArrayLocalCopyAlloc n src cur top i;
      _bglFrameTaken = 0;
      _bglFrameSrc = src;
      if (cur ~= 0 && cur-->(cur-->0) == $9084 && cur-->0 - 2 >= n) return cur;
      top = _bglFramePool + _bglFrameTop * WORDSIZE;
      if (src < top || src >= _bglFramePool + 64 * WORDSIZE) {
         _bglFrameTaken = n + 3;
         return _bglArrayLocalAlloc(n);
      }
      if (_bglFrameTop + n + 3 > 64) {
         print "^[Beguile runtime error: frame pool exhausted]^";
         quit;
      }
      _bglFrameTop = _bglFrameTop + n + 3;
      for (i = 1: i <= n: i++) top-->i = src-->i;
      top-->0 = n + 2;
      top-->(n + 1) = n;
      top-->(n + 2) = $9084;
      _bglFrameTaken = n + 3;
      _bglFrameSrc = top;
      return top;
   ];
   [ _bglArrayLocalAllocPlain size r i;
      r = _bglFrameAlloc(size + 1);
      r-->0 = size;
      for (i = 1: i <= size: i++) r-->i = 0;
      return r;
   ];
   [ _bglRawArrayLocalAlloc size r i;
      r = _bglFrameAlloc(size);
      for (i = 0: i < size: i++) r-->i = 0;
      return r;
   ];
   [ _bglByteArrayLocalAlloc nbytes words r i;
      words = 2 + ((nbytes + WORDSIZE - 1) / WORDSIZE);
      r = _bglFrameAlloc(words);
      for (i = 0: i < words: i++) r-->i = 0;
      r-->0 = nbytes;
      r-->1 = nbytes;   ! the length: a buffer starts full, as I6's does
      return r + WORDSIZE;
   ];
   [ _bglByteArrayLocalFree nbytes;
      _bglFrameFree(2 + ((nbytes + WORDSIZE - 1) / WORDSIZE));
   ];
   [ _bglByteArrayLocalCopy dst src i;
      for (i = 0: i < src-->0: i++) dst->(WORDSIZE + i) = src->(WORDSIZE + i);
      dst-->0 = src-->0;
   ];
constant _bglWorldBufSize = 128;
global _bglWorldBufIdx = -1;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
    #Ifdef TARGET_GLULX; @setiosys 2 0; #Endif;
];
 Constant NO_ATTRIBUTE 0; 
object _zcode
;
object bgl
  with zcode _zcode
;
[_bglArrayCompareAsc lhs rhs;
    
        if(lhs < rhs) return -1;
        if(lhs > rhs) return 1;
        return 0;
    
];
[sumDown n _bglret acc rest;
    acc = _bglArrayLocalAlloc(4);
    if (n <= 0) {
        _bglFrameFree(7);
        return 0;
    }
    _bglArray.append(acc, 0, n, 0);
    rest=sumdown(n - 1);
    _bglret =  _bglAt(acc, 0, 0)-->0  + rest;
    _bglFrameFree(7);
    return _bglret;
];
[useTwoLocals a b _bglret first second;
    first = _bglArrayLocalAlloc(3);
    second = _bglArrayLocalAlloc(3);
    _bglArray.append(first, 0, a, 0);
    _bglArray.append(first, 0, b, 0);
    _bglArray.append(second, 0, a + b, 0);
    _bglret =  _bglAt(first, 0, 0)-->0  +  _bglAt(first, 1, 0)-->0  +  _bglAt(second, 0, 0)-->0 ;
    _bglFrameFree(6);
    _bglFrameFree(6);
    return _bglret;
];
[earlyReturn flag _bglret buf;
    buf = _bglArrayLocalAlloc(5);
    _bglArray.append(buf, 0, 100, 0);
    if (flag) {
        _bglret =  _bglAt(buf, 0, 0)-->0 ;
        _bglFrameFree(8);
        return _bglret;
    }
    _bglArray.append(buf, 0, 200, 0);
    _bglret =  _bglAt(buf, 1, 0)-->0 ;
    _bglFrameFree(8);
    return _bglret;
];
[sumAll data total i;
    total = 0;
    for (i = 0 : i < _bglArray.length(data, 0) : i++) {
        total=total +  _bglAt(data, i, 0)-->0 ;
    }
    return total;
];
[listInitLocal _bglret primes;
    primes = _bglArrayLocalAlloc(5);
    primes-->1 = 2;
    primes-->2 = 3;
    primes-->3 = 5;
    primes-->4 = 7;
    primes-->5 = 11;
    primes-->6 = 5;
    _bglret = _bglArray.length(primes, 0) * 100 + sumall(primes);
    _bglFrameFree(8);
    return _bglret;
];
[localByteArray _bglret buf c0 c1;
    buf = _bglByteArrayLocalAlloc(8);
    _bglByteAt(buf, 0, 1)->0 = 'X';
    _bglByteAt(buf, 1, 1)->0 = 'Y';
    c0= _bglByteAt(buf, 0, 0)->0;
    c1= _bglByteAt(buf, 1, 0)->0;
    if (c0=='X' && c1=='Y') {
        _bglByteArrayLocalFree(8);
        return 777;
    }
    _bglByteArrayLocalFree(8);
    return 0;
];
[main;
    print sumdown(5);
    print usetwolocals(3,4);
    print earlyreturn(true);
    print earlyreturn(false);
    print listinitlocal();
    print localbytearray();
];
object _bglArray
  with rawGet [addr slot;
     return addr-->slot; 
  ],
       get [obj prop n;
    
            if(metaclass(obj)==object) return obj.&prop-->n;
            return obj-->(n+1);
        
  ],
       set [obj prop n v;
    
            if(metaclass(obj)==object){ obj.&prop-->n = v; return; }
            obj-->(n+1) = v;
        
  ],
       copy [dobj dprop sobj sprop assign n cap i;
    n=self.length(sobj,sprop);
    cap=self.size(dobj,dprop);
    if (n > cap) {
        n=cap;
    }
    for (i = 0 : i < n : i++) {
        self.setowned(dobj, dprop, i, self.get(sobj,sprop,i), assign);
    }
    self.setlength(dobj, dprop, n);
  ],
       isTracked [obj prop hdr;
     if(metaclass(obj)==object) rfalse; 
    hdr = self.rawget(obj,0);
    return self.rawget(obj,hdr)==36996 && self.rawget(obj,hdr-1)>=0;
  ],
       size [obj prop;
     if(metaclass(obj)==object) return obj.#prop/WORDSIZE - 1; 
    if (self.istracked(obj,prop)) {
        return self.rawget(obj,0)-2;
    }
    return self.rawget(obj,0);
  ],
       length [obj prop;
     if(metaclass(obj)==object) return obj.&prop-->(obj.#prop/WORDSIZE - 1); 
    if (self.istracked(obj,prop)) {
        return self.rawget(obj,self.rawget(obj,0)-1);
    }
    return self.rawget(obj,0);
  ],
       setLength [obj prop n cap;
    if (n < 0) {
        print (string)"^[Beguile runtime error: array length exceeds signed range (max 32767 on Z, 2^31-1 on Glulx)]^";
         quit; 
    }
    cap=self.size(obj,prop);
    if (n > cap) {
        n=cap;
    }
     if(metaclass(obj)==object){ obj.&prop-->(obj.#prop/WORDSIZE - 1) = n; return; } 
    if (self.istracked(obj,prop)) {
        self.set(obj, prop, self.size(obj,prop), n);
    }
  ],
       setOwned [obj prop n v assign;
    if (assign==0) {
        self.set(obj, prop, n, v);
        return;
    }
     if(metaclass(assign) ~= Routine) { self.set(obj, prop, n, v); return; } 
    self.set(obj, prop, n, assign(self.get(obj,prop,n),v));
  ],
       append [obj prop val assign len;
    len=self.length(obj,prop);
    if (len >= self.size(obj,prop)) {
        return false;
    }
    self.setOwned(obj, prop, len, val, assign);
    self.setLength(obj, prop, len + 1);
    return true;
  ]
;
[_bglAt arr i w n;
    n = 0;
    
        n = arr-->0;
        #Ifdef _BGL_TRACKED_ARRAYS;
            if(n > 1 && arr-->n == $9084) n = n - 2;
        #Endif;
        if(i >= 0 && i < n) return arr + (i + 1) * WORDSIZE;
        return _bglOutOfRange(i, n, w);
    
];
[_bglByteAt arr i w n;
    n = 0;
    
        n = arr-->(-1);
        if(i >= 0 && i < n) return arr + WORDSIZE + i;
        return _bglOutOfRange(i, n, w);
    
];
[_bglOutOfRange i n w;
    
        print "^[Beguile run-time error: array index ", i, " is outside the ", n, " element";
        if(n ~= 1) print "s";
        print " it ";
        if(w) print "can hold"; else print "holds";
        print "; the ";
        if(w) print "write"; else print "read";
        print " is skipped]^";
        _bglSink-->0 = 0;
        return _bglSink;
    
];
array _bglsink --> 1;
