!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_Shape
  class object
  with
    describe[;
        print (string)"a shape";
    ]
;
class _bglClass_Circle
  class _bglClass_Shape
  with
    describe[;
        print (string)"a circle";
    ]
;
class _bglClass_LittleCircle
  class _bglClass_Circle
  with
    describe[;
        print (string)"a little circle";
    ]
;
_bglClass_LittleCircle lc
;
_bglClass_Circle c
;
[main;
    lc.describe();
    c.describe();
];
