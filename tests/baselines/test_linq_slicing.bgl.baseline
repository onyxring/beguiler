!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
Constant _BGL_LINQ_SCRATCH_SIZE = 32;
Constant _BGL_TRACKED_ARRAYS;

    ! MAX_DEPTH = number of nesting levels: depth 0 is a top-level chain, depth 1 is a chain
    ! started inside a depth-0 chain lambda, and so on. 2 covers the common one-level nested
    ! case (a chain inside a predicate or mapper); deeper nesting trips the _bglLinqEnter guard.
    ! Each level costs one buffer PAIR (2 x _BGL_LINQ_SCRATCH_SIZE+2 words) of always-reserved
    ! static memory, so the default is kept small (Z5 story-size budget). To allow deeper nesting,
    ! raise the constant AND add matching buffer decls + selector arms + startup stamps.
    Constant _BGL_LINQ_MAXDEPTH = 2;
    Array _bglLinqS0A table _BGL_LINQ_SCRATCH_SIZE + 2;
    Array _bglLinqS0B table _BGL_LINQ_SCRATCH_SIZE + 2;
    Array _bglLinqS1A table _BGL_LINQ_SCRATCH_SIZE + 2;
    Array _bglLinqS1B table _BGL_LINQ_SCRATCH_SIZE + 2;
    Global _bglLinqActiveDepth = 0;

    [ _bglLinqBuf d h ;
        switch(d) {
            0: if(h==0) return _bglLinqS0A; return _bglLinqS0B;
            1: if(h==0) return _bglLinqS1A; return _bglLinqS1B;
        }
    ];

    ! Begin a chain step: return the write-half of the current depth's pair (the
    ! half that ISN'T `src`, so a step reading the previous step's output writes
    ! the other half; a first step whose src is a user array writes half A). Then
    ! bump the depth so a chain started inside this step's lambda nests deeper.
    [ _bglLinqEnter src d a ;
        d = _bglLinqActiveDepth;
        if(d >= _BGL_LINQ_MAXDEPTH){
            print "^[Beguile runtime error: LINQ chain nesting exceeds _BGL_LINQ_MAXDEPTH. Increase the constant in array.bgl.]^";
            quit;
        }
        a = _bglLinqBuf(d, 0);
        _bglLinqActiveDepth = d + 1;
        if(src == a) return _bglLinqBuf(d, 1);
        return a;
    ];

    [ _bglLinqLeave ;
        _bglLinqActiveDepth = _bglLinqActiveDepth - 1;
    ];

global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
    g_empty-->(g_empty-->0) = $9084;

    _bglLinqS0A-->(_bglLinqS0A-->0) = $9084;  _bglLinqS0A-->(_bglLinqS0A-->0 - 1) = 0;
    _bglLinqS0B-->(_bglLinqS0B-->0) = $9084;  _bglLinqS0B-->(_bglLinqS0B-->0 - 1) = 0;
    _bglLinqS1A-->(_bglLinqS1A-->0) = $9084;  _bglLinqS1A-->(_bglLinqS1A-->0 - 1) = 0;
    _bglLinqS1B-->(_bglLinqS1B-->0) = $9084;  _bglLinqS1B-->(_bglLinqS1B-->0 - 1) = 0;

];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
[_bglArrayCompareAsc lhs rhs;
    
        if(lhs < rhs) return -1;
        if(lhs > rhs) return 1;
        return 0;
    
];
array g_nums table 10 20 30 40 50 5 $9084;
array g_empty table 10;
[main;
    bglinit();
    print _bglArray.length(_bglArray.take(g_nums, 0, 3), 0);
    print  (_bglArray.take(g_nums, 0, 3))-->(0+1) ;
    print  (_bglArray.take(g_nums, 0, 3))-->(2+1) ;
    print _bglArray.length(_bglArray.take(g_nums, 0, 0), 0);
    print _bglArray.length(_bglArray.take(g_nums, 0, 99), 0);
    print _bglArray.length(_bglArray.take(g_nums, 0, -5), 0);
    print _bglArray.length(_bglArray.take(g_empty, 0, 3), 0);
    print _bglArray.length(_bglArray.skip(g_nums, 0, 2), 0);
    print  (_bglArray.skip(g_nums, 0, 2))-->(0+1) ;
    print  (_bglArray.skip(g_nums, 0, 2))-->(2+1) ;
    print _bglArray.length(_bglArray.skip(g_nums, 0, 0), 0);
    print _bglArray.length(_bglArray.skip(g_nums, 0, 99), 0);
    print _bglArray.length(_bglArray.skip(g_nums, 0, -3), 0);
    print _bglArray.length(_bglArray.skip(g_empty, 0, 2), 0);
    print _bglArray.length(_bglArray.takeWhile(g_nums, 0, _bglLambda_0), 0);
    print  (_bglArray.takeWhile(g_nums, 0, _bglLambda_1))-->(2+1) ;
    print _bglArray.length(_bglArray.takeWhile(g_nums, 0, _bglLambda_2), 0);
    print _bglArray.length(_bglArray.takeWhile(g_nums, 0, _bglLambda_3), 0);
    print _bglArray.length(_bglArray.skipWhile(g_nums, 0, _bglLambda_4), 0);
    print  (_bglArray.skipWhile(g_nums, 0, _bglLambda_5))-->(0+1) ;
    print _bglArray.length(_bglArray.skipWhile(g_nums, 0, _bglLambda_6), 0);
    print _bglArray.length(_bglArray.skipWhile(g_nums, 0, _bglLambda_7), 0);
    print _bglArray.length(_bglArray.take(_bglArray.filter(g_nums, 0, _bglLambda_8), 0, 2), 0);
    print  (_bglArray.take(_bglArray.filter(g_nums, 0, _bglLambda_9), 0, 2))-->(1+1) ;
    print _bglArray.length(_bglArray.skip(_bglArray.map(g_nums, 0, _bglLambda_10), 0, 3), 0);
    print  (_bglArray.skip(_bglArray.map(g_nums, 0, _bglLambda_11), 0, 3))-->(0+1) ;
    print _bglArray.length(_bglArray.filter(_bglArray.takeWhile(g_nums, 0, _bglLambda_12), 0, _bglLambda_13), 0);
];
[_bglLambda_0 x;
    return x < 35;
];
[_bglLambda_1 x;
    return x < 35;
];
[_bglLambda_2 x;
    return x > 100;
];
[_bglLambda_3 x;
    return x > 0;
];
[_bglLambda_4 x;
    return x < 35;
];
[_bglLambda_5 x;
    return x < 35;
];
[_bglLambda_6 x;
    return x > 100;
];
[_bglLambda_7 x;
    return x > 0;
];
[_bglLambda_8 x;
    return x >= 20;
];
[_bglLambda_9 x;
    return x >= 20;
];
[_bglLambda_10 x;
    return x + 1;
];
[_bglLambda_11 x;
    return x + 1;
];
[_bglLambda_12 x;
    return x < 40;
];
[_bglLambda_13 y;
    return y>15;
];
object _bglArray
  with rawGet [addr slot;
     return addr-->slot; 
  ],
       get [obj prop n;
    
            if(metaclass(obj)==object) return obj.&prop-->n;
            return obj-->(n+1);
        
  ],
       set [obj prop n v;
    
            if(metaclass(obj)==object){ obj.&prop-->n = v; return; }
            obj-->(n+1) = v;
        
  ],
       isTracked [obj prop hdr;
     if(metaclass(obj)==object) rfalse; 
    hdr = self.rawget(obj,0);
    return self.rawget(obj,hdr)==36996 && self.rawget(obj,hdr-1)>=0;
  ],
       size [obj prop;
     if(metaclass(obj)==object) return obj.#prop/WORDSIZE - 1; 
    if (self.istracked(obj,prop)) {
        return self.rawget(obj,0)-2;
    }
    return self.rawget(obj,0);
  ],
       length [obj prop;
     if(metaclass(obj)==object) return obj.&prop-->(obj.#prop/WORDSIZE - 1); 
    if (self.istracked(obj,prop)) {
        return self.rawget(obj,self.rawget(obj,0)-1);
    }
    return self.rawget(obj,0);
  ],
       setLength [obj prop n cap;
    if (n < 0) {
        print (string)"^[Beguile runtime error: array length exceeds signed range (max 32767 on Z, 2^31-1 on Glulx)]^";
         quit; 
    }
    cap=self.size(obj,prop);
    if (n > cap) {
        n=cap;
    }
     if(metaclass(obj)==object){ obj.&prop-->(obj.#prop/WORDSIZE - 1) = n; return; } 
    if (self.istracked(obj,prop)) {
        self.set(obj, prop, self.size(obj,prop), n);
    }
  ],
       filter [obj prop pred dst cap writeCount srcLen i elem;
    dst = _bgllinqenter(obj);
    cap = 32;
    writeCount = 0;
    srcLen=self.length(obj,prop);
    for (i = 0 : i < srclen : i++) {
        elem = self.get(obj,prop,i);
        if (pred(elem)) {
            if (writecount >= cap) {
                
                        print "^[Beguile runtime error: filter() output exceeds linqScratchSize. Increase via #beguilerSettings.linqScratchSize.]^";
                        quit;
                    
            }
            dst-->(writecount+1) = elem;
             writecount++ ;
        }
    }
    _bglArray.setLength(dst, 0, writeCount);
    _bgllinqleave();
    return dst;
  ],
       first [obj prop;
    if (self.length(obj,prop) == 0) {
        return 0;
    }
    return self.get(obj,prop,0);
  ],
       map [obj prop f dst cap srcLen i;
    dst = _bgllinqenter(obj);
    cap = 32;
    srcLen=self.length(obj,prop);
    if (srclen > cap) {
        
                print "^[Beguile runtime error: map() output exceeds linqScratchSize. Increase via #beguilerSettings.linqScratchSize.]^";
                quit;
            
    }
    for (i = 0 : i < srclen : i++) {
        dst-->(i+1) = f(self.get(obj,prop,i));
    }
    _bglArray.setLength(dst, 0, srcLen);
    _bgllinqleave();
    return dst;
  ],
       take [obj prop n dst cap srcLen outLen i;
    dst = _bgllinqenter(obj);
    cap = 32;
    srcLen=self.length(obj,prop);
    outLen=n;
    if (outlen < 0) {
        outLen = 0;
    }
    if (outlen > srclen) {
        outLen=srcLen;
    }
    if (outlen > cap) {
        
                print "^[Beguile runtime error: take() output exceeds linqScratchSize. Increase via #beguilerSettings.linqScratchSize.]^";
                quit;
            
    }
    for (i = 0 : i < outlen : i++) {
        dst-->(i+1) = self.get(obj,prop,i);
    }
    _bglArray.setLength(dst, 0, outLen);
    _bgllinqleave();
    return dst;
  ],
       skip [obj prop n dst cap srcLen start outLen i;
    dst = _bgllinqenter(obj);
    cap = 32;
    srcLen=self.length(obj,prop);
    start=n;
    if (start < 0) {
        start = 0;
    }
    if (start > srclen) {
        start=srcLen;
    }
    outLen=srclen - start;
    if (outlen > cap) {
        
                print "^[Beguile runtime error: skip() output exceeds linqScratchSize. Increase via #beguilerSettings.linqScratchSize.]^";
                quit;
            
    }
    for (i = 0 : i < outlen : i++) {
        dst-->(i+1) = self.get(obj,prop,start + i);
    }
    _bglArray.setLength(dst, 0, outLen);
    _bgllinqleave();
    return dst;
  ],
       takeWhile [obj prop pred dst cap srcLen outLen i;
    dst = _bgllinqenter(obj);
    cap = 32;
    srcLen=self.length(obj,prop);
    outLen = 0;
    for (i = 0 : i < srclen : i++) {
        if ((~~pred(self.get(obj,prop,i)))) {
            break;
        }
        if (outlen >= cap) {
            
                    print "^[Beguile runtime error: takeWhile() output exceeds linqScratchSize. Increase via #beguilerSettings.linqScratchSize.]^";
                    quit;
                
        }
        dst-->(outlen+1) = self.get(obj,prop,i);
         outlen++ ;
    }
    _bglArray.setLength(dst, 0, outLen);
    _bgllinqleave();
    return dst;
  ],
       skipWhile [obj prop pred dst cap srcLen start outLen i;
    dst = _bgllinqenter(obj);
    cap = 32;
    srcLen=self.length(obj,prop);
    start = 0;
    while (start < srclen && pred(self.get(obj,prop,start))) {
         start++ ;
    }
    outLen=srclen - start;
    if (outlen > cap) {
        
                print "^[Beguile runtime error: skipWhile() output exceeds linqScratchSize. Increase via #beguilerSettings.linqScratchSize.]^";
                quit;
            
    }
    for (i = 0 : i < outlen : i++) {
        dst-->(i+1) = self.get(obj,prop,start + i);
    }
    _bglArray.setLength(dst, 0, outLen);
    _bgllinqleave();
    return dst;
  ]
;
