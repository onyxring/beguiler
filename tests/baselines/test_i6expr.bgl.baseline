!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_Npc
  class object
  with
    seen,
    score[;
        return self.seen;
    ]
;
_bglClass_Npc robot
;
class _bglClass_Counter
  class object
  with
    value
;
_bglClass_Counter globalC
;
[main localC;
    print ((5 * 2) * 2);
    print (40 + 2);
    print _bgl_bglOpCodes_readChar(1);
    @print_char 65;
    print robot.score();
    print (globalc.value + globalc.value);
    print (localc.value + 7);
];
[_bgl_bglOpCodes_readChar dev c;
     @read_char dev -> c; 
    return c;
];
