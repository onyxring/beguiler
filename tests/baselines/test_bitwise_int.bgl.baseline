!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
[main a b xor_ shl shr;
    a = 12;
    b = 10;
    xor_=(a | b) - (a & b);
    shl=_bglShiftLeft(a, 3);
    shr=_bglShiftRight(a, 1);
    a = ((a | 3) - (a & 3));
    a = _bglShiftLeft(a, 1);
    b = _bglShiftRight(b, 1);
    print xor_;
    print shl;
    print shr;
];
[_bglShiftLeft i numBits;
    return i * _bglpow(2,numbits);
];
[_bglShiftRight i numBits;
    return i / _bglpow(2,numbits);
];
[_bglPow i p retval t;
    if (p == 0) {
        return 1;
    }
    retval=i;
    if (p < 0) {
        for (t = 0 : t < (-p) - 1 : t++) {
            retval=retval / i;
        }
        return retval;
    }
    for (t = 0 : t < p - 1 : t++) {
        retval=retval * i;
    }
    return retval;
];
