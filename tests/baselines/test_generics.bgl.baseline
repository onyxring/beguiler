!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
constant _bglWorldBufSize = 128;
global _bglWorldBufIdx = -1;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
    #Ifdef TARGET_GLULX; @setiosys 2 0; #Endif;
];
 Constant NO_ATTRIBUTE 0; 
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_Room
  class object
  with
    visits 0
;
_bglClass_Room kitchen
;
_bglClass_Room hall
;
_bglClass_Room studio
;
array nums table 1 2 3;
array flags table true false true;
array names table "alpha" "beta";
array rooms table kitchen hall studio;
[main i b s r n1 n2;
    i= _bglAt(nums, 0, 0)-->0;
    b= _bglAt(flags, 1, 0)-->0;
    s =  _bglAt(names, 0, 0)-->0;
    r =  _bglAt(rooms, 2, 0)-->0;
    _bglAt(nums, 0, 1)-->0 = 42;
    _bglAt(flags, 1, 1)-->0 = false;
    _bglAt(names, 0, 1)-->0 = "gamma";
    _bglAt(rooms, 0, 1)-->0 = hall;
    n1=nums-->0;
    n2=rooms-->0;
];
[_bglAt arr i w n;
    n = 0;
    
        n = arr-->0;
        #Ifdef _BGL_TRACKED_ARRAYS;
            if(n > 1 && arr-->n == $9084) n = n - 2;
        #Endif;
        if(i >= 0 && i < n) return arr + (i + 1) * WORDSIZE;
        return _bglOutOfRange(i, n, w);
    
];
[_bglOutOfRange i n w;
    
        print "^[Beguile run-time error: array index ", i, " is outside the ", n, " element";
        if(n ~= 1) print "s";
        print " it ";
        if(w) print "can hold"; else print "holds";
        print "; the ";
        if(w) print "write"; else print "read";
        print " is skipped]^";
        _bglSink-->0 = 0;
        return _bglSink;
    
];
array _bglsink --> 1;
