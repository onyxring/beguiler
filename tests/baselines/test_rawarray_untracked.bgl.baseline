!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
Constant _BGL_TRACKED_ARRAYS;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
[_bglArrayCompareAsc lhs rhs;
    
        if(lhs < rhs) return -1;
        if(lhs > rhs) return 1;
        return 0;
    
];
array trk table "a" "b" "c" 3 $9084;
array raw --> "a" "b" "c";
array rs --> 4;
[main;
    print (string) raw-->0 ;
    print (string) trk-->(0+1) ;
    rs-->0 = 7;
    rs-->1 = 8;
];
