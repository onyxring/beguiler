!% -G
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 1000;
#Ifdef beguiler;#Endif;
Constant _BGL_WORLD_BUFSIZE = 128;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
object _glulx
;
object bgl
  with glulx _glulx
;
[_bglArrayCompareAsc lhs rhs;
    
        if(lhs < rhs) return -1;
        if(lhs > rhs) return 1;
        return 0;
    
    return 0;
];
object _bglArray
  with rawGet [addr slot;
     return addr-->slot; 
    return 0;
  ],
       rawSet [addr slot v;
     addr-->slot = v; 
  ],
       get [obj prop n;
    
            if(metaclass(obj)==object) return obj.&prop-->n;
            return obj-->(n+1);
        
    return 0;
  ],
       set [obj prop n v;
    
            if(metaclass(obj)==object){ obj.&prop-->n = v; return; }
            obj-->(n+1) = v;
        
  ],
       copy [dobj dprop sobj sprop n cap i;
    n=self.length(sobj,sprop);
    cap=self.size(dobj,dprop);
    if (n > cap) {
        n = cap;
    }
    for (i = 0 : i < n : i++) {
        self.set(dobj, dprop, i, self.get(sobj,sprop,i));
    }
    self.setlength(dobj, dprop, n);
  ],
       isTracked [obj prop hdr;
     if(metaclass(obj)==object) rfalse; 
    hdr = self.rawget(obj,0);
    return self.rawget(obj,hdr)==36996&&self.rawget(obj,hdr-1)>=0;
  ],
       size [obj prop;
     if(metaclass(obj)==object) return obj.#prop/WORDSIZE; 
    if (self.istracked(obj,prop)) {
        return self.rawget(obj,0)-2;
    }
    return self.rawget(obj,0);
  ],
       length [obj prop;
     if(metaclass(obj)==object) return obj.#prop/WORDSIZE; 
    if (self.istracked(obj,prop)) {
        return self.rawget(obj,self.rawget(obj,0)-1);
    }
    return self.rawget(obj,0);
  ],
       setLength [obj prop n;
     if(metaclass(obj)==object) return; 
    if (self.istracked(obj,prop)) {
        if (n < 0) {
            print (string)"^[Beguile runtime error: setLength value exceeds signed range (max 32767 on Z, 2^31-1 on Glulx)]^";
             quit; 
        }
        self.set(obj, prop, self.size(obj,prop), n);
    }
  ],
       indexOf [obj prop val eq eqProp sz t e;
    sz=self.size(obj,prop);
    for (t = 0 : t < sz : t++) {
        e = self.get(obj,prop,t);
        if (e==val) {
            return t;
        }
        if (eq~=0&&e~=0&&val~=0&&eq(e,val)) {
            return t;
        }
        
                if(eqProp ~= 0 && e ~= 0 && metaclass(e) == Object
                   && e provides eqProp && e.(eqProp)(val)) return t;
            
    }
    return -1;
  ],
       clear [obj prop sz t;
    sz=self.size(obj,prop);
    for (t = 0 : t < sz : t++) {
        self.set(obj, prop, t, 0);
    }
    self.setLength(obj, prop, 0);
  ],
       swap [obj prop pos1 pos2 tmp;
    tmp = self.get(obj,prop,pos1);
    self.set(obj, prop, pos1, self.get(obj,prop,pos2));
    self.set(obj, prop, pos2, tmp);
  ],
       reverse [obj prop len half i;
    len=self.length(obj,prop);
    half=len / 2;
    for (i = 0 : i < half : i++) {
        self.swap(obj, prop, i, len - 1 - i);
    }
  ],
       append [obj prop val len;
    len=self.length(obj,prop);
    if (len >= self.size(obj,prop)) {
        return false;
    }
    self.set(obj, prop, len, val);
    self.setLength(obj, prop, len + 1);
    return true;
  ],
       insert [obj prop pos val len i;
    len=self.length(obj,prop);
    if (len >= self.size(obj,prop)) {
        return false;
    }
    if (pos < 0 || pos > len) {
        return false;
    }
    for (i = len : i > pos : i--) {
        self.set(obj, prop, i, self.get(obj,prop,i - 1));
    }
    self.set(obj, prop, pos, val);
    self.setLength(obj, prop, len + 1);
    return true;
  ],
       prepend [obj prop val;
    return self.insert(obj,prop,0,val);
  ],
       remove [obj prop pos len i;
    len=self.length(obj,prop);
    if (pos < 0 || pos >= len) {
        return;
    }
    for (i = pos : i < len - 1 : i++) {
        self.set(obj, prop, i, self.get(obj,prop,i + 1));
    }
    self.set(obj, prop, len - 1, 0);
    self.setLength(obj, prop, len - 1);
  ],
       removeValue [obj prop val eq eqProp pos len e hit;
    pos = 0;
    len=self.length(obj,prop);
    while (pos < len) {
        e = self.get(obj,prop,pos);
        hit=false;
        if (e==val) {
            hit = true;
        }
        if (~~hit) {
            if (eq~=0&&e~=0&&val~=0&&eq(e,val)) {
                hit = true;
            }
        }
        if (~~hit) {
            
                    if(eqProp ~= 0 && e ~= 0 && metaclass(e) == Object
                       && e provides eqProp && e.(eqProp)(val)) hit = true;
                
        }
        if (hit) {
            self.remove(obj, prop, pos);
            len = self.length(obj,prop);
        }
        else {
             pos++ ;
        }
    }
  ],
       push [obj prop val;
    self.insert(obj, prop, 0, val);
  ],
       pop [obj prop v;
    if (self.length(obj,prop) == 0) {
        return 0;
    }
    v = self.get(obj,prop,0);
    self.remove(obj, prop, 0);
    return v;
  ],
       dequeue [obj prop;
    return self.pop(obj,prop);
  ],
       enqueue [obj prop val;
    self.append(obj, prop, val);
  ],
       peek [obj prop;
    if (self.length(obj,prop) == 0) {
        return 0;
    }
    return self.get(obj,prop,0);
  ],
       peekEnd [obj prop len;
    len=self.length(obj,prop);
    if (len == 0) {
        return 0;
    }
    return self.get(obj,prop,len - 1);
  ],
       popEnd [obj prop len v;
    len=self.length(obj,prop);
    if (len == 0) {
        return 0;
    }
    v = self.get(obj,prop,len - 1);
    self.remove(obj, prop, len - 1);
    return v;
  ],
       sortDefault [obj prop cmp;
    if (cmp==0) {
        self.sort(obj, prop, _bglarraycompareasc);
    }
    else {
        self.sort(obj, prop, cmp);
    }
  ],
       sort [obj prop compare len i key j;
    len=self.length(obj,prop);
    for (i = 1 : i < len : i++) {
        key = self.get(obj,prop,i);
        j=i - 1;
        while (j >= 0 && compare(self.get(obj,prop,j),key) > 0) {
            self.set(obj, prop, j + 1, self.get(obj,prop,j));
             j-- ;
        }
        self.set(obj, prop, j + 1, key);
    }
  ]
;
global _bglWorldBufIdx = -1;
class combatant
  class object
  with
    hp,
    maxHp,
    short_name
;
combatant player
  with short_name "player"
;
combatant goblin
  with short_name "goblin"
;
[setHp c v;
    c.hp = v;
    c.maxhp = v;
];
[applyDamage target damage;
    target.hp = target.hp - damage;
    if (_bglFloatLt(target.hp, _bglFloatNumtof(0))) {
        target.hp = _bglFloatNumtof(0);
    }
];
[healthBar c pct;
    pct = _bglFloatFmul(_bglFloatFdiv(c.hp, c.maxhp), _bglFloatNumtof(100));
    print (string)c.short_name;
    print (string)": ";
    _bglFloatPrintDecimal(c.hp);
    print (string)"/";
    _bglFloatPrintDecimal(c.maxhp);
    print (string)" (";
    _bglFloatPrintDecimal(pct);
    print (string)"%)^";
];
class marker
  class object
  with
    x,
    y
;
marker home;
marker treasure;
[distance a b dx dy;
    dx = _bglFloatFsub(a.x, b.x);
    dy = _bglFloatFsub(a.y, b.y);
    return _bglFloatSqrt(_bglFloatFadd(_bglFloatFmul(dx, dx), _bglFloatFmul(dy, dy)));
];
[roll threshold sample;
    return _bglFloatLe(sample, threshold);
];
class runningavg
  class object
  with
    total,
    count 0
;
runningavg avg;
[addSample a v;
    a.total = _bglFloatFadd(a.total, v);
    a.count++;
];
[mean a;
    if (a.count == 0) {
        return _bglFloatNumtof(0);
    }
    return _bglFloatFdiv(a.total, _bglFloatNumtof(a.count));
];
[main crit d dSquared roundTrip pi4 sinComp cosComp threshold dx modPart;
    sethp(player, _bglFloatNumtof(100));
    sethp(goblin, _bglFloatNumtof(25));
    treasure.x = _bglFloatNumtof(6);
    treasure.y = _bglFloatNumtof(8);
    print (string)"--- combat ---^";
    healthbar(player);
    healthbar(goblin);
    applydamage(goblin, _bglFloatNumtof(8));
    applydamage(goblin, _bglFloatNumtof(3));
    crit = _bglFloatFmul(_bglFloatNumtof(15), _bglFloatNumtof(2));
    applydamage(goblin, crit);
    applydamage(player, _bglFloatFdiv(_bglFloatNumtof(125), _bglFloatNumtof(10)));
    healthbar(player);
    healthbar(goblin);
    print (string)"--- map ---^";
    d = distance(home,treasure);
    print (string)"distance home->treasure: ";
    _bglFloatPrintDecimal(d);
    print (string)"^";
    dSquared = _bglFloatPow(d, _bglFloatNumtof(2));
    print (string)"d^2 = ";
    _bglFloatPrintDecimal(dSquared);
    print (string)"^";
    roundTrip = _bglFloatExp(_bglFloatLog(d));
    print (string)"exp(log(d)) ~ ";
    _bglFloatPrintDecimal(roundTrip);
    print (string)"^";
    pi4 = _bglFloatFdiv(_bglFloatNumtof(3927), _bglFloatNumtof(5000));
    sinComp = _bglFloatSin(pi4);
    cosComp = _bglFloatCos(pi4);
    print (string)"sin(pi/4) ~ ";
    _bglFloatPrintDecimal(sinComp);
    print (string)"^";
    print (string)"cos(pi/4) ~ ";
    _bglFloatPrintDecimal(cosComp);
    print (string)"^";
    print (string)"--- chance ---^";
    threshold = _bglFloatFdiv(_bglFloatNumtof(3), _bglFloatNumtof(10));
    if (roll(threshold,_bglFloatFdiv(_bglFloatNumtof(15), _bglFloatNumtof(100)))) {
        print (string)"0.15 hit^";
    }
    if (roll(threshold,_bglFloatFdiv(_bglFloatNumtof(45), _bglFloatNumtof(100)))) {
        print (string)"0.45 hit^";
    }
    if (roll(threshold,_bglFloatFdiv(_bglFloatNumtof(30), _bglFloatNumtof(100)))) {
        print (string)"0.30 hit^";
    }
    print (string)"--- stats ---^";
    addsample(avg, _bglFloatFdiv(_bglFloatNumtof(15), _bglFloatNumtof(10)));
    addsample(avg, _bglFloatFdiv(_bglFloatNumtof(23), _bglFloatNumtof(10)));
    addsample(avg, _bglFloatFdiv(_bglFloatNumtof(8), _bglFloatNumtof(10)));
    print (string)"turn-cost mean: ";
    _bglFloatPrintDecimal(mean(avg));
    print (string)"^";
    dx = _bglFloatFsub(_bglFloatNumtof(0), _bglFloatNumtof(7));
    print (string)"abs(-7) = ";
    _bglFloatPrintDecimal(_bglFloatAbs(dx));
    print (string)"^";
    modPart = _bglFloatFmod(_bglFloatFdiv(_bglFloatNumtof(17), _bglFloatNumtof(2)), _bglFloatNumtof(3));
    print (string)"8.5 mod 3 = ";
    _bglFloatPrintDecimal(modPart);
    print (string)"^";
    print (string)"ceil(3.2)  = ";
    _bglFloatPrintDecimal(_bglFloatCeil(_bglFloatFdiv(_bglFloatNumtof(32), _bglFloatNumtof(10))));
    print (string)"^";
    print (string)"floor(3.8) = ";
    _bglFloatPrintDecimal(_bglFloatFloor(_bglFloatFdiv(_bglFloatNumtof(38), _bglFloatNumtof(10))));
    print (string)"^";
];
[_bgl_float_valueCompare a b;
    
            if(_bglFloatLt(a, b)) return -1;
            if(_bglFloatGt(a, b)) return 1;
            return 0;
        
    return 0;
];
[_bglFloatAbs v;
    if (_bglfloatlt(v,_bglFloatNumtof(0))) {
        return _bglFloatFsub(_bglFloatNumtof(0), v);
    }
    return v;
];
[_bglFloatCeil v r;
     @ceil v r; 
    return r;
];
[_bglFloatCos v r;
     @cos v r; 
    return r;
];
[_bglFloatExp v r;
     @exp v r; 
    return r;
];
[_bglFloatFadd x y r;
     @fadd x y r; 
    return r;
];
[_bglFloatFdiv x y r;
     @fdiv x y r; 
    return r;
];
[_bglFloatFloor v r;
     @floor v r; 
    return r;
];
[_bglFloatFmod x y r;
     @fmod x y r sp; 
    return r;
];
[_bglFloatFmul x y r;
     @fmul x y r; 
    return r;
];
[_bglFloatFsub x y r;
     @fsub x y r; 
    return r;
];
[_bglFloatGt x y;
     @jfgt x y ?yes; rfalse; .yes; rtrue; 
    return false;
];
[_bglFloatLe x y;
     @jfle x y ?yes; rfalse; .yes; rtrue; 
    return false;
];
[_bglFloatLog v r;
     @log v r; 
    return r;
];
[_bglFloatLt x y;
     @jflt x y ?yes; rfalse; .yes; rtrue; 
    return false;
];
[_bglFloatNumtof n r;
     @numtof n r; 
    return r;
];
[_bglFloatPow a b r;
     @pow a b r; 
    return r;
];
[_bglFloatPrintDecimal v isNeg ipart frac fdigits;
    isNeg=_bglfloatlt(v,_bglFloatNumtof(0));
    if (isNeg) {
        v = _bglFloatFsub(_bglFloatNumtof(0), v);
    }
    ipart=_bglFloatFtonumz(v);
    frac = _bglFloatFsub(v, _bglFloatNumtof(ipart));
    fdigits=_bglFloatFtonumz((_bglFloatFmul(frac, _bglFloatNumtof(10000))));
    if (fdigits < 0) {
        fdigits = -fdigits;
    }
    if (isNeg) {
        print (string)"-";
    }
    print ipart;
    print (string)".";
    if (fdigits < 1000) {
        print (string)"0";
    }
    if (fdigits < 100) {
        print (string)"0";
    }
    if (fdigits < 10) {
        print (string)"0";
    }
    print fdigits;
];
[_bglFloatSin v r;
     @sin v r; 
    return r;
];
[_bglFloatSqrt v r;
     @sqrt v r; 
    return r;
];
[_bglFloatFtonumz f r;
     @ftonumz f r; 
    return r;
];
