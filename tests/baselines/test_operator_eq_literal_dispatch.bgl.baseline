!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bgl_temp0;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_clamped
  with
    _raw 0,
    _opeq[v;
        if (v > 100) { _bgl_temp0 = 100; } else { _bgl_temp0 = v; }
        self._raw = (_bgl_temp0);
    ]
;
class _bglClass_widget
  class object
  with
    value
;
_bglClass_clamped _w_value;
_bglClass_widget w
  with value _w_value
;
[main v;
    w.value._opeq(250);
    v = 999;
    w.value._opeq(v);
];
