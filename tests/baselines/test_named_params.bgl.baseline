!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 1000;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
object _zcode
;
object _bglUtil
;
object bgl
  with zcode _zcode,
       bglUtil _bglutil
;
[greet name times;
    print (string)name;
];
[spawn name x y hostile;
    print (string)name;
];
[main;
    greet("Jim", 3);
    spawn("goblin", 10, 20, true);
];
