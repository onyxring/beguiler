!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
[greet _l_name times;
    print (string)_l_name;
];
[spawn _l_name x y hostile;
    print (string)_l_name;
];
[main;
    greet("Jim", 3);
    spawn("goblin", 10, 20, true);
];
