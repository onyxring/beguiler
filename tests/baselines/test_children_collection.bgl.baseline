!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
object apple
;
object bowl
;
object shelf
;
[main n o _bglfi1;
    move apple to bowl;
    move bowl to shelf;
    n = 0;
    for (o = child(shelf) : o : o = _bglfi1) {
        _bglfi1 = sibling(o);
        n=n + 1;
    }
    print n;
    print children(shelf);
    print children(bowl);
];
