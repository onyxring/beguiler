!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
Constant _BGL_LINQ_SCRATCH_SIZE = 32;
Constant _BGL_TRACKED_ARRAYS;

    ! MAX_DEPTH = number of nesting levels: depth 0 is a top-level chain, depth 1 is a chain
    ! started inside a depth-0 chain lambda, and so on. 2 covers the common one-level nested
    ! case (a chain inside a predicate or mapper); deeper nesting trips the _bglLinqEnter guard.
    ! Each level costs one buffer PAIR (2 x _BGL_LINQ_SCRATCH_SIZE+2 words) of always-reserved
    ! static memory, so the default is kept small (Z5 story-size budget). To allow deeper nesting,
    ! raise the constant AND add matching buffer decls + selector arms + startup stamps.
    Constant _BGL_LINQ_MAXDEPTH = 2;
    Array _bglLinqS0A table _BGL_LINQ_SCRATCH_SIZE + 2;
    Array _bglLinqS0B table _BGL_LINQ_SCRATCH_SIZE + 2;
    Array _bglLinqS1A table _BGL_LINQ_SCRATCH_SIZE + 2;
    Array _bglLinqS1B table _BGL_LINQ_SCRATCH_SIZE + 2;
    Global _bglLinqActiveDepth = 0;

    [ _bglLinqBuf d h ;
        switch(d) {
            0: if(h==0) return _bglLinqS0A; return _bglLinqS0B;
            1: if(h==0) return _bglLinqS1A; return _bglLinqS1B;
        }
    ];

    ! Begin a chain step: return the write-half of the current depth's pair (the
    ! half that ISN'T `src`, so a step reading the previous step's output writes
    ! the other half; a first step whose src is a user array writes half A). Then
    ! bump the depth so a chain started inside this step's lambda nests deeper.
    [ _bglLinqEnter src d a ;
        d = _bglLinqActiveDepth;
        if(d >= _BGL_LINQ_MAXDEPTH){
            print "^[Beguile runtime error: LINQ chain nesting exceeds _BGL_LINQ_MAXDEPTH. Increase the constant in array.bgl.]^";
            quit;
        }
        a = _bglLinqBuf(d, 0);
        _bglLinqActiveDepth = d + 1;
        if(src == a) return _bglLinqBuf(d, 1);
        return a;
    ];

    [ _bglLinqLeave ;
        _bglLinqActiveDepth = _bglLinqActiveDepth - 1;
    ];

global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
    g_empty-->(g_empty-->0) = $9084;

    _bglLinqS0A-->(_bglLinqS0A-->0) = $9084;  _bglLinqS0A-->(_bglLinqS0A-->0 - 1) = 0;
    _bglLinqS0B-->(_bglLinqS0B-->0) = $9084;  _bglLinqS0B-->(_bglLinqS0B-->0 - 1) = 0;
    _bglLinqS1A-->(_bglLinqS1A-->0) = $9084;  _bglLinqS1A-->(_bglLinqS1A-->0 - 1) = 0;
    _bglLinqS1B-->(_bglLinqS1B-->0) = $9084;  _bglLinqS1B-->(_bglLinqS1B-->0 - 1) = 0;

];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
[_bglArrayCompareAsc lhs rhs;
    
        if(lhs < rhs) return -1;
        if(lhs > rhs) return 1;
        return 0;
    
];
array g_dupes table 3 1 4 1 5 9 2 6 5 3 10 $9084;
array g_unsorted table 30 10 50 20 40 5 $9084;
array g_alldup table 7 7 7 7 4 $9084;
array g_empty table 10;
[main;
    bglinit();
    print _bglArray.length(_bglArray.distinct(g_dupes, 0), 0);
    print  (_bglArray.distinct(g_dupes, 0))-->(0+1) ;
    print  (_bglArray.distinct(g_dupes, 0))-->(1+1) ;
    print  (_bglArray.distinct(g_dupes, 0))-->(2+1) ;
    print  (_bglArray.distinct(g_dupes, 0))-->(3+1) ;
    print  (_bglArray.distinct(g_dupes, 0))-->(4+1) ;
    print  (_bglArray.distinct(g_dupes, 0))-->(5+1) ;
    print  (_bglArray.distinct(g_dupes, 0))-->(6+1) ;
    print _bglArray.length(_bglArray.distinct(g_alldup, 0), 0);
    print  (_bglArray.distinct(g_alldup, 0))-->(0+1) ;
    print _bglArray.length(_bglArray.distinct(g_empty, 0), 0);
    print _bglArray.length(_bglArray.orderBy(g_unsorted, 0, 0), 0);
    print  (_bglArray.orderBy(g_unsorted, 0, 0))-->(0+1) ;
    print  (_bglArray.orderBy(g_unsorted, 0, 0))-->(4+1) ;
    print  g_unsorted-->(0+1) ;
    print  g_unsorted-->(1+1) ;
    print  g_unsorted-->(2+1) ;
    print  (_bglArray.orderBy(g_unsorted, 0, _bglLambda_0))-->(0+1) ;
    print  g_unsorted-->(0+1) ;
    print _bglArray.length(_bglArray.orderBy(g_empty, 0, 0), 0);
    print _bglArray.length(_bglArray.orderBy(_bglArray.distinct(_bglArray.filter(g_dupes, 0, _bglLambda_1), 0), 0, 0), 0);
    print  (_bglArray.orderBy(_bglArray.distinct(_bglArray.filter(g_dupes, 0, _bglLambda_2), 0), 0, 0))-->(0+1) ;
    print  (_bglArray.orderBy(_bglArray.distinct(_bglArray.filter(g_dupes, 0, _bglLambda_3), 0), 0, 0))-->(4+1) ;
];
[_bglLambda_0 a b;
    if (a > b) {
        return -1;
    }
    if (a < b) {
        return 1;
    }
    return 0;
];
[_bglLambda_1 x;
    return x > 2;
];
[_bglLambda_2 x;
    return x > 2;
];
[_bglLambda_3 x;
    return x > 2;
];
object _bglArray
  with rawGet [addr slot;
     return addr-->slot; 
  ],
       get [obj prop n;
    
            if(metaclass(obj)==object) return obj.&prop-->n;
            return obj-->(n+1);
        
  ],
       set [obj prop n v;
    
            if(metaclass(obj)==object){ obj.&prop-->n = v; return; }
            obj-->(n+1) = v;
        
  ],
       isTracked [obj prop hdr;
     if(metaclass(obj)==object) rfalse; 
    hdr = self.rawget(obj,0);
    return self.rawget(obj,hdr)==36996 && self.rawget(obj,hdr-1)>=0;
  ],
       size [obj prop;
     if(metaclass(obj)==object) return obj.#prop/WORDSIZE - 1; 
    if (self.istracked(obj,prop)) {
        return self.rawget(obj,0)-2;
    }
    return self.rawget(obj,0);
  ],
       length [obj prop;
     if(metaclass(obj)==object) return obj.&prop-->(obj.#prop/WORDSIZE - 1); 
    if (self.istracked(obj,prop)) {
        return self.rawget(obj,self.rawget(obj,0)-1);
    }
    return self.rawget(obj,0);
  ],
       setLength [obj prop n cap;
    if (n < 0) {
        print (string)"^[Beguile runtime error: array length exceeds signed range (max 32767 on Z, 2^31-1 on Glulx)]^";
         quit; 
    }
    cap=self.size(obj,prop);
    if (n > cap) {
        n=cap;
    }
     if(metaclass(obj)==object){ obj.&prop-->(obj.#prop/WORDSIZE - 1) = n; return; } 
    if (self.istracked(obj,prop)) {
        self.set(obj, prop, self.size(obj,prop), n);
    }
  ],
       sortDefault [obj prop cmp;
    if (cmp==0) {
        self.sort(obj, prop, _bglarraycompareasc);
    }
    else {
        self.sort(obj, prop, cmp);
    }
  ],
       invokeCompare [cmp a b;
    
            if(metaclass(cmp) == Routine) return cmp(a, b);
            if(metaclass(a) == Object && a provides cmp) return a.(cmp)(b);
        
    return 0;
  ],
       sort [obj prop compare len i key j;
    len=self.length(obj,prop);
    for (i = 1 : i < len : i++) {
        key = self.get(obj,prop,i);
        j=i - 1;
        while (j >= 0 && self.invokecompare(compare,self.get(obj,prop,j),key) > 0) {
            self.set(obj, prop, j + 1, self.get(obj,prop,j));
             j-- ;
        }
        self.set(obj, prop, j + 1, key);
    }
  ],
       filter [obj prop pred dst cap writeCount srcLen i elem;
    dst = _bgllinqenter(obj);
    cap = 32;
    writeCount = 0;
    srcLen=self.length(obj,prop);
    for (i = 0 : i < srclen : i++) {
        elem = self.get(obj,prop,i);
        if (pred(elem)) {
            if (writecount >= cap) {
                
                        print "^[Beguile runtime error: filter() output exceeds linqScratchSize. Increase via #beguilerSettings.linqScratchSize.]^";
                        quit;
                    
            }
            dst-->(writecount+1) = elem;
             writecount++ ;
        }
    }
    _bglArray.setLength(dst, 0, writeCount);
    _bgllinqleave();
    return dst;
  ],
       first [obj prop;
    if (self.length(obj,prop) == 0) {
        return 0;
    }
    return self.get(obj,prop,0);
  ],
       distinct [obj prop dst cap srcLen outLen i elem seen j;
    dst = _bgllinqenter(obj);
    cap = 32;
    srcLen=self.length(obj,prop);
    outLen = 0;
    for (i = 0 : i < srclen : i++) {
        elem = self.get(obj,prop,i);
        seen=false;
        for (j = 0 : j < outlen : j++) {
            if ( dst-->(j+1) ==elem) {
                seen=true;
                break;
            }
        }
        if (~~seen) {
            if (outlen >= cap) {
                
                        print "^[Beguile runtime error: distinct() output exceeds linqScratchSize. Increase via #beguilerSettings.linqScratchSize.]^";
                        quit;
                    
            }
            dst-->(outlen+1) = elem;
             outlen++ ;
        }
    }
    _bglArray.setLength(dst, 0, outLen);
    _bgllinqleave();
    return dst;
  ],
       orderBy [obj prop compare dst cap srcLen i;
    dst = _bgllinqenter(obj);
    cap = 32;
    srcLen=self.length(obj,prop);
    if (srclen > cap) {
        
                print "^[Beguile runtime error: orderBy() output exceeds linqScratchSize. Increase via #beguilerSettings.linqScratchSize.]^";
                quit;
            
    }
    for (i = 0 : i < srclen : i++) {
        dst-->(i+1) = self.get(obj,prop,i);
    }
    _bglArray.setLength(dst, 0, srcLen);
    self.sortDefault(dst, 0, compare);
    _bgllinqleave();
    return dst;
  ]
;
