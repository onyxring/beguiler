        print (string)"^";
    }
    cagedAnimals=_bglArray.length(_bglworld.instances(animal, _bglLambda_0), 0);
    print (string)"caged animals (in-walk filter): ";
    print cagedAnimals;
    print (string)"^";
    cageWithoutStones=_bglArray.length(_bglworld.inparent(cage, _bglLambda_1), 0);
    print (string)"cage without stones: ";
    print cageWithoutStones;
    print (string)"^";
    notFish=_bglArray.length(_bglworld.getall(_bglLambda_2), 0);
    print (string)"everything except fish: ";
    print notFish;
    print (string)"^";
    print (string)"nested walk:^";
    _bglfia3 = _bglworld.instances(animal, 0);
    _bglfi4 = 0;
    for (: _bglfi4 < _bglArray.length(_bglfia3, 0) : _bglfi4++) {
        o = _bglfia3-->(_bglfi4+1);
        here=_bglArray.length(_bglworld.inparent(parent(o), 0), 0);
        print (string)" - ";
        print (string)o.short_name;
        print (string)" shares its parent with ";
        print here;
        print (string)" objects^";
    }
];
[_bglLambda_0 o;
    return parent(o) == cage;
];
[_bglLambda_1 o;
    return o ~= stone;
