!% -v5
!% -E1
!% $OMIT_UNUSED_ROUTINES=1
Constant beguiler = 5;
#Ifdef beguiler;#Endif;
global _bglInitDone = 0;
[bglInit;
    if(_bglInitDone) return;
    _bglInitDone = 1;
];
 Constant NO_ATTRIBUTE 0; 
global _bglWorldBufIdx = -1;
constant _bglWorldBufSize = 128;
object _zcode
;
object bgl
  with zcode _zcode
;
class _bglClass_Animal
  class object
  with
    legs 4,
    short_name
;
object cage
  with short_name "cage"
;
_bglClass_Animal dog cage
  with short_name "dog"
;
_bglClass_Animal cat cage
  with short_name "cat"
;
_bglClass_Animal fish
  with short_name "fish"
;
object stone cage
  with short_name "stone"
;
[main totalCount caged animals o _bglfia1 _bglfi2 cagedAnimals cageWithoutStones notFish _bglfia3 _bglfi4 here;
    totalCount=_bglworld.getall(0)-->0;
    print (string)"total objects: ";
    print totalCount;
    print (string)"^";
    caged=_bglworld.inparent(cage, 0)-->0;
    print (string)"in cage: ";
    print caged;
    print (string)"^";
    animals=_bglworld.instances(_bglClass_Animal, 0)-->0;
    print (string)"animals: ";
    print animals;
    print (string)"^";
    print (string)"named animals:^";
    _bglfia1 = _bglworld.instances(_bglClass_Animal, 0);
       _bglfi2 = 0;
       for (: _bglfi2 < _bglfia1-->0 : _bglfi2++) {
          o = _bglfia1-->(_bglfi2+1);
        print (string)" - ";
        print (string)o.short_name;
        print (string)"^";
       }
    cagedAnimals=_bglworld.instances(_bglClass_Animal, _bglLambda_0)-->0;
    print (string)"caged animals (in-walk filter): ";
    print cagedAnimals;
    print (string)"^";
    cageWithoutStones=_bglworld.inparent(cage, _bglLambda_1)-->0;
    print (string)"cage without stones: ";
    print cageWithoutStones;
    print (string)"^";
    notFish=_bglworld.getall(_bglLambda_2)-->0;
    print (string)"everything except fish: ";
    print notFish;
    print (string)"^";
    print (string)"nested walk:^";
    _bglfia3 = _bglworld.instances(_bglClass_Animal, 0);
       _bglfi4 = 0;
       for (: _bglfi4 < _bglfia3-->0 : _bglfi4++) {
          o = _bglfia3-->(_bglfi4+1);
        here=_bglworld.inparent(parent(o), 0)-->0;
        print (string)" - ";
        print (string)o.short_name;
        print (string)" shares its parent with ";
        print here;
        print (string)" objects^";
       }
];
[_bglLambda_0 o;
    return parent(o) == cage;
];
[_bglLambda_1 o;
    return o ~= stone;
];
[_bglLambda_2 o;
    return o ~= fish;
];
object _bglWorld
  with getAll [pred;
    return _bglworldgetall(pred);
  ],
       inParent [p pred;
    return _bglworldinparent(p,pred);
  ],
       instances [cls pred;
    return _bglworldinstances(cls,pred);
  ]
;
[_bglWorldGetAll pred buf o n;
    buf = _bglworldnextbuf();
    n = 0;
    
        objectloop(o) {
            if(n >= _bglWorldBufSize) break;
            if(metaclass(o) == Object && parent(o) ~= 0 && metaclass(parent(o)) == Class) continue;   ! a pool slot not yet in use
            if(pred == 0 || indirect(pred, o)) { n++; buf-->n = o; }
        }
    
    _bglworldstamp(buf, n);
    return buf;
];
[_bglWorldInParent parent pred buf o n;
    buf = _bglworldnextbuf();
    n = 0;
    
        objectloop(o in parent) {
            if(n >= _bglWorldBufSize) break;
            if(pred == 0 || indirect(pred, o)) { n++; buf-->n = o; }
        }
    
    _bglworldstamp(buf, n);
    return buf;
];
[_bglWorldInstances cls pred buf o n;
    buf = _bglworldnextbuf();
    n = 0;
    
        objectloop(o ofclass cls) {
            if(n >= _bglWorldBufSize) break;
            if(metaclass(o) == Object && parent(o) ~= 0 && metaclass(parent(o)) == Class) continue;   ! a pool slot not yet in use
            if(pred == 0 || indirect(pred, o)) { n++; buf-->n = o; }
        }
    
    _bglworldstamp(buf, n);
    return buf;
];
[_bglWorldNextBuf;
    _bglworldbufidx=(_bglworldbufidx + 1) % 4;
    switch (_bglworldbufidx) {
        0:
            return _bglworldbuf0;
        1:
            return _bglworldbuf1;
        2:
            return _bglworldbuf2;
        3:
            return _bglworldbuf3;
    }
    return _bglworldbuf0;
];
[_bglWorldStamp buf count;
    
        #Ifdef _BGL_TRACKED_ARRAYS;
            buf-->(buf-->0)     = $9084;
            buf-->(buf-->0 - 1) = count;
        #Ifnot;
            buf-->0 = count;
        #Endif;
    
];
array _bglworldbuf0 table 128;
array _bglworldbuf1 table 128;
array _bglworldbuf2 table 128;
array _bglworldbuf3 table 128;
