        return 2;
    ]
;
array book table _bglanon4 _bglanon5;
[main v _bgl_tempL0;
    print ( _bglAt(book, 1, 0)-->0 ).pri;
    _bgl_tempL0 = ( _bglAt(book, 0, 0)-->0 ).matcher;
    if(_bgl_tempL0 provides print) _bgl_tempL0.print(); else print (name)_bgl_tempL0;
