            if(n > 1 && arr-->n == $9084) n = n - 2;
        #Endif;
        if(i >= 0 && i < n) return arr + (i + 1) * WORDSIZE;
        return _bglOutOfRange(i, n, w);
    
];
[_bglFloatGt x y;
     @jfgt x y ?yes; rfalse; .yes; rtrue; 
];
[_bglFloatLt x y;
     @jflt x y ?yes; rfalse; .yes; rtrue; 
