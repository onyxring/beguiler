/*  test_ref_stringobj_no_own.bgl — a `ref` local owns nothing.

    Regression test: the local-declaration path used to run the type's init/deinit
    emitters for `ref` locals too. For a type with a lifecycle — `stringObj` owns a pool
    buffer — that meant
      • init  → `_bglStr.new()`, allocating an instance the initializer immediately
                overwrote (a leaked pool slot per declaration), and
      • deinit → `h.free()`, handing the REFERENT back to the pool, so the next
                allocation reused an array element's buffer and the array silently
                began reading another string's text.

    The emitted `aliasOnly` routine must contain NO `_bglStr.new()` and NO `.free()`
    — only the alias assignment. Ordinary (non-ref) locals must still do both.
    (`string` has no lifecycle — it is a primitive, a word pointing at fixed text — so
    `ref string` is not allowed.)  */
#beguilerSettings { target = z5; informName = "none"; outputPath = "tests/output"; }
#include <array>
#include <string>

array<stringObj> shelf[4];

void aliasOnly(){
    ref stringObj h := shelf[0];  // pointer alias — owns nothing
    print(h);
}

void ownsLocals(){
    stringObj a = "one";         // ordinary local — allocates and frees
    stringObj b = "two";
    print(a); print(b);
}

void main(){
    bglInit();
    stringObj kept = "payload";
    shelf.enqueue(kept);
    aliasOnly();
    ownsLocals();
    print(shelf[0]);             // must still be "payload"
}
