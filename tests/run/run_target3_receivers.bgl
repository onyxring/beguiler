// run_target3_receivers — bare `{ ... }` rows in an object's member array of a struct, compound,
// increment and `=` through a nested array element's member, a statement opening with a cast over
// `.parent`, for-in over member arrays reached through casts and elements, an accessor read through an
// element of an object's member array, and member reads on `?:` receivers in a method and a routine.
// EXPECT_OUTPUT: 2 2 2 1 2 5 3 4 9 6 11 11 11 11 7 big 7 20 20 20 20
#beguilerSettings { target = z5; informName = "none"; }
#include <array>
struct Slot {
    inline int kind;
    inline int qty;
    Slot operator = (Slot o) { kind = o.kind; qty = o.qty; return self; }
}
struct Gauge {
    int _v = 0;
    int operator () { return _v; }
    void operator = (int v) { _v = v; }
}
class Bay : object {
    int code;
    int plain;
    int n;
    array<int> counts[4];
    Gauge level;
    Slot best;
    Bay add(int k) { n += k; return self; }
    int twice() { return n * 2; }
    int total() { return code / 10; }
}
Bay b1 { code = 10; }
Bay b2 { code = 20; }
array<Slot> glob = { { 0, 1 }, { 3, 2 } };
object yard {
    array<Slot> spare = { { 0, 1 }, { 3, 2 } };
    array<Bay> bays = { b1, b2 };
}
object tok { parent = b1; }
array<array<Bay>> grid = { { b1, b2 } };
object desk {
    void show() {
        print((b1.total() > b2.total() ? b1 : b2).code); print(" ");
    }
}
void main() {
    bglInit();
    print(glob[1].qty); print(" "); print(yard.spare[1].qty); print(" "); print(yard.spare.length); print(" ");
    grid[0][0].level++;
    grid[0][0].plain += 2;
    print($"{b1.level} {b1.plain} ");
    grid[0][1].level = 5;
    print($"{b2.level} ");
    Slot s = Slot{ 3, 4 };
    grid[0][1].best = s;
    s.qty = 9;
    print($"{b2.best.kind} {b2.best.qty} {s.qty} ");
    ((Bay)tok.parent).add(3);
    print(((Bay)tok.parent).twice()); print(" ");
    b1.counts += 5; b1.counts += 6;
    object o = b1;
    int a = 0; for (int k in ((Bay)o).counts) a += k;
    int b = 0; for (int k in ((Bay)tok.parent).counts) b += k;
    int c = 0; for (int k in yard.bays[0].counts) c += k;
    Bay x = b1;
    int d = 0; for (int k in x.counts) d += k;
    print($"{a} {b} {c} {d} ");
    b1.level = 7;
    print(yard.bays[0].level); print(" ");
    if (yard.bays[0].level > 5) print("big ");
    print(((Bay)yard.bays[0]).level); print(" ");
    desk.show();
    print($"{(b1.total() > b2.total() ? b1 : b2).code} ");
    bool f = false;
    int v = (f ? b1 : b2).code;
    print(v); print(" ");
    print((f ? b1 : b2).code);
}
