// run_stringobj_long_text_glulx — <stringObj>: a literal longer than stringCaptureSize (512) is kept whole when
// the heap has room (printing a literal runs no code, so it may use all of the heap's free room); a capture
// longer than that stops the program with an error naming the setting.
// EXPECT_OUTPUT: lit 700 vwx e=EEEE
// EXPECT_OUTPUT: 701 characters were printed into room for
// EXPECT_OUTPUT: raise the stringCaptureSize setting
#beguilerSettings { target = glulx; informName = "none"; }
#include <string>
#include "glulxConsole.bgl"
stringObj after = "AFTER";
void main(){
    bglInit(); glulxConsole();
    stringObj a = "x";
    stringObj e = "EEEE";
    a = "";
    print($"lit {a.length} {a.right(3)} e={e}^");
    int n = 7;
    stringObj d = $"{n}";
    print($"not reached {d.length} {after}");
}
