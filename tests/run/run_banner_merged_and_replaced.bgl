#beguilerSettings { target = z5; includePaths = "../../../inform6/stdlib"; title = "BANNER TEST"; headline = "\nA test.\n"; }
#include <bindings/i6StandardLibrary>
#includeI6 "parser"
#includeI6 "verblib"
object roomA { short_name = "Room A"; string description = "Room A."; attributes = {light}; }
replace void Banner(){
    replaced();
    printLine("A line of the game's own.");
}
int Initialise(){ location = roomA; return 0; }
#includeI6 "grammar"
