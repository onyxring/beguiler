// run_local_nested_array_empty_row — a local array of arrays may have an empty `{}` row: it still gets
// storage (one slot) and reads as length 0.
// EXPECT_OUTPUT: 3 2 0 3
#beguilerSettings { target = z5; informName = "none"; }
#include <array>
void main(){ bglInit(); array<array<int>> grid = { {1, 2}, {}, {3} }; print($"{grid.length} {grid[0].length} {grid[1].length} {grid[2][0]}"); }
