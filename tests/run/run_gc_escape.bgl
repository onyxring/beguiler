// run_gc_escape — a local array that leaves its routine is not freed at the routine's exit: stored into another
// array's element, appended to one, or bound to a global ref; the routine that runs next can't reuse its words.
// EXPECT_OUTPUT: elem 11 12 | ref 21 | append 41 | kept 3
#beguilerSettings { target = z5; informName = "none"; heapSize = 512; }
#include <array>
array<array<int>> rows[4];
array<array<int>> list[4];
ref array<int> gref;
void storeElem(){ array<int> t[3]; t += 11; t += 12; rows[0] = t; }
void bindRef(){ array<int> t[3]; t += 21; gref := t; }
void appendElem(){ array<int> t[3]; t += 41; list += t; }
void clobber(){ array<int> z[3]; z += 99; z += 98; z += 97; }
void main(){
    bglInit();
    storeElem(); clobber();
    print($"elem {rows[0][0]} {rows[0][1]} | ");
    bindRef(); clobber();
    print($"ref {gref[0]} | ");
    appendElem(); clobber();
    print($"append {list[0][0]} | ");
    bgl.gc.collect();
    int kept = 0;
    if(rows[0][1] == 12) kept++;
    if(gref[0] == 21) kept++;
    if(list[0][0] == 41) kept++;
    print($"kept {kept}");
}
