// run_nested_element_append — `grid[i] -= v` / `grid[i] += v` on an array-of-arrays element remove and
// append on the inner array, as `-=` / `+=` do on an array variable (an inner array's capacity is its
// initializer's length).
// EXPECT_OUTPUT: 1 2 2 7 3
#beguilerSettings { target = z5; informName = "none"; }
#include <array>
array<array<int>> grid = { {1, 2}, {5} };
void main(){
    bglInit();
    int i = 0;
    grid[i] -= 1;
    print($"{grid[0].length} {grid[0][0]} ");
    grid[0] += 7;
    print($"{grid[0].length} {grid[0][1]} ");
    grid[1][0] -= 2;
    print(grid[1][0]);
}
