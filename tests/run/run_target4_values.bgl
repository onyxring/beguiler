// run_target4_values — bare nested `{ ... }` for a value-class member inside an inline value, a table row
// and an object body (beside a value-class method that calls a routine declared below), and reads of
// never-stored slots of an object's member array.
// EXPECT_OUTPUT: 2 3 150 1 0 0 7
#beguilerSettings { target = z5; informName = "none"; }
#include <array>
value class Qty {
    inline int kg;
    Qty operator = (Qty o) { kg = o.kg; return self; }
    bool near(Qty o) { return gap(kg, o.kg) <= 5; }
}
value class Pair { inline Qty a; inline Qty b; Pair operator = (Pair o) { a = o.a; b = o.b; return self; } }
class Bin : object { inline Qty cap; }
array<Pair> ps = { { { 1 }, { 2 } } };
Pair g = Pair{ { 3 }, { 4 } };
Bin binA { { 150 }; }
int gap(int a, int b) { return a > b ? a - b : b - a; }
object depot { array<Qty> moves[4]; }
void main() {
    bglInit();
    print(ps[0].b.kg); print(" "); print(g.a.kg); print(" "); print(binA.cap.kg); print(" ");
    print(binA.cap.near(Qty{ 148 }) ? 1 : 0); print(" ");
    print(depot.moves[1].kg); print(" ");
    print(depot.moves[3].kg); print(" ");
    depot.moves[2].kg = 7;
    print(depot.moves[2].kg);
}
