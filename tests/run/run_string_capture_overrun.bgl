// run_string_capture_overrun — <archive/string>: on the Z-machine a capture longer than a pooled buffer would be
// written past it, so the program stops with an error naming the setting instead.
// EXPECT_OUTPUT: 700 characters were printed into room for 494; raise bglStringDefaultSize
#beguilerSettings { target = z5; informName = "none"; }
#include <archive/string>
void main(){
    bglInit();
    stringObj d = "d";
    stringObj e = "EEEE";
    d = $"";
    print($"not reached {e}");
}
