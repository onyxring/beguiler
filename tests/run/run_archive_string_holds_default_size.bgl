// <archive/string>: a stringObj holds bglStringDefaultSize characters (500 by default); its header is extra.
// Text an operator would put past that is dropped.
// EXPECT_OUTPUT: 500 500 guard done
#beguilerSettings { target = z5; informName = "none"; }
#include <archive/string>
void main() {
    bglInit();
    stringObj g = "guard";
    stringObj s = "";
    for (int i = 0; i < 50; i++) s += "0123456789";
    print($"{s.length} ");
    s += "overflow";
    print($"{s.length} {g} done");
}
