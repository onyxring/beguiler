/*  A class-typed member whose type has an `init` emitter is actually initialised.

    Locals had this from the start; object members and file-scope variables never did.
    `object j { stringObj label = "fish"; }` emitted the packed literal straight into the
    property, so the slot held a text pointer rather than a pooled string: reads printed
    garbage, and every method call dispatched against the OWNER (`j.setFromLit(...)`)
    rather than the member.

    Verified against pre-split builds — `string name = "fish"` failed the same way before
    stringObj existed, so this was never a regression, just a shape nothing tested.

    Emission diffing could not have caught it: `with name "fish"` is perfectly valid I6.  */
// EXPECT_OUTPUT: member: fish
// EXPECT_OUTPUT: member length: 4
// EXPECT_OUTPUT: member assigned: trout
// EXPECT_OUTPUT: member method: TROUT
// EXPECT_OUTPUT: bare member: set
// EXPECT_OUTPUT: global: worldwide
// EXPECT_OUTPUT: local: nearby
// EXPECT_OUTPUT: inherited: a room
// EXPECT_OUTPUT: inherited written: changed
// EXPECT_OUTPUT: sibling untouched: a room
// EXPECT_OUTPUT: instance override: special
// EXPECT_OUTPUT: nested read: hero
// EXPECT_OUTPUT: nested write: villain
// EXPECT_OUTPUT: auto-typed: brave
// EXPECT_OUTPUT: deep read: 4
// EXPECT_OUTPUT: deep write: deep!
// EXPECT_OUTPUT: self-containing ok: n
#beguilerSettings { target = z5; informName = "none"; }
// Every live stringObj takes a pool slot, and a class field costs one PER INSTANCE, so a
// fixture with this many of them needs more than the default 10 (§16.2.4).
#i6 { Constant bglStringPoolReserve 40; }
#include <string>

stringObj g = "worldwide";           // file scope, with initializer

object j {
    stringObj label = "fish";         // object member, with initializer
    stringObj bare;                  // object member, no initializer — still allocated
}

// Declared on a CLASS, not the instance — the common shape, and the one that was missed:
// the class-level default bakes the literal into the I6 Class, so reads looked correct
// while writes failed. Each instance must get its OWN allocation.
class Room { stringObj desc = "a room"; }
object r1 : Room {}
object r2 : Room {}
object r3 : Room { desc = "special"; }        // instance overrides the class default

// A class-typed member that itself holds one needing init. Backing synthesis reaches one
// level for an object member, so the sweep matches that depth: `player.info.title` has an
// instance to initialise, and going deeper would write through a slot that is still 0.
class Inner { stringObj title = "hero"; }
object player { Inner info; }

// The same shape reached through an inline auto-typed object.
object hero { auto card = { stringObj motto = "brave"; } }

// Several levels down. Backings nest as far as the init sweep descends, so the two stop at
// the same place and an init is never emitted for a path whose instance was not created.
class L3 { stringObj tag = "4"; }
class L2 { stringObj tag = "3"; L3 next; }
class L1 { stringObj tag = "2"; L2 next; }
object deep { L1 top; }

// A class holding its own type must not recurse forever in either pass.
class Cycle { stringObj tag = "n"; Cycle child; }
object cyc { Cycle top; }

void main(){
    bglInit();
    print("member: ");          print(j.label);              print("^");
    print("member length: ");   print(j.label.getLength());  print("^");

    j.label = "trout";                                       // operator= into the MEMBER
    print("member assigned: "); print(j.label);              print("^");
    print("member method: ");   print(j.label.toUpper());    print("^");

    // an initializer-less member is still a live instance, not an empty slot
    j.bare = "x";
    print("bare member: ");     print(j.bare ? "set" : "empty"); print("^");

    print("global: ");          print(g);                   print("^");

    stringObj l = "nearby";
    print("local: ");           print(l);                   print("^");

    print("inherited: ");       print(r1.desc);             print("^");
    r1.desc = "changed";
    print("inherited written: "); print(r1.desc);           print("^");
    print("sibling untouched: "); print(r2.desc);           print("^");
    print("instance override: "); print(r3.desc);           print("^");

    print("nested read: ");  print(player.info.title);       print("^");
    player.info.title = "villain";
    print("nested write: "); print(player.info.title);       print("^");
    print("auto-typed: ");   print(hero.card.motto);         print("^");

    print("deep read: ");    print(deep.top.next.next.tag);  print("^");
    deep.top.next.next.tag = "deep!";
    print("deep write: ");   print(deep.top.next.next.tag);  print("^");
    print("self-containing ok: "); print(cyc.top.tag);       print("^");
}
