/*  run_order_forward_method — order-independence for a class METHOD used before its declaration.

    `holder.use()` calls `self.mk({5,6})` where the method `mk` is declared LATER in the same
    object. At the call site `mk` is only a pre-scan stub, so method brace-argument inference must
    consult the param-carrying stub — collectMethodCandidates now falls back to stubs when no real
    method is visible yet. Uses a global object as the receiver so `self` is a real backed instance
    (the point under test is the forward METHOD resolution, not local class-instance backing).
    Runtime-verified. (Object is `holder`, not `box` — `box` is a reserved I6 statement keyword.)  */
// EXPECT_OUTPUT: m=5,6
#beguilerSettings { target = z5; informName = "none"; }

class Pt {
    inline int x = 0;
    inline int y = 0;
    Pt operator = (Pt o){ self.x = o.x; self.y = o.y; return self; }
}

object holder {
    void use(){
        Pt r = self.mk({5, 6});   // forward method call (mk declared below) with a {…} argument
        print("m="); print(r.x); print(","); print(r.y);
    }
    Pt mk(Pt p){ return p; }        // declared AFTER use() above
}

void main(){ holder.use(); }
