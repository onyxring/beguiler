emitter int scale(int v) { ($v * 3) }
int early(int n) { return scale(n); }
replace emitter int scale(int v) { ($v * 5) }
int score(int n) { return n * 2; }
int both(int n) { return score(n) + 1; }
replace int score(int n, int bonus = 0) { return replaced(n) + bonus; }
enum eHint { width = 7, depth }
struct Inner { int width = 3; Inner operator = (Inner o) { width = o.width; return self; } }
struct Outer { Inner part; Outer operator = (Outer o) { part = o.part; return self; } }
struct Dim { int raw = 4; int writes = 0; int operator () { return raw; } void operator = (int v) { raw = v; writes = writes + 1; } }
class Box : object { Dim size; int count() { return self.size.writes; } }
