int TrackOpen() { print("open"); return 1; }
void TrackClose(int id) { print("-close"); }
emitter class Ticket { emitter void init() { $self = TrackOpen(); } emitter void deinit() { TrackClose($self); } }
void viaBreak(int n) {
    switch (n) {
        case 1: { Ticket s; if (n == 1) break; print("unreached"); }
        default: print("default");
    }
}

