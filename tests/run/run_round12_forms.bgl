struct Clamp { int Raw; int operator () { return Raw; } void operator = (int v) { Raw = v > 9 ? 9 : v; } }
class Meter : object {
    Clamp Level;
    array<int> History[4];
    void Push(int v) { Level = v; History += Level; History.append(Level); int c = Level; History += c; }
}
