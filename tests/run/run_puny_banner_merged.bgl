#beguilerSettings { target = z5; includePaths = "../../../inform6/puny/lib"; title = "PUNY BANNER"; headline = "\nA test.\n"; }

const object INITIAL_LOCATION_VALUE = roomA;

#includeI6 "globals"
#includeI6 "puny"
#include <bindings/punyInform>

object roomA { "Room A"; attributes = {light}; }
void Initialise(){ Banner(); }
