// run_target4_chains — casts of `?.` chains, member-array `.length`/`.size`/methods after `?.` steps and
// on parenthesized `??` receivers, an inline accessor reached by `?.`, global arrays named like <linq>
// methods, prefix `++`/`--` through `?.`, a statement opening with `new`, and stringObj member steps after
// `?.`.
// EXPECT_OUTPUT: 5 5 5 9 2 5 1 2 1 0 1 5 4 0 1 4 1 1 1 1 3 5 4 7 blue 3 RED
#beguilerSettings { target = z5; informName = "none"; }
#include <linq>
#include <string>
class Car : object {
    ref Car next;
    int code;
    array<int> loads[4];
    Car after(int n = 1) { Car c = self; while (n > 0 && c != null) { c = c.next; n--; } return c; }
}
class Tank : Car {
    array<int> fuel[2];
    int level = 7;
}
Car carA { code = 1; next = carC; }
Tank carC { code = 3; level = 5; }
object hub {
    array<Car> links[2];
    auto front = {
        int _i = 0;
        Car operator () { return outer.links[_i]; }
        void operator = (Car c) { outer.links[_i] = c; }
    };
}
array<int> all = {1, 2, 3};
array<int> any = {1, 2, 3};
class Cart : object {
    int weight = 1;
    ref Cart next;
    stringObj label;
}
Cart cartA { weight = 2; label = "red"; }
Cart cartB { weight = 5; label = "blue"; }
class Ticket[2] : object {
    int number;
    void create(int n) { number = n; }
    void punch() { print(number + 6); print(" "); }
}
void main() {
    bglInit();
    carC.fuel[0] = 8; carC.fuel[1] = 9;
    print(((Tank)carA?.after())?.level); print(" ");
    print(((Tank)carA?.after()).level); print(" ");
    print(((Tank)carA?.next)?.level); print(" ");
    print(((Tank)carA?.next).fuel[1]); print(" ");
    carC.loads.length = 2;
    carC.loads[1] = 5;
    print(carC.loads.length); print(" "); print(carC.loads[1]); print(" ");
    carA.loads += 5;
    print(carA?.loads.length); print(" ");
    Car c = carA;
    print(c.next?.loads.length); print(" ");
    print(carA.after(0).loads.length); print(" ");
    print(carA?.loads.indexOf(5)); print(" ");
    print(carA?.loads.contains(5) ? 1 : 0); print(" ");
    print(carA?.loads.first()); print(" ");
    print(carA?.loads.size); print(" ");
    print((carA ?? carC).loads.indexOf(5)); print(" ");
    print((carA.after(9) ?? carA).loads.length); print(" ");
    print((carA.next ?? carA).loads.size); print(" ");
    hub.front = carA;
    print(hub.front?.code); print(" ");
    print(hub?.front?.code); print(" ");
    print(hub?.front.code); print(" ");
    print(all.all((int x) => x > 0) ? 1 : 0); print(" ");
    print(any.count()); print(" ");
    cartA.next = cartB;
    ++cartA.weight;
    cartA?.weight++;
    ++cartA?.weight;
    --cartA?.next?.weight;
    print(cartA.weight); print(" "); print(cartB.weight); print(" ");
    new Ticket(1)?.punch();
    print(cartA?.next.label); print(" ");
    print(cartA?.label.length); print(" ");
    print(cartA?.label.toUpper());
}
