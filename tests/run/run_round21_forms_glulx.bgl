/*  run_round21_forms_glulx — round-21 forms on Glulx (D1247, D1248).  */
// EXPECT_OUTPUT: true | r 1 3 r -5 3
#beguilerSettings { target = glulx; informName = "none"; }
#include "glulxConsole.bgl"

// D1247: postfix `?` on a call result.
string label(int n) { if (n == 1) return "one"; return null; }

// D1248: a throw past two nested sends, caught and returned through a send.
object inner { int fail(int v) { if (v > 2) throw v; return v; } }
object middle { int pass(int v) { return inner.fail(v); } }
object sifter {
    int size = 3;
    int sift(int v) { int r = 0; try { r = middle.pass(v); } catch (int e) { r = -e; } return r; }
    void run(int v) { int r = sift(v); print($"r {r} {size}"); }
}

void main() {
    bglInit(); glulxConsole();
    bool b = label(1)?; print(b); print(" | ");
    sifter.run(1); print(" "); sifter.run(5);
    print("^");
}
