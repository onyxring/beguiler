// run_value_class_results_kept — two calls that return a value-class instance from the same routine
// keep their own values within one expression: as an operator's operands and as call arguments.
// EXPECT_OUTPUT: 30 10/20 no
#beguilerSettings { target = z5; informName = "none"; }
value class Vec2 {
    int x;
    Vec2 operator = (Vec2 o){ x = o.x; return self; }
    int operator + (Vec2 o){ return x + o.x; }
    bool operator == (Vec2 o){ return x == o.x; }
}
Vec2 make(int n){ Vec2 v; v.x = n; return v; }
void show(Vec2 a, Vec2 b){ print($"{a.x}/{b.x}"); }
void main(){
    bglInit();
    print(make(10) + make(20));
    print(" ");
    show(make(10), make(20));
    print(" ");
    if (make(1) == make(2)) print("yes"); else print("no");
}
