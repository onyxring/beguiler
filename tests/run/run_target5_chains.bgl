// run_target5_chains — a `for` initializer typed by a bare alias (in the object's body and through
// #using), `?.` statements starting at a #using-imported member, casts of a member read and of `?.`
// chains starting with a `.` step or a call, a `?.` call on a bare member in a namespace object's method,
// a void lambda whose body is a `?.` call, and `.child` of an object named `box`.
// EXPECT_OUTPUT: 3 3 3 6 7 9 2 3 3 y 5 7 7 5 6 4
#beguilerSettings { target = z5; informName = "none"; }
class N : object { ref N next; int v; void bump() { v++; } }
N a { v = 1; }
N b { v = 2; }
object ns {
    alias node for N;
    ref N head;
    int sum() {
        int t = 0;
        for (node s = head; s != null; s = s.next) t += s.v;
        return t;
    }
}
#using ns;
int gsum() {
    int t = 0;
    for (node s = ns.head; s != null; s = s.next) t += s.v;
    return t;
}
class Nd : object { ref Nd next; ref object thing; int v; Nd self2() { return self; } void bump() { v++; } }
object crate { }
Nd n1 { v = 3; parent = crate; }
object box { }
object pin { parent = box; }
Nd p { v = 3; }
Nd q { v = 5; }
Nd r { v = 7; }
object ns2 {
    ref Nd head2;
    void poke() { head2?.next?.bump(); }
}
void main() {
    bglInit();
    a.next = b;
    ns.head = a;
    print(ns.sum()); print(" "); print(gsum()); print(" ");
    a.v = 1; b.v = 2;
    head?.next?.v = 3;
    print(b.v); print(" ");
    head?.next?.v = 6;
    print(b.v); print(" ");
    head?.next?.v += 1;
    print(b.v); print(" ");
    head?.v = 9;
    print(a.v); print(" ");
    a.v = 1; b.v = 2;
    head?.bump();
    head?.next?.bump();
    print(a.v); print(" "); print(b.v); print(" ");
    print(((Nd)crate.child).v); print(" ");
    print(box.child == pin ? "y" : "n"); print(" ");
    p.next = q; q.thing = r; p.thing = q;
    Nd w = (Nd)p?.thing;
    print(w.v); print(" ");
    Nd y = (Nd)p?.next?.thing;
    Nd x = (Nd)p.next?.thing;
    Nd z = (Nd)p.self2()?.thing;
    print(y.v); print(" "); print(x.v); print(" "); print(z.v); print(" ");
    ns2.head2 = p;
    ns2.poke();
    print(q.v); print(" ");
    func<void, Nd> f = (Nd n) => n?.bump();
    f(p);
    f(null);
    print(p.v);
}
