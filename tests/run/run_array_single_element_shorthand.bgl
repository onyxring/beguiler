/*  Single-element array shorthand ("drop the braces when declaring a list of one"):
    `array<T> name = v;` is semantically identical to `array<T> name = {v};`.

    Disambiguation is by the RHS's resolved type — an element-compatible value becomes a
    one-element initializer list; an array/aggregate (or opaque `var`) RHS stays a
    pointer-aliasing init. This test pins the shorthand across int, sized-capacity, byte,
    and object-element arrays, and confirms length/capacity semantics (bare = both size
    and length 1; sized keeps its capacity with length 1 and zeroed tail).  */
// EXPECT_OUTPUT: bare 3 len 1
// EXPECT_OUTPUT: brace 3 len 1
// EXPECT_OUTPUT: obj 9
// EXPECT_OUTPUT: sized 7 len 1 tail 0
// EXPECT_OUTPUT: sized appended 99 len 2
#beguilerSettings { target = z5; informName = "none"; }
#include <array>

class Room : object { int visits = 9; }
Room r1;

array<int>  aBare  = 3;       // == {3}
array<int>  aBrace = {3};      // control
array<Room> aObj   = r1;      // == {r1} (element-compatible object identifier)
array<int>  aSized[5] = 7;    // capacity 5, first slot 7, length 1, tail zeroed

void main(){
    bglInit();
    print("bare ");  print(aBare[0]);  print(" len ");  print(aBare.length());  print("^");
    print("brace "); print(aBrace[0]); print(" len ");  print(aBrace.length()); print("^");
    print("obj ");   print(aObj[0].visits); print("^");
    print("sized "); print(aSized[0]); print(" len "); print(aSized.length());
        print(" tail "); print(aSized[4]); print("^");
    aSized.append(99);
    print("sized appended "); print(aSized[1]); print(" len "); print(aSized.length()); print("^");
}
