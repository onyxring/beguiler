// run_target1_values — a positional section opening with an inline value, a ref argument written back
// after an element's method call, a value copy through a `ref` to a struct member, and an array of values
// that is a struct's member.
// EXPECT_OUTPUT: 2 1 1 3 a<4>| 5 7 6 7 2 1 2
#beguilerSettings { target = z5; informName = "none"; }
#include <array>
#include <string>
struct Pt {
    inline int x;
    inline int y;
    Pt operator = (Pt o) { x = o.x; y = o.y; return self; }
    int far(int a) { return gap(x, a); }
    void into(ref stringObj s) { s += $"<{x}>"; }
}
class Stake : object { inline Pt at; inline int code; }
Stake s1 { Pt{ 2, 1 }, 1, "s1"; }
int gap(int a, int b) { return a > b ? a - b : b - a; }
struct Mark {
    Pt pt;
    int weight;
}
Mark m;
void setPt(ref Pt a, Pt b) { a = b; }
struct Route {
    array<Pt> stops[2];
    Route operator = (Route o) { stops.clear(); for (Pt p in o.stops) stops += p; return self; }
}
Route saved;
void show(ref stringObj s, Route r) {
    for (int i in 0 to r.stops.length - 1) r.stops[i].into(s);
}
void other(ref stringObj row) { row += "|"; }
void main() {
    bglInit();
    print($"{s1.at.x} {s1.at.y} {s1.code} {s1.at.far(5)} ");
    Route r;
    Pt p; p.x = 4;
    r.stops += p;
    stringObj a = "a";
    show(a, r);
    other(a);
    print(a); print(" ");
    m.pt.x = 1; m.weight = 7;
    Pt q; q.x = 5;
    setPt(m.pt, q);
    print($"{m.pt.x} {m.weight} ");
    ref Pt rp := m.pt;
    q.x = 6;
    rp = q;
    print($"{m.pt.x} {m.weight} ");
    Route r2;
    Pt t;
    t.x = 1; r2.stops += t;
    t.x = 2; r2.stops += t;
    saved = r2;
    print($"{saved.stops.length} {saved.stops[0].x} {saved.stops[1].x}");
}
