// In a debug build, text cut short to fit a string prints a run-time warning; the program runs on (§22.3).
// BEGUILER_FLAGS: --debug
// EXPECT_OUTPUT: run-time warning: 50 characters were printed into room for 32, so the text was cut short
// EXPECT_OUTPUT: guard-a done
#beguilerSettings { target = z5; informName = "none"; stringCaptureSize = 32; }
#include <string>
void main() {
    bglInit();
    stringObj a = "guard-a";
    stringObj s;
    int n = 7;
    s = $"0123456789 0123456789 0123456789 0123456789 {n} tail";
    print($"{s.length} [{s}] {a} ");
    s = $"fits {n}";
    print($"[{s}] ");
    s += $"0123456789 0123456789 0123456789 0123456789 {n} tail";
    print($"{s.length} [{s}] {a} done");
}
