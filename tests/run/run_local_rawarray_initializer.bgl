// run_local_rawarray_initializer — a local rawArray<T> with an initializer list holds its values at
// indices 0..N-1, within its N-word allocation.
// EXPECT_OUTPUT: 11 22 33
#beguilerSettings { target = z5; informName = "none"; }
void main(){ rawArray<int> names = { 11, 22, 33 }; print($"{names[0]} {names[1]} {names[2]}"); }
