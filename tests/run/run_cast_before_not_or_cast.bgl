// run_cast_before_not_or_cast — a cast before `!` or another cast converts that whole operand's result:
// `(int)!t` is 0, `(int)(char)65` is 65.
// EXPECT_OUTPUT: 0 0 65 5 65 -5 1 66 1 true 0 66 A
#beguilerSettings { target = z5; informName = "none"; }
void main(){
    bool t = true; int a = 5; char c = 'A';
    print($"{(int)!t} {(int)(!t)} {(int)(char)65} {(int)(char)a} {(int)c} {(int)-a} {(int)t}");
    print($" {(int)(char)65 + 1} {(int)!t + 1} {(int)!t == 0}");
    int v = (int)!t; int w = (int)(char)66; print($" {v} {w}");
    char d = (char)(int)c; print($" {d}");
}
