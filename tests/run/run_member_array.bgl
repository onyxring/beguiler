/*  A member `array<T>` has the same semantics as any other array.

    It used to be a bare I6 property array: no length word, so length() reported
    CAPACITY and the growth operations could not grow it — `append` returned false and
    the write was lost. It now carries its length in a trailing slot, so capacity is
    `obj.#prop/WORDSIZE - 1` and length moves as elements are added and removed.

    The slot is TRAILING so the data keeps 0-based `obj.&prop-->n` indexing; putting it
    first would have shifted every subscript.

    Two element kinds keep the bare layout, because I6 owns them:
      rawArray<T>              the explicit opt-out (see run_rawarray_member)
      array<dictionaryWord>    parser data — the `name` property and its kin, which I6
                               reads word by word, so a trailing length would be matched
                               as a dictionary word

    As with a global array, a subscript write does NOT move the length cursor — it fills
    a slot. Growth is what append/prepend/insert do.  */
// EXPECT_OUTPUT: sized cap 4 len 0
// EXPECT_OUTPUT: appended len 2 -> 30 10
// EXPECT_OUTPUT: sorted 10 30
// EXPECT_OUTPUT: seeded cap 3 len 3
// EXPECT_OUTPUT: popped 1 len 2
// EXPECT_OUTPUT: removed len 1
// EXPECT_OUTPUT: external cap 4 len 1
#beguilerSettings { target = z5; informName = "none"; }
#include <array>

object w {
    array<int> nums[4];              // capacity 4, length 0
    array<int> seeded = {1, 2, 3};   // capacity 3, length 3
    void fill(){ nums += 30; nums += 10; }
    void sortIt(){ nums.sort(); }
    int  len(){ return nums.length(); }
    int  cap(){ return nums.size(); }
    void show(string label){
        print(label); for(int i = 0; i < nums.length(); i++){ print(nums[i]); print(" "); } print("^");
    }
}
object ext { array<int> slots[4]; }

void main(){
    bglInit();
    print("sized cap "); print(w.cap()); print(" len "); print(w.len()); print("^");
    w.fill();
    print("appended len "); print(w.len()); print(" -> ");
    for(int i = 0; i < 2; i++){ print(w.nums[i]); print(" "); } print("^");
    w.sortIt();
    print("sorted "); for(int i = 0; i < 2; i++){ print(w.nums[i]); print(" "); } print("^");

    print("seeded cap "); print(w.seeded.size()); print(" len "); print(w.seeded.length()); print("^");
    print("popped ");     print(w.seeded.pop());  print(" len "); print(w.seeded.length()); print("^");
    w.seeded.removeValue(2);
    print("removed len "); print(w.seeded.length()); print("^");

    // and from outside the object
    ext.slots += 5;
    print("external cap "); print(ext.slots.size()); print(" len "); print(ext.slots.length()); print("^");
}
