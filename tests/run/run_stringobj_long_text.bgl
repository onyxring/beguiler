// run_stringobj_long_text — <stringObj>: a literal longer than stringCaptureSize (512) is kept whole when
// the heap has room (printing a literal runs no code, so it may use all of the heap's free room); a capture
// longer than that is cut short to stringCaptureSize characters, and the program runs on.
// EXPECT_OUTPUT: lit 700 vwx e=EEEE
// EXPECT_OUTPUT: cut 512 AFTER
#beguilerSettings { target = z5; informName = "none"; }
#include <string>
stringObj after = "AFTER";
void main(){
    bglInit();
    stringObj a = "x";
    stringObj e = "EEEE";
    a = "";
    print($"lit {a.length} {a.right(3)} e={e}^");
    int n = 7;
    stringObj d = $"{n}";
    print($"cut {d.length} {after}");
}
