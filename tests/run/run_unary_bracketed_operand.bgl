// run_unary_bracketed_operand — `!( … )` and `-( … )` take everything up to their own `)`: `!(a == b && c == d)`
// once read the `&&` right operand as just `c`.
// EXPECT_OUTPUT: falsetrue truefalsefalse -5 truefalsetrue false
#beguilerSettings { target = z5; informName = "none"; }
bool q1(int a, int b, int c, int d) { return !(a == b && c == d); }
bool q5(int a, int b, int c, int d) { return !(a < b || c < d) && a == 1; }
int q6(int a) { return -(a - 1) * 2 + 1; }
bool q7(bool x, int a) { return !(x) || a > 3; }
void main(){
    print(q1(1,1,2,2)); print(q1(1,2,2,2)); print(" ");
    print(q5(1,0,3,2)); print(q5(2,0,3,2)); print(q5(0,1,3,2)); print(" ");
    print(q6(4)); print(" "); print(q7(true, 5)); print(q7(true, 1)); print(q7(false, 1));
    bool r = !(1 == 1 && 2 == 2); print(" "); print(r);
    if (!(q6(4) == -5 && q1(1,2,3,4))) print(" ok");
}
