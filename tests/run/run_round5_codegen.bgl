/*  run_round5_codegen — a value-class local in a Z-machine try (declared, assigned and printed through
    interpolation, all through a frame slot); a pooled class whose owned value-class member is set from
    a create() parameter named like the member's field; a sized array<char> registered as a tracked
    buf; a literal passed to a stringObj parameter.  */
// EXPECT_OUTPUT: try=5,7,5c pool=3 25 2 110 buf=80,true pad=[Name    ]
#beguilerSettings { target = z5; informName = "none"; }
#include <string>
value class Money {
    int Cents;
    Money operator = (Money o) { Cents = o.Cents; return self; }
    void print() { print($"{Cents}c"); }
}
Money Make(int c) { Money r; r.Cents = c; return r; }
class Order[2] : object {
    int Quantity;
    Money UnitPrice;
    void create(int qty, int cents) { Quantity = qty; UnitPrice.Cents = cents; }
}
array<char> scratch[80];
stringObj padRight(stringObj s, int width) { while (s.length < width) s += ' '; return s; }
void main(){
    bglInit();
    try {
        Money a = Make(5);
        Money b;
        b = Make(7);
        print($"try={a.Cents},{b.Cents},{a}");
    } catch (int e) { print(e); }
    Order first = new Order(3, 25);
    Order second = new Order(2, 110);
    print($" pool={first.Quantity} {first.UnitPrice.Cents} {second.Quantity} {second.UnitPrice.Cents}");
    print($" buf={scratch.size},{scratch.isTracked()}");
    stringObj p = padRight("Name", 8);
    print($" pad=[{p}]^");
}
