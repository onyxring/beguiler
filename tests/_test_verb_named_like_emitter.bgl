/* A program's emitter named like a verb is a name clash. */
// EXPECT_ERROR: verb 'rule' has the same name as emitter 'rule'
#beguilerSettings { target = z5; informName = "none"; outputPath = "tests/output"; }
emitter void rule { print "--^"; }
verb Rule { grammar = {.rule}; void handler(){ } }
void main(){ }
