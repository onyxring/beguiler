! test_inf_mode_raw_object_parent.inf — an object declared in raw I6, read in a #bgl island through a
! member every object has (`parent`, `child`): the read goes through the member's emitter, `parent(x)`.
#bgl{
	#beguilerSettings{ target = z5; informName = "none"; }
}
Object pad "pad";
Object basket "basket";
[ Main;
#bgl{
	if(basket.parent == pad && basket.child == null) print("on the pad");
}
];
