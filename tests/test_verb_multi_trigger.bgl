// test_verb_multi_trigger.bgl — multi-trigger grammar-line syntax via |-alternation in first position.
//
// `{.w1|.w2|.w3, pat...}` declares a grammar line that fires on any of the listed trigger words,
// with one shared pattern. It expands to one grammar line per word, and Beguile emits one pure
// I6 `Verb 'w'` directive per word (a word carried by several lines gets one directive with
// several `*` patterns).
//
// A trigger word owned by ANOTHER native verb does NOT emit `Extend`: the first native verb to
// claim a word owns its `Verb 'w'`, and every later native verb's lines for that word FOLD into
// it (routed to their own action). A fully-Beguile program therefore never leaks I6 `Extend`.
// (`Extend` is reserved for words owned by an extern/library verb — not exercised here.)
//
// Verifies:
//   - Single multi-trigger line → one pure Verb directive per word
//   - Multiple multi-trigger lines with the SAME trigger set → each word's directive carries
//     multiple `*` patterns
//   - Multi-trigger line whose triggers overlap another native verb's word → the overlapping
//     word folds into that verb's Verb directive (no Extend); brand-new words get their own
//   - Multi-trigger contributions inside `extend V { grammar += { ... } }` → fold into the
//     verb's own Verb directive (brand-new words get their own Verb)

#beguilerSettings {
    target = z5;
    informName = "none";
    outputPath = "tests/output";
}

#include <bindings/i6StandardLibrary>

// Single multi-trigger line — emits as one combined Verb directive
verb TypeNum {
    grammar = {
        {.typo|.entrz|.putz, number, .into|.in|.on|.onto, noun},
    };
    void handler(){ print("type num"); }
}

// Two multi-trigger lines sharing the SAME trigger set — consolidated under one directive
verb Toggle {
    grammar = {
        {.flip|.flop, noun},
        {.flip|.flop, noun, .twice},
    };
    void handler(){ print("toggle"); }
}

// A single-trigger verb whose word later appears in a multi-trigger line for another native verb —
// the overlapping word folds into Beep's `Verb 'beep'` directive (Beep declared 'beep' first)
verb Beep {
    grammar = {
        {.beep, noun},
    };
    void handler(){ print("beep"); }
}

verb Chirp {
    grammar = {
        {.chirp|.beep|.tweet, noun},   // 'beep' owned by Beep → folds into its Verb; chirp/tweet are new
    };
    void handler(){ print("chirp"); }
}

// Multi-trigger inside an extend block, all triggers brand new — still emits as one combined
// Verb directive (each new word is a fresh I6 verb mapping to the action; there's nothing to Extend)
verb Squelch {
    grammar = {
        {.squelch, noun},
    };
    void handler(){ print("squelch"); }
}

extend Squelch {
    grammar += {
        {.mash|.squish, noun},
    };
}

// Multi-trigger inside an extend, mixed state — one trigger already exists, two are new.
// The existing trigger (squelch) folds into Squelch's own Verb directive; crush/grind get their own.
extend Squelch {
    grammar += {
        {.squelch|.crush|.grind, noun, .firmly},
    };
}

void main(){}
