/*  test_stringobj_manual_lifecycle.bgl — stringObj slots, automatic lifecycle.

    `stringObj` is a slot that OWNS a pool buffer, as against `string`, a slot holding a
    pointer to static text.

    CONTRACT: stringObj publishes both halves of the lifecycle to generic containers —

        static var  operator = (var cur, var v)   // allocate on first write, copy after
        static void deinit(var s)                 // release

    — which the compiler hands array<T> via $opref(=) and $opref(deinit). Every store
    entry point (subscript, append, prepend, insert) routes through the assign hook, and
    every drop (remove, removeValue, -=, clear, local scope exit) routes through the
    destructor. The developer writes text, not allocations.

    Pins: the owning slot write goes through _bglArray.setOwned with the assign routine's
    address; the drop paths carry the destructor's; and array<int>, which publishes
    neither, keeps core's inline word store with 0 in both channels.  */
#beguilerSettings { target = z5; informName = "none"; outputPath = "tests/output"; }
#include <array>
#include <string>

array<stringObj> slots[10];
array<int>       counts = {3, 1, 2};

void main(){
    bglInit();
    slots[9] = "jim";                         // allocates — no _bglStr.new() needed
    print(slots[9]);
    slots[9] = "replaced";                    // reuses slot 9's buffer
    print(slots[9]);
    print(slots[0]? "allocated" : "empty");   // never written -> empty

    slots += "appended";                      // append allocates too
    slots.prepend("first");
    slots.insert(1, "second");
    slots.remove(0);                          // frees the dropped element
    slots.clear();                            // frees the rest

    counts[0] = 9;                            // plain element type — untouched
    print(counts[0]);
}
