// A write to an operator-hidden accessor must be a compile error (the write op is hidden on vertWin).
// EXPECT_ERROR: is hidden
#beguilerSettings { target = z5; informName = "none"; }
class dim { int val; int operator(){ return val; } void operator =(int n){ val = n; } }
class baseWin[4] : _bglObject { dim width; dim height; }
class vertWin[4] : baseWin { hide height.operator =; }
void main(){ vertWin v = new vertWin(); v.height = 5; }
