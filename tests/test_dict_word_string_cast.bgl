// A string literal cast to dictionaryWord is a dictionary word made at compile time (§1.6.7):
// the way to write a word the dot form can't spell, such as one that starts with a digit.
#beguilerSettings {
    target = z5;
    informName = "none";
    outputPath = "tests/output";
}

#include <bindings/i6StandardLibrary>

emitter class thing {
    rawArray<dictionaryWord> name;
}

thing key101 {
    name = {.key, (dictionaryWord)"101", (dictionaryWord)"7", (dictionaryWord)"o'clock"};
}

void main(){
    dictionaryWord w = (dictionaryWord)"100";
    array<dictionaryWord> ws = {.a, (dictionaryWord)"2nd"};
    if(w == (dictionaryWord)"100") print("same");
}
