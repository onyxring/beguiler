// A verb declared in Beguile must give handler(): `verb` declares it `required`, and its body becomes
// the I6 <verbName>Sub action routine. The `default` body (the I6 routine) is only the fallback for an
// extern verb; a native verb falling back to it would call itself.
// EXPECT_ERROR: must give 'handler', which 'verb' requires.

#beguilerSettings { informName = "none"; }
#include <bindings/i6StandardLibrary>

verb Frob {
    grammar = {.frob, noun};
    // no handler() — should be rejected
}
