/* Negative test: a scalar member bound to an additive property is rejected.

   `name` is an additive property (declared type-less by the core BLR), and an additive property
   is read as a list, so a scalar member can't read it. This is
   the shape that used to fail at run time with I6's "has a property name, but it is longer than 2
   bytes so you cannot use '.' to read it" — a message naming neither the class nor the override. */
// EXPECT_ERROR: is declared 'stringObj', but 'name' is an ADDITIVE property
// EXPECT_ERROR: it holds a list of every class's and object's contributions
#beguilerSettings { target = z5; informName = "none"; outputPath = "tests/output"; }
#include <string>

class Room { stringObj name = "box"; }
object r1 : Room { stringObj name = "wooden"; }

void main(){ bglInit(); }
