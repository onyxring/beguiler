// Negative test: a member's bare name used above the #using that imports it: the error names the cause.
// EXPECT_ERROR: which a #using further down imports
#beguilerSettings { target = z5; informName = "none"; outputPath = "tests/output"; }
object kit { int count = 3; }
int early() { return count + 1; }
#using kit;
void main() { print(early() + count); }
