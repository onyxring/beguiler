/*  The scalar-on-additive WARNING, which applies to a property declared in the untyped form.

    I6 accumulates an additive property, so a class default plus an instance override become a
    multi-word property that `.` can no longer read. `bad1` hits that. The others are the shapes
    that must stay silent: a default with no override, an override with no default, and a
    non-additive property.

    A property declared in the TYPED form (`additive property rawArray<T> p;`) rejects a scalar
    member outright — see _test_additive_scalar_member — so this warning is what remains for the
    untyped form, where nothing says what the property holds.  */
// EXPECT_WARNING: 'bad1.hook' overrides a default on 'Room'
// EXPECT_WARNING: is an ADDITIVE I6 property
#beguilerSettings { target = z5; informName = "none"; outputPath = "tests/output"; }

additive property hook;          // untyped: unchecked, so a scalar member only warns
additive property quietHook;
property plainHook;              // not additive

class Room { int hook = 1; }
object bad1 : Room { int hook = 2; }

class Quiet { int quietHook = 1; }
object okDefaultOnly : Quiet { }

class Bare { int plainHook = 1; }
object okOverride : Bare { int plainHook = 2; }

void main(){ bglInit(); }
