/*  test_stringobj_lazy_array.bgl — stringObj owns its buffer; array<stringObj> is lazy.

    `stringObj` is a slot that OWNS a pool buffer, as against `string`, a slot holding a
    pointer to static text. It publishes `static var operator =`, which array<T> uses to
    write a slot: allocate on first write, copy into the existing buffer thereafter.

    Two things this pins:
      • slots[9] = "jim" on a declared-but-unwritten array allocates ONLY slot 9;
      • array<int> keeps core's inline `-->` word store. The ownership hook must never
        cost a routine call for an element type that does not own storage.  */
#beguilerSettings { target = z5; informName = "none"; outputPath = "tests/output"; }
#include <array>
#include <string>

array<stringObj> slots[10];
array<int>       counts = {3, 1, 2};

void main(){
    bglInit();
    slots[9] = "jim";        // empty slot -> allocate + copy
    slots[9] = "bob";        // owns a buffer -> copy in
    print(slots[9]);
    print(slots[0]? "allocated" : "empty");   // never written -> empty
    counts[0] = 9;                             // must stay an inline word store
    print(counts[0]);
}
