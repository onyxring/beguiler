#once
#if TARGET_ZCODE
    #error "<glulxWindow> is a Glulx extension and is not compatible with the Z-machine. Set `target = Glulx`, or guard the include with `#if TARGET_GLULX`."
#endif
//=============================================================================
// glulxWindow.bgl — the opt-in Glulx window toolkit (#include <glulxWindow>)
// A typed layer over the glk window opcodes: window classes, sized splits and image drawing
//=============================================================================

// Scratch for glk: [0] width, [1] height
array<int> _glkWinSizeBuf[2];
// The pair window made by the split that placed win; its parent may be a newer pair
superposed int _glkSplitPair(int win){
    int pair = bgl.asm.windowGetParent(win);
    while(pair != 0){
        _glkWinSizeBuf[0] = 0;
        bgl.asm.windowGetArrangement(pair, 0, 0, ((int)_glkWinSizeBuf) + bgl.wordsize);
        if(_glkWinSizeBuf[0] == win) return pair;
        pair = bgl.asm.windowGetParent(pair);
    }
    return bgl.asm.windowGetParent(win);
}

// Image drawing needs blorb assets, so it is gated on generateBlorb
#if (generateBlorb == true)
#include <glulxImage>
#endif

// Width/height proxy for window instances; only the axis the split controls is writable
struct _winDim {
    int _id = 0;
    int _axis = 0;   // 0 = width, 1 = height
    int _method = 0;   // The window's split method
    int _size = 0;   // The size last given on the axis the split controls
    int operator() {
        bgl.asm.windowGetSize(_id, ((int)_glkWinSizeBuf) + bgl.wordsize, ((int)_glkWinSizeBuf) + (2 * bgl.wordsize));
        return _glkWinSizeBuf[_axis];
    }
    void operator = (int v){
        // Placement is the low two bits: left 0, right 1, above 2, below 3
        int adjustable = 0;
        if((_method % 4) >= 2) adjustable = 1;
        if(_axis == adjustable){
            bgl.asm.windowSetArrangement(_glkSplitPair(_id), _method, v, _id);
            _size = v;
        }
        else
            bgl.output.log("[glulxWindow] size ignored: this axis is fixed by the sibling window (resize the split axis).");
    }
}

// ---- base window (pooled) and subtypes ----
// Rooted at _bglObject, not object: a window is not a world-tree object
/// A Glk window. Split an existing one to make another (`splitUpGrid`, `splitRightBuffer`, …); the
/// split method's name picks the new window's content type and where it goes.
class window[16] : _bglObject {
    /// The Glk window handle. 0 once the window is closed.
    int id asI6 _bglWin_id = 0;
    int _type = 0;   // Its eGlulxWindowType
    int _bglChildStyles = 0;   // The sheet childStyles refers to, or 0
    int _splitMethod = 0;   // How its split placed it
    int _seq = 0;   // Its opening's number; its rock is _bglWinRockBase plus this
    window _parentWin = null;   // The window it was split from, or null when split from a root
    int _root = 0;   // The root it was split from: 1 the main window, 2 the status bar
    /// The style sheet for windows split from this one; a sheet passed to the split wins.
    typesealed childStylesRef childStyles asI6 _bglWin_childStyles;
    /// The window's width, writable only on the axis its split controls.
    _winDim width asI6 _bglWin_width;
    /// The window's height, on the same terms as `width`.
    _winDim height asI6 _bglWin_height;

    void _bind(int newId, bGlulxWindowMethodFlags method, int size){
        self.id = newId;
        self._splitMethod = (int)method;
        self.width._id  = newId; self.width._axis  = 0; self.width._method  = (int)method;
        self.height._id = newId; self.height._axis = 1; self.height._method = (int)method;
        self.width._size = size; self.height._size = size;
    }
    int _openSize(){
        if((self._splitMethod % 4) >= 2) return self.height._size;
        return self.width._size;
    }
    /// Close this window and return it to the pool.
    void close() asI6 _bglWin_close {
        if(self.id == 0 && _bglWinIndex(self) < 0) return;
        if(self.id != 0) bgl.asm.windowClose(self.id, 0);
        self.id = 0;
        _bglWinForget(self);
        delete self;
    }
    // Open this window again, empty, where its split put it
    void _reopen(){
        int pid = 0;
        if(self._root == 1) pid = bgl.ui.mainWin.id;
        else if(self._root == 2) pid = bgl.ui.statusBar.id;
        else if(self._parentWin != null) pid = self._parentWin.id;
        int size = self._openSize();
        bGlulxWindowMethodFlags method = (bGlulxWindowMethodFlags)self._splitMethod;
        int newId = 0;
        if(pid != 0){
            _bglWinSeq++;
            self._seq = _bglWinSeq;
            int rock = _bglWinRockBase + _bglWinSeq;
            if(self._root == 1)      newId = _glkOpen(pid, (eGlulxWindowType)self._type, method, size, bgl.ui.mainWin.childStyles, _bglNoStyles, rock);
            else if(self._root == 2) newId = _glkOpen(pid, (eGlulxWindowType)self._type, method, size, bgl.ui.statusBar.childStyles, _bglNoStyles, rock);
            else                     newId = _glkOpen(pid, (eGlulxWindowType)self._type, method, size, self._parentWin.childStyles, _bglNoStyles, rock);
        }
        self._bind(newId, method, size);
    }

    // ---- re-arrangement: change an existing window's placement and size ----
    void _rearrange(bGlulxWindowMethodFlags method, int size){
        // A split keeps its axis: up/down stays up/down, left/right stays left/right
        if(((self._splitMethod % 4) >= 2) != (((int)method % 4) >= 2)){
            print("^[** Programming error: a window split across can't move up or down, and one split up or down can't move across **]^");
            return;
        }
        self._splitMethod = (int)method;
        self.width._method  = (int)method;
        self.height._method = (int)method;
        self.width._size = size; self.height._size = size;
        bgl.asm.windowSetArrangement(_glkSplitPair(self.id), method, size, self.id);
    }
    /// Move this window to the top of its parent split and resize it. `size` is lines, or a
    /// percentage when `scale` is `proportional`.
    void moveUp   (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder) asI6 _bglWin_moveUp { self._rearrange(bGlulxWindowPlacement.above | scale | border, size); }
    void moveDown (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder) asI6 _bglWin_moveDown { self._rearrange(bGlulxWindowPlacement.below | scale | border, size); }
    void moveLeft (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder) asI6 _bglWin_moveLeft { self._rearrange(bGlulxWindowPlacement.left  | scale | border, size); }
    void moveRight(int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder) asI6 _bglWin_moveRight { self._rearrange(bGlulxWindowPlacement.right | scale | border, size); }

    // ---- split family: the name picks the content type; Up/Down return …Horz, Left/Right …Vert ----
    /// Split this window and put a new text grid above it, `size` lines tall.
    textGridWindowHorz   splitUpGrid    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglWin_splitUpGrid { return (textGridWindowHorz)_splitFrom(self.id, self, 0, eGlulxWindowType.textGrid, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    textGridWindowHorz   splitDownGrid  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglWin_splitDownGrid { return (textGridWindowHorz)_splitFrom(self.id, self, 0, eGlulxWindowType.textGrid, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    textGridWindowVert   splitLeftGrid  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglWin_splitLeftGrid { return (textGridWindowVert)_splitFrom(self.id, self, 0, eGlulxWindowType.textGrid, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    textGridWindowVert   splitRightGrid (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglWin_splitRightGrid { return (textGridWindowVert)_splitFrom(self.id, self, 0, eGlulxWindowType.textGrid, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
    graphicsWindowHorz   splitUpGraphics    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglWin_splitUpGraphics { return (graphicsWindowHorz)_splitFrom(self.id, self, 0, eGlulxWindowType.graphics, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    graphicsWindowHorz   splitDownGraphics  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglWin_splitDownGraphics { return (graphicsWindowHorz)_splitFrom(self.id, self, 0, eGlulxWindowType.graphics, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    graphicsWindowVert   splitLeftGraphics  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglWin_splitLeftGraphics { return (graphicsWindowVert)_splitFrom(self.id, self, 0, eGlulxWindowType.graphics, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    graphicsWindowVert   splitRightGraphics (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglWin_splitRightGraphics { return (graphicsWindowVert)_splitFrom(self.id, self, 0, eGlulxWindowType.graphics, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
    textBufferWindowHorz splitUpBuffer    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglWin_splitUpBuffer { return (textBufferWindowHorz)_splitFrom(self.id, self, 0, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    textBufferWindowHorz splitDownBuffer  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglWin_splitDownBuffer { return (textBufferWindowHorz)_splitFrom(self.id, self, 0, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    textBufferWindowVert splitLeftBuffer  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglWin_splitLeftBuffer { return (textBufferWindowVert)_splitFrom(self.id, self, 0, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    textBufferWindowVert splitRightBuffer (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglWin_splitRightBuffer { return (textBufferWindowVert)_splitFrom(self.id, self, 0, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
}
/// A window that holds text — the base of the grid and buffer kinds.
class textWindow[8]       : window { }
/// A scrolling text window, where the story's prose goes. Lines wrap and the view scrolls.
class textBufferWindow[8] : textWindow { }
/// A fixed grid of character cells, addressed by column and line. What a status bar is made of.
class textGridWindow[8]   : textWindow {
    /// Put the cursor at a cell. Columns and lines count from 0.
    void moveCursor(int col, int line) asI6 _bglWin_moveCursor { bgl.asm.windowMoveCursor(self.id, col, line); }
}
/// A window you draw images into rather than text.
class graphicsWindow[8]   : window {
    /// Set the background colour and clear the window to it. `color` is 0xRRGGBB.
    void setBackgroundColor(int color) asI6 _bglWin_setBackgroundColor { bgl.asm.windowSetBackgroundColor(self.id, color); bgl.asm.windowClear(self.id); }
}

// ---- Axis-B orientation views: compile-time alias classes that hide the fixed axis ----
alias class textGridWindowHorz   for textGridWindow   { hide width.operator =; hide moveLeft; hide moveRight; }
alias class textGridWindowVert   for textGridWindow   { hide height.operator =; hide moveUp; hide moveDown; }
alias class textBufferWindowHorz for textBufferWindow { hide width.operator =; hide moveLeft; hide moveRight; }
alias class textBufferWindowVert for textBufferWindow { hide height.operator =; hide moveUp; hide moveDown; }
alias class graphicsWindowHorz   for graphicsWindow   { hide width.operator =; hide moveLeft; hide moveRight; }
alias class graphicsWindowVert   for graphicsWindow   { hide height.operator =; hide moveUp; hide moveDown; }

// Split: the parent is a window, or a root (1 the main window, 2 the status bar)
window _splitFrom(int parentId, window parentWin, int root, eGlulxWindowType type, bGlulxWindowMethodFlags method, int size,
                  ref styleSheet inherited = _bglNoStyles, ref styleSheet styles = _bglNoStyles){
    if(parentId == 0) return null;   // Parent not open (e.g. a status bar with no height)
    // Take the pooled object first so a spent pool opens no window
    ref window kid;
    if(type == eGlulxWindowType.graphics)       kid = new graphicsWindow();
    else if(type == eGlulxWindowType.textGrid)  kid = new textGridWindow();
    else                                        kid = new textBufferWindow();
    if(kid == null) return null;
    _bglWinSeq++;
    int id = _glkOpen(parentId, type, method, size, inherited, styles, _bglWinRockBase + _bglWinSeq);
    if(id == 0){ delete kid; return null; }   // Glk refused (e.g. no graphics support)
    kid._bind(id, method, size);
    kid._type = (int)type;
    kid._seq = _bglWinSeq;
    kid._parentWin = parentWin;
    kid._root = root;
    _bglWinRemember(kid);
    return kid;
}
// Open a Glk window:  styles apply to the new window only, inherited first; type-wide hints are restored after
int _glkOpen(int parentId, eGlulxWindowType type, bGlulxWindowMethodFlags method, int size,
             ref styleSheet inherited, ref styleSheet styles, int rock){
    bool styled = type != eGlulxWindowType.graphics;
    bool hasInherited = (int)inherited != 0;
    if(styled && hasInherited) _applySheet((int)type, inherited);
    if(styled) _applySheet((int)type, styles);
    int id = bgl.asm.windowOpen(parentId, type, size, method, rock);
    if(styled) _restoreSheet((int)type, styles);
    if(styled && hasInherited) _restoreSheet((int)type, inherited);
    return id;
}

// ---- recovery after restore, undo and restart ----
// The windows the program has open, in the order it opened them; restore and undo roll this back with the rest of memory
const int _bglWinRockBase = $40000000;   // The status bar's rock (core); a window's is this plus its opening's number
rawArray<window> _bglWinOpen[32];
int _bglWinOpenCount = 0;
int _bglWinSeq = 0;
rawArray<int> _bglWinDoomed[32];   // Glk windows to close, gathered before closing any

int _bglWinIndex(window w){
    for(int i = 0; i < _bglWinOpenCount; i++) if(_bglWinOpen[i] == w) return i;
    return -1;
}
void _bglWinRemember(window w){
    if(_bglWinOpenCount >= 32) return;
    _bglWinOpen[_bglWinOpenCount] = w;
    _bglWinOpenCount++;
}
// Drop a closed window, keeping the order; windows split from it now hang from its parent
void _bglWinForget(window w){
    int at = _bglWinIndex(w);
    if(at < 0) return;
    for(int i = 0; i < _bglWinOpenCount; i++){
        if(_bglWinOpen[i]._parentWin == w){ _bglWinOpen[i]._parentWin = w._parentWin; _bglWinOpen[i]._root = w._root; }
    }
    for(int j = at; j < _bglWinOpenCount - 1; j++) _bglWinOpen[j] = _bglWinOpen[j + 1];
    _bglWinOpenCount--;
}
// True when w is back in its pool
bool _bglWinGone(window w){
    #i6 { if(parent(w) ~= 0 && metaclass(parent(w)) == Class) rtrue; }
    return false;
}
window _bglWinBySeq(int seq){
    for(int i = 0; i < _bglWinOpenCount; i++) if(_bglWinOpen[i]._seq == seq) return _bglWinOpen[i];
    return null;
}
// Keep Glk's windows the program has open, close the ones it doesn't, and open again the ones Glk lost
void _bglWinRecover(){
    int i = 0;
    int n = 0;
    i = 0;
    while(i < _bglWinOpenCount){
        if(_bglWinGone(_bglWinOpen[i])) _bglWinForget(_bglWinOpen[i]);   // deleted without close()
        else { _bglWinOpen[i].id = 0; i++; }
    }
    int g = bgl.asm.windowIterate(0, 0);
    while(g != 0){
        int rock = bgl.asm.windowGetRock(g);
        if(rock > _bglWinRockBase){
            window w = _bglWinBySeq(rock - _bglWinRockBase);
            if(w != null && bgl.asm.windowGetType(g) == w._type) w.id = g;
            else if(n < 32){ _bglWinDoomed[n] = g; n++; }
        }
        g = bgl.asm.windowIterate(g, 0);
    }
    for(i = 0; i < n; i++) bgl.asm.windowClose(_bglWinDoomed[i], 0);
    for(i = 0; i < _bglWinOpenCount; i++){
        window k = _bglWinOpen[i];
        if(k.id != 0) k._bind(k.id, (bGlulxWindowMethodFlags)k._splitMethod, k._openSize());
        else k._reopen();
    }
}
#startup {
    _bglWinRecoverHook = _bglWinRecover;
}

// ---- expose window types under bgl.glulx ----
extend _glulx {
    alias window           for window;
    alias textBufferWindow for textBufferWindow;
    alias textGridWindow   for textGridWindow;
    alias graphicsWindow   for graphicsWindow;
}

// ---- root integration: mainWin and statusBar gain the window API ----
extend _bglMainWindow {
    int _bglChildStyles = 0;   // The sheet childStyles refers to, or 0
    /// The look every window split from the main window gets: the sheet itself, not a copy.
    typesealed childStylesRef childStyles asI6 _bglMainWin_childStyles;
    replace auto width = {
        int _m = 0;
        int operator(){ bgl.asm.windowGetSize(outer.id, ((int)_glkWinSizeBuf)+bgl.wordsize, ((int)_glkWinSizeBuf)+(2*bgl.wordsize)); return _glkWinSizeBuf[0]; }
        void operator=(int v){ bgl.asm.windowSetArrangement(_glkSplitPair(outer.id), _m, v, outer.id); }
    }
    auto height asI6 _bglMainWin_height = {
        int _m = 0;
        int operator(){ bgl.asm.windowGetSize(outer.id, ((int)_glkWinSizeBuf)+bgl.wordsize, ((int)_glkWinSizeBuf)+(2*bgl.wordsize)); return _glkWinSizeBuf[1]; }
        void operator=(int v){ bgl.asm.windowSetArrangement(_glkSplitPair(outer.id), _m, v, outer.id); }
    }
    textGridWindowHorz   splitUpGrid    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglMainWin_splitUpGrid { return (textGridWindowHorz)_splitFrom(self.id, null, 1, eGlulxWindowType.textGrid, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    textGridWindowHorz   splitDownGrid  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglMainWin_splitDownGrid { return (textGridWindowHorz)_splitFrom(self.id, null, 1, eGlulxWindowType.textGrid, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    textGridWindowVert   splitLeftGrid  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglMainWin_splitLeftGrid { return (textGridWindowVert)_splitFrom(self.id, null, 1, eGlulxWindowType.textGrid, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    textGridWindowVert   splitRightGrid (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglMainWin_splitRightGrid { return (textGridWindowVert)_splitFrom(self.id, null, 1, eGlulxWindowType.textGrid, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
    graphicsWindowHorz   splitUpGraphics    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglMainWin_splitUpGraphics { return (graphicsWindowHorz)_splitFrom(self.id, null, 1, eGlulxWindowType.graphics, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    graphicsWindowHorz   splitDownGraphics  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglMainWin_splitDownGraphics { return (graphicsWindowHorz)_splitFrom(self.id, null, 1, eGlulxWindowType.graphics, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    graphicsWindowVert   splitLeftGraphics  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglMainWin_splitLeftGraphics { return (graphicsWindowVert)_splitFrom(self.id, null, 1, eGlulxWindowType.graphics, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    graphicsWindowVert   splitRightGraphics (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglMainWin_splitRightGraphics { return (graphicsWindowVert)_splitFrom(self.id, null, 1, eGlulxWindowType.graphics, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
    textBufferWindowHorz splitUpBuffer    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglMainWin_splitUpBuffer { return (textBufferWindowHorz)_splitFrom(self.id, null, 1, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    textBufferWindowHorz splitDownBuffer  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglMainWin_splitDownBuffer { return (textBufferWindowHorz)_splitFrom(self.id, null, 1, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    textBufferWindowVert splitLeftBuffer  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglMainWin_splitLeftBuffer { return (textBufferWindowVert)_splitFrom(self.id, null, 1, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    textBufferWindowVert splitRightBuffer (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglMainWin_splitRightBuffer { return (textBufferWindowVert)_splitFrom(self.id, null, 1, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
}
// statusBar already has height; add width and the splits
extend _bglStatus {
    int _bglChildStyles = 0;   // The sheet childStyles refers to, or 0
    /// The look every window split from the status bar gets: the sheet itself, not a copy.
    typesealed childStylesRef childStyles asI6 _bglStatus_childStyles;
    replace auto width = {
        int _m = 0;
        int operator(){ bgl.asm.windowGetSize(outer.id, ((int)_glkWinSizeBuf)+bgl.wordsize, ((int)_glkWinSizeBuf)+(2*bgl.wordsize)); return _glkWinSizeBuf[0]; }
        void operator=(int v){ bgl.asm.windowSetArrangement(_glkSplitPair(outer.id), _m, v, outer.id); }
    }
    textGridWindowHorz   splitUpGrid    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglStatus_splitUpGrid { return (textGridWindowHorz)_splitFrom(self.id, null, 2, eGlulxWindowType.textGrid, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    textGridWindowHorz   splitDownGrid  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglStatus_splitDownGrid { return (textGridWindowHorz)_splitFrom(self.id, null, 2, eGlulxWindowType.textGrid, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    textGridWindowVert   splitLeftGrid  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglStatus_splitLeftGrid { return (textGridWindowVert)_splitFrom(self.id, null, 2, eGlulxWindowType.textGrid, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    textGridWindowVert   splitRightGrid (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglStatus_splitRightGrid { return (textGridWindowVert)_splitFrom(self.id, null, 2, eGlulxWindowType.textGrid, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
    graphicsWindowHorz   splitUpGraphics    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglStatus_splitUpGraphics { return (graphicsWindowHorz)_splitFrom(self.id, null, 2, eGlulxWindowType.graphics, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    graphicsWindowHorz   splitDownGraphics  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglStatus_splitDownGraphics { return (graphicsWindowHorz)_splitFrom(self.id, null, 2, eGlulxWindowType.graphics, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    graphicsWindowVert   splitLeftGraphics  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglStatus_splitLeftGraphics { return (graphicsWindowVert)_splitFrom(self.id, null, 2, eGlulxWindowType.graphics, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    graphicsWindowVert   splitRightGraphics (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglStatus_splitRightGraphics { return (graphicsWindowVert)_splitFrom(self.id, null, 2, eGlulxWindowType.graphics, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
    textBufferWindowHorz splitUpBuffer    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglStatus_splitUpBuffer { return (textBufferWindowHorz)_splitFrom(self.id, null, 2, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    textBufferWindowHorz splitDownBuffer  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglStatus_splitDownBuffer { return (textBufferWindowHorz)_splitFrom(self.id, null, 2, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    textBufferWindowVert splitLeftBuffer  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglStatus_splitLeftBuffer { return (textBufferWindowVert)_splitFrom(self.id, null, 2, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    textBufferWindowVert splitRightBuffer (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles) asI6 _bglStatus_splitRightBuffer { return (textBufferWindowVert)_splitFrom(self.id, null, 2, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
}

// ---- Images — blorb only ----
// Width/height 0 means natural size or aspect-preserving fit
#if (generateBlorb == true)
// Shared drawer (avoids same-named local backing collisions); alignOrX is the alignment or x
void _drawScaled(int winId, eImages image, int alignOrX, int y, int width, int height){
    bglSize sz = scaleVectors({width, height}, _bglGetImageInfo((int)image));
    bgl.asm.imageDrawScaled(winId, (int)image, alignOrX, y, sz.width, sz.height);
}
extend class textBufferWindow {
    void drawImage(eImages image, eGlulxImageAlign align = inlineCenter, int width = 0, int height = 0) asI6 _bglWin_drawImage { _drawScaled(self.id, image, (int)align, 0, width, height); }
}
extend class graphicsWindow {
    void drawImage(eImages image, int x = 0, int y = 0, int width = 0, int height = 0) asI6 _bglWin_drawImage { _drawScaled(self.id, image, x, y, width, height); }
}
extend _bglMainWindow {
    void drawImage(eImages image, eGlulxImageAlign align = inlineCenter, int width = 0, int height = 0) asI6 _bglMainWin_drawImage { _drawScaled(self.id, image, (int)align, 0, width, height); }
}
#endif

// ============================ Styles ============================
// Type-wide hints apply to later windows and are recorded per type so a split can restore them

const int styleUnset = $7FFFFFFF;   // Leave the interpreter default

/// A yes/no style setting that can also be left unset.
primitive class styleFlag {
    emitter styleFlag operator = (bool v){ $target = $v; }   /// Turn the setting on or off.
    emitter styleFlag operator = (int v){ $target = $v; }    /// Set it from 1 or 0, or leave it unset with `styleUnset`.
    emitter bool operator == (int v){ $val == $v }           /// True when it holds `v`.
    emitter bool operator != (int v){ $val ~= $v }           /// True when it doesn't hold `v`.
    emitter int  operator () { $val }                        /// Its value: 1, 0 or `styleUnset`.
}

// Justification values; cast to int when set on a style
enum eGlulxJustify { left = 0, full = 1, centered = 2, right = 3 }

// Hint selector for measureStyle; members match the style fields, values are glk hint indices
enum eGlulxStyleHint {
    indentation = 0, paragraphIndentation = 1, justify = 2, sizeAdjustment = 3, fontWeight = 4,
    italics = 5, fixedWidth = 6, foreColor = 7, backColor = 8, reverse = 9
}

// Declarative style bag; unset fields keep the interpreter default
struct style {
    inline int justify asI6 _bglStyle_justify                    = styleUnset;   // An eGlulxJustify value, cast to int
    inline int indentation asI6 _bglStyle_indentation            = styleUnset;
    inline int paragraphIndentation asI6 _bglStyle_paragraphIndentation = styleUnset;
    inline int sizeAdjustment asI6 _bglStyle_sizeAdjustment      = styleUnset;   // Relative to the base size (-1, 0, 1)
    inline int fontWeight asI6 _bglStyle_fontWeight              = styleUnset;   // -1 lighter, 0 normal, 1 bold
    inline styleFlag italics asI6 _bglStyle_italics              = styleUnset;
    inline styleFlag fixedWidth asI6 _bglStyle_fixedWidth        = styleUnset;
    inline int foreColor asI6 _bglStyle_foreColor                = styleUnset;   // 0xRRGGBB
    inline int backColor asI6 _bglStyle_backColor                = styleUnset;   // 0xRRGGBB
    inline styleFlag reverse asI6 _bglStyle_reverse              = styleUnset;
    style operator = (style s){
        self.justify = s.justify;                           self.indentation = s.indentation;
        self.paragraphIndentation = s.paragraphIndentation; self.sizeAdjustment = s.sizeAdjustment;
        self.fontWeight = s.fontWeight;                     self.italics = s.italics;
        self.fixedWidth = s.fixedWidth;                     self.foreColor = s.foreColor;
        self.backColor = s.backColor;                       self.reverse = s.reverse;
        return self;
    }
    /// True when at least one hint is set.
    bool hasHints() asI6 _bglStyle_hasHints {
        return justify != styleUnset || indentation != styleUnset || paragraphIndentation != styleUnset
            || sizeAdjustment != styleUnset || fontWeight != styleUnset || italics != styleUnset
            || fixedWidth != styleUnset || foreColor != styleUnset || backColor != styleUnset || reverse != styleUnset;
    }
}

/// A look for every style type at once. A style left unset leaves that style type alone.
struct styleSheet {
    style normal asI6 _bglSheet_normal;           /// Plain text.
    style emphasized asI6 _bglSheet_emphasized;   /// Emphasized text.
    style fixed asI6 _bglSheet_fixed;             /// Fixed-width text.
    style header asI6 _bglSheet_header;           /// Headers.
    style subheader asI6 _bglSheet_subheader;     /// Subheaders.
    style alert asI6 _bglSheet_alert;             /// Alerts.
    style note asI6 _bglSheet_note;               /// Notes.
    style blockQuote asI6 _bglSheet_blockQuote;   /// Block quotations.
    style input asI6 _bglSheet_input;             /// The player's input.
    style user1 asI6 _bglSheet_user1;             /// A style the game defines.
    style user2 asI6 _bglSheet_user2;             /// A second style the game defines.
    styleSheet operator = (styleSheet s){
        self.normal = s.normal;         self.emphasized = s.emphasized; self.fixed = s.fixed;
        self.header = s.header;         self.subheader = s.subheader;   self.alert = s.alert;
        self.note = s.note;             self.blockQuote = s.blockQuote; self.input = s.input;
        self.user1 = s.user1;           self.user2 = s.user2;
        return self;
    }
}

/// The type of a window's `childStyles`: it refers to a sheet rather than holding a copy.
extern emitter class childStylesRef {
    /// Refer to `v` (null for none).
    emitter childStylesRef operator = (styleSheet v){ $self._bglChildStyles = $v }
    /// The sheet referred to, or null.
    emitter styleSheet operator(){ ($self._bglChildStyles) }
}

styleSheet _bglNoStyles;   // The empty sheet, a split's default
styleSheet _bglBufferLook;   // Type-wide hints for text-buffer windows
styleSheet _bglGridLook;   // Type-wide hints for text-grid windows
style      _bglNoStyle;   // Every hint unset

// Apply a style's set fields via glk_stylehint_set; hint indices are the fixed glk numbers
void _applyStyle(int wintype, eGlulxStyleType st, style s){
    if(s.justify              != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 2, s.justify);
    if(s.indentation          != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 0, s.indentation);
    if(s.paragraphIndentation != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 1, s.paragraphIndentation);
    if(s.sizeAdjustment       != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 3, s.sizeAdjustment);
    if(s.fontWeight           != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 4, s.fontWeight);
    if(s.italics              != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 5, (int)s.italics);
    if(s.fixedWidth           != styleUnset){ int prop = 1; if((int)s.fixedWidth != 0) prop = 0; bgl.asm.stylehintSet(wintype, (int)st, 6, prop); }  // Proportional is the inverse of fixed-pitch
    if(s.foreColor            != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 7, s.foreColor);
    if(s.backColor            != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 8, s.backColor);
    if(s.reverse              != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 9, (int)s.reverse);
}
// Reset a style's hints to the interpreter default
void _clearStyle(int wintype, eGlulxStyleType st){
    int h = 0;
    for(h = 0; h < 10; h++) bgl.asm.stylehintClear(wintype, (int)st, h);
}

// Record into the type-wide sheet
void _recordStyle(int wintype, eGlulxStyleType st, style s){
    if(wintype == (int)eGlulxWindowType.textGrid) _setSheetStyle(_bglGridLook, st, s);
    else                                          _setSheetStyle(_bglBufferLook, st, s);
}
void _setSheetStyle(ref styleSheet sh, eGlulxStyleType st, style s){
    switch(st){
        case eGlulxStyleType.normal:     sh.normal = s;
        case eGlulxStyleType.emphasized: sh.emphasized = s;
        case eGlulxStyleType.fixed:      sh.fixed = s;
        case eGlulxStyleType.header:     sh.header = s;
        case eGlulxStyleType.subheader:  sh.subheader = s;
        case eGlulxStyleType.alert:      sh.alert = s;
        case eGlulxStyleType.note:       sh.note = s;
        case eGlulxStyleType.blockQuote: sh.blockQuote = s;
        case eGlulxStyleType.input:      sh.input = s;
        case eGlulxStyleType.user1:      sh.user1 = s;
        case eGlulxStyleType.user2:      sh.user2 = s;
    }
}
// Set or clear type-wide hints and record them
void _setTypeStyle(int wintype, eGlulxStyleType st, style s){ _applyStyle(wintype, st, s); _recordStyle(wintype, st, s); }
void _clearTypeStyle(int wintype, eGlulxStyleType st){ _clearStyle(wintype, st); _recordStyle(wintype, st, _bglNoStyle); }

// Apply every style a sheet sets
void _applySheet(int wintype, ref styleSheet sh){
    _applyStyle(wintype, eGlulxStyleType.normal, sh.normal);         _applyStyle(wintype, eGlulxStyleType.emphasized, sh.emphasized);
    _applyStyle(wintype, eGlulxStyleType.fixed, sh.fixed);           _applyStyle(wintype, eGlulxStyleType.header, sh.header);
    _applyStyle(wintype, eGlulxStyleType.subheader, sh.subheader);   _applyStyle(wintype, eGlulxStyleType.alert, sh.alert);
    _applyStyle(wintype, eGlulxStyleType.note, sh.note);             _applyStyle(wintype, eGlulxStyleType.blockQuote, sh.blockQuote);
    _applyStyle(wintype, eGlulxStyleType.input, sh.input);           _applyStyle(wintype, eGlulxStyleType.user1, sh.user1);
    _applyStyle(wintype, eGlulxStyleType.user2, sh.user2);
}
// Put a touched style back to the type-wide hints
void _restoreStyle(int wintype, eGlulxStyleType st, style touched, style typeWide){
    if(!touched.hasHints()) return;
    _clearStyle(wintype, st);
    _applyStyle(wintype, st, typeWide);
}
// After a split, restore the hints the sheet touched
void _restoreSheet(int wintype, ref styleSheet sh){
    if(wintype == (int)eGlulxWindowType.textGrid) _restoreSheetFrom(wintype, sh, _bglGridLook);
    else                                          _restoreSheetFrom(wintype, sh, _bglBufferLook);
}
void _restoreSheetFrom(int wintype, ref styleSheet sh, ref styleSheet base){
    _restoreStyle(wintype, eGlulxStyleType.normal, sh.normal, base.normal);
    _restoreStyle(wintype, eGlulxStyleType.emphasized, sh.emphasized, base.emphasized);
    _restoreStyle(wintype, eGlulxStyleType.fixed, sh.fixed, base.fixed);
    _restoreStyle(wintype, eGlulxStyleType.header, sh.header, base.header);
    _restoreStyle(wintype, eGlulxStyleType.subheader, sh.subheader, base.subheader);
    _restoreStyle(wintype, eGlulxStyleType.alert, sh.alert, base.alert);
    _restoreStyle(wintype, eGlulxStyleType.note, sh.note, base.note);
    _restoreStyle(wintype, eGlulxStyleType.blockQuote, sh.blockQuote, base.blockQuote);
    _restoreStyle(wintype, eGlulxStyleType.input, sh.input, base.input);
    _restoreStyle(wintype, eGlulxStyleType.user1, sh.user1, base.user1);
    _restoreStyle(wintype, eGlulxStyleType.user2, sh.user2, base.user2);
}

// Per-type styling on text windows
extend class textBufferWindow {
    void setStyle(eGlulxStyleType type, style s) asI6 _bglWin_setStyle { _setTypeStyle((int)eGlulxWindowType.textBuffer, type, s); }
    void clearStyle(eGlulxStyleType type) asI6 _bglWin_clearStyle { _clearTypeStyle((int)eGlulxWindowType.textBuffer, type); }
}
extend class textGridWindow {
    void setStyle(eGlulxStyleType type, style s) asI6 _bglWin_setStyle { _setTypeStyle((int)eGlulxWindowType.textGrid, type, s); }
    void clearStyle(eGlulxStyleType type) asI6 _bglWin_clearStyle { _clearTypeStyle((int)eGlulxWindowType.textGrid, type); }
}

// bgl.ui.screen: the global style scope, both text window types
superposed _bglObject _bglScreen {
    void setStyle(eGlulxStyleType type, style s) asI6 _bglScreen_setStyle {
        _setTypeStyle((int)eGlulxWindowType.textBuffer, type, s);
        _setTypeStyle((int)eGlulxWindowType.textGrid,   type, s);
    }
    void clearStyle(eGlulxStyleType type) asI6 _bglScreen_clearStyle {
        _clearTypeStyle((int)eGlulxWindowType.textBuffer, type);
        _clearTypeStyle((int)eGlulxWindowType.textGrid,   type);
    }
}
extend _bglUi { alias screen = _bglScreen; }

// Style the root windows
extend _bglMainWindow {
    void setStyle(eGlulxStyleType type, style s) asI6 _bglMainWin_setStyle { _setTypeStyle((int)eGlulxWindowType.textBuffer, type, s); }
    void clearStyle(eGlulxStyleType type) asI6 _bglMainWin_clearStyle { _clearTypeStyle((int)eGlulxWindowType.textBuffer, type); }
}
extend _bglStatus {
    void setStyle(eGlulxStyleType type, style s) asI6 _bglStatus_setStyle { _setTypeStyle((int)eGlulxWindowType.textGrid, type, s); }
    void clearStyle(eGlulxStyleType type) asI6 _bglStatus_clearStyle { _clearTypeStyle((int)eGlulxWindowType.textGrid, type); }
}

// ---- style validation (glk_style_measure) ----
// Query the live window, so call after it exists; interpreters may ignore hints

/// How a style check came out: what the interpreter reported, or that it couldn't report.
enum eStyleCheck {
    unknown = 0,   /// The interpreter can't report the hints the style sets.
    applied,       /// Every reported hint is what the style asks for.
    differs,       /// At least one reported hint is not what the style asks for.
    /// True when the interpreter could report.
    emitter bool known     { ($self ~= 0) }
    /// True when every reported hint matched.
    emitter bool isApplied { ($self == 1) }
    /// True when a reported hint didn't match.
    emitter bool isDiffering { ($self == 2) }
}

// One hint: 0 not reportable, 1 matches want, 2 differs
int _checkHint(int winId, eGlulxStyleType type, int hint, int want){
    if(want == styleUnset) return -1;   // Not asked for
    if(bgl.asm.styleMeasure(winId, (int)type, hint, ((int)_glkWinSizeBuf) + bgl.wordsize) == 0) return 0;
    if(_glkWinSizeBuf[0] == want) return 1;
    return 2;
}

extend class window {
    int measureStyle(eGlulxStyleType type, eGlulxStyleHint hint) asI6 _bglWin_measureStyle {
        int ok = bgl.asm.styleMeasure(self.id, (int)type, (int)hint, ((int)_glkWinSizeBuf) + bgl.wordsize);
        if(ok == 0) return styleUnset;
        if(hint == eGlulxStyleHint.fixedWidth){ if(_glkWinSizeBuf[0] == 0) return 1; return 0; }   // Glk reports Proportional
        return _glkWinSizeBuf[0];
    }
    bool styleHonored(eGlulxStyleType type, eGlulxStyleHint hint) asI6 _bglWin_styleHonored {
        return bgl.asm.styleMeasure(self.id, (int)type, (int)hint, ((int)_glkWinSizeBuf) + bgl.wordsize) != 0;
    }
    /// Whether this window shows style type `type` the way `s` asks.
    eStyleCheck checkStyle(eGlulxStyleType type, style s) asI6 _bglWin_checkStyle {
        int measured = 0; int mismatched = 0; int r = 0;
        int fixedWant = styleUnset;
        if(s.fixedWidth != styleUnset){ fixedWant = 1; if((int)s.fixedWidth != 0) fixedWant = 0; }   // Glk measures Proportional
        r = _checkHint(self.id, type, 2, s.justify);              if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 0, s.indentation);          if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 1, s.paragraphIndentation); if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 3, s.sizeAdjustment);       if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 4, s.fontWeight);           if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 5, (int)s.italics);         if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 6, fixedWant);              if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 7, s.foreColor);            if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 8, s.backColor);            if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 9, (int)s.reverse);         if(r > 0) measured++; if(r == 2) mismatched++;
        if(measured == 0)   return eStyleCheck.unknown;
        if(mismatched > 0)  return eStyleCheck.differs;
        return eStyleCheck.applied;
    }
    /// True when the interpreter shows style types `a` and `b` differently in this window; false when
    /// they look the same or it can't tell.
    bool distinguishes(eGlulxStyleType a, eGlulxStyleType b) asI6 _bglWin_distinguishes {
        return bgl.asm.styleDistinguish(self.id, (int)a, (int)b) != 0;
    }
}

// ============================ Window output ============================
// Print through the ordinary print overloads, switching the stream to this window and back
int _bglOutSaved = 0;   // Stream to return to

extend class textWindow {
    /// Print `v` in this window.
    emitter void print(var v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $i6Expr(::print($v)); $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Print an interpolated string in this window.
    emitter void print(interpolatedStringLiteral v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $v; $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Print `v` in this window, then a newline.
    emitter void printLine(var v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $i6Expr(::print($v)); print "^"; $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Print an interpolated string in this window, then a newline.
    emitter void printLine(interpolatedStringLiteral v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $v; print "^"; $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Print a newline in this window.
    emitter void printLine(){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); print "^"; $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Clear this window.
    void clear() asI6 _bglWin_clear { bgl.asm.windowClear(self.id); }
}
extend _bglMainWindow {
    /// Print `v` in the main window.
    emitter void print(var v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $i6Expr(::print($v)); $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Print an interpolated string in the main window.
    emitter void print(interpolatedStringLiteral v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $v; $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Print `v` in the main window, then a newline.
    emitter void printLine(var v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $i6Expr(::print($v)); print "^"; $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Print an interpolated string in the main window, then a newline.
    emitter void printLine(interpolatedStringLiteral v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $v; print "^"; $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Clear the main window.
    void clear() asI6 _bglMainWin_clear { bgl.asm.windowClear(self.id); }
}
extend _bglStatus {
    /// Print `v` in the status bar, at the cursor.
    emitter void print(var v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $i6Expr(::print($v)); $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Print an interpolated string in the status bar, at the cursor.
    emitter void print(interpolatedStringLiteral v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $v; $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Clear the status bar.
    void clear() asI6 _bglStatus_clear { bgl.asm.windowClear(self.id); }
}

// ============================ Capabilities ============================
/// How well the interpreter can show a character.
enum eCharOutput {
    none = 0,          /// It can't show it.
    approximate = 1,   /// It shows something close.
    exact = 2          /// It shows it exactly.
}

/// What the interpreter can do.
emitter class _bglSupports {
    emitter int  version              { ($i6Expr(bgl.asm.gestalt(0, 0))) }          /// The Glk version, as 0xMMmmrr.
    emitter bool timer                { ($i6Expr(bgl.asm.gestalt(5, 0)) ~= 0) }     /// Timed events.
    emitter bool graphics             { ($i6Expr(bgl.asm.gestalt(6, 0)) ~= 0) }     /// Images and graphics windows.
    emitter bool graphicsTransparency { ($i6Expr(bgl.asm.gestalt(14, 0)) ~= 0) }    /// Images with transparency.
    emitter bool sound                { ($i6Expr(bgl.asm.gestalt(8, 0)) ~= 0) }     /// Sound.
    emitter bool soundMusic           { ($i6Expr(bgl.asm.gestalt(13, 0)) ~= 0) }    /// Music formats (MOD and the like).
    emitter bool soundVolume          { ($i6Expr(bgl.asm.gestalt(9, 0)) ~= 0) }     /// Setting the volume.
    emitter bool soundNotify          { ($i6Expr(bgl.asm.gestalt(10, 0)) ~= 0) }    /// Notice when a sound ends.
    emitter bool hyperlinks           { ($i6Expr(bgl.asm.gestalt(11, 0)) ~= 0) }    /// Hyperlinks.
    emitter bool unicode              { ($i6Expr(bgl.asm.gestalt(15, 0)) ~= 0) }    /// Unicode text.
    emitter bool dateTime             { ($i6Expr(bgl.asm.gestalt(20, 0)) ~= 0) }    /// The date and time.
    emitter bool lineTerminators      { ($i6Expr(bgl.asm.gestalt(18, 0)) ~= 0) }    /// Keys other than Return ending line input.
    emitter bool resourceStream       { ($i6Expr(bgl.asm.gestalt(22, 0)) ~= 0) }    /// Reading data files from the blorb.
    /// How well it can show `c`.
    emitter eCharOutput charOutput(char c){ ($i6Expr(bgl.asm.gestalt(3, (int)$c))) }
    /// True when the player can type `c` at a key prompt.
    emitter bool charInput(char c){ ($i6Expr(bgl.asm.gestalt(1, (int)$c)) ~= 0) }
    /// True when windows of type `t` can show images.
    emitter bool images(eGlulxWindowType t){ ($i6Expr(bgl.asm.gestalt(7, (int)$t)) ~= 0) }
    /// True when windows of type `t` take mouse input.
    emitter bool mouse(eGlulxWindowType t){ ($i6Expr(bgl.asm.gestalt(4, (int)$t)) ~= 0) }
    /// True when windows of type `t` take hyperlink clicks.
    emitter bool hyperlinkInput(eGlulxWindowType t){ ($i6Expr(bgl.asm.gestalt(12, (int)$t)) ~= 0) }
}
extend _glulx { alias supports for _bglSupports; }

/// What the interpreter can do in one kind of window.
primitive class windowSupport {
    emitter bool images     { ($i6Expr(bgl.asm.gestalt(7, (int)$self)) ~= 0) }    /// It can show images.
    emitter bool mouse      { ($i6Expr(bgl.asm.gestalt(4, (int)$self)) ~= 0) }    /// It takes mouse input.
    emitter bool hyperlinks { ($i6Expr(bgl.asm.gestalt(12, (int)$self)) ~= 0) }   /// It takes hyperlink clicks.
}
extend class window {
    /// What the interpreter can do in this window.
    emitter windowSupport supports { ($self._type) }
}
extend _bglMainWindow {
    /// What the interpreter can do in the main window.
    emitter windowSupport supports { (3) }
}
extend _bglStatus {
    /// What the interpreter can do in the status bar.
    emitter windowSupport supports { (4) }
}

// ============================ Colors ============================
// Colors as 0xRRGGBB ints; color.rgb(r,g,b) composes one from 0-255 channels
superposed _bglObject _bglColor {
    int rgb(int r, int g, int b) asI6 _bglColor_rgb { return (r * 65536) + (g * 256) + b; }

    emitter int black     { $000000 }
    emitter int white     { $ffffff }
    emitter int red       { $ff0000 }
    emitter int green     { $00ff00 }
    emitter int blue      { $0000ff }
    emitter int yellow    { $ffff00 }
    emitter int cyan      { $00ffff }
    emitter int magenta   { $ff00ff }
    emitter int gray      { $808080 }
    emitter int lightGray { $c0c0c0 }
    emitter int darkGray  { $404040 }
}
extend _glulx { alias color = _bglColor; }
