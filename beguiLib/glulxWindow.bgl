#once
#if TARGET_ZCODE
    #error "<glulxWindow> is a Glulx extension and is not compatible with the Z-machine. Set `target = Glulx`, or guard the include with `#if TARGET_GLULX`."
#endif
//=============================================================================
// glulxWindow.bgl — the opt-in Glulx window toolkit (`#include <glulxWindow>`).
//
// A typed veneer over the raw glk window opcodes (already bound as bgl.asm.* in
// core/_glulxOpCodes.bgl). Provides a window class hierarchy with compile-time
// subtype safety (§7.6 Axis A), active-property sizing `.width`/`.height` (§4.2),
// directional typed splits (§4.7), and image drawing. The core roots
// bgl.ui.mainWin / bgl.ui.statusBar are the SAME objects, enriched here (§7.4).
//
// PURE BLR — zero compiler work (⛔ diktat 2026-09-17). Design notes:
//  • Child windows are pooled `window`-class instances (reference semantics;
//    `new` needs a sized pool per concrete subtype).
//  • `.width`/`.height` on child instances use the `_winDim` value-helper proxy,
//    which carries its OWN copy of the window id — because accessor `outer` is
//    object-singleton-only today (tracked compiler ticket
//    project_ticket_outer_on_class_instance_accessors). The root OBJECTS below
//    DO use `outer.id`.
//  • The split family is declared on `window` (inherited by subtypes) AND on the
//    root objects; the bodies are identical (`self.id`). That duplication is
//    inherent until Beguile grows a mixin/trait — noted, not a workaround.
//
// Design doc: SilverBullet IF/Beguile/glulx-window-extension-design.md
//=============================================================================

// Two-word scratch: glk writes [0]=width, [1]=height.
array<int> _glkWinSizeBuf[2];

// Image drawing reuses core's aspect-preserving `scaleVectors` (in _glulxCore, #if generateBlorb) and
// `_bglGetImageInfo` (in <glulxImage>). Both are blorb-only — you can't draw images without blorb
// assets — so the drawImage methods below are gated `#if generateBlorb` to match. Pull in glulxImage
// for `_bglGetImageInfo`; scaleVectors auto-loads with the platform core under the same gate.
#if (generateBlorb == true)
#include <glulxImage>
#endif

// Read+write dimension proxy for child window INSTANCES. Reading queries the live window
// (glk_window_get_size). Writing is validated at RUNTIME (§7.6 Axis-B): only the axis the window was
// split along is resizable — Left/Right → width, Above/Below → height — because the cross axis is
// dictated by the sibling window. A write to the cross axis is a no-op (with a debug-only diagnostic),
// rather than a compile error, keeping the uniform `.width`/`.height` API on all window types.
value class _winDim {
    int _id = 0;
    int _axis = 0;      // 0 = width, 1 = height
    int _method = 0;    // the owning window's split method (placement|scale|border)
    int operator() {
        bgl.asm.windowGetSize(_id, ((int)_glkWinSizeBuf) + bgl.wordsize, ((int)_glkWinSizeBuf) + (2 * bgl.wordsize));
        return _glkWinSizeBuf[_axis];
    }
    void operator = (int v){
        // glk placement is the low bits of the method (left=0, right=1, above=2, below=3), so the
        // adjustable axis is width (0) for left/right and height (1) for above/below.
        int adjustable = 0;
        if((_method % 4) >= 2) adjustable = 1;
        if(_axis == adjustable)
            bgl.asm.windowSetArrangement(bgl.asm.windowGetParent(_id), _method, v, _id);
        else
            log("[glulxWindow] size ignored: this axis is fixed by the sibling window (resize the split axis).");
    }
}

// ---- base window (pooled) + Axis-A subtypes ----
// Rooted at `_bglObject`, NOT `object`: a window is a UI entity, not an IF world-tree citizen — it
// has no `parent`/`children`/attributes and isn't `remove`-able from the object tree.
/// A Glk window. Split an existing one to make another (`splitUpGrid`, `splitRightBuffer`, …); the
/// split method's name picks the new window's content type and where it goes.
class window[16] : _bglObject {
    /// The Glk window handle. 0 once the window is closed.
    int id = 0;
    int _type = 0;   // its eGlulxWindowType, for `supports`
    int _bglChildStyles = 0;   // the sheet `childStyles` refers to, or 0
    /// The look every window split from this one gets: the sheet itself, not a copy. A sheet passed to
    /// the split wins over it. Set it to null for none.
    typesealed childStylesRef childStyles;
    /// The window's width. Writable only on the axis its split controls; a write to the other is
    /// ignored at run time.
    _winDim width;      // read/write; a write to the non-adjustable axis is a runtime no-op (see _winDim)
    /// The window's height, on the same terms as `width`.
    _winDim height;

    void _bind(int newId, bGlulxWindowMethodFlags method = noBorder){
        self.id = newId;
        self.width._id  = newId; self.width._axis  = 0; self.width._method  = (int)method;
        self.height._id = newId; self.height._axis = 1; self.height._method = (int)method;
    }
    // Close this window (glk closes its subtree). self.id guards double-close.
    /// Close this window and everything split from it. Safe to call twice.
    void close(){ if(self.id != 0){ bgl.asm.windowClose(self.id, 0); self.id = 0; } }

    // ---- re-arrangement: change an EXISTING window's placement/size within its parent pair ----
    // Re-runs glk_window_set_arrangement on the parent and updates the stored split method on both
    // proxies, so which axis is subsequently writable follows the new placement.
    void _rearrange(bGlulxWindowMethodFlags method, int size){
        self.width._method  = (int)method;
        self.height._method = (int)method;
        bgl.asm.windowSetArrangement(bgl.asm.windowGetParent(self.id), method, size, self.id);
    }
    /// Move this window to the top of its parent split and resize it. `size` is lines, or a
    /// percentage when `scale` is `proportional`.
    void moveUp   (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder){ self._rearrange(bGlulxWindowPlacement.above | scale | border, size); }
    void moveDown (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder){ self._rearrange(bGlulxWindowPlacement.below | scale | border, size); }
    void moveLeft (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder){ self._rearrange(bGlulxWindowPlacement.left  | scale | border, size); }
    void moveRight(int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder){ self._rearrange(bGlulxWindowPlacement.right | scale | border, size); }

    // ---- split family: content type in the name → typed return; direction → placement + orientation.
    // Up/Down (horizontal divider) → the child owns its HEIGHT → a `…Horz` subtype (width write hidden).
    // Left/Right (vertical divider) → owns its WIDTH → a `…Vert` subtype (height write hidden).
    /// Split this window and put a new TEXT GRID above it, `size` lines tall. The `Horz` return type
    /// is what makes only the height writable — the split's own axis.
    textGridWindowHorz   splitUpGrid    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textGridWindowHorz)_splitFrom(self.id, eGlulxWindowType.textGrid, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    textGridWindowHorz   splitDownGrid  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textGridWindowHorz)_splitFrom(self.id, eGlulxWindowType.textGrid, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    textGridWindowVert   splitLeftGrid  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textGridWindowVert)_splitFrom(self.id, eGlulxWindowType.textGrid, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    textGridWindowVert   splitRightGrid (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textGridWindowVert)_splitFrom(self.id, eGlulxWindowType.textGrid, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
    graphicsWindowHorz   splitUpGraphics    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (graphicsWindowHorz)_splitFrom(self.id, eGlulxWindowType.graphics, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    graphicsWindowHorz   splitDownGraphics  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (graphicsWindowHorz)_splitFrom(self.id, eGlulxWindowType.graphics, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    graphicsWindowVert   splitLeftGraphics  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (graphicsWindowVert)_splitFrom(self.id, eGlulxWindowType.graphics, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    graphicsWindowVert   splitRightGraphics (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (graphicsWindowVert)_splitFrom(self.id, eGlulxWindowType.graphics, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
    textBufferWindowHorz splitUpBuffer    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textBufferWindowHorz)_splitFrom(self.id, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    textBufferWindowHorz splitDownBuffer  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textBufferWindowHorz)_splitFrom(self.id, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    textBufferWindowVert splitLeftBuffer  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textBufferWindowVert)_splitFrom(self.id, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    textBufferWindowVert splitRightBuffer (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textBufferWindowVert)_splitFrom(self.id, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
}
/// A window that holds text — the base of the grid and buffer kinds.
class textWindow[8]       : window { }
/// A scrolling text window, where the story's prose goes. Lines wrap and the view scrolls.
class textBufferWindow[8] : textWindow { }   // drawImage(align) added under #if generateBlorb below
/// A fixed grid of character cells, addressed by column and line. What a status bar is made of.
class textGridWindow[8]   : textWindow {
    /// Put the cursor at a cell. Columns and lines count from 0.
    void moveCursor(int col, int line) asI6 _bglWin_moveCursor { bgl.asm.windowMoveCursor(self.id, col, line); }   // `MoveCursor` is a standard-library routine
}
/// A window you draw images into rather than text.
class graphicsWindow[8]   : window {
    /// Set the background colour and clear the window to it. `color` is 0xRRGGBB.
    void setBackgroundColor(int color){ bgl.asm.windowSetBackgroundColor(self.id, color); bgl.asm.windowClear(self.id); }
    // drawImage(x,y,…) added under #if generateBlorb below
}

// ---- Axis-B orientation views (§7.6): COMPILE-TIME-ONLY subtypes ----
// A split makes a divider; the NEW window owns the axis ALONG the split and inherits the cross axis from
// its parent. Up/Down → HORIZONTAL divider → the child owns its HEIGHT, width is fixed → `…Horz` hides
// `width.operator =` (writing the fixed axis is a COMPILE error; the read + `.height =` stay). Left/Right
// → VERTICAL divider → width sizable, height fixed → `…Vert` hides `height`.
//
// These add NO data and NO runtime behaviour — only the `hide` restriction — so they are `alias class`es:
// distinct Beguile types for compile-time checking that DISSOLVE to their content type for I6 emission
// (no own Class directive, no pool). A split `new`s the pooled content type and cast-labels the result
// with the orientation view. Hold the result as the content type — or cast `(textGridWindow)w` — to
// regain both writable axes (runtime-guarded); the cast is VM-sound because `hide` is front-end only.
alias class textGridWindowHorz   for textGridWindow   { hide width.operator =; }
alias class textGridWindowVert   for textGridWindow   { hide height.operator =; }
alias class textBufferWindowHorz for textBufferWindow { hide width.operator =; }
alias class textBufferWindowVert for textBufferWindow { hide height.operator =; }
alias class graphicsWindowHorz   for graphicsWindow   { hide width.operator =; }
alias class graphicsWindowVert   for graphicsWindow   { hide height.operator =; }

// Shared split machinery — allocates the pooled CONTENT subtype, opens the glk window, binds. Orientation
// is purely a compile-time label: each split method casts this result to its `…Horz`/`…Vert` alias view
// (which dissolves right back to the content type at emission), so nothing orientation-specific is
// allocated or emitted here.
// `styles` is the new window's own look: glk reads hints only as a window opens, so they are set just
// before it opens and the type-wide hints are put back right after, leaving other windows alone.
// `inherited` is the parent's `childStyles` (0 for none); `styles` is applied after it, so it wins.
window _splitFrom(int parentId, eGlulxWindowType type, bGlulxWindowMethodFlags method, int size,
                  ref styleSheet inherited = _bglNoStyles, ref styleSheet styles = _bglNoStyles){
    if(parentId == 0) return null;   // the window to split isn't open (e.g. a status bar with no height)
    bool styled = type != eGlulxWindowType.graphics;
    bool hasInherited = (int)inherited != 0;
    if(styled && hasInherited) _applySheet((int)type, inherited);
    if(styled) _applySheet((int)type, styles);
    int id = bgl.asm.windowOpen(parentId, type, size, method, 0);
    if(styled) _restoreSheet((int)type, styles);
    if(styled && hasInherited) _restoreSheet((int)type, inherited);
    if(id == 0) return null;   // Glk refused the split (e.g. no graphics support)
    window kid;
    if(type == eGlulxWindowType.graphics)       kid = new graphicsWindow();
    else if(type == eGlulxWindowType.textGrid)  kid = new textGridWindow();
    else                                        kid = new textBufferWindow();
    kid._bind(id, method);
    kid._type = (int)type;
    return kid;
}

// ---- expose window types under bgl.glulx (bgl.ui.mainWin/statusBar are the roots, §7.4) ----
extend _glulx {
    alias window           for window;
    alias textBufferWindow for textBufferWindow;
    alias textGridWindow   for textGridWindow;
    alias graphicsWindow   for graphicsWindow;
    // (enum members are reached via eGlulxWindowType.*; an enum-type alias does not
    //  forward member access, so there is no `winType` alias here.)
}

// ---- root integration (§7.4): the SAME core objects gain the window API ----
// mainWin (text buffer): add .width/.height (via outer.id) + the full split family.
extend _bglMainWindow {
    int _bglChildStyles = 0;   // the sheet `childStyles` refers to, or 0
    /// The look every window split from the main window gets: the sheet itself, not a copy.
    typesealed childStylesRef childStyles;
    auto width = {
        int _m = 0;
        int operator(){ bgl.asm.windowGetSize(outer.id, ((int)_glkWinSizeBuf)+bgl.wordsize, ((int)_glkWinSizeBuf)+(2*bgl.wordsize)); return _glkWinSizeBuf[0]; }
        void operator=(int v){ bgl.asm.windowSetArrangement(bgl.asm.windowGetParent(outer.id), _m, v, outer.id); }
    }
    auto height = {
        int _m = 0;
        int operator(){ bgl.asm.windowGetSize(outer.id, ((int)_glkWinSizeBuf)+bgl.wordsize, ((int)_glkWinSizeBuf)+(2*bgl.wordsize)); return _glkWinSizeBuf[1]; }
        void operator=(int v){ bgl.asm.windowSetArrangement(bgl.asm.windowGetParent(outer.id), _m, v, outer.id); }
    }
    // (mainWin is a text-buffer window: drawImage(align) added under #if generateBlorb below)
    // Split family returns oriented subtypes (Up/Down → …Horz, Left/Right → …Vert), same as `window`.
    textGridWindowHorz   splitUpGrid    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textGridWindowHorz)_splitFrom(self.id, eGlulxWindowType.textGrid, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    textGridWindowHorz   splitDownGrid  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textGridWindowHorz)_splitFrom(self.id, eGlulxWindowType.textGrid, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    textGridWindowVert   splitLeftGrid  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textGridWindowVert)_splitFrom(self.id, eGlulxWindowType.textGrid, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    textGridWindowVert   splitRightGrid (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textGridWindowVert)_splitFrom(self.id, eGlulxWindowType.textGrid, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
    graphicsWindowHorz   splitUpGraphics    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (graphicsWindowHorz)_splitFrom(self.id, eGlulxWindowType.graphics, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    graphicsWindowHorz   splitDownGraphics  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (graphicsWindowHorz)_splitFrom(self.id, eGlulxWindowType.graphics, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    graphicsWindowVert   splitLeftGraphics  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (graphicsWindowVert)_splitFrom(self.id, eGlulxWindowType.graphics, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    graphicsWindowVert   splitRightGraphics (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (graphicsWindowVert)_splitFrom(self.id, eGlulxWindowType.graphics, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
    textBufferWindowHorz splitUpBuffer    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textBufferWindowHorz)_splitFrom(self.id, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    textBufferWindowHorz splitDownBuffer  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textBufferWindowHorz)_splitFrom(self.id, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    textBufferWindowVert splitLeftBuffer  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textBufferWindowVert)_splitFrom(self.id, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    textBufferWindowVert splitRightBuffer (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textBufferWindowVert)_splitFrom(self.id, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
}
// statusBar (text grid): library binding already owns .height — add .width + split family only.
extend _bglStatus {
    int _bglChildStyles = 0;   // the sheet `childStyles` refers to, or 0
    /// The look every window split from the status bar gets: the sheet itself, not a copy.
    typesealed childStylesRef childStyles;
    auto width = {
        int _m = 0;
        int operator(){ bgl.asm.windowGetSize(outer.id, ((int)_glkWinSizeBuf)+bgl.wordsize, ((int)_glkWinSizeBuf)+(2*bgl.wordsize)); return _glkWinSizeBuf[0]; }
        void operator=(int v){ bgl.asm.windowSetArrangement(bgl.asm.windowGetParent(outer.id), _m, v, outer.id); }
    }
    textGridWindowHorz   splitUpGrid    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textGridWindowHorz)_splitFrom(self.id, eGlulxWindowType.textGrid, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    textGridWindowHorz   splitDownGrid  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textGridWindowHorz)_splitFrom(self.id, eGlulxWindowType.textGrid, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    textGridWindowVert   splitLeftGrid  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textGridWindowVert)_splitFrom(self.id, eGlulxWindowType.textGrid, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    textGridWindowVert   splitRightGrid (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textGridWindowVert)_splitFrom(self.id, eGlulxWindowType.textGrid, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
    graphicsWindowHorz   splitUpGraphics    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (graphicsWindowHorz)_splitFrom(self.id, eGlulxWindowType.graphics, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    graphicsWindowHorz   splitDownGraphics  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (graphicsWindowHorz)_splitFrom(self.id, eGlulxWindowType.graphics, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    graphicsWindowVert   splitLeftGraphics  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (graphicsWindowVert)_splitFrom(self.id, eGlulxWindowType.graphics, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    graphicsWindowVert   splitRightGraphics (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (graphicsWindowVert)_splitFrom(self.id, eGlulxWindowType.graphics, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
    textBufferWindowHorz splitUpBuffer    (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textBufferWindowHorz)_splitFrom(self.id, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.above | scale | border, size, self.childStyles, styles); }
    textBufferWindowHorz splitDownBuffer  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textBufferWindowHorz)_splitFrom(self.id, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.below | scale | border, size, self.childStyles, styles); }
    textBufferWindowVert splitLeftBuffer  (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textBufferWindowVert)_splitFrom(self.id, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.left | scale | border, size, self.childStyles, styles); }
    textBufferWindowVert splitRightBuffer (int size, bGlulxWindowScale scale=fixed, bGlulxWindowBorder border=noBorder, ref styleSheet styles = _bglNoStyles){ return (textBufferWindowVert)_splitFrom(self.id, eGlulxWindowType.textBuffer, bGlulxWindowPlacement.right | scale | border, size, self.childStyles, styles); }
}

// ---- Images (§4.3) — blorb-only: reuse core aspect-preserving scaleVectors + _bglGetImageInfo ----
// Gated as a single top-level block (#if is not allowed inside class/extend bodies) that `extend`s the
// window subtypes and the mainWin root. `image` is an `eImages` asset; a glulxImage converts to one, and a
// raw resource id is written `(eImages)id`.
// 0 width/height ⇒ natural size / aspect-preserving fit; both set ⇒ explicit box. Text-buffer windows
// take an alignment where a graphics window takes x/y (the y slot is unused, 0).
#if (generateBlorb == true)
// One shared drawer holds the sole `bglSize` local. The three drawImage methods below just forward to
// it — this both keeps the scaling in one place AND sidesteps a value-local backing-name collision
// (same-named methods across classes synthesize the same `_bglLocal_drawImage_sz` backing).
// `alignOrX`/`y`: a graphics window passes x,y; a text-buffer window passes the alignment and 0.
void _drawScaled(int winId, eImages image, int alignOrX, int y, int width, int height){
    bglSize sz = scaleVectors({width, height}, _bglGetImageInfo((int)image));
    bgl.asm.imageDrawScaled(winId, (int)image, alignOrX, y, sz.width, sz.height);
}
extend class textBufferWindow {
    void drawImage(eImages image, eGlulxImageAlign align = inlineCenter, int width = 0, int height = 0){ _drawScaled(self.id, image, (int)align, 0, width, height); }
}
extend class graphicsWindow {
    void drawImage(eImages image, int x = 0, int y = 0, int width = 0, int height = 0){ _drawScaled(self.id, image, x, y, width, height); }
}
extend _bglMainWindow {
    void drawImage(eImages image, eGlulxImageAlign align = inlineCenter, int width = 0, int height = 0){ _drawScaled(self.id, image, (int)align, 0, width, height); }
}
#endif

// ============================ Styles (§4.4) ============================
// glk style hints are set per (window TYPE, style type, hint) and read only when a window opens. The
// type-wide calls (`bgl.ui.screen.setStyle`, `win.setStyle`) set them for every later window of that type
// and are recorded in a sheet per type, so a split can give one window its own look and then put the
// type-wide hints back. Hints are always-available opcodes (NOT blorb-gated).

const int styleUnset = $7FFFFFFF;   // "leave the interpreter default" sentinel — no real glk hint value

/// A yes/no style setting that can also be left unset.
primitive class styleFlag {
    emitter styleFlag operator = (bool v){ $target = $v; }   /// Turn the setting on or off.
    emitter styleFlag operator = (int v){ $target = $v; }    /// Set it from 1 or 0, or leave it unset with `styleUnset`.
    emitter bool operator == (int v){ $val == $v }           /// True when it holds `v`.
    emitter bool operator != (int v){ $val ~= $v }           /// True when it doesn't hold `v`.
    emitter int  operator () { $val }                        /// Its value: 1, 0 or `styleUnset`.
}

// Justification values (glk stylehint_just_*). Cast to int when set on a style: `justify = (int)eGlulxJustify.centered;`.
enum eGlulxJustify { left = 0, full = 1, centered = 2, right = 3 }

// Style-hint selector for measureStyle(). Members are named after the `style` fields (so you validate
// the same aspect you set); the values are the fixed glk hint indices (Glk §5.5). Named this way —
// rather than the raw glk names — both for author consistency and to avoid a bare-name clash (glk's
// "Proportional" would collide with bGlulxWindowScale.proportional).
enum eGlulxStyleHint {
    indentation = 0, paragraphIndentation = 1, justify = 2, sizeAdjustment = 3, fontWeight = 4,
    italics = 5, fixedWidth = 6, foreColor = 7, backColor = 8, reverse = 9
}

// Declarative style bag — set only the fields you want; omitted fields keep the interpreter default.
// Copied on assignment (its `operator =`), used as `win.setStyle(styleType, style{ backColor = $111111; italics = true; })`.
// Each member emits under a `_bglStyle_` name: I6 properties share one global namespace, and plain
// words such as `italics` or `reverse` are routine names in other libraries (orLibrary has `italics`).
value class style {
    inline int justify asI6 _bglStyle_justify                    = styleUnset;   // an eGlulxJustify value (cast to int)
    inline int indentation asI6 _bglStyle_indentation            = styleUnset;   // left-margin indent
    inline int paragraphIndentation asI6 _bglStyle_paragraphIndentation = styleUnset;   // first-line extra indent
    inline int sizeAdjustment asI6 _bglStyle_sizeAdjustment      = styleUnset;   // relative to the base text size (…-1, 0, 1…)
    inline int fontWeight asI6 _bglStyle_fontWeight              = styleUnset;   // -1 lighter, 0 normal, 1 bold
    inline styleFlag italics asI6 _bglStyle_italics              = styleUnset;   // oblique/italic
    inline styleFlag fixedWidth asI6 _bglStyle_fixedWidth        = styleUnset;   // true ⇒ fixed-pitch (non-proportional)
    inline int foreColor asI6 _bglStyle_foreColor                = styleUnset;   // 0xRRGGBB text color
    inline int backColor asI6 _bglStyle_backColor                = styleUnset;   // 0xRRGGBB background color
    inline styleFlag reverse asI6 _bglStyle_reverse              = styleUnset;   // swap fore/back
    style operator = (style s){
        self.justify = s.justify;                           self.indentation = s.indentation;
        self.paragraphIndentation = s.paragraphIndentation; self.sizeAdjustment = s.sizeAdjustment;
        self.fontWeight = s.fontWeight;                     self.italics = s.italics;
        self.fixedWidth = s.fixedWidth;                     self.foreColor = s.foreColor;
        self.backColor = s.backColor;                       self.reverse = s.reverse;
        return self;
    }
    /// True when at least one hint is set.
    bool hasHints(){
        return justify != styleUnset || indentation != styleUnset || paragraphIndentation != styleUnset
            || sizeAdjustment != styleUnset || fontWeight != styleUnset || italics != styleUnset
            || fixedWidth != styleUnset || foreColor != styleUnset || backColor != styleUnset || reverse != styleUnset;
    }
}

/// A look for every style type at once. A style left unset leaves that style type alone.
value class styleSheet {
    style normal asI6 _bglSheet_normal;           /// Plain text.
    style emphasized asI6 _bglSheet_emphasized;   /// Emphasized text.
    style fixed asI6 _bglSheet_fixed;             /// Fixed-width text.
    style header asI6 _bglSheet_header;           /// Headers.
    style subheader asI6 _bglSheet_subheader;     /// Subheaders.
    style alert asI6 _bglSheet_alert;             /// Alerts.
    style note asI6 _bglSheet_note;               /// Notes.
    style blockQuote asI6 _bglSheet_blockQuote;   /// Block quotations.
    style input asI6 _bglSheet_input;             /// The player's input.
    style user1 asI6 _bglSheet_user1;             /// A style the game defines.
    style user2 asI6 _bglSheet_user2;             /// A second style the game defines.
    styleSheet operator = (styleSheet s){
        self.normal = s.normal;         self.emphasized = s.emphasized; self.fixed = s.fixed;
        self.header = s.header;         self.subheader = s.subheader;   self.alert = s.alert;
        self.note = s.note;             self.blockQuote = s.blockQuote; self.input = s.input;
        self.user1 = s.user1;           self.user2 = s.user2;
        return self;
    }
}

/// The type of a window's `childStyles`: it refers to a sheet rather than holding a copy.
extern emitter class childStylesRef {
    /// Refer to `v` (null for none).
    emitter childStylesRef operator = (styleSheet v){ $self._bglChildStyles = $v }
    /// The sheet referred to, or null.
    emitter styleSheet operator(){ ($self._bglChildStyles) }
}

styleSheet _bglNoStyles;      // the empty sheet: a split's default
styleSheet _bglBufferLook;    // the type-wide hints set for text-buffer windows
styleSheet _bglGridLook;      // the type-wide hints set for text-grid windows
style      _bglNoStyle;       // every hint unset

// Apply the set fields of `s` to (wintype, st) via glk_stylehint_set. Hint indices are the fixed glk
// ABI (Glk §5.5): 0 Indentation, 1 ParaIndentation, 2 Justification, 3 Size, 4 Weight, 5 Oblique,
// 6 Proportional, 7 TextColor, 8 BackColor, 9 ReverseColor.
void _applyStyle(int wintype, eGlulxStyleType st, style s){
    if(s.justify              != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 2, s.justify);
    if(s.indentation          != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 0, s.indentation);
    if(s.paragraphIndentation != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 1, s.paragraphIndentation);
    if(s.sizeAdjustment       != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 3, s.sizeAdjustment);
    if(s.fontWeight           != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 4, s.fontWeight);
    if(s.italics              != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 5, (int)s.italics);
    if(s.fixedWidth           != styleUnset){ int prop = 1; if((int)s.fixedWidth != 0) prop = 0; bgl.asm.stylehintSet(wintype, (int)st, 6, prop); }  // Proportional is the inverse of fixed-pitch
    if(s.foreColor            != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 7, s.foreColor);
    if(s.backColor            != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 8, s.backColor);
    if(s.reverse              != styleUnset) bgl.asm.stylehintSet(wintype, (int)st, 9, (int)s.reverse);
}
// Reset every hint for (wintype, st) back to the interpreter default.
void _clearStyle(int wintype, eGlulxStyleType st){
    int h = 0;
    for(h = 0; h < 10; h++) bgl.asm.stylehintClear(wintype, (int)st, h);
}

// The type-wide sheet a wintype records into.
void _recordStyle(int wintype, eGlulxStyleType st, style s){
    if(wintype == (int)eGlulxWindowType.textGrid) _setSheetStyle(_bglGridLook, st, s);
    else                                          _setSheetStyle(_bglBufferLook, st, s);
}
void _setSheetStyle(ref styleSheet sh, eGlulxStyleType st, style s){
    switch(st){
        case eGlulxStyleType.normal:     sh.normal = s;
        case eGlulxStyleType.emphasized: sh.emphasized = s;
        case eGlulxStyleType.fixed:      sh.fixed = s;
        case eGlulxStyleType.header:     sh.header = s;
        case eGlulxStyleType.subheader:  sh.subheader = s;
        case eGlulxStyleType.alert:      sh.alert = s;
        case eGlulxStyleType.note:       sh.note = s;
        case eGlulxStyleType.blockQuote: sh.blockQuote = s;
        case eGlulxStyleType.input:      sh.input = s;
        case eGlulxStyleType.user1:      sh.user1 = s;
        case eGlulxStyleType.user2:      sh.user2 = s;
    }
}
// A type-wide setStyle / clearStyle: set the hints and remember them.
void _setTypeStyle(int wintype, eGlulxStyleType st, style s){ _applyStyle(wintype, st, s); _recordStyle(wintype, st, s); }
void _clearTypeStyle(int wintype, eGlulxStyleType st){ _clearStyle(wintype, st); _recordStyle(wintype, st, _bglNoStyle); }

// Every style a sheet sets, applied to `wintype`.
void _applySheet(int wintype, ref styleSheet sh){
    _applyStyle(wintype, eGlulxStyleType.normal, sh.normal);         _applyStyle(wintype, eGlulxStyleType.emphasized, sh.emphasized);
    _applyStyle(wintype, eGlulxStyleType.fixed, sh.fixed);           _applyStyle(wintype, eGlulxStyleType.header, sh.header);
    _applyStyle(wintype, eGlulxStyleType.subheader, sh.subheader);   _applyStyle(wintype, eGlulxStyleType.alert, sh.alert);
    _applyStyle(wintype, eGlulxStyleType.note, sh.note);             _applyStyle(wintype, eGlulxStyleType.blockQuote, sh.blockQuote);
    _applyStyle(wintype, eGlulxStyleType.input, sh.input);           _applyStyle(wintype, eGlulxStyleType.user1, sh.user1);
    _applyStyle(wintype, eGlulxStyleType.user2, sh.user2);
}
// For one style type a sheet touched: back to the type-wide hints.
void _restoreStyle(int wintype, eGlulxStyleType st, style touched, style typeWide){
    if(!touched.hasHints()) return;
    _clearStyle(wintype, st);
    _applyStyle(wintype, st, typeWide);
}
// After a split: every style the sheet touched goes back to the type-wide hints for `wintype`.
void _restoreSheet(int wintype, ref styleSheet sh){
    if(wintype == (int)eGlulxWindowType.textGrid) _restoreSheetFrom(wintype, sh, _bglGridLook);
    else                                          _restoreSheetFrom(wintype, sh, _bglBufferLook);
}
void _restoreSheetFrom(int wintype, ref styleSheet sh, ref styleSheet base){
    _restoreStyle(wintype, eGlulxStyleType.normal, sh.normal, base.normal);
    _restoreStyle(wintype, eGlulxStyleType.emphasized, sh.emphasized, base.emphasized);
    _restoreStyle(wintype, eGlulxStyleType.fixed, sh.fixed, base.fixed);
    _restoreStyle(wintype, eGlulxStyleType.header, sh.header, base.header);
    _restoreStyle(wintype, eGlulxStyleType.subheader, sh.subheader, base.subheader);
    _restoreStyle(wintype, eGlulxStyleType.alert, sh.alert, base.alert);
    _restoreStyle(wintype, eGlulxStyleType.note, sh.note, base.note);
    _restoreStyle(wintype, eGlulxStyleType.blockQuote, sh.blockQuote, base.blockQuote);
    _restoreStyle(wintype, eGlulxStyleType.input, sh.input, base.input);
    _restoreStyle(wintype, eGlulxStyleType.user1, sh.user1, base.user1);
    _restoreStyle(wintype, eGlulxStyleType.user2, sh.user2, base.user2);
}

// Per-wintype styling on the text window subtypes.
extend class textBufferWindow {
    void setStyle(eGlulxStyleType type, style s){ _setTypeStyle((int)eGlulxWindowType.textBuffer, type, s); }
    void clearStyle(eGlulxStyleType type){ _clearTypeStyle((int)eGlulxWindowType.textBuffer, type); }
}
extend class textGridWindow {
    void setStyle(eGlulxStyleType type, style s){ _setTypeStyle((int)eGlulxWindowType.textGrid, type, s); }
    void clearStyle(eGlulxStyleType type){ _clearTypeStyle((int)eGlulxWindowType.textGrid, type); }
}

// bgl.ui.screen — the global style scope (both text window types at once). The idiomatic place to set
// up styles at game start, before any window is split.
superposed _bglObject _bglScreen {
    void setStyle(eGlulxStyleType type, style s){
        _setTypeStyle((int)eGlulxWindowType.textBuffer, type, s);
        _setTypeStyle((int)eGlulxWindowType.textGrid,   type, s);
    }
    void clearStyle(eGlulxStyleType type){
        _clearTypeStyle((int)eGlulxWindowType.textBuffer, type);
        _clearTypeStyle((int)eGlulxWindowType.textGrid,   type);
    }
}
extend _bglUi { alias screen = _bglScreen; }   // bgl.ui.screen

// The roots are typed windows too: mainWin = text buffer, statusBar = text grid.
extend _bglMainWindow {
    void setStyle(eGlulxStyleType type, style s){ _setTypeStyle((int)eGlulxWindowType.textBuffer, type, s); }
    void clearStyle(eGlulxStyleType type){ _clearTypeStyle((int)eGlulxWindowType.textBuffer, type); }
}
extend _bglStatus {
    void setStyle(eGlulxStyleType type, style s){ _setTypeStyle((int)eGlulxWindowType.textGrid, type, s); }
    void clearStyle(eGlulxStyleType type){ _clearTypeStyle((int)eGlulxWindowType.textGrid, type); }
}

// ---- style validation (glk_style_measure) ----
// Interpreters may ignore style hints. measureStyle reports the ACTUAL value the interpreter uses for
// a (style type, hint) on this window, or `styleUnset` if the hint isn't measurable; styleHonored is
// the boolean "did the interpreter report this hint at all". checkStyle compares what a style asks for
// with what the interpreter reports. All query the LIVE window, so call them after the window exists
// (unlike setStyle, which sets hints for windows created afterward).

/// How a style check came out: what the interpreter reported, or that it couldn't report.
enum eStyleCheck {
    unknown = 0,   /// The interpreter can't report the hints the style sets.
    applied,       /// Every reported hint is what the style asks for.
    differs,       /// At least one reported hint is not what the style asks for.
    /// True when the interpreter could report.
    emitter bool known     { ($self ~= 0) }
    /// True when every reported hint matched.
    emitter bool isApplied { ($self == 1) }
    /// True when a reported hint didn't match.
    emitter bool isDiffering { ($self == 2) }
}

// One hint: 0 when the interpreter can't report it, 1 when it reports `want`, 2 when it reports another value.
int _checkHint(int winId, eGlulxStyleType type, int hint, int want){
    if(want == styleUnset) return -1;   // not asked for
    if(bgl.asm.styleMeasure(winId, (int)type, hint, ((int)_glkWinSizeBuf) + bgl.wordsize) == 0) return 0;
    if(_glkWinSizeBuf[0] == want) return 1;
    return 2;
}

extend class window {
    int measureStyle(eGlulxStyleType type, eGlulxStyleHint hint){
        int ok = bgl.asm.styleMeasure(self.id, (int)type, (int)hint, ((int)_glkWinSizeBuf) + bgl.wordsize);
        if(ok == 0) return styleUnset;
        if(hint == eGlulxStyleHint.fixedWidth){ if(_glkWinSizeBuf[0] == 0) return 1; return 0; }   // glk reports Proportional
        return _glkWinSizeBuf[0];
    }
    bool styleHonored(eGlulxStyleType type, eGlulxStyleHint hint){
        return bgl.asm.styleMeasure(self.id, (int)type, (int)hint, ((int)_glkWinSizeBuf) + bgl.wordsize) != 0;
    }
    /// Whether this window shows style type `type` the way `s` asks.
    eStyleCheck checkStyle(eGlulxStyleType type, style s){
        int measured = 0; int mismatched = 0; int r = 0;
        int fixedWant = styleUnset;
        if(s.fixedWidth != styleUnset){ fixedWant = 1; if((int)s.fixedWidth != 0) fixedWant = 0; }   // glk measures Proportional
        r = _checkHint(self.id, type, 2, s.justify);              if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 0, s.indentation);          if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 1, s.paragraphIndentation); if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 3, s.sizeAdjustment);       if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 4, s.fontWeight);           if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 5, (int)s.italics);         if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 6, fixedWant);              if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 7, s.foreColor);            if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 8, s.backColor);            if(r > 0) measured++; if(r == 2) mismatched++;
        r = _checkHint(self.id, type, 9, (int)s.reverse);         if(r > 0) measured++; if(r == 2) mismatched++;
        if(measured == 0)   return eStyleCheck.unknown;
        if(mismatched > 0)  return eStyleCheck.differs;
        return eStyleCheck.applied;
    }
    /// True when the interpreter shows style types `a` and `b` differently in this window; false when
    /// they look the same or it can't tell.
    bool distinguishes(eGlulxStyleType a, eGlulxStyleType b){
        return bgl.asm.styleDistinguish(self.id, (int)a, (int)b) != 0;
    }
}

// ============================ Window output ============================
// Each prints through the ordinary `print` overloads, so a value prints the same way in any window;
// the output stream is switched to this window for the call and then put back.
int _bglOutSaved = 0;   // the stream to return to

extend class textWindow {
    /// Print `v` in this window.
    emitter void print(var v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $i6Expr(::print($v)); $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Print an interpolated string in this window.
    emitter void print(interpolatedStringLiteral v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $v; $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Print `v` in this window, then a newline.
    emitter void printLine(var v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $i6Expr(::print($v)); print "^"; $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Print an interpolated string in this window, then a newline.
    emitter void printLine(interpolatedStringLiteral v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $v; print "^"; $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Print a newline in this window.
    emitter void printLine(){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); print "^"; $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Clear this window.
    void clear(){ bgl.asm.windowClear(self.id); }
}
extend _bglMainWindow {
    /// Print `v` in the main window.
    emitter void print(var v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $i6Expr(::print($v)); $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Print an interpolated string in the main window.
    emitter void print(interpolatedStringLiteral v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $v; $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Print `v` in the main window, then a newline.
    emitter void printLine(var v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $i6Expr(::print($v)); print "^"; $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Print an interpolated string in the main window, then a newline.
    emitter void printLine(interpolatedStringLiteral v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $v; print "^"; $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Clear the main window.
    void clear(){ bgl.asm.windowClear(self.id); }
}
extend _bglStatus {
    /// Print `v` in the status bar, at the cursor.
    emitter void print(var v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $i6Expr(::print($v)); $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Print an interpolated string in the status bar, at the cursor.
    emitter void print(interpolatedStringLiteral v){ _bglOutSaved = $i6Expr(bgl.asm.streamGetCurrent()); $i6Expr(bgl.asm.setWindow($self.id)); $v; $i6Expr(bgl.asm.streamSetCurrent(_bglOutSaved)); }
    /// Clear the status bar.
    void clear(){ bgl.asm.windowClear(self.id); }
    /// Put the cursor at a cell. Columns and lines count from 0.
    void moveCursor(int col, int line) asI6 _bglWin_moveCursor { bgl.asm.windowMoveCursor(self.id, col, line); }
}

// ============================ Capabilities ============================
/// How well the interpreter can show a character.
enum eCharOutput {
    none = 0,          /// It can't show it.
    approximate = 1,   /// It shows something close.
    exact = 2          /// It shows it exactly.
}

/// What the interpreter can do. Each is read as a property; the ones that take an argument are routines.
emitter class _bglSupports {
    emitter int  version              { ($i6Expr(bgl.asm.gestalt(0, 0))) }          /// The Glk version, as 0xMMmmrr.
    emitter bool timer                { ($i6Expr(bgl.asm.gestalt(5, 0)) ~= 0) }     /// Timed events.
    emitter bool graphics             { ($i6Expr(bgl.asm.gestalt(6, 0)) ~= 0) }     /// Images and graphics windows.
    emitter bool graphicsTransparency { ($i6Expr(bgl.asm.gestalt(14, 0)) ~= 0) }    /// Images with transparency.
    emitter bool sound                { ($i6Expr(bgl.asm.gestalt(8, 0)) ~= 0) }     /// Sound.
    emitter bool soundMusic           { ($i6Expr(bgl.asm.gestalt(13, 0)) ~= 0) }    /// Music formats (MOD and the like).
    emitter bool soundVolume          { ($i6Expr(bgl.asm.gestalt(9, 0)) ~= 0) }     /// Setting the volume.
    emitter bool soundNotify          { ($i6Expr(bgl.asm.gestalt(10, 0)) ~= 0) }    /// Notice when a sound ends.
    emitter bool hyperlinks           { ($i6Expr(bgl.asm.gestalt(11, 0)) ~= 0) }    /// Hyperlinks.
    emitter bool unicode              { ($i6Expr(bgl.asm.gestalt(15, 0)) ~= 0) }    /// Unicode text.
    emitter bool dateTime             { ($i6Expr(bgl.asm.gestalt(20, 0)) ~= 0) }    /// The date and time.
    emitter bool lineTerminators      { ($i6Expr(bgl.asm.gestalt(18, 0)) ~= 0) }    /// Keys other than Return ending line input.
    emitter bool resourceStream       { ($i6Expr(bgl.asm.gestalt(22, 0)) ~= 0) }    /// Reading data files from the blorb.
    /// How well it can show `c`.
    emitter eCharOutput charOutput(char c){ ($i6Expr(bgl.asm.gestalt(3, (int)$c))) }
    /// True when the player can type `c` at a key prompt.
    emitter bool charInput(char c){ ($i6Expr(bgl.asm.gestalt(1, (int)$c)) ~= 0) }
    /// True when windows of type `t` can show images.
    emitter bool images(eGlulxWindowType t){ ($i6Expr(bgl.asm.gestalt(7, (int)$t)) ~= 0) }
    /// True when windows of type `t` take mouse input.
    emitter bool mouse(eGlulxWindowType t){ ($i6Expr(bgl.asm.gestalt(4, (int)$t)) ~= 0) }
    /// True when windows of type `t` take hyperlink clicks.
    emitter bool hyperlinkInput(eGlulxWindowType t){ ($i6Expr(bgl.asm.gestalt(12, (int)$t)) ~= 0) }
}
extend _glulx { alias supports for _bglSupports; }   // bgl.glulx.supports

/// What the interpreter can do in one kind of window.
primitive class windowSupport {
    emitter bool images     { ($i6Expr(bgl.asm.gestalt(7, (int)$self)) ~= 0) }    /// It can show images.
    emitter bool mouse      { ($i6Expr(bgl.asm.gestalt(4, (int)$self)) ~= 0) }    /// It takes mouse input.
    emitter bool hyperlinks { ($i6Expr(bgl.asm.gestalt(12, (int)$self)) ~= 0) }   /// It takes hyperlink clicks.
}
extend class window {
    /// What the interpreter can do in this window.
    emitter windowSupport supports { ($self._type) }
}
extend _bglMainWindow {
    /// What the interpreter can do in the main window.
    emitter windowSupport supports { (3) }
}
extend _bglStatus {
    /// What the interpreter can do in the status bar.
    emitter windowSupport supports { (4) }
}

// ============================ Colors (§4.5) ============================
// Sugar over raw 0xRRGGBB ints for setBackgroundColor / style colours. `color.rgb(r,g,b)` composes a
// colour from 0-255 channels; the named members are ready-made 0xRRGGBB values. Both are plain ints,
// so they drop straight into `foreColor = color.red;` / `pic.setBackgroundColor(color.rgb(20,30,40));`.
superposed _bglObject _bglColor {
    int rgb(int r, int g, int b){ return (r * 65536) + (g * 256) + b; }

    int black     = $000000;
    int white     = $ffffff;
    int red       = $ff0000;
    int green     = $00ff00;
    int blue      = $0000ff;
    int yellow    = $ffff00;
    int cyan      = $00ffff;
    int magenta   = $ff00ff;
    int gray      = $808080;
    int lightGray = $c0c0c0;
    int darkGray  = $404040;
}
extend _glulx { alias color = _bglColor; }   // bgl.glulx.color
