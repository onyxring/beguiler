#once
/*============================================================================
  beguiLib / bglStdLib / _verdict.bgl
  eVerdict - the outcome every rule body returns.
  ============================================================================*/

// The 0/1/2 numbering matters: a rule that falls off its end returns 0 (proceed)
enum eVerdict {
    proceed = 0,   // No decision; go on to the next rule
    stop    = 1,   // Handled; halt the book, the action succeeds
    block   = 2    // Veto; halt the book, the action fails
}
