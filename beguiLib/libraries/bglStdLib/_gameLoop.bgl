#once
/*============================================================================
  beguiLib / bglStdLib / _gameLoop.bgl
  The two outermost rulebooks and the program entry point.
  ============================================================================*/

// The main window's Glk id; 0 until configureUi opens it
int mainWindow = 0;

//-- Game-turn rulebook ------------------------------------------------------

eVerdict getInput() {
    // TODO: read a line with Glk so printInput can echo it
    return proceed;
}

eVerdict printInput() {
    print("^(turn)^");
    return proceed;
}

eVerdict continueTurn() {
    return proceed;
}

array<literal func<eVerdict>> gameTurnRulebook = {
    getInput,
    printInput,
    continueTurn,
};

//-- Root rulebook -----------------------------------------------------------

eVerdict configureUi() {
    // TODO: open the Glk windows
    return proceed;
}

eVerdict gameTurnLoop() {
    while (runRulebook(gameTurnRulebook) == proceed) { }
    return proceed;
}

array<literal func<eVerdict>> rootRulebook = {
    configureUi,
    gameTurnLoop,
};

//-- Entry point -------------------------------------------------------------
// TODO: confirm main serves as the entry point of a binding-less Glulx build

void main() {
    bglInit();
    runRulebook(rootRulebook);
}
