#once
/*============================================================================
  beguiLib / bglStdLib / _rulebook.bgl
  The generic rulebook runner: an array of zero-argument rules, each returning an eVerdict.
  ============================================================================*/

eVerdict runRulebook(array<func<eVerdict>> book) {
    for (func<eVerdict> r in book) {
        eVerdict v = r();
        if (v != proceed) return v;
    }
    return proceed;                
}
