    // Lock `s` if it is a freed pool string and remember it; any other value passes through.
    var stackLock(var s) asI6 _bglText_stackLock {
        if(_bglStr.ambiguousLock(s)) {
            #i6 {
                if(_bglStringLockStackTop >= bglStringLockStackSize){
                    print "[ERROR: too many temporary strings in one expression.]";
                    return s;
                }
                _bglStringLockStackSlots-->_bglStringLockStackTop = s;
                _bglStringLockStackTop++;
            }
        }
        return s;
    }
    // Open a mark at the current height; the matching stackDrain releases back to it.
    int stackMark() asI6 _bglText_stackMark {
        #i6 {
            if(_bglStringLockStackMarkTop >= bglStringLockStackSize){
                print "[ERROR: temporary strings nested too deeply.]";
                return 0;
            }
            _bglStringLockStackMarks-->_bglStringLockStackMarkTop = _bglStringLockStackTop;
            _bglStringLockStackMarkTop++;
        }
        return 0;
    }
    // Free what was locked since the most recent mark, close that mark, and pass `result` through.
    var stackDrain(var result, int unused) asI6 _bglText_stackDrain {
        #i6 {
            if(_bglStringLockStackMarkTop == 0) return result;
            _bglStringLockStackMarkTop--;
            while(_bglStringLockStackTop > _bglStringLockStackMarks-->_bglStringLockStackMarkTop){
                _bglStringLockStackTop--;
                _bglStr._bglText_ambiguousFree(_bglStringLockStackSlots-->_bglStringLockStackTop, true);
            }
        }
        return result;
    }
}

