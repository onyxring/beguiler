//-----------------------------------------------------------------------------
// archive/string.bgl - the earlier, pool-based Beguile string runtime (archived 2026-10-21)
//
// Every string gets a fixed-size buffer from a pool. Include it as <archive/string>, instead of <string>
//
// Pool sizing can be overridden before including this file:
//   #i6 { Default bglStringPoolReserve 20; }            ! number of simultaneous strings
// The per-string capacity lives in <buf>, which the core loads first:
//   #emitfirst { Constant bglStringDefaultSize 800; }   ! per-string capacity in chars
//-----------------------------------------------------------------------------
#once
#declare BGL_STRING_POOL
#if BGL_STRING_HEAP
    #error "<archive/string> and <string> both provide stringObj; include one of them."
#endif

#include <buf>
//-- String pool and buffer allocation ----
#i6 {
    Constant _bglOverrunSetting "bglStringDefaultSize";        ! what <buf> names when printed text overruns its room
    Default bglStringLockStackSize 32;                          ! temporaries an operator can hold at once (_bglStringLockStack)
    Array _bglStringLockStackSlots --> bglStringLockStackSize;
    Global _bglStringLockStackTop = 0;
    Array _bglStringLockStackMarks --> bglStringLockStackSize;  ! the slot height at each open mark
    Global _bglStringLockStackMarkTop = 0;
    Array _bglStrAppendTemps --> 8;                             ! `s += $"…"` captures into one of these, nested
    Global _bglStrAppendTop = 0;

    Constant _bglStrSlotBytes = bglStringDefaultSize + 2 * WORDSIZE + 2;   ! a slot: its header, then bglStringDefaultSize characters
    Array _bglDsbuf buffer _bglStrSlotBytes * bglBufferPoolReserve;  ! one mega-buffer carved into pool slots at startup

    class _bglBufferWrapper(bglBufferPoolReserve) with _bglText_buf 0;   ! buffer-as-object so it can move between sentinel containers

    object _bglAllocatedObjects;   ! sentinel — live pool (parent of currently-locked instances)
    object _bglObjectHeap;         ! sentinel — free pool (parent of available instances)

    object _bglStringPool
        private _allocateObj[type  ! Take a free object and lock it
                o retval;
            objectloop(o in _bglObjectHeap && o ofclass type) {
                retval=o;
                break;
            }
            if(retval==0) {
                #Ifdef TARGET_GLULX;
                    ! No window is open yet at startup
                    if(glk($0048) == 0) glk($002F, glk($0023, 0, 0, 0, 3, 0));
                #Endif;
                print "^[Beguile runtime error: the <string> pool is out of strings; raise bglStringPoolReserve]^";
                quit;
            }
            move retval to _bglAllocatedObjects;
            return retval;
        ]
    ,	_freeObj[obj; ! Free an allocated object
            if(obj==0) return 0;
            move obj to _bglObjectHeap;
            return obj;
        ]
    ,	_reclaimObj[obj; ! Lock a free object
            if(obj==0) return 0;
            move obj to _bglAllocatedObjects;
            return obj;
        ]
    ,	_findAllocatedObjFromBuffer[b o;
            objectloop(o in _bglAllocatedObjects && o ofclass _bglBufferWrapper ) if(o._bglText_buf==b) return o;
            return 0;
        ]
    ,	_findAvailableObjFromBuffer[b o;
            objectloop(o in _bglObjectHeap && o ofclass _bglBufferWrapper ) if(o._bglText_buf==b) return o;
            return 0;
        ]
    ,	_bglText_isManagedBuffer[b;
            if(self._findAllocatedObjFromBuffer(b)==0) rfalse;
            rtrue;
        ]
    ,	_findObjFromBuffer[b retval;
            retval=self._findAllocatedObjFromBuffer(b);
            if(retval==0) retval=self._findAvailableObjFromBuffer(b);
            return retval;
        ]
    ,	_findAllocatedObj[b o;
            objectloop(o in _bglAllocatedObjects) if(o==b) return o;
            return 0;
        ]
    ,	_findAvailableObj[b o;
            objectloop(o in _bglObjectHeap) if(o==b) return o;
            return 0;
        ]
    with _bglText_allocateString[retval; ! Take a free string and give it a buffer
            retval = self._allocateObj(_bglString);
            retval._bglText_getBuf();
            return retval;
        ]
    ,	_bglText_freeString[str;
            self._bglText_freeBuffer(self._findAllocatedObj(str));
            self._freeObj(self._findAllocatedObj(str));

            return str;
        ]
    ,	_bglText_reclaimString[b retval;
            retval = self._reclaimObj(self._findAvailableObj(b));
            if(retval~=0) self._bglText_reclaimBuffer(retval._bglText_getBuf(true));
            return retval;
        ]
    ,	_bglText_allocateBuffer[retval; ! Take a free buffer, emptied
            retval = self._allocateObj(_bglBufferWrapper)._bglText_buf;
            _bglBuf._bglText_setLength(retval,0);
            return retval;
        ]
    ,	_bglText_freeBuffer[b;
            self._freeObj(self._findAllocatedObjFromBuffer(b));
            return b;
        ]
    ,	_bglText_reclaimBuffer[b retval;
            retval = self._reclaimObj(self._findAvailableObjFromBuffer(b));
            if(retval~=0) return retval._bglText_buf;
            return 0;
        ]
    , 	_bglText_isLocked[obj;
            if(self._findAllocatedObj(obj)) return true;
            if(self._findAllocatedObjFromBuffer(obj)) return true;
            return false;
        ]
    ,	_bglText_isFree[obj;
            if(self._findAvailableObj(obj)) return true;
            if(self._findAvailableObjFromBuffer(obj)) return true;
            return false;
        ]
    ;

    [_bglInitializeStringBuffers
            i obj;
        for(i=0:_bglBufferWrapper.remaining()>0:i++){
            obj=_bglBufferWrapper.create();
            obj._bglText_buf=_bglDsbuf+(i*_bglStrSlotBytes);
            obj._bglText_buf=_bglConvertToSizedBuffer(obj._bglText_buf,_bglStrSlotBytes);
            move obj to _bglObjectHeap;
        }

        for(i=0:_bglString.remaining()>0:i++){
            obj=_bglString.create();
            obj._bglText_getBuf(); ! Gives every string a buffer
            move obj to _bglObjectHeap;
        }
    ];
}

#startup {
    _bglInitializeStringBuffers();
}

// Promote a raw buffer chunk to the sized-buffer layout, registering it with _bglBuf
// The 2 bytes before the size word are reserved and unused
array<char> _bglConvertToSizedBuffer(array<char> b, int sz) {
    if(_bglBuf.isTracked(b)) return b;
    array<char> result = _bglAsBuf((int)b + bgl.wordsize + 2);
    _bglSetWord(result, -1, sz - bgl.wordsize - bgl.wordsize - 2);
    _bglBuf._registerTracked(result);
    return result;
}

//-- _bglStr: helpers for any string-shaped value ----
object _bglStr {
    // Allocate a string, copying unkStr if given
    var new(var unkStr = 0) asI6 _bglText_new {
        var retval; var lck;
        #i6 {
            lck    = self._bglText_ambiguousLock(unkStr);
            retval = _bglStringPool._bglText_allocateString();
            if(unkStr ~= 0) retval._bglText_set(unkStr);
            else retval._bglText_setLength(0);   ! A pooled buffer still holds its last text
            self._bglText_ambiguousFree(unkStr, lck);
            retval = retval._bglText_lock();
        }
        return retval;
    }

    // Copy an array<char> into a freed pooled string
    var fromChars(var chars) asI6 _bglText_fromChars {
        var retval = self.new();
        int n; int i;
        #i6 {
            n = chars-->0;
            i = _bglBuf._bglText_size(retval._bglText_getBuf());   ! -1 when the buffer has no capacity
            if(i >= 0 && n > i) n = i;
            for(i = 0 : i < n : i++) retval._bglText_setChar(i, chars->(i + WORDSIZE));
            retval._bglText_setLength(n);
            retval = retval._bglText_free();
        }
        return retval;
    }

    // Apply a $0..$3 pattern to s, returning a freed result
    var format(var s, var pattern, var p1 = 0, var p2 = 0, var p3 = 0) asI6 _bglText_format {
        bool lk_pattern = self.ambiguousLock(pattern);        bool lk_p1 = self.ambiguousLock(p1);
        bool lk_p2 = self.ambiguousLock(p2);
        bool lk_p3 = self.ambiguousLock(p3);
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_format(pattern, p1, p2, p3); str._bglText_free(); }
        self.ambiguousFree(p3, lk_p3);
        self.ambiguousFree(p2, lk_p2);
        self.ambiguousFree(p1, lk_p1);
        self.ambiguousFree(pattern, lk_pattern);
        return tmp;
    }

    // Cast a string-shaped value to a buffer; callers must wrap the result in ambiguousLock/Free
    var toAmbiguousBuffer(var unkStr) asI6 _bglText_toAmbiguousBuffer {
        var retval;
        #i6 {
            if(unkStr ofclass _bglString) return unkStr._bglText_getBuf();
            ! A null string reads as the empty one
            if(unkStr == 0){
                retval = _bglStringPool._bglText_allocateBuffer();
                _bglBuf._bglText_setLength(retval, 0);
                return _bglStringPool._bglText_freeBuffer(retval);
            }
            ! Not a _bglString, so a packed literal
            retval = _bglStringPool._bglText_allocateBuffer();
            _bglBuf._bglText_setFromLiteral(retval, unkStr);
            retval = _bglStringPool._bglText_freeBuffer(retval);
        }
        return retval;
    }

    // Lock buf if it is freed; pass the result to ambiguousFree
    bool ambiguousLock(var buf) asI6 _bglText_ambiguousLock {
        bool retval = false;
        #i6 {
            if(_bglStringPool._bglText_isFree(buf)) {
                _bglStringPool._bglText_reclaimBuffer(buf);
                _bglStringPool._bglText_reclaimString(buf);
                retval = true;
            }
        }
        return retval;
    }

    // Undo ambiguousLock
    void ambiguousFree(var buf, bool val) asI6 _bglText_ambiguousFree {
        if(val) {
            #i6 {
                _bglStringPool._bglText_freeBuffer(buf);
                _bglStringPool._bglText_freeString(buf);
            }
        }
    }

    // Compare any two string-shaped values; the first is locked across converting the second
    bool areEqual(var buf1, var buf2, bool caseInsensitive = false) asI6 _bglText_areEqual {
        buf1 = self.toAmbiguousBuffer(buf1);
        bool lck = self.ambiguousLock(buf1);
        buf2 = self.toAmbiguousBuffer(buf2);
        bool retval = _bglBuf.equals(buf1, buf2, caseInsensitive);
        self.ambiguousFree(buf1, lck);
        return retval;
    }

    // Order any two string-shaped values, returning -1, 0 or 1
    int compareValues(var buf1, var buf2, bool caseInsensitive = false) asI6 _bglText_compareValues {
        buf1 = self.toAmbiguousBuffer(buf1);
        bool lck = self.ambiguousLock(buf1);
        buf2 = self.toAmbiguousBuffer(buf2);
        int retval = _bglBuf.compare(buf1, buf2, caseInsensitive);
        self.ambiguousFree(buf1, lck);
        return retval;
    }

    // Character count of any string-shaped value
    int getLength(var s) asI6 _bglText_getLength {
        var str = self.new(s);
        int n;
        #i6 { n = str._bglText_getLength(); str._bglText_free(); }
        return n;
    }

    //-- Value-based surface ----
    // Mutating members are not here; they need a real instance
    int getChar(var s, int pos) asI6 _bglText_getChar {
        var str = self.new(s);
        int r;
        #i6 { r = str._bglText_getChar(pos); str._bglText_free(); }
        return r;
    }
    int indexOf(var s, var searchText, int startingIndex) asI6 _bglText_indexOf {
        bool lk_searchText = self.ambiguousLock(searchText);        var str = self.new(s);
        int r;
        #i6 { r = str._bglText_indexOf(searchText, startingIndex); str._bglText_free(); }
        self.ambiguousFree(searchText, lk_searchText);
        return r;
    }
    bool startsWith(var s, var prefix, bool caseInsensitive) asI6 _bglText_startsWith {
        bool lk_prefix = self.ambiguousLock(prefix);        var str = self.new(s);
        bool r;
        #i6 { r = str._bglText_startsWith(prefix, caseInsensitive); str._bglText_free(); }
        self.ambiguousFree(prefix, lk_prefix);
        return r;
    }
    bool endsWith(var s, var suffix, bool caseInsensitive) asI6 _bglText_endsWith {
        bool lk_suffix = self.ambiguousLock(suffix);        var str = self.new(s);
        bool r;
        #i6 { r = str._bglText_endsWith(suffix, caseInsensitive); str._bglText_free(); }
        self.ambiguousFree(suffix, lk_suffix);
        return r;
    }
    bool contains(var s, var searchText) asI6 _bglText_contains {
        bool lk_searchText = self.ambiguousLock(searchText);        var str = self.new(s);
        bool r;
        #i6 { r = str._bglText_contains(searchText); str._bglText_free(); }
        self.ambiguousFree(searchText, lk_searchText);
        return r;
    }
    bool isEmpty(var s) asI6 _bglText_isEmpty {
        var str = self.new(s);
        bool r;
        #i6 { r = str._bglText_isEmpty(); str._bglText_free(); }
        return r;
    }
    // Append s += $"…" via a temporary
    var beginAppend(var s) asI6 _bglText_beginAppend {
        var t = self.new();
        #i6 { _bglStrAppendTemps-->_bglStrAppendTop = t; _bglStrAppendTop++; t._bglText_capture(); }
        return s;
    }
    var endAppend(var s) asI6 _bglText_endAppend {
        var t;
        #i6 { _bglStrAppendTop--; t = _bglStrAppendTemps-->_bglStrAppendTop; t._bglText_release(); s._bglText_setFromStr(s._bglText_append(t)); t._bglText_free(); }
        return s;
    }
    var append(var s, var text) asI6 _bglText_append {
        bool lk_text = self.ambiguousLock(text);        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_append(text); str._bglText_free(); }
        self.ambiguousFree(text, lk_text);
        return tmp;    }
    var appendChar(var s, int c) asI6 _bglText_appendChar {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_appendChar(c); str._bglText_free(); }
        return tmp;    }
    var prependChar(var s, int c) asI6 _bglText_prependChar {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_prependChar(c); str._bglText_free(); }
        return tmp;    }
    var prepend(var s, var text) asI6 _bglText_prepend {
        bool lk_text = self.ambiguousLock(text);        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_prepend(text); str._bglText_free(); }
        self.ambiguousFree(text, lk_text);
        return tmp;    }
    var toUpper(var s) asI6 _bglText_toUpper {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_toUpper(); str._bglText_free(); }
        return tmp;    }
    var toLower(var s) asI6 _bglText_toLower {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_toLower(); str._bglText_free(); }
        return tmp;    }
    var trimLeft(var s) asI6 _bglText_trimLeft {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_trimLeft(); str._bglText_free(); }
        return tmp;    }
    var trimRight(var s) asI6 _bglText_trimRight {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_trimRight(); str._bglText_free(); }
        return tmp;    }
    var reverse(var s) asI6 _bglText_reverse {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_reverse(); str._bglText_free(); }
        return tmp;    }
    var mid(var s, int start, int count) asI6 _bglText_mid {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_mid(start, count); str._bglText_free(); }
        return tmp;    }
    var left(var s, int count) asI6 _bglText_left {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_left(count); str._bglText_free(); }
        return tmp;    }
    var right(var s, int count) asI6 _bglText_right {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_right(count); str._bglText_free(); }
        return tmp;    }
    var insert(var s, int pos, var source) asI6 _bglText_insert {
        bool lk_source = self.ambiguousLock(source);        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_insert(pos, source); str._bglText_free(); }
        self.ambiguousFree(source, lk_source);
        return tmp;    }
    var delete(var s, int pos, int count) asI6 _bglText_delete {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_delete(pos, count); str._bglText_free(); }
        return tmp;    }
    var replace(var s, var searchText, var replaceText) asI6 _bglText_replace {
        bool lk_searchText = self.ambiguousLock(searchText);        bool lk_replaceText = self.ambiguousLock(replaceText);
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_replace(searchText, replaceText); str._bglText_free(); }
        self.ambiguousFree(replaceText, lk_replaceText);
        self.ambiguousFree(searchText, lk_searchText);
        return tmp;    }
    var replaceAll(var s, var searchText, var replaceText) asI6 _bglText_replaceAll {
        bool lk_searchText = self.ambiguousLock(searchText);        bool lk_replaceText = self.ambiguousLock(replaceText);
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_replaceAll(searchText, replaceText); str._bglText_free(); }
        self.ambiguousFree(replaceText, lk_replaceText);
        self.ambiguousFree(searchText, lk_searchText);
        return tmp;    }

    // Trim leading and trailing whitespace
    var trim(var buf) asI6 _bglText_trim {
        var str = self.new(buf);
        var tmpStr;
        #i6 {
            tmpStr = str._bglText_trim();
            str._bglText_free();
        }
        return tmpStr;
    }

    // Print a literal, buffer, _bglString or routine; resolve buf through prop if given
    void print(var buf, var prop = 0) {
        #i6 {
            if(prop ~= 0){
                if(metaclass(buf.prop) == Routine){ buf.prop(); return; }   ! Run as the object's own method
                buf = buf.prop;
            }
            if(buf == 0) return;   ! Null prints nothing
            if(buf provides print) {
                buf.print();
                return;
            }
            if(metaclass(buf) == Routine) return buf();
        }
        _bglBuf.print(buf);
    }
}

//-- _bglStringLockStack: holds a call's temporary strings until the call returns ----
superposed _bglObject _bglStringLockStack {
    // Lock s if it is a freed pool string and push it
    var stackLock(var s) asI6 _bglText_stackLock {
        if(_bglStr.ambiguousLock(s)) {
            #i6 {
                if(_bglStringLockStackTop >= bglStringLockStackSize){
                    print "[ERROR: too many temporary strings in one expression.]";
                    return s;
                }
                _bglStringLockStackSlots-->_bglStringLockStackTop = s;
                _bglStringLockStackTop++;
            }
        }
        return s;
    }
    // Open a mark at the current height
    int stackMark() asI6 _bglText_stackMark {
        #i6 {
            if(_bglStringLockStackMarkTop >= bglStringLockStackSize){
                print "[ERROR: temporary strings nested too deeply.]";
                return 0;
            }
            _bglStringLockStackMarks-->_bglStringLockStackMarkTop = _bglStringLockStackTop;
            _bglStringLockStackMarkTop++;
        }
        return 0;
    }
    // Free back to the latest mark and close it, returning result
    var stackDrain(var result, int unused) asI6 _bglText_stackDrain {
        #i6 {
            if(_bglStringLockStackMarkTop == 0) return result;
            _bglStringLockStackMarkTop--;
            while(_bglStringLockStackTop > _bglStringLockStackMarks-->_bglStringLockStackMarkTop){
                _bglStringLockStackTop--;
                _bglStr._bglText_ambiguousFree(_bglStringLockStackSlots-->_bglStringLockStackTop, true);
            }
        }
        return result;
    }
}

//-- _bglString: a pooled string instance wrapping a sized buffer ----
class _bglString[bglStringPoolReserve] : bglAllocated {
    int _underlyingBuffer = 0;

    //-- Introspection ----
    int getLength() asI6 _bglText_getLength {
        int retval;
        #i6 { retval = _bglBuf._bglText_length(self._bglText_getBuf()); }
        return retval;
    }

    var getBuf(int suppressAllocation = 0) asI6 _bglText_getBuf {
        var retval;
        #i6 {
            if(self._underlyingBuffer == 0 && suppressAllocation == 0)
                self._underlyingBuffer = _bglStringPool._bglText_allocateBuffer();
            retval = self._underlyingBuffer;
        }
        return retval;
    }

    int getChar(int pos) asI6 _bglText_getChar {
        int retval;
        #i6 { retval = self._bglText_getBuf()->(pos + WORDSIZE); }
        return retval;
    }

    int getCharFromRight(int pos) asI6 _bglText_getCharFromRight {
        int retval;
        #i6 { retval = self._bglText_getChar(self._bglText_getLength() - (pos + 1)); }
        return retval;
    }

    bool isEmpty() asI6 _bglText_isEmpty {
        bool retval;
        #i6 { retval = (_bglBuf._bglText_length(self._bglText_getBuf()) == 0); }
        return retval;
    }

    //-- Lifecycle and pool state ----
    var clone() asI6 _bglText_clone {
        var retval;
        #i6 { retval = _bglStr._bglText_new(self); }
        return retval;
    }

    bool isLocked() asI6 _bglText_isLocked {
        bool retval;
        #i6 { retval = _bglStringPool._bglText_isLocked(self); }
        return retval;
    }

    bool isBufferLocked() asI6 _bglText_isBufferLocked {
        bool retval;
        #i6 { retval = _bglStringPool._bglText_isLocked(self._underlyingBuffer); }
        return retval;
    }

    var lock() asI6 _bglText_lock {
        #i6 { _bglStringPool._bglText_reclaimString(self); }
        return self;
    }

    var free() asI6 _bglText_free {
        #i6 { _bglStringPool._bglText_freeString(self); }
        return self;
    }

    //-- Mutation ----
    var set(var unkStr) asI6 _bglText_set {
        var ab;
        bool lckBuf;
        bool lckSelf;
        #i6 {
            ! Keep this order: lckSelf, ab, lckBuf
            lckSelf = _bglStr._bglText_ambiguousLock(self);
            ab      = _bglStr._bglText_toAmbiguousBuffer(unkStr);
            lckBuf  = _bglStr._bglText_ambiguousLock(ab);
            _bglBuf._bglText_setAny(self._bglText_getBuf(), ab);
            _bglStr._bglText_ambiguousFree(ab, lckBuf);
            _bglStr._bglText_ambiguousFree(self, lckSelf);
        }
        return self;
    }

    //-- Type-specific setters ----
    var setFromLit(var lit) asI6 _bglText_setFromLit {
        #i6 {
            ! A null string is the empty one
            if(lit == 0){ _bglBuf._bglText_setLength(self._bglText_getBuf(), 0); return self; }
            _bglBuf._bglText_setFromLiteral(self._bglText_getBuf(), lit);
        }
        return self;
    }
    var setFromStr(var src) asI6 _bglText_setFromStr {
        #i6 {
            ! A null string is the empty one
            if(src == 0){ _bglBuf._bglText_setLength(self._bglText_getBuf(), 0); return self; }
            ! Packed text arrives where a stringObj is expected
            if(metaclass(src) == String){ _bglBuf._bglText_setFromLiteral(self._bglText_getBuf(), src); return self; }
            _bglBuf._bglText_setFromBuffer(self._bglText_getBuf(), src._bglText_getBuf());
        }
        return self;
    }

    var setLength(int newLength) asI6 _bglText_setLength {
