//-----------------------------------------------------------------------------
// archive/string.bgl - the earlier, pool-based Beguile string runtime (archived 2026-10-21).
//
// <string> replaced it: there each string's buffer grows in a string heap. This one gives every
// string a fixed-size buffer from a pool. Include it as <archive/string>, instead of <string>.
//
// Backed during Phase 0 of the orString→Beguile port by an I6 island
// (_todostring.bgl) that holds the renamed orLibrary orString + orStringPool
// + orStr implementation. Later phases will progressively replace those I6
// routines with Beguile-native equivalents (easiest first, allocation core
// last) until the I6 island is gone.
//
// Usage:
//   #include <archive/string>      in your .bgl file, instead of <string>.
//
// Pool sizing can be overridden before including this file:
//   #i6 { Default bglStringPoolReserve 20; }            ! number of simultaneous strings
// The per-string capacity lives in <buf>, which the core loads first:
//   #emitfirst { Constant bglStringDefaultSize 800; }   ! per-string capacity in chars
//-----------------------------------------------------------------------------
#once
#declare BGL_STRING_POOL
#if BGL_STRING_HEAP
    #error "<archive/string> and <string> both provide stringObj; include one of them."
#endif

#include <buf>
// bglAllocated is now auto-loaded in core (no include needed); _bglString inherits it.
//------------------------------------------------------------------------------
// String pool & buffer allocation — I6 island (the last un-ported piece of the
// orString port). Folded in from the former root-level _todostring.bgl so the
// beguiLib root holds only user-includable extensions. This is string-internal
// machinery: _bglStringPool (the allocator), _bglDsbuf (the backing mega-buffer),
// _bglBufferWrapper, the live/free sentinel pools, and _bglInitializeStringBuffers
// (seeded from #startup above). It will disappear once the pool is ported to
// Beguile-native (see string.bgl's port note).
//------------------------------------------------------------------------------
#i6 {
    Constant _bglOverrunSetting "bglStringDefaultSize";        ! what <buf> names when printed text overruns its room
    Default bglStringLockStackSize 32;                          ! temporaries an operator can hold at once (_bglStringLockStack)
    Array _bglStringLockStackSlots --> bglStringLockStackSize;
    Global _bglStringLockStackTop = 0;
    Array _bglStringLockStackMarks --> bglStringLockStackSize;  ! the slot height at each open mark
    Global _bglStringLockStackMarkTop = 0;
    Array _bglStrAppendTemps --> 8;                             ! `s += $"…"` captures into one of these, nested
    Global _bglStrAppendTop = 0;
    ! bglStringDefaultSize is declared in <buf>, already in scope.

    Array _bglDsbuf buffer bglStringDefaultSize * bglBufferPoolReserve;  ! one mega-buffer carved into pool slots at startup

    class _bglBufferWrapper(bglBufferPoolReserve) with _bglText_buf 0;   ! buffer-as-object so it can move between sentinel containers

    object _bglAllocatedObjects;   ! sentinel — live pool (parent of currently-locked instances)
    object _bglObjectHeap;         ! sentinel — free pool (parent of available instances)

    ! _bglStr was here. Ported to Beguile-native (see string.bgl). I6-side
    ! callers (e.g. _bglString.set, _bglString.equals) still invoke
    ! _bglStr.X(...) — same I6 dispatch surface, just the implementation
    ! moved out.

    ! _bglString class was here. Ported to Beguile-native pooled class (see
    ! string.bgl). I6-side callers (_bglInitializeStringBuffers,
    ! _bglStringPool.allocateString, .freeString, etc.) still see _bglString
    ! as a class with create()/remaining()/.method() dispatch at link time —
    ! the I6 emission of the Beguile-declared class IS a Class _bglString(N).

    ! _bglStringPool provides a pattern to reuse buffers and _bglString instances, somewhat working around
    ! the fact memory cannot be dynamically allocated in the Z-machine
    object _bglStringPool
        private _allocateObj[type  !pick an arbitrary free object, lock it, and return it for use
                o retval;
            objectloop(o in _bglObjectHeap && o ofclass type) {
                retval=o;
                break;
            }
            if(retval==0) {
                #Ifdef TARGET_GLULX;
                    ! At startup no window is open yet to print the error in.
                    if(glk($0048) == 0) glk($002F, glk($0023, 0, 0, 0, 3, 0));
                #Endif;
                print "^[Beguile runtime error: the <string> pool is out of strings; raise bglStringPoolReserve]^";
                quit;
            }
            move retval to _bglAllocatedObjects;
            return retval;
        ]
    ,	_freeObj[obj; !take specific allocated object, and free it for later allocations
            if(obj==0) return 0;
            move obj to _bglObjectHeap;
            return obj;
        ]
    ,	_reclaimObj[obj; !take a specific free object, and lock it
            if(obj==0) return 0;
            move obj to _bglAllocatedObjects;
            return obj;
        ]
        !find the allocated object wrapper for the given buffer
    ,	_findAllocatedObjFromBuffer[b o;
            objectloop(o in _bglAllocatedObjects && o ofclass _bglBufferWrapper ) if(o._bglText_buf==b) return o;
            return 0;
        ]
            !find the unallocated object wrapper for the given buffer
    ,	_findAvailableObjFromBuffer[b o;
            objectloop(o in _bglObjectHeap && o ofclass _bglBufferWrapper ) if(o._bglText_buf==b) return o;
            return 0;
        ]
    ,	_bglText_isManagedBuffer[b; !-is the buffer one of the ones we manage in our allocation/free pool?
            if(self._findAllocatedObjFromBuffer(b)==0) rfalse;
            rtrue;
        ]
    ,	_findObjFromBuffer[b retval;
            retval=self._findAllocatedObjFromBuffer(b);
            if(retval==0) retval=self._findAvailableObjFromBuffer(b);
            return retval;
        ]
        !find the allocated object wrapper for the given buffer
    ,	_findAllocatedObj[b o;
            objectloop(o in _bglAllocatedObjects) if(o==b) return o;
            return 0;
        ]
        !find the unallocated object wrapper for the given buffer
    ,	_findAvailableObj[b o;
            objectloop(o in _bglObjectHeap) if(o==b) return o;
            return 0;
        ]
    with _bglText_allocateString[retval; !pick an arbitrary free string, lockit, then initialize it with an arbitrary free buffer; return the string
            retval = self._allocateObj(_bglString);
            retval._bglText_getBuf(); !force initilization
            return retval;
        ]
    ,	_bglText_freeString[str; !take a specific allocated string, and free it for later use
            self._bglText_freeBuffer(self._findAllocatedObj(str));
            self._freeObj(self._findAllocatedObj(str));

            return str;
        ]
    ,	_bglText_reclaimString[b retval; !take a previously freed string and lock it again
            retval = self._reclaimObj(self._findAvailableObj(b));
            if(retval~=0) self._bglText_reclaimBuffer(retval._bglText_getBuf(true));
            return retval;
        ]
    ,	_bglText_allocateBuffer[retval; !pick an arbitrary buffer, allocate it, and set its length to 0, returning it
            retval = self._allocateObj(_bglBufferWrapper)._bglText_buf;
            _bglBuf._bglText_setLength(retval,0);
            return retval;
        ]
    ,	_bglText_freeBuffer[b; !take a specific buffer and free it for later allocation
            self._freeObj(self._findAllocatedObjFromBuffer(b));
            return b;
        ]
    ,	_bglText_reclaimBuffer[b retval;
            retval = self._reclaimObj(self._findAvailableObjFromBuffer(b));
            if(retval~=0) return retval._bglText_buf;
            return 0;
        ]
    , 	_bglText_isLocked[obj;
            if(self._findAllocatedObj(obj)) return true;
            if(self._findAllocatedObjFromBuffer(obj)) return true;
            return false;
        ]
    ,	_bglText_isFree[obj;
            if(self._findAvailableObj(obj)) return true;
            if(self._findAvailableObjFromBuffer(obj)) return true;
            return false;
        ]
    ;

    ! _bglConvertToSizedBuffer was here. Ported to Beguile-native in <string>
    ! (see string.bgl). I6-side callers (currently _bglInitializeStringBuffers)
    ! invoke it by name as an ordinary I6 routine.

    [_bglInitializeStringBuffers
            i obj;
        for(i=0:_bglBufferWrapper.remaining()>0:i++){
            obj=_bglBufferWrapper.create();
            obj._bglText_buf=_bglDsbuf+(i*bglStringDefaultSize);
            obj._bglText_buf=_bglConvertToSizedBuffer(obj._bglText_buf,bglStringDefaultSize);
            move obj to _bglObjectHeap;
        }

        for(i=0:_bglString.remaining()>0:i++){
            obj=_bglString.create();
            obj._bglText_getBuf(); !lets make sure that we've associated a buffer to all strings: getBuf will allocate one if not previously allocated
            move obj to _bglObjectHeap;
        }
    ];
}

#startup {
    _bglInitializeStringBuffers();
}

//------------------------------------------------------------------------------
// _bglConvertToSizedBuffer — promote a raw buffer chunk to the SizedBuffer
// layout that <buf> uses everywhere: advance the user pointer by WORDSIZE+2
// and write the size word at offset -1. Returns the new user-visible pointer.
//
// The user pointer is also registered with _bglBuf for `isTracked()` lookups
// — the registry is the definitive source of truth for tracked-buffer status.
//
// DEPRECATED magic-byte slot: the 2 bytes at offsets -WORDSIZE-2 and
// -WORDSIZE-1 (immediately before the size word) used to hold a $90 $84
// magic stamp consumed by the old heuristic isTracked(). Phase B (registry +
// typed dispatch) removed the dependency, so this routine no longer writes
// the stamp. The slot is intentionally left reserved (allocation size and
// user-pointer offset unchanged) for the deprecation window — full prefix
// compaction is captured as pending follow-up.
//
// Called from _bglInitializeStringBuffers (still in the I6 island).
//------------------------------------------------------------------------------
array<char> _bglConvertToSizedBuffer(array<char> b, int sz) {
    if(_bglBuf.isTracked(b)) return b;
    array<char> result = _bglAsBuf((int)b + bgl.wordsize + 2);
    _bglSetWord(result, -1, sz - bgl.wordsize - bgl.wordsize - 2);
    _bglBuf._registerTracked(result);   // definitive tracking via registry
    return result;
}

//==============================================================================
// _bglStr — utility helpers operating on string-shaped values (literals,
// raw buffers, _bglString instances) regardless of which they actually are.
// These are INTERNAL plumbing — users of the string class never call into
// _bglStr directly. The "ambiguous dance" (ambiguousLock/ambiguousFree)
// negotiates lock state so callers don't have to know whether a value they
// got from a string helper is locked or ephemeral.
//
// Hybrid port stage: Beguile structure + types, with #i6 blocks for the
// cross-island dispatch into _bglStringPool and _bglString (still I6-side).
// When _bglStringPool and _bglString port to Beguile, these #i6 blocks
// can become typed Beguile expressions.
//==============================================================================
object _bglStr {
    // Allocate a new managed string. If unkStr is provided (non-zero), the
    // new string is initialized to its value (literal, buf, or _bglString —
    // ambiguousLock/Free handles all three cases).
    //
    // The trailing retval.lock() is load-bearing: allocateString() returns
    // an unlocked string from the pool. Early orLib testing showed removing
    // this lock() caused premature deallocation. Left in place pending a
    // full lifecycle test that proves it's redundant.
    var new(var unkStr = 0) asI6 _bglText_new {
        var retval; var lck;
        #i6 {
            lck    = self._bglText_ambiguousLock(unkStr);
            retval = _bglStringPool._bglText_allocateString();
            if(unkStr ~= 0) retval._bglText_set(unkStr);
            else retval._bglText_setLength(0);   ! a pooled buffer still holds its last text
            self._bglText_ambiguousFree(unkStr, lck);
            retval = retval._bglText_lock();
        }
        return retval;
    }

    // An `array<char>` as a string: copied into a pooled string returned freed (ephemeral), like
    // the other results here. A char array is laid out as a buffer is — a length word, then the
    // characters — but nothing at run time tells it from a packed literal, so it is converted
    // where its type is still known.
    var fromChars(var chars) asI6 _bglText_fromChars {
        var retval = self.new();
        int n; int i;
        #i6 {
            n = chars-->0;
            i = _bglBuf._bglText_size(retval._bglText_getBuf());   ! -1 when the buffer carries no capacity
            if(i >= 0 && n > i) n = i;
            for(i = 0 : i < n : i++) retval._bglText_setChar(i, chars->(i + WORDSIZE));
            retval._bglText_setLength(n);
            retval = retval._bglText_free();
        }
        return retval;
    }

    // Apply a $0/$1/$2/$3 format pattern to source string `s` (which becomes $0),
    // returning a freed (ephemeral) result. Mirrors appendChar/trim's contract:
    // the receiver-facing emitters route here as `_bglStr.format($val, …)` so the
    // bare `string` value type works, not just `stringObj`. `s` may be a literal,
    // a `string`, or a `_bglString` — `self.new` canonicalizes it.
    var format(var s, var pattern, var p1 = 0, var p2 = 0, var p3 = 0) asI6 _bglText_format {
        bool lk_pattern = self.ambiguousLock(pattern);   // an ephemeral argument must outlive the copies made below
        bool lk_p1 = self.ambiguousLock(p1);
        bool lk_p2 = self.ambiguousLock(p2);
        bool lk_p3 = self.ambiguousLock(p3);
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_format(pattern, p1, p2, p3); str._bglText_free(); }
        self.ambiguousFree(p3, lk_p3);
        self.ambiguousFree(p2, lk_p2);
        self.ambiguousFree(p1, lk_p1);
        self.ambiguousFree(pattern, lk_pattern);
        return tmp;   // ephemeral, same contract as trim()
    }

    // Cast any string-shaped value into a buffer suitable for _bglBuf operations.
    // Return value's lock state is "ambiguous": if the input was a _bglString,
    // the underlying buffer is locked; if a literal/raw, a freshly allocated
    // (and freed) buffer is returned. Callers MUST use ambiguousLock/Free to
    // safely operate on the return value.
    var toAmbiguousBuffer(var unkStr) asI6 _bglText_toAmbiguousBuffer {
        var retval;
        #i6 {
            if(unkStr ofclass _bglString) return unkStr._bglText_getBuf();
            ! A null string reads as the empty one.
            if(unkStr == 0){
                retval = _bglStringPool._bglText_allocateBuffer();
                _bglBuf._bglText_setLength(retval, 0);
                return _bglStringPool._bglText_freeBuffer(retval);
            }
            ! Phase B safety: at this point we KNOW unkStr is not a _bglString
            ! (ofclass check failed), so it's a packed string literal in practice.
            ! Skip _bglBuf.set's isTracked heuristic — go straight to setFromLiteral.
            ! Eliminates the residual isTracked-collision bug for all callers of
            ! toAmbiguousBuffer (insert, replace, indexOf, startsWith, etc.).
            retval = _bglStringPool._bglText_allocateBuffer();
            _bglBuf._bglText_setFromLiteral(retval, unkStr);
            retval = _bglStringPool._bglText_freeBuffer(retval);
        }
        return retval;
    }

    // If buf is currently in the pool's free list (ephemeral), temporarily
    // lock it. Returns true iff this call performed the lock — caller MUST
    // pass that bool back to ambiguousFree() to restore the prior state.
    bool ambiguousLock(var buf) asI6 _bglText_ambiguousLock {
        bool retval = false;
        #i6 {
            if(_bglStringPool._bglText_isFree(buf)) {
                _bglStringPool._bglText_reclaimBuffer(buf);
                _bglStringPool._bglText_reclaimString(buf);
                retval = true;
            }
        }
        return retval;
    }

    // Restore prior lock state — only frees if ambiguousLock returned true.
    void ambiguousFree(var buf, bool val) asI6 _bglText_ambiguousFree {
        if(val) {
            #i6 {
                _bglStringPool._bglText_freeBuffer(buf);
                _bglStringPool._bglText_freeString(buf);
            }
        }
    }

    // Equality check across any combination of string-shaped values.
    // Both operands go through toAmbiguousBuffer, which hands back an ephemeral
    // (already-freed) buffer for a literal. Converting the second operand allocates
    // again and would otherwise be handed the very buffer the first one is using —
    // making every literal-vs-literal comparison compare a value with itself. Lock
    // the first result across the second conversion, per toAmbiguousBuffer's contract.
    bool areEqual(var buf1, var buf2, bool caseInsensitive = false) asI6 _bglText_areEqual {
        buf1 = self.toAmbiguousBuffer(buf1);
        bool lck = self.ambiguousLock(buf1);
        buf2 = self.toAmbiguousBuffer(buf2);
        bool retval = _bglBuf.equals(buf1, buf2, caseInsensitive);
        self.ambiguousFree(buf1, lck);
        return retval;
    }

    // Ordering across any combination of string-shaped values. Returns -1/0/1 in
    // the qsort tradition, so it can be handed straight to array<T>.sort().
    int compareValues(var buf1, var buf2, bool caseInsensitive = false) asI6 _bglText_compareValues {
        buf1 = self.toAmbiguousBuffer(buf1);
        bool lck = self.ambiguousLock(buf1);       // see areEqual — hold across the 2nd conversion
        buf2 = self.toAmbiguousBuffer(buf2);
        int retval = _bglBuf.compare(buf1, buf2, caseInsensitive);
        self.ambiguousFree(buf1, lck);
        return retval;
    }

    // Character count of any string-shaped value. Takes the value as a PARAMETER so
    // new() can detect literal-vs-instance; a `$self.getLength()` message send would
    // fault on an array element or object property, which hold packed literals.
    // Allocate/use/free is net-zero on the pool (same shape as trim below).
    int getLength(var s) asI6 _bglText_getLength {
        var str = self.new(s);
        int n;
        #i6 { n = str._bglText_getLength(); str._bglText_free(); }
        return n;
    }

    // ── Value-based surface ───────────────────────────────────────────────────
    // Each takes the string as a PARAMETER so new() can detect literal-vs-instance.
    // The emitter surface on `string` routes here rather than sending a message to
    // the receiver, which would fault whenever the receiver is an array element or
    // object property (both hold packed literals). allocate/use/free is net-zero on
    // the pool. Mutating members (operator =, +=, []=, capture/release) are NOT here:
    // they change the receiver in place and genuinely require a real instance.
    int getChar(var s, int pos) asI6 _bglText_getChar {
        var str = self.new(s);
        int r;
        #i6 { r = str._bglText_getChar(pos); str._bglText_free(); }
        return r;
    }
    int indexOf(var s, var searchText, int startingIndex) asI6 _bglText_indexOf {
        bool lk_searchText = self.ambiguousLock(searchText);   // an ephemeral argument must outlive the copies made below
        var str = self.new(s);
        int r;
        #i6 { r = str._bglText_indexOf(searchText, startingIndex); str._bglText_free(); }
        self.ambiguousFree(searchText, lk_searchText);
        return r;
    }
    bool startsWith(var s, var prefix, bool caseInsensitive) asI6 _bglText_startsWith {
        bool lk_prefix = self.ambiguousLock(prefix);   // an ephemeral argument must outlive the copies made below
        var str = self.new(s);
        bool r;
        #i6 { r = str._bglText_startsWith(prefix, caseInsensitive); str._bglText_free(); }
        self.ambiguousFree(prefix, lk_prefix);
        return r;
    }
    bool endsWith(var s, var suffix, bool caseInsensitive) asI6 _bglText_endsWith {
        bool lk_suffix = self.ambiguousLock(suffix);   // an ephemeral argument must outlive the copies made below
        var str = self.new(s);
        bool r;
        #i6 { r = str._bglText_endsWith(suffix, caseInsensitive); str._bglText_free(); }
        self.ambiguousFree(suffix, lk_suffix);
        return r;
    }
    bool contains(var s, var searchText) asI6 _bglText_contains {
        bool lk_searchText = self.ambiguousLock(searchText);   // an ephemeral argument must outlive the copies made below
        var str = self.new(s);
        bool r;
        #i6 { r = str._bglText_contains(searchText); str._bglText_free(); }
        self.ambiguousFree(searchText, lk_searchText);
        return r;
    }
    bool isEmpty(var s) asI6 _bglText_isEmpty {
        var str = self.new(s);
        bool r;
        #i6 { r = str._bglText_isEmpty(); str._bglText_free(); }
        return r;
    }
    // `s += $"…"`: the interpolation is captured into a temporary, then appended.
    var beginAppend(var s) asI6 _bglText_beginAppend {
        var t = self.new();
        #i6 { _bglStrAppendTemps-->_bglStrAppendTop = t; _bglStrAppendTop++; t._bglText_capture(); }
        return s;
    }
    var endAppend(var s) asI6 _bglText_endAppend {
        var t;
        #i6 { _bglStrAppendTop--; t = _bglStrAppendTemps-->_bglStrAppendTop; t._bglText_release(); s._bglText_setFromStr(s._bglText_append(t)); t._bglText_free(); }
        return s;
    }
    var append(var s, var text) asI6 _bglText_append {
        bool lk_text = self.ambiguousLock(text);   // an ephemeral argument must outlive the copies made below
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_append(text); str._bglText_free(); }
        self.ambiguousFree(text, lk_text);
        return tmp;   // ephemeral, same contract as trim()
    }
    var appendChar(var s, int c) asI6 _bglText_appendChar {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_appendChar(c); str._bglText_free(); }
        return tmp;   // ephemeral, same contract as trim()
    }
    var prependChar(var s, int c) asI6 _bglText_prependChar {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_prependChar(c); str._bglText_free(); }
        return tmp;   // ephemeral, same contract as trim()
    }
    var prepend(var s, var text) asI6 _bglText_prepend {
        bool lk_text = self.ambiguousLock(text);   // an ephemeral argument must outlive the copies made below
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_prepend(text); str._bglText_free(); }
        self.ambiguousFree(text, lk_text);
        return tmp;   // ephemeral, same contract as trim()
    }
    var toUpper(var s) asI6 _bglText_toUpper {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_toUpper(); str._bglText_free(); }
        return tmp;   // ephemeral, same contract as trim()
    }
    var toLower(var s) asI6 _bglText_toLower {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_toLower(); str._bglText_free(); }
        return tmp;   // ephemeral, same contract as trim()
    }
    var trimLeft(var s) asI6 _bglText_trimLeft {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_trimLeft(); str._bglText_free(); }
        return tmp;   // ephemeral, same contract as trim()
    }
    var trimRight(var s) asI6 _bglText_trimRight {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_trimRight(); str._bglText_free(); }
        return tmp;   // ephemeral, same contract as trim()
    }
    var reverse(var s) asI6 _bglText_reverse {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_reverse(); str._bglText_free(); }
        return tmp;   // ephemeral, same contract as trim()
    }
    var mid(var s, int start, int count) asI6 _bglText_mid {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_mid(start, count); str._bglText_free(); }
        return tmp;   // ephemeral, same contract as trim()
    }
    var left(var s, int count) asI6 _bglText_left {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_left(count); str._bglText_free(); }
        return tmp;   // ephemeral, same contract as trim()
    }
    var right(var s, int count) asI6 _bglText_right {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_right(count); str._bglText_free(); }
        return tmp;   // ephemeral, same contract as trim()
    }
    var insert(var s, int pos, var source) asI6 _bglText_insert {
        bool lk_source = self.ambiguousLock(source);   // an ephemeral argument must outlive the copies made below
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_insert(pos, source); str._bglText_free(); }
        self.ambiguousFree(source, lk_source);
        return tmp;   // ephemeral, same contract as trim()
    }
    var delete(var s, int pos, int count) asI6 _bglText_delete {
        var str = self.new(s);
        var tmp;
        #i6 { tmp = str._bglText_delete(pos, count); str._bglText_free(); }
        return tmp;   // ephemeral, same contract as trim()
    }
