//=============================================================================
// <linq> — LINQ-style fluent chain operations for array<T>, split out of <array>
// so programs that use extended arrays but not chains don't pay for them.
// `#include <linq>` pulls in <array> automatically (LINQ builds on the
// tracked-array get/set/length/sort helpers).
//=============================================================================
#once
#include <array>

//-----------------------------------------------------------------------------
// Each chain step's result is a new array on the heap with its input's capacity, so a result assigned back
// (`held = held.filter(…)`) can still grow as the original could; nothing more is needed
// once the chain's result is freed (by the collector, or as soon as the next step has read it).
// `_bglLinqActiveDepth` counts the steps running, so a `catch` can restore it after a throw from a
// predicate or mapper.
//-----------------------------------------------------------------------------
#emitfirst{
    Global _bglLinqActiveDepth = 0;
}

// A chain step's result array, room for `n` elements; the step is running until _bglLinqLeave.
superposed array<var> _bglLinqEnter(int n){
    #i6 {
        _bglLinqActiveDepth++;
        if(n < 1) n = 1;
        return _bglHeapFresh(n);
    }
}
// A step's input that a call or a previous step returned (`prop` -1) is freed once read, when nothing holds it.
superposed void _bglLinqUsed(var obj, var prop){
    #i6 { if(prop == -1 && _bglHeapIsFresh(obj)) _bglHeapFree(obj); }
}
// A chain step has finished.
superposed void _bglLinqLeave(){
    #i6 { _bglLinqActiveDepth--; }
}

// LINQ-style fluent operations surface on array<T> (moved from <array>).
extend extern class array {
    // LINQ-style fluent operations. Each non-terminal returns a new array.
    // filter/distinct/orderBy etc. are type-preserving; map returns array<var>
    // because the mapper's output type can't be statically tracked.
    /// The elements `pred` accepts: `nums.filter((int n) => n > 3)`, as a new array.
    emitter array<T>   filter(func<bool, T> pred)   { _bglArray.filter($self, $prop, $pred) }
    /// Each element put through `f`. The result is `array<var>`: the mapper may return any type.
    emitter array<var> map(func<var, T> f)          { _bglArray.map($self, $prop, $f) }

    // Terminals — collapse a chain to a scalar, with no new array; receiver
    // type drives element type for first/last (returns T) and any/all (pred
    // signature). count is a plain alias of length() for naming familiarity.
    /// The first element, or 0 when empty (an error for a struct, which is never empty). A terminal — it ends the chain.
    emitter T    first()                            { _bglArray.first($self, $prop, $opref(deinit)) }
    /// The last element, or 0 when empty (an error for a struct). A terminal.
    emitter T    last()                             { _bglArray.last($self, $prop, $opref(deinit)) }
    /// How many elements. A terminal; the same number as `length`.
    emitter int  count()                            { _bglArray.chainCount($self, $prop) }
    /// True when at least one element satisfies `pred`. Stops at the first hit.
    emitter bool any(func<bool, T> pred)            { _bglArray.any($self, $prop, $pred) }
    /// True when every element satisfies `pred`. Stops at the first miss.
    emitter bool all(func<bool, T> pred)            { _bglArray.all($self, $prop, $pred) }

    // Slicing — all type-preserving, flip parity, return array<T>.
    /// The first `n` elements. Fewer if the array is shorter.
    emitter array<T> take(int n)                    { _bglArray.take($self, $prop, $n) }
    /// Everything after the first `n` elements.
    emitter array<T> skip(int n)                    { _bglArray.skip($self, $prop, $n) }
    /// Elements from the start until `pred` first fails. Unlike `filter`, it stops there.
    emitter array<T> takeWhile(func<bool, T> pred)  { _bglArray.takeWhile($self, $prop, $pred) }
    /// Elements from where `pred` first fails, to the end.
    emitter array<T> skipWhile(func<bool, T> pred)  { _bglArray.skipWhile($self, $prop, $pred) }

    // distinct / orderBy. distinct keeps first occurrence (O(N²) scan, fine at IF scale).
    // orderBy sorts a new copy with sort() — two overloads matching sort's surface.
    /// The elements with later duplicates dropped, first occurrence kept.
    emitter array<T> distinct()                          { _bglArray.distinct($self, $prop, $opref(==)) }
    /// Sorted ascending by the element type's `<=>`, into a new buffer. Unlike `sort()`, the source is left alone.
    emitter array<T> orderBy()                           { _bglArray.orderBy($self, $prop, $oprefReq(<=>)) }
    /// Sorted by your own comparison, which returns <0, 0 or >0.
    emitter array<T> orderBy(func<int, T, T> compare)    { _bglArray.orderBy($self, $prop, $compare) }
}

// LINQ non-terminals + terminals — extend the <array> utility object _bglArray.
extend _bglArray {
    // ── LINQ chain primitives ─────────────────────────────────────────────────
    // Each non-terminal reads elements 0..length-1 from `obj`, writes results
    // into a new array with room for all of them (_bglLinqEnter), sets its
    // length, and returns it.

    array<var> filter(var obj, var prop, func<bool, var> pred){
        array<var> dst = _bglLinqEnter(size(obj, prop));
        int writeCount = 0;
        int srcLen = length(obj, prop);
        for(int i = 0; i < srcLen; i++){
            var elem = get(obj, prop, i);
            if(pred(elem)){
                dst[writeCount] = elem;
                writeCount++;
            }
        }
        dst.length = writeCount;
        _bglLinqUsed(obj, prop);
        _bglLinqLeave();
        return dst;
    }

    // ── LINQ terminals ────────────────────────────────────────────────────────
    // No parity flip; these read from the receiver and return a scalar. count()
    // dispatches directly through the surface (no helper) since it's just length().
    // first/last return 0 on empty — same convention as pop/peek.
    // any/all short-circuit (first match wins for any; first non-match wins for all).

    int chainCount(var obj, var prop){
        int n = length(obj, prop);
        _bglLinqUsed(obj, prop);
        return n;
    }

    var first(var obj, var prop, var owned = 0){
        var r = 0;
        if(length(obj, prop) > 0) r = get(obj, prop, 0);
        else if(owned != 0) emptyValueError("first");
        _bglLinqUsed(obj, prop);
        return r;
    }

    // An element that is a value (a struct) has no 0 to stand for "none".
    void emptyValueError(string which){
        print("^[Beguile run-time error: ");
        print(which);
        print("() of an empty array of values; check count() first]^");
        #i6 { quit; }
    }

    var last(var obj, var prop, var owned = 0){
        var r = 0;
        int len = length(obj, prop);
        if(len > 0) r = get(obj, prop, len - 1);
        else if(owned != 0) emptyValueError("last");
        _bglLinqUsed(obj, prop);
        return r;
    }

    bool any(var obj, var prop, func<bool, var> pred){
        bool r = false;
        int len = length(obj, prop);
        for(int i = 0; i < len && !r; i++)
            if(pred(get(obj, prop, i))) r = true;
        _bglLinqUsed(obj, prop);
        return r;
    }

    bool all(var obj, var prop, func<bool, var> pred){
        bool r = true;
        int len = length(obj, prop);
        for(int i = 0; i < len && r; i++)
            if(!pred(get(obj, prop, i))) r = false;
        _bglLinqUsed(obj, prop);
        return r;
    }

    array<var> map(var obj, var prop, func<var, var> f){
        array<var> dst = _bglLinqEnter(size(obj, prop));
        int srcLen = length(obj, prop);
        for(int i = 0; i < srcLen; i++){
            dst[i] = f(get(obj, prop, i));
        }
        dst.length = srcLen;
        _bglLinqUsed(obj, prop);
        _bglLinqLeave();
        return dst;
    }

    // ── LINQ slicing ──────────────────────────────────────────────────────────
    // take/skip clamp negative and over-length arguments to the natural bounds
    // (a Beguile-idiomatic "be forgiving" choice — IF code often passes counts
    // derived from earlier ops where empty/full edges are common).
    // takeWhile/skipWhile follow the standard LINQ semantics: takeWhile stops at
    // the first element that fails the predicate; skipWhile drops while the
    // predicate matches, then keeps everything from the first failure on.

    array<var> take(var obj, var prop, int n){
        array<var> dst = _bglLinqEnter(size(obj, prop));
        int srcLen = length(obj, prop);
        int outLen = n;
        if(outLen < 0)      outLen = 0;
        if(outLen > srcLen) outLen = srcLen;
        for(int i = 0; i < outLen; i++) dst[i] = get(obj, prop, i);
        dst.length = outLen;
        _bglLinqUsed(obj, prop);
        _bglLinqLeave();
        return dst;
    }

    array<var> skip(var obj, var prop, int n){
        array<var> dst = _bglLinqEnter(size(obj, prop));
        int srcLen = length(obj, prop);
        int start = n;
        if(start < 0)      start = 0;
        if(start > srcLen) start = srcLen;
        int outLen = srcLen - start;
        for(int i = 0; i < outLen; i++) dst[i] = get(obj, prop, start + i);
        dst.length = outLen;
        _bglLinqUsed(obj, prop);
        _bglLinqLeave();
        return dst;
    }

    array<var> takeWhile(var obj, var prop, func<bool, var> pred){
        array<var> dst = _bglLinqEnter(size(obj, prop));
        int srcLen = length(obj, prop);
        int outLen = 0;
        for(int i = 0; i < srcLen; i++){
            if(!pred(get(obj, prop, i))) break;
            dst[outLen] = get(obj, prop, i);
            outLen++;
        }
        dst.length = outLen;
        _bglLinqUsed(obj, prop);
        _bglLinqLeave();
        return dst;
    }

    array<var> skipWhile(var obj, var prop, func<bool, var> pred){
        array<var> dst = _bglLinqEnter(size(obj, prop));
        int srcLen = length(obj, prop);
        int start = 0;
        while(start < srcLen && pred(get(obj, prop, start))) start++;
        int outLen = srcLen - start;
        for(int i = 0; i < outLen; i++) dst[i] = get(obj, prop, start + i);
        dst.length = outLen;
        _bglLinqUsed(obj, prop);
        _bglLinqLeave();
        return dst;
    }

    // ── LINQ distinct / orderBy ──────────────────────────────────────────────
    // distinct keeps the first occurrence of each value — an O(N²) scan, fine as
    // IF arrays are small. orderBy copies into a new array, then sorts that copy
    // in place with sort(), so the source array is left untouched.

    array<var> distinct(var obj, var prop, var op = 0){
        array<var> dst = _bglLinqEnter(size(obj, prop));
        int srcLen = length(obj, prop);
        int outLen = 0;
        for(int i = 0; i < srcLen; i++){
            var elem = get(obj, prop, i);
            bool seen = false;
            for(int j = 0; j < outLen; j++){
                var kept = dst[j];
                if(kept == elem){ seen = true; break; }
                #i6 {
                    if(op ~= 0 && kept ~= 0 && elem ~= 0 && op(kept, elem)){ seen = true; break; }
                }
            }
            if(!seen){
                dst[outLen] = elem;
                outLen++;
            }
        }
        dst.length = outLen;
        _bglLinqUsed(obj, prop);
        _bglLinqLeave();
        return dst;
    }

    array<var> orderBy(var obj, var prop, func<int, var, var> compare = 0){
        array<var> dst = _bglLinqEnter(size(obj, prop));
        int srcLen = length(obj, prop);
        for(int i = 0; i < srcLen; i++) dst[i] = get(obj, prop, i);
        dst.length = srcLen;
        sortDefault(dst, 0, compare);
        _bglLinqUsed(obj, prop);
        _bglLinqLeave();
        return dst;
    }
}
