//=============================================================================
// <linq> - LINQ-style fluent chain operations for array<T>
// #include <linq> pulls in <array> automatically
//=============================================================================
#once
#include <array>

// Counts running chain steps so a catch can restore it after a throw
#emitfirst{
    Global _bglLinqActiveDepth = 0;
}

// Begin a chain step and allocate its result array
superposed array<var> _bglLinqEnter(int n){
    #i6 {
        _bglLinqActiveDepth++;
        if(n < 1) n = 1;
        return _bglHeapFresh(n);
    }
}
// Free a step's input once read, if it was returned (prop -1) and nothing holds it
superposed void _bglLinqUsed(var obj, var prop){
    #i6 { if(prop == -1 && _bglHeapIsFresh(obj)) _bglHeapFree(obj); }
}
// End a chain step
superposed void _bglLinqLeave(){
    #i6 { _bglLinqActiveDepth--; }
}

extend class array {
    /// The elements `pred` accepts: `nums.filter((int n) => n > 3)`, as a new array.
    emitter array<T>   filter(func<bool, T> pred)   { _bglArray._bglArr_filter($self, $prop, $pred) }
    /// Each element put through `f`. The result is `array<var>`: the mapper may return any type.
    emitter array<var> map(func<var, T> f)          { _bglArray._bglArr_map($self, $prop, $f) }

    /// The first element, or 0 when empty (an error for a struct). A terminal.
    emitter T    first()                            { _bglArray._bglArr_first($self, $prop, $opref(deinit)) }
    /// The last element, or 0 when empty (an error for a struct). A terminal.
    emitter T    last()                             { _bglArray._bglArr_last($self, $prop, $opref(deinit)) }
    /// How many elements. A terminal; the same number as `length`.
    emitter int  count()                            { _bglArray._bglArr_chainCount($self, $prop) }
    /// True when at least one element satisfies `pred`. Stops at the first hit.
    emitter bool any(func<bool, T> pred)            { _bglArray._bglArr_any($self, $prop, $pred) }
    /// True when every element satisfies `pred`. Stops at the first miss.
    emitter bool all(func<bool, T> pred)            { _bglArray._bglArr_all($self, $prop, $pred) }

    /// The first `n` elements. Fewer if the array is shorter.
    emitter array<T> take(int n)                    { _bglArray._bglArr_take($self, $prop, $n) }
    /// Everything after the first `n` elements.
    emitter array<T> skip(int n)                    { _bglArray._bglArr_skip($self, $prop, $n) }
    /// Elements from the start until `pred` first fails. Unlike `filter`, it stops there.
    emitter array<T> takeWhile(func<bool, T> pred)  { _bglArray._bglArr_takeWhile($self, $prop, $pred) }
    /// Elements from where `pred` first fails, to the end.
    emitter array<T> skipWhile(func<bool, T> pred)  { _bglArray._bglArr_skipWhile($self, $prop, $pred) }

    /// The elements with later duplicates dropped, first occurrence kept.
    emitter array<T> distinct()                          { _bglArray._bglArr_distinct($self, $prop, $opref(==)) }
    /// Sorted ascending by the element type's `<=>`, as a new array.
    emitter array<T> orderBy()                           { _bglArray._bglArr_orderBy($self, $prop, $oprefReq(<=>)) }
    /// Sorted by your own comparison, which returns <0, 0 or >0.
    emitter array<T> orderBy(func<int, T, T> compare)    { _bglArray._bglArr_orderBy($self, $prop, $compare) }
}

extend _bglArray {
    // ── LINQ chain primitives ─────────────────────────────────────────────────

    array<var> filter(var obj, var prop, func<bool, var> pred) asI6 _bglArr_filter {
        array<var> dst = _bglLinqEnter(size(obj, prop));
        int writeCount = 0;
        int srcLen = length(obj, prop);
        for(int i = 0; i < srcLen; i++){
            var elem = get(obj, prop, i);
            if(pred(elem)){
                dst[writeCount] = elem;
                writeCount++;
            }
        }
        dst.length = writeCount;
        _bglLinqUsed(obj, prop);
        _bglLinqLeave();
        return dst;
    }

    // ── LINQ terminals ────────────────────────────────────────────────────────

    int chainCount(var obj, var prop) asI6 _bglArr_chainCount {
        int n = length(obj, prop);
        _bglLinqUsed(obj, prop);
        return n;
    }

    var first(var obj, var prop, var owned = 0) asI6 _bglArr_first {
        var r = 0;
        if(length(obj, prop) > 0) r = get(obj, prop, 0);
        else if(owned != 0) emptyValueError("first");
        _bglLinqUsed(obj, prop);
        return r;
    }

    // A struct element has no 0 to stand for none
    void emptyValueError(string which) asI6 _bglArr_emptyValueError {
        print("^[Beguile run-time error: ");
        print(which);
        print("() of an empty array of values; check count() first]^");
        #i6 { quit; }
    }

    var last(var obj, var prop, var owned = 0) asI6 _bglArr_last {
        var r = 0;
        int len = length(obj, prop);
        if(len > 0) r = get(obj, prop, len - 1);
        else if(owned != 0) emptyValueError("last");
        _bglLinqUsed(obj, prop);
        return r;
    }

    bool any(var obj, var prop, func<bool, var> pred) asI6 _bglArr_any {
        bool r = false;
        int len = length(obj, prop);
        for(int i = 0; i < len && !r; i++)
            if(pred(get(obj, prop, i))) r = true;
        _bglLinqUsed(obj, prop);
        return r;
    }

    bool all(var obj, var prop, func<bool, var> pred) asI6 _bglArr_all {
        bool r = true;
        int len = length(obj, prop);
        for(int i = 0; i < len && r; i++)
            if(!pred(get(obj, prop, i))) r = false;
        _bglLinqUsed(obj, prop);
        return r;
    }

    array<var> map(var obj, var prop, func<var, var> f) asI6 _bglArr_map {
        array<var> dst = _bglLinqEnter(size(obj, prop));
        int srcLen = length(obj, prop);
        for(int i = 0; i < srcLen; i++){
            dst[i] = f(get(obj, prop, i));
        }
        dst.length = srcLen;
        _bglLinqUsed(obj, prop);
        _bglLinqLeave();
        return dst;
    }

    // ── LINQ slicing ──────────────────────────────────────────────────────────
    // take/skip clamp out-of-range counts to the array bounds

    array<var> take(var obj, var prop, int n) asI6 _bglArr_take {
        array<var> dst = _bglLinqEnter(size(obj, prop));
        int srcLen = length(obj, prop);
        int outLen = n;
        if(outLen < 0)      outLen = 0;
        if(outLen > srcLen) outLen = srcLen;
        for(int i = 0; i < outLen; i++) dst[i] = get(obj, prop, i);
        dst.length = outLen;
        _bglLinqUsed(obj, prop);
        _bglLinqLeave();
        return dst;
    }

    array<var> skip(var obj, var prop, int n) asI6 _bglArr_skip {
        array<var> dst = _bglLinqEnter(size(obj, prop));
        int srcLen = length(obj, prop);
        int start = n;
        if(start < 0)      start = 0;
        if(start > srcLen) start = srcLen;
        int outLen = srcLen - start;
        for(int i = 0; i < outLen; i++) dst[i] = get(obj, prop, start + i);
        dst.length = outLen;
        _bglLinqUsed(obj, prop);
        _bglLinqLeave();
        return dst;
    }

    array<var> takeWhile(var obj, var prop, func<bool, var> pred) asI6 _bglArr_takeWhile {
        array<var> dst = _bglLinqEnter(size(obj, prop));
        int srcLen = length(obj, prop);
        int outLen = 0;
        for(int i = 0; i < srcLen; i++){
            if(!pred(get(obj, prop, i))) break;
            dst[outLen] = get(obj, prop, i);
            outLen++;
        }
        dst.length = outLen;
        _bglLinqUsed(obj, prop);
        _bglLinqLeave();
        return dst;
    }

    array<var> skipWhile(var obj, var prop, func<bool, var> pred) asI6 _bglArr_skipWhile {
        array<var> dst = _bglLinqEnter(size(obj, prop));
        int srcLen = length(obj, prop);
        int start = 0;
        while(start < srcLen && pred(get(obj, prop, start))) start++;
        int outLen = srcLen - start;
        for(int i = 0; i < outLen; i++) dst[i] = get(obj, prop, start + i);
        dst.length = outLen;
        _bglLinqUsed(obj, prop);
        _bglLinqLeave();
        return dst;
    }

    // ── LINQ distinct / orderBy ──────────────────────────────────────────────

    array<var> distinct(var obj, var prop, var op = 0) asI6 _bglArr_distinct {
        array<var> dst = _bglLinqEnter(size(obj, prop));
        int srcLen = length(obj, prop);
        int outLen = 0;
        for(int i = 0; i < srcLen; i++){
            var elem = get(obj, prop, i);
            bool seen = false;
            for(int j = 0; j < outLen; j++){
                var kept = dst[j];
                if(kept == elem){ seen = true; break; }
                #i6 {
                    if(op ~= 0 && kept ~= 0 && elem ~= 0 && op(kept, elem)){ seen = true; break; }
                }
            }
            if(!seen){
                dst[outLen] = elem;
                outLen++;
            }
        }
        dst.length = outLen;
        _bglLinqUsed(obj, prop);
        _bglLinqLeave();
        return dst;
    }

    array<var> orderBy(var obj, var prop, func<int, var, var> compare = 0) asI6 _bglArr_orderBy {
        array<var> dst = _bglLinqEnter(size(obj, prop));
        int srcLen = length(obj, prop);
        for(int i = 0; i < srcLen; i++) dst[i] = get(obj, prop, i);
        dst.length = srcLen;
        sortDefault(dst, 0, compare);
        _bglLinqUsed(obj, prop);
        _bglLinqLeave();
        return dst;
    }
}
