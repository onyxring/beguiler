#once
#if TARGET_ZCODE
    #error "<glulxImage> is a Glulx extension and is not compatible with the Z-machine. Set `target = Glulx`, or guard the include with `#if TARGET_GLULX`."
#endif
//=============================================================================
// glulxImage.bgl — a typed handle to a Glulx image resource (blorb asset)
// It reports an image's pixel size; drawing is done by windows and print rules.
//=============================================================================

array<int> _glkTmpSizeBuf[2];

// Get the natural pixel size of an image resource
bglSize _bglGetImageInfo(int imgId){
    int ptrWidth  = &_glkTmpSizeBuf + bgl.wordsize;   // Skip the array length slot
    int ptrHeight = ptrWidth + bgl.wordsize;
    bglSize retval;
    bgl.asm.imageGetInfo(imgId, ptrWidth, ptrHeight);
    retval.width  = _glkTmpSizeBuf[0];
    retval.height = _glkTmpSizeBuf[1];
    return retval;
}
int _imgWidth (int imgId){ return _bglGetImageInfo(imgId).width;  }
int _imgHeight(int imgId){ return _bglGetImageInfo(imgId).height; }

/// A picture from the blorb file. Ask it how big it is; draw it through a window's `drawImage()`
/// or a print rule.
primitive class glulxImage {
    emitter void operator = (eImages a){ $self = $a; }     
    emitter void operator = (int id)   { $self = $id; }    
    emitter int  operator ()           { ($self) }         
    emitter eImages operator ()       { ($self) }         

    /// The image's natural size in pixels.
    emitter bglSize size    { (_bglGetImageInfo($self)) }
    /// The image's natural width in pixels.
    emitter int     width   { (_imgWidth($self))  }
    /// The image's natural height in pixels.
    emitter int     height  { (_imgHeight($self)) }
}

// Size members on image assets, e.g. eImages.logo.width
extend enum eImages {
    /// The image's natural size in pixels.
    emitter bglSize size   { (_bglGetImageInfo($self)) }
    /// The image's natural width in pixels.
    emitter int     width  { (_imgWidth($self))  }
    /// The image's natural height in pixels.
    emitter int     height { (_imgHeight($self)) }
}
