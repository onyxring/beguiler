//-----------------------------------------------------------------------------
// buf.bgl - character buffer operations for the Beguile runtime
// Include <buf> to give array<char> a length, a capacity and text operations
//-----------------------------------------------------------------------------
#once
// Default capture buffer size; override early with #emitfirst
#emitfirst{
    Default bglStringDefaultSize 500; #Ifdef bglStringDefaultSize; #Endif;
}
extern int bglStringDefaultSize;

// Private copies: the I6 library declares its own only after anything emitted first
#if TARGET_GLULX
    const int _bglFilemodeWrite = 1;
    rawArray<int> _bglStreamCounts[2];   // Close counts: read, write
#endif

//-----------------------------------------------------------------------------
// Raw byte and word access; var accepts array<char> or int pointers
//-----------------------------------------------------------------------------
emitter int  _bglGetByte(var ptr, int offset)         { $ptr->($offset) }
emitter void _bglSetByte(var ptr, int offset, int v)  { $ptr->($offset) = $v }
emitter void _bglSetByte(var ptr, int offset, char v) { $ptr->($offset) = $v }
emitter int  _bglGetWord(var ptr, int offset)         { $ptr-->($offset) }
emitter void _bglSetWord(var ptr, int offset, int v)  { $ptr-->($offset) = $v }

// Relabel an int as array<char>
emitter array<char> _bglAsBuf(int p) { $p }

//-----------------------------------------------------------------------------
// Capture/release stacks, 16 deep; the Glulx one holds the streams to restore
//-----------------------------------------------------------------------------
array<var> _bglBufStreamStack[16];
array<int> _bglBufGlulxStreams[16];

// Registry of tracked buffers, sized from the string pool plus the program's own
#i6 {
    Default bglStringPoolReserve 10;
    Default bglBufferPoolReserve (bglStringPoolReserve + 2);
    Default bglTrackedBufferReserve 116;
    Constant _BGL_TRACKED_CAP (bglBufferPoolReserve + bglTrackedBufferReserve);
    Array _bglTrackedRegistry --> _BGL_TRACKED_CAP;
}

//=============================================================================
// Surface buf operations on byteArray
//=============================================================================
/// Gives an `array<char>` a length separate from its capacity.
extend class byteArray {
    /// How many bytes the buffer can hold.
    replace emitter int  size             { _bglBuf._bglText_size($val) }
    /// True when this buffer carries a length.
    emitter bool isTracked()              { _bglBuf._bglText_isTracked($val) }
    /// Copy another buffer's bytes and length into this one, up to this buffer's size.
    replace emitter void copyFrom(array<char> src) { _bglBuf._bglText_setFromBuffer($self, $src) }
    /// Print the bytes in use.
    emitter void print()                  { _bglBuf.print($val) }
}

/// With `<buf>`, a buffer's `length` is assignable.
extend class byteArrayLength {
    /// How many bytes are in use.
    replace emitter int  operator()       { _bglBuf._bglText_length($self) }
    /// Set how many bytes are in use.
    emitter void operator = (int n)       { _bglBuf._bglText_setLength($self, $n) }
}

//=============================================================================
// _bglBuf - buffer operations. Layout: size at buf-->(-1), length at buf-->0, data from buf->WORDSIZE
//=============================================================================
superposed object _bglBuf {
    // Capture stack depth
    int _stackTop = 0;
    // Count of registered buffers
    int _trackedCount = 0;
    // What a lenient release found printed past the room
    int _overran = 0;
    // Cut-short text, reported once no capture is active
    int _cutWritten = 0;
    int _cutRoom = 0;
    int _heapShort = 0;

    // ── Tracked-buf detection ────────────────────────────────────────────────
    // Membership test against the registry
    superposed bool isTracked(array<char> buf) asI6 _bglText_isTracked {
        int p = (int)buf;
        if(p == 0) return false;
        for(int i = 0; i < self._trackedCount; i++)
            #i6 { if(_bglTrackedRegistry-->i == p) rtrue; }
        return false;
    }

    // Register a buffer; on a full registry it is dropped with a runtime error
    superposed void _registerTracked(array<char> buf){
        #i6 {
            if(self._trackedCount >= _BGL_TRACKED_CAP){
                print "^[Beguile runtime: tracked buffer registry full; raise bglTrackedBufferReserve]^";
                return;
            }
            _bglTrackedRegistry-->(self._trackedCount) = buf;
        }
        self._trackedCount++;
    }

    // Remove a local buffer on return
    superposed void _unregisterTracked(array<char> buf){
        int p = (int)buf;
        for(int i = self._trackedCount - 1; i >= 0; i--)
            #i6 {
                if(_bglTrackedRegistry-->i == p){
                    self._trackedCount--;
                    _bglTrackedRegistry-->i = _bglTrackedRegistry-->(self._trackedCount);
                    return;
                }
            }
    }

    // Capacity in chars, -1 for null; not valid on an I6 buffer array (no size word)
    superposed int size(array<char> buf) asI6 _bglText_size {
        if((int)buf == 0) return -1;
        return _bglGetWord(buf, -1);
    }

    // Current char count
    superposed int length(array<char> buf) asI6 _bglText_length {
        return _bglGetWord(buf, 0);
    }

    // Set the char count, clamped to size
    superposed void setLength(array<char> buf, int newLength) asI6 _bglText_setLength {
        int sz = size(buf);
        if(sz >= 0 && newLength > sz) newLength = sz;
        _bglSetWord(buf, 0, newLength);
    }

    // ── Character access ──────────────────────────────────────────────────────
    superposed int getChar(array<char> buf, int pos) asI6 _bglText_getChar {
        int sz = size(buf);
        if(sz < 0 || sz > pos) return _bglGetByte(buf, pos + bgl.wordsize);
        return -1;
    }

    superposed void setChar(array<char> buf, int pos, int val) asI6 _bglText_setChar {
        int sz = size(buf);
        if(sz == -1 || sz > pos) _bglSetByte(buf, pos + bgl.wordsize, val);
    }
    superposed void setChar(array<char> buf, int pos, char val) asI6 _bglText_setChar {
        int sz = size(buf);
        if(sz == -1 || sz > pos) _bglSetByte(buf, pos + bgl.wordsize, val);
    }

    // ── Copy / write ──────────────────────────────────────────────────────────
    superposed array<char> set(array<char> buf, string stringVal) asI6 _bglText_set { return setFromLiteral(buf, stringVal); }
    superposed array<char> set(array<char> buf, array<char> src) asI6 _bglText_set { return setFromBuffer(buf, src); }

    // Copy from a tracked buffer or a packed string
    superposed array<char> setAny(array<char> buf, var stringVal) asI6 _bglText_setAny {
        if(isTracked(stringVal)) setFromBuffer(buf, stringVal);
        else                     setFromLiteral(buf, stringVal);
        return buf;
    }

    // Render a packed string into buf
    superposed array<char> setFromLiteral(array<char> buf, var stringVal) asI6 _bglText_setFromLiteral {
        int sz = size(buf);
        if(sz < 0) sz = bglStringDefaultSize;
        sz = sz + bgl.wordsize;   // print_to_array counts the length word in the array's size
        #i6 { stringVal.print_to_array(buf, sz); }
        int room = size(buf);
        if(room >= 0 && length(buf) > room){
            #if TARGET_ZCODE
                overrun(length(buf), room);
            #else
                cutShort(length(buf), room);
            #endif
        }
        setLength(buf, length(buf));
        return buf;
    }

    // Copy from another buffer
    superposed array<char> setFromBuffer(array<char> buf, array<char> stringVal) asI6 _bglText_setFromBuffer {
        int svlen = length(stringVal);
        copy(buf, stringVal, svlen, 0, 0);
        setLength(buf, svlen);
        return buf;
    }

    // Copy chars between buffers; -1 count means to the end of the source
    superposed array<char> copy(array<char> toBuf, array<char> fromBuf, int numCharsToCopy, int toPos = 0, int fromPos = 0) asI6 _bglText_copy {
        if(fromPos == -1) fromPos = 0;
        if(toPos == -1)   toPos = 0;
        int srcLen = length(fromBuf);
        if(numCharsToCopy < 0 || numCharsToCopy + fromPos > srcLen)
            numCharsToCopy = srcLen - fromPos;
        int tgtSize = size(toBuf);
        if(tgtSize >= 0 && numCharsToCopy + toPos > tgtSize)
            numCharsToCopy = tgtSize - toPos;
        int frmPtr = (int)fromBuf + fromPos + bgl.wordsize;
        int toPtr  = (int)toBuf  + toPos  + bgl.wordsize;
        #if TARGET_ZCODE
            bgl.asm.copyTable(frmPtr, toPtr, numCharsToCopy);
        #else
            bgl.asm.mcopy(numCharsToCopy, frmPtr, toPtr);
        #endif
        setLength(toBuf, toPos + numCharsToCopy);
        return toBuf;
    }

    // Z-machine overrun of the buffer: stop the program
    superposed void overrun(int written, int room) asI6 _bglBufOverrun {
        // Restore screen output first
        #if TARGET_ZCODE
            while(self._stackTop > 0){ self._stackTop--; bgl.asm.outputStream(-1 * 3); }
        #else
            if(self._stackTop > 0){ bgl.asm.streamSetCurrent(_bglBufGlulxStreams[0]); self._stackTop = 0; }
        #endif
        #i6 {
            print "^[Beguile run-time error: ", written, " characters were printed into room for ", room, "; raise ";
            #Ifdef _bglOverrunSetting; print (string) _bglOverrunSetting; #Ifnot; print "the buffer's size"; #Endif;
            print "]^";
            quit;
        }
    }

    // Text cut short; a debug build warns once no capture is active
    superposed void cutShort(int written, int room) asI6 _bglBufCutShort {
        self._cutWritten = written;
        self._cutRoom = room;
        warnFlush();
    }
    superposed void warnFlush() asI6 _bglBufWarnFlush {
        #i6 {
            #Ifdef DEBUG;
                if(self._stackTop > 0) return;
                if(self._heapShort){
                    self._heapShort = 0;
                    print "^[Beguile run-time warning: the string heap is full, so text was cut short; raise the stringHeapSize setting]^";
                }
                if(self._cutWritten){
                    print "^[Beguile run-time warning: ", self._cutWritten, " characters were printed into room for ", self._cutRoom, ", so the text was cut short; raise ";
                    #Ifdef _bglOverrunSetting; print (string) _bglOverrunSetting; #Ifnot; print "the buffer's size"; #Endif;
                    print "]^";
                    self._cutWritten = 0;
                }
            #Endif;
        }
    }

    // ── Stream redirect ───────────────────────────────────────────────────────
    // Redirect print output into buf; captures nest
    superposed void capture(array<char> buf, int maxBytes = 0) asI6 _bglText_capture {
        _bglBufStreamStack[self._stackTop] = buf;
        #if TARGET_ZCODE
            bgl.asm.outputStream(3, (int)buf);
        #else
            if(maxBytes == 0){
                int s = size(buf);
                maxBytes = (s < 0) ? bglStringDefaultSize : s;
            }
            _bglBufGlulxStreams[self._stackTop] = bgl.asm.streamGetCurrent();
            bgl.asm.streamSetCurrent(bgl.asm.streamOpenMemory((int)buf + bgl.wordsize, maxBytes, _bglFilemodeWrite, 662));
        #endif
        self._stackTop++;
    }

    // Restore output; on Z-code an overrun stops the program unless lenient, which sets _overran
    superposed array<char> release(bool lenient = false) asI6 _bglText_release {
        if(self._stackTop == 0) return _bglAsBuf(0);
        self._overran = 0;
        self._stackTop--;
        array<char> buf = _bglBufStreamStack[self._stackTop];
        #if TARGET_ZCODE
            bgl.asm.outputStream(-1 * 3);   // The VM writes the count into the length word
            int room = size(buf);
            if(room >= 0 && length(buf) > room){
                if(lenient) self._overran = length(buf);
                else overrun(length(buf), room);
            }
            setLength(buf, length(buf));
        #else
            bgl.asm.streamClose(bgl.asm.streamGetCurrent(), (int)_bglStreamCounts);
            // The write count includes bytes not kept
            bgl.asm.streamSetCurrent(_bglBufGlulxStreams[self._stackTop]);
            int room = size(buf);
            if(room >= 0 && _bglStreamCounts[1] > room) cutShort(_bglStreamCounts[1], room);
            setLength(buf, _bglStreamCounts[1]);
            warnFlush();
        #endif
        return buf;
    }

    superposed int stackLen() asI6 _bglText_stackLen {
        return self._stackTop;
    }

    // ── Print ─────────────────────────────────────────────────────────────────
    // Print the buf; len -1 prints all of it
    superposed array<char> print(array<char> buf, int len = -1){
        if((int)buf == 0) return buf;
        if(len <= 0) len = length(buf);
        #if TARGET_GLULX
            bgl.asm.putBuffer((int)buf + bgl.wordsize, len);
        #else
            for(int i = 0; i < len; i++){
                int c = _bglGetByte(buf, i + bgl.wordsize);
                if(c == 0) break;
                bgl.asm.printChar(c);
            }
        #endif
        return buf;
    }

    // ── Comparison ────────────────────────────────────────────────────────────
    // Compare character data for equality
    superposed bool equals(array<char> buf1, array<char> buf2, bool caseInsensitive = false) asI6 _bglText_equals {
        int len1 = length(buf1);
        if(len1 != length(buf2)) return false;
        for(int t = 0; t < len1; t++){
            int c1 = _bglGetByte(buf1, t + bgl.wordsize);
            int c2 = _bglGetByte(buf2, t + bgl.wordsize);
            if(caseInsensitive){
                c1 = _bglCharToLower(c1);
                c2 = _bglCharToLower(c2);
            }
            if(c1 != c2) return false;
        }
        return true;
    }

    // Order by byte value (-1, 0, 1); on Z-code uppercase sorts before lowercase
    superposed int compare(array<char> buf1, array<char> buf2, bool caseInsensitive = false) asI6 _bglText_compare {
        int len1 = length(buf1);
        int len2 = length(buf2);
        int lim  = len1 < len2 ? len1 : len2;
        for(int t = 0; t < lim; t++){
            int c1 = _bglGetByte(buf1, t + bgl.wordsize);
            int c2 = _bglGetByte(buf2, t + bgl.wordsize);
            if(caseInsensitive){
                c1 = _bglCharToLower(c1);
                c2 = _bglCharToLower(c2);
            }
            if(c1 != c2) return c1 < c2 ? -1 : 1;
        }
        if(len1 == len2) return 0;
        return len1 < len2 ? -1 : 1;
    }

    // Test the prefix
    superposed bool startsWith(array<char> buf1, array<char> buf2, bool caseInsensitive = false) asI6 _bglText_startsWith {
        int len2 = length(buf2);
        if(length(buf1) < len2) return false;
        for(int t = 0; t < len2; t++){
            int c1 = _bglGetByte(buf1, t + bgl.wordsize);
            int c2 = _bglGetByte(buf2, t + bgl.wordsize);
            if(caseInsensitive){
                c1 = _bglCharToLower(c1);
                c2 = _bglCharToLower(c2);
            }
            if(c1 != c2) return false;
        }
        return true;
    }

    // Test the suffix
    superposed bool endsWith(array<char> buf1, array<char> buf2, bool caseInsensitive = false) asI6 _bglText_endsWith {
        int len2 = length(buf2);
        int offset = length(buf1) - len2;
        if(offset < 0) return false;
        for(int t = 0; t < len2; t++){
            int c1 = _bglGetByte(buf1, offset + t + bgl.wordsize);
            int c2 = _bglGetByte(buf2, t + bgl.wordsize);
            if(caseInsensitive){
                c1 = _bglCharToLower(c1);
                c2 = _bglCharToLower(c2);
            }
            if(c1 != c2) return false;
        }
        return true;
    }

    // ── Substring extraction ──────────────────────────────────────────────────
    // Copy a range; -1 count means to the end, out-of-range values are clamped
    superposed array<char> mid(array<char> toBuf, array<char> fromBuf, int fromPos, int numCharsToCopy) asI6 _bglText_mid {
        int len = length(fromBuf);
        if(fromPos < 0) fromPos = 0;
        if(fromPos > len) fromPos = len;
        int maxLen = len - fromPos;
        if(numCharsToCopy == -1 || numCharsToCopy > maxLen) numCharsToCopy = maxLen;
        if(numCharsToCopy < 0) numCharsToCopy = 0;
        copy(toBuf, fromBuf, numCharsToCopy, 0, fromPos);
        setLength(toBuf, numCharsToCopy);
        return toBuf;
    }

    // Copy the first n chars
    superposed array<char> left(array<char> toBuf, array<char> fromBuf, int numCharsToCopy) asI6 _bglText_left {
        int len = length(fromBuf);
        if(numCharsToCopy > len) numCharsToCopy = len;
        if(numCharsToCopy < 0) numCharsToCopy = 0;
        copy(toBuf, fromBuf, numCharsToCopy, 0, 0);
        setLength(toBuf, numCharsToCopy);
        return toBuf;
    }

    // Copy the last n chars
    superposed array<char> right(array<char> toBuf, array<char> fromBuf, int numCharsToCopy) asI6 _bglText_right {
        int len = length(fromBuf);
        if(numCharsToCopy > len) numCharsToCopy = len;
        if(numCharsToCopy < 0) numCharsToCopy = 0;
        copy(toBuf, fromBuf, numCharsToCopy, 0, len - numCharsToCopy);
        setLength(toBuf, numCharsToCopy);
        return toBuf;
    }

    // ── Insertion / deletion ──────────────────────────────────────────────────
    // Insert at toPos; charCount 0 means all of fromBuf
    superposed array<char> insert(array<char> toBuf, array<char> fromBuf, int toPos, int charCount = 0) asI6 _bglText_insert {
        if(charCount <= 0) charCount = length(fromBuf);
        int len = length(toBuf);
        if(toPos < 0) toPos = 0;
        if(toPos > len) toPos = len;   // Past the end appends
        copy(toBuf, toBuf, len - toPos, toPos + charCount, toPos);
        copy(toBuf, fromBuf, charCount, toPos, 0);
        setLength(toBuf, len + charCount);
        return toBuf;
    }

    // Insert at the start
    superposed array<char> prepend(array<char> toBuf, array<char> fromBuf) asI6 _bglText_prepend { return prependBuffer(toBuf, fromBuf); }
    superposed array<char> prependBuffer(array<char> toBuf, array<char> fromBuf) asI6 _bglText_prependBuffer {
        insert(toBuf, fromBuf, 0, length(fromBuf));
        return toBuf;
    }

    // Add to the end
    superposed array<char> append(array<char> toBuf, array<char> fromBuf) asI6 _bglText_append { return appendBuffer(toBuf, fromBuf); }
    superposed array<char> appendBuffer(array<char> toBuf, array<char> fromBuf) asI6 _bglText_appendBuffer {
        copy(toBuf, fromBuf, -1, length(toBuf), 0);
        return toBuf;
    }

    // Append a string, preserving the text its length word overwrites
    superposed array<char> append(array<char> toBuf, string text) asI6 _bglText_append {
        int len = length(toBuf);
        int sz = size(toBuf);
        if(sz < 0) sz = bglStringDefaultSize;
        int n = 0;
        int saved = 0;
        #i6 {
            saved = (toBuf + len)-->0;
            text.print_to_array(toBuf + len, sz - len);
            n = (toBuf + len)-->0;
            (toBuf + len)-->0 = saved;
        }
        setLength(toBuf, len + n);
        return toBuf;
    }

    // Prepend a string by appending, then rotating
    superposed array<char> prepend(array<char> toBuf, string text) asI6 _bglText_prepend {
        int len = length(toBuf);
        append(toBuf, text);
        int total = length(toBuf);
        reverseRange(toBuf, 0, total);
        reverseRange(toBuf, 0, total - len);
        reverseRange(toBuf, total - len, total);
        return toBuf;
    }

    // Reverse the range [from, to)
    superposed void reverseRange(array<char> buf, int from, int to) asI6 _bglText_reverseRange {
        int w = bgl.wordsize;
        for(to = to - 1; from < to; from++){
            int c = _bglGetByte(buf, from + w);
            _bglSetByte(buf, from + w, _bglGetByte(buf, to + w));
            _bglSetByte(buf, to + w, c);
            to--;
        }
    }

    // Remove count chars at pos
    superposed array<char> delete(array<char> buf, int pos, int count) asI6 _bglText_delete {
        int len = length(buf);
        copy(buf, buf, len - count, pos, pos + count);
        setLength(buf, len - count);
        return buf;
    }

    // ── Search / replace ──────────────────────────────────────────────────────
    // Replace the first occurrence
    superposed array<char> replace(array<char> buf, array<char> searchTextBuf, array<char> replaceTextBuf) asI6 _bglText_replace {
        int searchLen = length(searchTextBuf);
        int pos = indexOf(buf, searchTextBuf, 0);
        if(pos == -1) return buf;
        self.delete(buf, pos, searchLen);
        insert(buf, replaceTextBuf, pos, 0);
        return buf;
    }

    // Replace all occurrences from startingIndex
    superposed array<char> replaceAll(array<char> buf, array<char> searchTextBuf, array<char> replaceTextBuf, int startingIndex = 0) asI6 _bglText_replaceAll {
        int searchLen = length(searchTextBuf);
        int rtlen = length(replaceTextBuf);
        if(searchLen == 0) return buf;
        // Resume after the inserted text so replacements are not re-matched
        int pos = indexOf(buf, searchTextBuf, startingIndex);
        while(pos != -1){
            self.delete(buf, pos, searchLen);
            insert(buf, replaceTextBuf, pos, 0);
            pos = indexOf(buf, searchTextBuf, pos + rtlen);
        }
        return buf;
    }

    // Index of the first match at or after startingIndex, or -1
    superposed int indexOf(array<char> buf, array<char> searchTextBuf, int startingIndex = 0) asI6 _bglText_indexOf {
        int stblen = length(searchTextBuf);
        int blen   = length(buf);
        if(startingIndex < 0) startingIndex = 0;
        for(int o = startingIndex; o + stblen <= blen; o++){
            int i;
            for(i = 0; i < stblen; i++){
                if(_bglGetByte(buf, o + i + bgl.wordsize) != _bglGetByte(searchTextBuf, i + bgl.wordsize)) break;
            }
            if(i == stblen) return o;
        }
        return -1;
    }

    // Index of the first char satisfying pred, or -1
    superposed int indexOfFirstTrue(array<char> buf, func<bool, char> pred, int startingIndex = 0) asI6 _bglText_indexOfFirstTrue {
        int buflen = length(buf);
        if(startingIndex < 0) startingIndex = 0;
        for(int o = startingIndex; o < buflen; o++){
            char c = _bglGetByte(buf, o + bgl.wordsize);
            if(pred(c)) return o;
        }
        return -1;
    }

    // Index of the first char failing pred, or -1
    superposed int indexOfFirstFalse(array<char> buf, func<bool, char> pred, int startingIndex = 0) asI6 _bglText_indexOfFirstFalse {
        int buflen = length(buf);
        if(startingIndex < 0) startingIndex = 0;
        if(startingIndex > buflen) return -1;
        for(int o = startingIndex; o < buflen; o++){
            char c = _bglGetByte(buf, o + bgl.wordsize);
            if(!pred(c)) return o;
        }
        return -1;
    }

    // ── Case transforms ──────────────────────────────────────────────────────
    superposed array<char> toUpper(array<char> buf) asI6 _bglText_toUpper {
        int buflen = length(buf);
        for(int t = 0; t < buflen; t++)
            _bglSetByte(buf, t + bgl.wordsize, _bglCharToUpper(_bglGetByte(buf, t + bgl.wordsize)));
        return buf;
    }

    superposed array<char> toLower(array<char> buf) asI6 _bglText_toLower {
        int buflen = length(buf);
        for(int t = 0; t < buflen; t++)
            _bglSetByte(buf, t + bgl.wordsize, _bglCharToLower(_bglGetByte(buf, t + bgl.wordsize)));
        return buf;
    }

    superposed array<char> reverse(array<char> buf) asI6 _bglText_reverse {
        int buflen = length(buf);
        for(int t = 0; t < buflen / 2; t++){
            int c = _bglGetByte(buf, t + bgl.wordsize);
            _bglSetByte(buf, t + bgl.wordsize, _bglGetByte(buf, buflen - t - 1 + bgl.wordsize));
            _bglSetByte(buf, buflen - t - 1 + bgl.wordsize, c);
        }
        return buf;
    }

    superposed array<char> trimLeft(array<char> buf) asI6 _bglText_trimLeft {
        while(length(buf) > 0 && getChar(buf, 0) == ' ') self.delete(buf, 0, 1);
        return buf;
    }

    superposed array<char> trimRight(array<char> buf) asI6 _bglText_trimRight {
        while(length(buf) > 0 && getChar(buf, length(buf) - 1) == ' ')
            self.delete(buf, length(buf) - 1, 1);
        return buf;
    }

    superposed array<char> trim(array<char> buf) asI6 _bglText_trim {
        return trimRight(trimLeft(buf));
    }
}

extend _bglUtil {
    alias buf = _bglBuf;   /// Text-buffer operations.
}
