            fmt = _bglStr._bglText_new(fmt);  ! convert literal-or-otherwise to _bglString
            fmt._bglText_set(fmt._bglText_replaceAll("$0", self));

            if(p1 ~= 0) fmt._bglText_set(fmt._bglText_replaceAll("$1", p1));
            if(p2 ~= 0) fmt._bglText_set(fmt._bglText_replaceAll("$2", p2));
            if(p3 ~= 0) fmt._bglText_set(fmt._bglText_replaceAll("$3", p3));

            retval._bglText_set(fmt);
            fmt._bglText_free();
            retval = retval._bglText_free();
        }
        return retval;
    }
}

//------------------------------------------------------------------------------
// Beguile string class extension. The instance methods dispatch via $self into
// the _bglString class methods defined in the I6 island (one-line .X() calls).
// Helpers that operate on bare literals/raw buffers route through _bglStr.
//------------------------------------------------------------------------------


/// `<string>` upgrades `string` from I6's address semantics: `==` now compares TEXT, and the query
/// and transform methods below become available. A `string` still owns no storage — every method
/// that changes text returns a new `stringObj`.
extend class string {
    // NO lifecycle. A `string` is a slot holding a pointer to static text: it allocates
    // nothing and frees nothing. `stringObj` is the slot that owns a pool buffer.

    // Assignment — Phase B: type-discriminated dispatch eliminates isTracked()
    // false-positive risk that could surface when a packed-string address
    // numerically collided with a tracked-buffer user pointer.
    // Assignment REPOINTS the slot — a plain word write; there is no buffer to copy into.
    // An interpolated literal must be built at runtime, so it needs a stringObj.
    replace emitter string operator = (stringLiteral v)         { $target = $v }
    emitter string operator = (string v)                        { $target = $v }

    // Concatenation: returns ephemeral copy with rhs appended; lhs is not mutated.
    // str3 = str1 + str2  =>  str3.set(str1.append(str2))
    emitter stringObj operator + (stringLiteral v) { _bglStr._bglText_append($val, $v) }
    emitter stringObj operator + (string v)        { _bglStr._bglText_append($val, $v) }
    emitter stringObj operator + (stringObj v)     { _bglStr._bglText_append($val, $v) }

    // Compound concatenation: s += v  ≡  s = s + v. Unlike `+`, this mutates the
    // lhs in place — append() produces the joined (ephemeral) copy and setFromStr
    // copies it back into self.
    // No `+=` and no `[]=` — mutation needs a buffer this type does not own. Use stringObj.

    // Equality — Phase B typed dispatch
    // `replace` — core declares these as address equality; <string> upgrades them to
    // content comparison. `!=` must be replaced alongside `==`, or the two would
    // disagree (content vs address) on the same pair of values.
    replace emitter eBool operator == (stringLiteral v) { _bglStr._bglText_areEqual($val, $v, false) }
    replace emitter eBool operator == (string v)        { _bglStr._bglText_areEqual($val, $v, false) }
    replace emitter eBool operator == (stringObj v)     { _bglStr._bglText_areEqual($val, $v, false) }
    replace emitter eBool operator != (stringLiteral v) { (~~_bglStr._bglText_areEqual($val, $v, false)) }
    replace emitter eBool operator != (string v)        { (~~_bglStr._bglText_areEqual($val, $v, false)) }
    replace emitter eBool operator != (stringObj v)     { (~~_bglStr._bglText_areEqual($val, $v, false)) }
    emitter eBool operator =~ (stringLiteral v) { _bglStr._bglText_areEqual($val, $v, true) }   /// True when both are the same text, ignoring case.
    emitter eBool operator =~ (string v)        { _bglStr._bglText_areEqual($val, $v, true) }   /// True when both are the same text, ignoring case.
    emitter eBool operator =~ (stringObj v)     { _bglStr._bglText_areEqual($val, $v, true) }   /// True when both are the same text, ignoring case.

    // Switch comparison — Phase B typed dispatch
    emitter eBool operator switch(stringLiteral v) { _bglStr._bglText_areEqual($val, $v, false) }
    emitter eBool operator switch(string v)        { _bglStr._bglText_areEqual($val, $v, false) }

    // Comparison published for generic containers. `static` means no receiver, so these
    // emit as free routines whose address array<T> can be handed — the only shape that can
    // serve a PACKED LITERAL element, which has no properties to dispatch on. Both operands
    // arrive as parameters, so toAmbiguousBuffer can sort out literal-vs-instance for each.
    // `static` = no receiver, so this emits as a free routine whose address array<T> can be
    // handed — the only shape that can serve a PACKED LITERAL element, which has no properties
    // to dispatch on. Taking both operands is what makes that possible. A static operator is
    // never selected at an ordinary `a == b` site; the instance operators above own those.
    static bool operator == (var a, var b) { return _bglStr.areEqual(a, b, false); }
    static int  operator <=> (var a, var b) { return _bglStr.compareValues(a, b, false); }

    // Ordering — lexicographic by content, NOT by the packed address. Each
    // yields a bool, so `a < b` reads the way it does for numbers.
    //
    // A sort comparator needs a signed -1/0/+1 ordering rather than a bool, so
    // reach for compareTo() there:  arr.sort((string a, string b) => a.compareTo(b));
    emitter eBool operator <  (stringLiteral v) { (_bglStr._bglText_compareValues($val, $v, false) < 0) }
    emitter eBool operator <  (string v)        { (_bglStr._bglText_compareValues($val, $v, false) < 0) }
    emitter eBool operator >  (stringLiteral v) { (_bglStr._bglText_compareValues($val, $v, false) > 0) }
    emitter eBool operator >  (string v)        { (_bglStr._bglText_compareValues($val, $v, false) > 0) }
    emitter eBool operator <= (stringLiteral v) { (_bglStr._bglText_compareValues($val, $v, false) <= 0) }
    emitter eBool operator <= (string v)        { (_bglStr._bglText_compareValues($val, $v, false) <= 0) }
    emitter eBool operator >= (stringLiteral v) { (_bglStr._bglText_compareValues($val, $v, false) >= 0) }
    emitter eBool operator >= (string v)        { (_bglStr._bglText_compareValues($val, $v, false) >= 0) }

    // Indexed character access
    emitter char operator[](int pos)                  { _bglStr._bglText_getChar($val, $pos) }

    // Query — enables ?., ??, and postfix ? for null (unallocated) checks
    replace emitter eBool operator ?() { $self ~= 0 }

    // Methods
    replace emitter void  print()                          { _bglStr.print($val) }

    /// Return a NEW string with `v` joined on. This one does not change the original — `stringObj` is the type that can be mutated.
    emitter stringObj  append(string v)                      { _bglStr._bglText_append($val, $v) }
    /// Return a new string with one character joined on.
    emitter stringObj  append(char v)                        { _bglStr._bglText_appendChar($val, $v) }
    emitter stringObj  append(array<char> v)                        { _bglStr._bglText_append($val, _bglStr._bglText_fromChars($v)) }
    /// Return a new string with `v` joined on the FRONT.
    emitter stringObj  prepend(char v)                       { _bglStr._bglText_prependChar($val, $v) }
    emitter stringObj  prepend(var v)                        { _bglStr._bglText_prepend($val, $v) }
    emitter stringObj prepend(array<char> v) { _bglStr._bglText_prepend($val, _bglStr._bglText_fromChars($v)) }
    /// Return an upper-case copy.
    emitter stringObj  toUpper()                             { _bglStr._bglText_toUpper($val) }
    /// Return a lower-case copy.
    emitter stringObj  toLower()                             { _bglStr._bglText_toLower($val) }
    /// Return a copy with leading and trailing whitespace removed.
    emitter stringObj  trim()                                { _bglStr._bglText_trim($val) }
    /// Return a copy with leading whitespace removed.
    emitter stringObj  trimLeft()                            { _bglStr._bglText_trimLeft($val) }
    /// Return a copy with trailing whitespace removed.
    emitter stringObj  trimRight()                           { _bglStr._bglText_trimRight($val) }
    /// Return a copy with the characters in reverse order.
    emitter stringObj  reverse()                             { _bglStr._bglText_reverse($val) }
    /// Return `count` characters starting at `start`, counting from 0.
    emitter stringObj  mid(int start, int count)             { _bglStr._bglText_mid($val, $start, $count) }
    /// Return the first `count` characters.
    emitter stringObj  left(int count)                       { _bglStr._bglText_left($val, $count) }
    /// Return the last `count` characters.
    emitter stringObj  right(int count)                      { _bglStr._bglText_right($val, $count) }
    /// Return a copy with `source` inserted at `pos`.
    emitter stringObj  insert(int pos, var source)           { _bglStr._bglText_insert($val, $pos, $source) }
    /// Return a copy with `count` characters removed from `pos`.
    emitter stringObj  delete(int pos, int count)            { _bglStr._bglText_delete($val, $pos, $count) }
    /// Return a copy with the FIRST `searchText` swapped for `replaceText`.
    emitter stringObj  replace(char c, var replaceText)      { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_replace($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), $replaceText), _bglStringLockStack._bglText_stackMark()) }
    emitter stringObj  replaceAll(char c, var replaceText)   { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_replaceAll($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), $replaceText), _bglStringLockStack._bglText_stackMark()) }
    emitter stringObj  replace(char c, char r)               { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_replace($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $r))), _bglStringLockStack._bglText_stackMark()) }
    emitter stringObj  replaceAll(char c, char r)            { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_replaceAll($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $r))), _bglStringLockStack._bglText_stackMark()) }
    emitter stringObj  replace(var searchText, char r)       { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_replace($val, $searchText, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $r))), _bglStringLockStack._bglText_stackMark()) }
    emitter stringObj  replaceAll(var searchText, char r)    { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_replaceAll($val, $searchText, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $r))), _bglStringLockStack._bglText_stackMark()) }
    emitter stringObj  replace(var searchText, var replaceText)    { _bglStr._bglText_replace($val, $searchText, $replaceText) }
    /// Return a copy with EVERY `searchText` swapped for `replaceText`.
    emitter stringObj  replaceAll(var searchText, var replaceText) { _bglStr._bglText_replaceAll($val, $searchText, $replaceText) }
    /// Substitute `$0`, `$1`… in `pattern` with this string and any extra arguments.
    emitter stringObj  format(var pattern)                                               { _bglStr._bglText_format($val, $pattern) }
    emitter stringObj  format(var pattern, string | stringObj p1)                        { _bglStr._bglText_format($val, $pattern, $p1) }
    emitter stringObj  format(var pattern, string | stringObj p1, string | stringObj p2) { _bglStr._bglText_format($val, $pattern, $p1, $p2) }
    /// How many characters, not counting a terminator.
    emitter int     length                                { _bglStr._bglText_getLength($val) }
    /// Order two strings by content: <0, 0 or >0. This is the comparison to hand `sort`.
    emitter int     compareTo(var other)                  { _bglStr._bglText_compareValues($val, $other, false) }
    emitter int compareTo(array<char> other) { _bglStr._bglText_compareValues($val, _bglStr._bglText_fromChars($other), false) }
    /// Order by content, optionally ignoring case.
    emitter int     compareTo(var other, bool ci)         { _bglStr._bglText_compareValues($val, $other, $ci) }
    /// Position of the first `searchText`, counting from 0, or -1.
    emitter int     indexOf(var searchText)               { _bglStr._bglText_indexOf($val, $searchText, 0) }
    emitter int indexOf(array<char> searchText) { _bglStr._bglText_indexOf($val, _bglStr._bglText_fromChars($searchText), 0) }
    /// True when the string begins with `prefix`.
    emitter eBool   startsWith(var prefix)                { _bglStr._bglText_startsWith($val, $prefix, false) }
    emitter eBool startsWith(array<char> prefix) { _bglStr._bglText_startsWith($val, _bglStr._bglText_fromChars($prefix), false) }
    /// True when the string ends with `suffix`.
    emitter eBool   endsWith(var suffix)                  { _bglStr._bglText_endsWith($val, $suffix, false) }
    emitter eBool endsWith(array<char> suffix) { _bglStr._bglText_endsWith($val, _bglStr._bglText_fromChars($suffix), false) }
    /// True when `searchText` appears anywhere.
    emitter eBool   contains(var searchText)              { _bglStr._bglText_contains($val, $searchText) }
    emitter eBool contains(array<char> searchText) { _bglStr._bglText_contains($val, _bglStr._bglText_fromChars($searchText)) }
    /// The position of the character `c`, or -1.
    emitter int     indexOf(char c)                       { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_indexOf($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), 0), _bglStringLockStack._bglText_stackMark()) }
    /// True when the text starts with the character `c`.
    emitter eBool   startsWith(char c)                    { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_startsWith($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), false), _bglStringLockStack._bglText_stackMark()) }
    /// True when the text ends with the character `c`.
    emitter eBool   endsWith(char c)                      { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_endsWith($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), false), _bglStringLockStack._bglText_stackMark()) }
    /// True when the text holds the character `c`.
    emitter eBool   contains(char c)                      { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_contains($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c))), _bglStringLockStack._bglText_stackMark()) }
    /// A copy with the character `c` inserted at `pos`.
    emitter stringObj insert(int pos, char c)             { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_insert($val, $pos, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c))), _bglStringLockStack._bglText_stackMark()) }
    /// True when the text is the one character `c`.
    emitter eBool   operator == (char c)                  { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_areEqual($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), false), _bglStringLockStack._bglText_stackMark()) }
    /// True when the text is not the one character `c`.
    emitter eBool   operator != (char c)                  { (~~_bglStringLockStack._bglText_stackDrain(_bglStr._bglText_areEqual($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), false), _bglStringLockStack._bglText_stackMark())) }
    emitter eBool   isEmpty()                             { _bglStr._bglText_isEmpty($val) }
    // capture/release/captureOutput redirect output INTO a buffer — stringObj only.
}


//-----------------------------------------------------------------------------
// stringObj — a slot that OWNS a pool buffer.
//
// The counterpart to `string`, which is a slot holding a pointer to static text.
// The distinction exists because one type covering both representations is what
// let a slot silently change representation: assigning a pool instance into a
// literal-holding slot aliased a buffer the slot did not own, and the referent
// was freed out from under it by its real owner.
//
//   stringLiteral   the text itself; an rvalue
//   string          a slot pointing at text
//   stringObj       a slot owning a pool buffer   <- this
//
// Widening (stringLiteral/string -> stringObj) allocates and copies the text in.
// Narrowing (stringObj -> string) is rejected: it would alias an owned buffer.
// `stringObj a = b` copies b's VALUE into a's own buffer; `ref stringObj a := b`
// copies the address and owns nothing.
//
// Members mirror `string`'s surface and delegate to the same var-taking _bglStr
// utilities — the single implementation both types share.
//-----------------------------------------------------------------------------
/// Text you build at run time. Unlike `string`, which points at fixed text in the story file, a
/// `stringObj` owns a buffer from the string pool: it is taken when the variable is declared and
/// given back when its block ends. Assigning copies the TEXT in.
emitter class stringObj {
    // Lifecycle
    /// Take a buffer from the pool. Runs automatically at the declaration.
    emitter void init()   { $self = _bglStr._bglText_new(); }
    /// Take a buffer from the pool holding a copy of `v`. Runs automatically for a parameter.
    emitter void init(stringObj v) { $self = _bglStr._bglText_new($v); }

    // Temporaries in a call: a released (temporary) result is held from when it is produced until the
    // call returns, so evaluating another argument can't take its buffer. The compiler places these.
    /// Open a mark to release held temporaries back to. Used by the compiler before a call's arguments.
    emitter int temporaryMark() { _bglStringLockStack._bglText_stackMark() }
    /// Hold `v` if it is a temporary; a live string passes through. Used by the compiler on an argument.
    emitter stringObj holdTemporary(stringObj v) { _bglStringLockStack._bglText_stackLock($v) }
    /// Release what was held since the open mark and close it, passing `result` through; `marked` only orders the mark first. Used by the compiler around a call.
    emitter var releaseTemporaries(var result, int marked) { _bglStringLockStack._bglText_stackDrain($result, $marked) }
    /// Give the buffer back. Runs automatically when the declaring block ends.
    emitter void deinit() { if ($self) $self._bglText_free(); }

    // Assignment — Phase B: type-discriminated dispatch eliminates isTracked()
    // false-positive risk that could surface when a packed-string address
    // numerically collided with a tracked-buffer user pointer.
    emitter stringObj operator = (stringLiteral v)         { $self._bglText_setFromLit($v); }
    emitter stringObj operator = (stringObj v)                  { $self._bglText_setFromStr($v); }
    // Widening: a `string` is a pointer to static text, so copy that text INTO this
    // object's own buffer. setFromLit handles a bare text pointer; setFromStr would
    // assume an instance.
    emitter stringObj operator = (string v)                     { $self._bglText_setFromLit($v); }
    emitter stringObj operator = (interpolatedStringLiteral v)     { $self._bglText_capture(); $v; $self._bglText_release(); }

    // Concatenation: returns ephemeral copy with rhs appended; lhs is not mutated.
    // str3 = str1 + str2  =>  str3.set(str1.append(str2))
    emitter stringObj operator + (stringLiteral v) { _bglStr._bglText_append($val, $v) }
    emitter stringObj operator + (stringObj v)        { _bglStr._bglText_append($val, $v) }
    emitter stringObj operator + (string v)           { _bglStr._bglText_append($val, $v) }
    emitter stringObj operator + (char c)             { _bglStr._bglText_appendChar($val, $c) }

    // Compound concatenation: s += v  ≡  s = s + v. Unlike `+`, this mutates the
    // lhs in place — append() produces the joined (ephemeral) copy and setFromStr
    // copies it back into self.
    emitter stringObj operator += (stringLiteral v) { _bglStrAppendInPlace($self, $v) }
    emitter stringObj operator += (stringObj v)        { _bglStrAppendInPlace($self, $v) }
    emitter stringObj operator += (string v)           { _bglStrAppendInPlace($self, $v) }
    emitter stringObj operator += (char c)             { _bglStrAppendCharInPlace($self, $c) }
    emitter stringObj operator += (interpolatedStringLiteral v) { _bglStr._bglText_beginAppend($self); $v; _bglStr._bglText_endAppend($self); }

    // Equality — Phase B typed dispatch
    // `replace` — core declares these as address equality; <string> upgrades them to
    // content comparison. `!=` must be replaced alongside `==`, or the two would
    // disagree (content vs address) on the same pair of values.
    emitter eBool operator == (stringLiteral v) { _bglStr._bglText_areEqual($val, $v, false) }
    emitter eBool operator == (stringObj v)        { _bglStr._bglText_areEqual($val, $v, false) }
    emitter eBool operator == (string v)           { _bglStr._bglText_areEqual($val, $v, false) }
    emitter eBool operator != (stringLiteral v) { (~~_bglStr._bglText_areEqual($val, $v, false)) }
    emitter eBool operator != (stringObj v)        { (~~_bglStr._bglText_areEqual($val, $v, false)) }
    emitter eBool operator != (string v)           { (~~_bglStr._bglText_areEqual($val, $v, false)) }
    emitter eBool operator =~ (stringLiteral v) { _bglStr._bglText_areEqual($val, $v, true) }   /// True when both are the same text, ignoring case.
    emitter eBool operator =~ (stringObj v)     { _bglStr._bglText_areEqual($val, $v, true) }   /// True when both are the same text, ignoring case.
    emitter eBool operator =~ (string v)        { _bglStr._bglText_areEqual($val, $v, true) }   /// True when both are the same text, ignoring case.

    // Switch comparison — Phase B typed dispatch
    emitter eBool operator switch(stringLiteral v) { _bglStr._bglText_areEqual($val, $v, false) }
    emitter eBool operator switch(stringObj v)        { _bglStr._bglText_areEqual($val, $v, false) }

    // Comparison published for generic containers. `static` means no receiver, so these
    // emit as free routines whose address array<T> can be handed — the only shape that can
    // serve a PACKED LITERAL element, which has no properties to dispatch on. Both operands
    // arrive as parameters, so toAmbiguousBuffer can sort out literal-vs-instance for each.
    // `static` = no receiver, so this emits as a free routine whose address array<T> can be
    // handed — the only shape that can serve a PACKED LITERAL element, which has no properties
    // to dispatch on. Taking both operands is what makes that possible. A static operator is
    // never selected at an ordinary `a == b` site; the instance operators above own those.
    static bool operator == (var a, var b) { return _bglStr.areEqual(a, b, false); }
    static int  operator <=> (var a, var b) { return _bglStr.compareValues(a, b, false); }

    // Destruction published for generic containers — the value form of deinit(). The
    // emitter deinit() above frees a receiver at scope exit; this takes the value as a
    // parameter, so it emits as a free routine whose address array<T> can hold and call
    // on a slot it has no receiver for. Guarded: a slot may hold 0 (never written) or a
    // packed literal (not pool-owned), and neither is ours to free.
    static void deinit(var s) {
        #i6 { if(s ~= 0 && s ofclass _bglString) s._bglText_free(); }
    }

    // Assignment published for generic containers — the value form of operator =. setOwned
    // hands it the slot's CURRENT value and the incoming one, and stores what it returns.
    // That is what lets `slots[i] = "jim"` allocate: the slot owns a pooled buffer, so the
    // first write allocates one and later writes copy into the buffer already there, rather
    // than churning the pool. Assigning 0 releases the slot.
    static var operator = (var cur, var v) {
        #i6 {
            if(cur ~= 0 && cur ofclass _bglString) {
                if(v == 0) { cur._bglText_free(); return 0; }
                cur._bglText_set(v);                  ! reuse the allocation this slot already owns
                return cur;
            }
            if(v == 0) return 0;
        }
        return _bglStr.new(v);               // first write into this slot — allocate
    }

    // Ordering — lexicographic by content, NOT by the packed address. Each
    // yields a bool, so `a < b` reads the way it does for numbers.
    //
    // A sort comparator needs a signed -1/0/+1 ordering rather than a bool, so
    // reach for compareTo() there:  arr.sort((string a, string b) => a.compareTo(b));
    emitter eBool operator <  (stringLiteral v) { (_bglStr._bglText_compareValues($val, $v, false) < 0) }
    emitter eBool operator <  (stringObj v)        { (_bglStr._bglText_compareValues($val, $v, false) < 0) }
    emitter eBool operator >  (stringLiteral v) { (_bglStr._bglText_compareValues($val, $v, false) > 0) }
    emitter eBool operator >  (stringObj v)        { (_bglStr._bglText_compareValues($val, $v, false) > 0) }
    emitter eBool operator <= (stringLiteral v) { (_bglStr._bglText_compareValues($val, $v, false) <= 0) }
    emitter eBool operator <= (stringObj v)        { (_bglStr._bglText_compareValues($val, $v, false) <= 0) }
    emitter eBool operator >= (stringLiteral v) { (_bglStr._bglText_compareValues($val, $v, false) >= 0) }
    emitter eBool operator >= (stringObj v)        { (_bglStr._bglText_compareValues($val, $v, false) >= 0) }

    // Indexed character access
    emitter char operator[](int pos)                  { _bglStr._bglText_getChar($val, $pos) }
    emitter char operator[]=(int pos, char c)         { $val._bglText_setChar($pos,$c) }
    emitter char operator[]=(int pos, charLiteral c)  { $val._bglText_setChar($pos,$c) }

    // Query — enables ?., ??, and postfix ? for null (unallocated) checks
    emitter eBool operator ?() { $self ~= 0 }

    // Methods
    emitter void  print()                          { _bglStr.print($val) }

    emitter stringObj  append(stringObj v)                      { _bglStr._bglText_append($val, $v) }
    emitter stringObj  append(char v)                        { _bglStr._bglText_appendChar($val, $v) }
    emitter stringObj  append(array<char> v)                        { _bglStr._bglText_append($val, _bglStr._bglText_fromChars($v)) }
    emitter stringObj  prepend(char v)                       { _bglStr._bglText_prependChar($val, $v) }
    emitter stringObj  prepend(var v)                        { _bglStr._bglText_prepend($val, $v) }
    emitter stringObj prepend(array<char> v) { _bglStr._bglText_prepend($val, _bglStr._bglText_fromChars($v)) }
    emitter stringObj  toUpper()                             { _bglStr._bglText_toUpper($val) }
    emitter stringObj  toLower()                             { _bglStr._bglText_toLower($val) }
    emitter stringObj  trim()                                { _bglStr._bglText_trim($val) }
    emitter stringObj  trimLeft()                            { _bglStr._bglText_trimLeft($val) }
    emitter stringObj  trimRight()                           { _bglStr._bglText_trimRight($val) }
    emitter stringObj  reverse()                             { _bglStr._bglText_reverse($val) }
    emitter stringObj  mid(int start, int count)             { _bglStr._bglText_mid($val, $start, $count) }
    emitter stringObj  left(int count)                       { _bglStr._bglText_left($val, $count) }
    emitter stringObj  right(int count)                      { _bglStr._bglText_right($val, $count) }
    emitter stringObj  insert(int pos, var source)           { _bglStr._bglText_insert($val, $pos, $source) }
    emitter stringObj  delete(int pos, int count)            { _bglStr._bglText_delete($val, $pos, $count) }
    emitter stringObj  replace(char c, var replaceText)      { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_replace($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), $replaceText), _bglStringLockStack._bglText_stackMark()) }
    emitter stringObj  replaceAll(char c, var replaceText)   { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_replaceAll($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), $replaceText), _bglStringLockStack._bglText_stackMark()) }
    emitter stringObj  replace(char c, char r)               { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_replace($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $r))), _bglStringLockStack._bglText_stackMark()) }
    emitter stringObj  replaceAll(char c, char r)            { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_replaceAll($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $r))), _bglStringLockStack._bglText_stackMark()) }
    emitter stringObj  replace(var searchText, char r)       { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_replace($val, $searchText, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $r))), _bglStringLockStack._bglText_stackMark()) }
    emitter stringObj  replaceAll(var searchText, char r)    { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_replaceAll($val, $searchText, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $r))), _bglStringLockStack._bglText_stackMark()) }
    emitter stringObj  replace(var searchText, var replaceText)    { _bglStr._bglText_replace($val, $searchText, $replaceText) }
    emitter stringObj  replaceAll(var searchText, var replaceText) { _bglStr._bglText_replaceAll($val, $searchText, $replaceText) }
    emitter stringObj  format(var pattern)                                               { _bglStr._bglText_format($val, $pattern) }
    emitter stringObj  format(var pattern, string | stringObj p1)                        { _bglStr._bglText_format($val, $pattern, $p1) }
    emitter stringObj  format(var pattern, string | stringObj p1, string | stringObj p2) { _bglStr._bglText_format($val, $pattern, $p1, $p2) }
    emitter int     length                                { _bglStr._bglText_getLength($val) }
    emitter int     compareTo(var other)                  { _bglStr._bglText_compareValues($val, $other, false) }
    emitter int compareTo(array<char> other) { _bglStr._bglText_compareValues($val, _bglStr._bglText_fromChars($other), false) }
    emitter int     compareTo(var other, bool ci)         { _bglStr._bglText_compareValues($val, $other, $ci) }
    emitter int     indexOf(var searchText)               { _bglStr._bglText_indexOf($val, $searchText, 0) }
    emitter int indexOf(array<char> searchText) { _bglStr._bglText_indexOf($val, _bglStr._bglText_fromChars($searchText), 0) }
    emitter eBool   startsWith(var prefix)                { _bglStr._bglText_startsWith($val, $prefix, false) }
    emitter eBool startsWith(array<char> prefix) { _bglStr._bglText_startsWith($val, _bglStr._bglText_fromChars($prefix), false) }
    emitter eBool   endsWith(var suffix)                  { _bglStr._bglText_endsWith($val, $suffix, false) }
    emitter eBool endsWith(array<char> suffix) { _bglStr._bglText_endsWith($val, _bglStr._bglText_fromChars($suffix), false) }
    emitter eBool   contains(var searchText)              { _bglStr._bglText_contains($val, $searchText) }
    emitter eBool contains(array<char> searchText) { _bglStr._bglText_contains($val, _bglStr._bglText_fromChars($searchText)) }
    /// The position of the character `c`, or -1.
    emitter int     indexOf(char c)                       { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_indexOf($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), 0), _bglStringLockStack._bglText_stackMark()) }
    /// True when the text starts with the character `c`.
    emitter eBool   startsWith(char c)                    { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_startsWith($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), false), _bglStringLockStack._bglText_stackMark()) }
    /// True when the text ends with the character `c`.
    emitter eBool   endsWith(char c)                      { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_endsWith($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), false), _bglStringLockStack._bglText_stackMark()) }
    /// True when the text holds the character `c`.
    emitter eBool   contains(char c)                      { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_contains($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c))), _bglStringLockStack._bglText_stackMark()) }
    /// A copy with the character `c` inserted at `pos`.
    emitter stringObj insert(int pos, char c)             { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_insert($val, $pos, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c))), _bglStringLockStack._bglText_stackMark()) }
    /// True when the text is the one character `c`.
    emitter eBool   operator == (char c)                  { _bglStringLockStack._bglText_stackDrain(_bglStr._bglText_areEqual($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), false), _bglStringLockStack._bglText_stackMark()) }
    /// True when the text is not the one character `c`.
    emitter eBool   operator != (char c)                  { (~~_bglStringLockStack._bglText_stackDrain(_bglStr._bglText_areEqual($val, _bglStringLockStack._bglText_stackLock(_bglStr._bglText_appendChar("", $c)), false), _bglStringLockStack._bglText_stackMark())) }
    emitter eBool   isEmpty()                             { _bglStr._bglText_isEmpty($val) }
    emitter void    capture()                             { $self._bglText_capture() }
    emitter void    release()                             { $self._bglText_release() }
    emitter void    captureOutput(object obj, property prop)   { $self._bglText_captureOutput($obj, $prop) }

    // NOTE: no `static operator =` is published yet, so array<stringObj> slot writes
    // take core's raw word store and the developer owns the lifecycle explicitly:
    //     slots[9] = _bglStr.new("jim");   // caller allocates
    //     ... _bglStr.free(slots[9]);      // and frees on removal
    // Both halves are now automatic. stringObj publishes `static operator =` and
    // `static deinit`, which the compiler hands array<T> via $opref(=) and $opref(deinit):
    // every store (subscript, append, prepend, insert) allocates or copies into the slot's
    // own buffer, and every drop (remove, removeValue, -=, clear, local scope exit)
    // releases it. `slots[i] = "jim"` is the idiom; _bglStr.new() is no longer required
    // and, because assignment is a copy, passing one now allocates twice.
}

/// The `"…"` literal gains `<string>`'s content comparison and query methods, so a literal can be
/// compared and searched without first being copied into a `stringObj`.
extend class stringLiteral {
    emitter stringObj operator + (string v)      { _bglStr._bglText_append($self, $v) }
    emitter stringObj operator + (stringObj v)   { _bglStr._bglText_append($self, $v) }
    emitter stringObj operator + (charLiteral c) { _bglStr._bglText_appendChar($self, $c) }

    // Upgrade the literal's own comparison too. Core declares these as address
    // equality; without replacing them here a literal-on-the-left comparison
    // (`"a" == "a"`) would keep core semantics even with <string> included, while
    // the same test with a string on the left compared by content.
    replace emitter eBool operator == (stringLiteral v) { _bglStr._bglText_areEqual($val, $v, false) }
    replace emitter eBool operator == (string v)        { _bglStr._bglText_areEqual($val, $v, false) }
    replace emitter eBool operator == (stringObj v)     { _bglStr._bglText_areEqual($val, $v, false) }
    replace emitter eBool operator != (stringLiteral v) { (~~_bglStr._bglText_areEqual($val, $v, false)) }
    replace emitter eBool operator != (string v)        { (~~_bglStr._bglText_areEqual($val, $v, false)) }
    replace emitter eBool operator != (stringObj v)     { (~~_bglStr._bglText_areEqual($val, $v, false)) }
    emitter eBool operator =~ (stringLiteral v) { _bglStr._bglText_areEqual($val, $v, true) }   /// True when both are the same text, ignoring case.
    emitter eBool operator =~ (string v)        { _bglStr._bglText_areEqual($val, $v, true) }   /// True when both are the same text, ignoring case.
    emitter eBool operator =~ (stringObj v)     { _bglStr._bglText_areEqual($val, $v, true) }   /// True when both are the same text, ignoring case.
}

extend _bglOutput {
    replace emitter void print(string str) { _bglStr.print($str) }   /// Print `str`.
    emitter void print(stringObj str) { _bglStr.print($str) }        /// Print `str`.
}
