            grow = _bglBuf._bglText_length(rt) - _bglBuf._bglText_length(st);
            if(grow > 0){
                n = _bglStrCount(retval._bglText_getBuf(), st);
                _bglStrEnsure(retval, retval._bglText_getLength() + n * grow);
                if(_bglStrIs(searchText)) st = searchText._bglText_getBuf();
                if(_bglStrIs(replaceText)) rt = replaceText._bglText_getBuf();
