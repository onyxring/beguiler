    // ── Modifications, returning "free" strings ──────────────────────────────
    // The clone-mutate-free pattern: clone self into a freshly allocated
    // string, mutate the clone in place via _bglBuf, free the clone (making
    // it ephemeral so the caller doesn't need to dispose it explicitly), and
    // return it. The ephemeral remains valid until the next pool reuse.
    var insert(int pos, var source, int count = 0) asI6 _bglText_insert {
        var retval; var src; bool lk; int n;
        #i6 {
            retval = self._bglText_clone();
            src = _bglStr._bglText_toAmbiguousBuffer(source);
            lk = _bglStr._bglText_ambiguousLock(src);
            n = count; if(n <= 0) n = _bglBuf._bglText_length(src);
            _bglStrEnsure(retval, retval._bglText_getLength() + n);
            if(_bglStrIs(source)) src = source._bglText_getBuf();
            _bglBuf._bglText_insert(retval._bglText_getBuf(), src, pos, count);
            _bglStr._bglText_ambiguousFree(src, lk);
            retval = retval._bglText_free();
        }
        return retval;
    }

    var delete(int pos, int count) asI6 _bglText_delete {
        var retval;
        #i6 {
            retval = self._bglText_clone();
            _bglBuf._bglText_delete(retval._bglText_getBuf(), pos, count);
            retval = retval._bglText_free();
