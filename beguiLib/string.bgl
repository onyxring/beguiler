    var replace(var searchText, var replaceText) asI6 _bglText_replace {
        var retval;
        bool stl; bool rtl;
        var st; var rt; int n; int grow;
        #i6 {
            retval = self._bglText_clone();
            st = _bglStr._bglText_toAmbiguousBuffer(searchText);
            stl = _bglStr._bglText_ambiguousLock(st);
            rt = _bglStr._bglText_toAmbiguousBuffer(replaceText);
            rtl = _bglStr._bglText_ambiguousLock(rt);
            grow = _bglBuf._bglText_length(rt) - _bglBuf._bglText_length(st);
            if(grow > 0){
                n = 1;
                _bglStrEnsure(retval, retval._bglText_getLength() + n * grow);
                if(_bglStrIs(searchText)) st = searchText._bglText_getBuf();
                if(_bglStrIs(replaceText)) rt = replaceText._bglText_getBuf();
            }
            _bglBuf._bglText_replace(retval._bglText_getBuf(), st, rt);
            _bglStr._bglText_ambiguousFree(rt, rtl);
            _bglStr._bglText_ambiguousFree(st, stl);
            retval = retval._bglText_free();
        }
        return retval;
    }

    var replaceAll(var searchText, var replaceText) asI6 _bglText_replaceAll {
        var retval;
        bool stl; bool rtl;
