//-----------------------------------------------------------------------------
// string.bgl - Beguile string runtime.
//
// The stringObj type and its operations. Each string's buffer is a block in a string heap of its
// own, and grows as text is written into it. The earlier pool-based runtime, with fixed-size
// buffers, is kept as <archive/string>; the two can't be included together.
//
// Usage:
//   #include <string>      in your .bgl file to activate string support.
//-----------------------------------------------------------------------------
#once
#declare BGL_STRING_HEAP
#if BGL_STRING_POOL
    #error "<string> and <archive/string> both provide stringObj; include one of them."
#endif

#include <buf>

extend class beguilerSettingsType {
    int stringHeapSize;      /// Bytes in <string>'s string heap (unset: 5120); the `heap` debug verb reports the most a run needed.
    int stringCaptureSize;   /// The longest text, in characters, a capture or a literal writes into a stringObj (unset: 512).
}
#if #beguilerSettings.stringHeapSize > 0
    const int bglStringHeapSize = #beguilerSettings.stringHeapSize;
#else
    const int bglStringHeapSize = 5120;
#endif
extern var _bglStrRead(var s);   // the island's reader for the value-based methods
#if #beguilerSettings.stringCaptureSize > 0
    const int bglStringCaptureSize = #beguilerSettings.stringCaptureSize;
#else
    const int bglStringCaptureSize = 512;
#endif
// bglAllocated is now auto-loaded in core (no include needed); _bglString inherits it.
//------------------------------------------------------------------------------
// The string pool and the string heap. The pool (_bglStringPool) hands out the fixed set of
// _bglString instances and the temporary buffers, and tracks which are locked. Each string's
// buffer is a block in the string heap, which grows as text is written into it.
//
// A heap block is   [ owner | capacity | length | chars … ]
// and the buffer is the address of `length`, so it keeps <buf>'s sized-buffer layout: the
// capacity in the word before it, the length at 0, the chars from WORDSIZE. The owner is the
// _bglString (or temporary-buffer wrapper) holding the block; 0 marks a free block.
//
// Blocks are taken at the free end. A string grows in place when its block is the last one,
// and otherwise moves to the end. When the end is full, compaction drops the blocks of free
// strings and slides the rest down. The temporary buffers are held by address, so they come first
// and never move; a block being captured into is written by address, so it stays put too.
//------------------------------------------------------------------------------
#i6 {
    Constant _bglOverrunSetting "the stringCaptureSize setting (stringHeapSize, for a literal)";   ! what <buf> names when printed text overruns its room
    Default bglStringLockStackSize 32;                          ! temporaries an operator can hold at once (_bglStringLockStack)
    Array _bglStringLockStackSlots --> bglStringLockStackSize;
    Global _bglStringLockStackTop = 0;
    Array _bglStringLockStackMarks --> bglStringLockStackSize;  ! the slot height at each open mark
    Global _bglStringLockStackMarkTop = 0;
    Array _bglStrAppendTemps --> 8;                             ! `s += $"…"` captures into one of these, nested
    Global _bglStrAppendTop = 0;
    Constant _bglStrTempCount = bglBufferPoolReserve - bglStringPoolReserve;
    Constant _bglStrStartSize 16;                               ! a new string's capacity, in chars
    Array _bglStrHeap -> bglStringHeapSize;
    Global _bglStrHeapTop = 0;                                  ! bytes in use, from the start of the heap
    Global _bglStrCaptures = 0;                                 ! captures under way (reported by the debug usage line)

    class _bglBufferWrapper(_bglStrTempCount) with _bglText_buf 0;       ! buffer-as-object so it can move between sentinel containers

    ! Whether `x` is a pool string. `ofclass` faults on a value that isn't an object, and a buffer's
    ! address can arrive wherever a string can.
    [ _bglStrIs x; return metaclass(x) == Object && x ofclass _bglString; ];

    ! The string whose own buffer `b` is, or 0.
    [ _bglStrOwnerOf b; if(_bglStrInHeap(b) && _bglStrIs(b-->(-2))) return b-->(-2); return 0; ];

    [ _bglStrBlockBytes cap; return 3 * WORDSIZE + ((cap + WORDSIZE - 1) / WORDSIZE) * WORDSIZE; ];

    ! Whether buffer `b` is being captured into: output is going to its address, so it can't move.
    [ _bglStrCapturing b  i;
        for(i = 1 : i <= _bglBuf._stackTop : i++) if(_bglBufStreamStack-->i == b) rtrue;   ! element k of the array is at -->(k + 1)
        rfalse;
    ];

    ! Whether `b` is a buffer in the string heap.
    [ _bglStrInHeap b; return b >= _bglStrHeap + 2 * WORDSIZE && b < _bglStrHeap + bglStringHeapSize; ];

    ! Point the tracked-buffer registry's entry for `old` at `new`.
    [ _bglStrRetrack old new  i;
        for(i = 0 : i < _bglBuf._trackedCount : i++)
            if(_bglTrackedRegistry-->i == old){ _bglTrackedRegistry-->i = new; return; }
    ];

    #Ifdef DEBUG;
    Global _bglStrHeapPeak = 0;                                 ! the most bytes the heap has needed
    ! The bytes the heap needs now: what compaction couldn't give back (live strings at their length,
    ! temporaries, and blocks being captured into).
    [ _bglStrNeeded growing newLen  o b n owner need keep;
        for(o = 0 : o < _bglStrHeapTop : o = o + n){
            b = _bglStrHeap + o;
            n = _bglStrBlockBytes(b-->1);
            owner = b-->0;
            if(owner == 0) continue;
            if(owner ofclass _bglString && _bglStrCapturing(b + 2 * WORDSIZE) == false){
                if(owner in _bglObjectHeap) continue;   ! a free string's block can be dropped
                keep = b-->2;
                if(owner == growing) keep = newLen;   ! a write about to make it this long
                if(keep < _bglStrStartSize) keep = _bglStrStartSize;
                need = need + _bglStrBlockBytes(keep);
            }
            else need = need + n;
        }
        return need;
    ];
    ! Record what the heap needs as a block of `extra` bytes is taken, or as `growing` becomes `newLen`
    ! chars long: everything compaction can't give back, plus the new block.
    [ _bglStrNotePeak growing newLen extra  need;
        need = _bglStrNeeded(growing, newLen) + extra;
        if(need > _bglStrHeapPeak) _bglStrHeapPeak = need;
    ];
    ! A literal `len` chars long set into `s`, whose block holds `cap`: what growing it would need.
    [ _bglStrNoteLiteral s len cap;
        if(len > cap) _bglStrNotePeak(0, 0, _bglStrBlockBytes(len));
        else _bglStrNotePeak(s, len);
    ];
    ! The `heap` debug verb's line for the string heap.
    [ _bglStrHeapReport;
        _bglStrNotePeak();
        print "String heap: ", bglStringHeapSize, " bytes; ", _bglStrNeeded(), " in use, ", _bglStrHeapPeak, " at most.^";
    ];
    #Endif;

    ! A block of `cap` chars for `owner` at the free end: its buffer, or 0 when it doesn't fit.
    [ _bglStrBump owner cap  b n;
        n = _bglStrBlockBytes(cap);
        if(_bglStrHeapTop + n > bglStringHeapSize) return 0;
        b = _bglStrHeap + _bglStrHeapTop;
        _bglStrHeapTop = _bglStrHeapTop + n;
        b-->0 = owner; b-->1 = cap; b-->2 = 0;
        return b + 2 * WORDSIZE;
    ];

    ! Debug builds: what the string heap holds, by kind of owner.
    [ _bglStrUsage  o b n owner live free temps cap big;
        for(o = 0 : o < _bglStrHeapTop : o = o + n){
            b = _bglStrHeap + o;
            n = _bglStrBlockBytes(b-->1);
            owner = b-->0;
            if(owner == 0){ free = free + n; if(n > big) big = n; }
            else if(owner ofclass _bglBufferWrapper) temps = temps + n;
            else { live = live + n; cap = cap + b-->2; }
        }
        print "[string heap: ", _bglStrHeapTop, " of ", bglStringHeapSize, " bytes in use; strings ", live, " (", cap, " chars of text), temporaries ", temps, ", free blocks ", free, " (largest ", big, "), captures ", _bglStrCaptures, "]^";
    ];

    ! A block of `cap` chars for `owner` without moving any: at the free end, or in the first free
    ! block big enough (split when the rest can hold a block). Its buffer, or 0.
    [ _bglStrPlace owner cap  buf o b n need rest;
        buf = _bglStrBump(owner, cap);
        if(buf) return buf;
        need = _bglStrBlockBytes(cap);
        for(o = 0 : o < _bglStrHeapTop : o = o + n){
            b = _bglStrHeap + o;
            n = _bglStrBlockBytes(b-->1);
            if(b-->0 ~= 0) continue;
            ! Merge the free blocks that follow into this one.
            while(o + n < _bglStrHeapTop && (b + n)-->0 == 0){
                n = n + _bglStrBlockBytes((b + n)-->1);
                b-->1 = n - 3 * WORDSIZE;
            }
            if(o + n == _bglStrHeapTop){ _bglStrHeapTop = o; return _bglStrBump(owner, cap); }   ! a free run at the end is the free end
            if(n < need) continue;
            rest = n - need;
            if(rest >= 3 * WORDSIZE){
                b-->1 = cap;
                (b + need)-->0 = 0; (b + need)-->1 = rest - 3 * WORDSIZE; (b + need)-->2 = 0;
            }
            b-->0 = owner; b-->2 = 0;
            return b + 2 * WORDSIZE;
        }
        return 0;
    ];

    [ _bglStrHeapFull  w;
        while(_bglBuf._stackTop > 0) _bglBuf._bglText_release();   ! a capture would swallow the message
        #Ifdef TARGET_GLULX;
            ! Print in a text-buffer window: the status grid may be current, and at startup none is open.
            for(w = glk($0020, 0, 0) : w ~= 0 && glk($0028, w) ~= 3 : w = glk($0020, w, 0)) ;
            if(w == 0) w = glk($0023, 0, 0, 0, 3, 0);
            glk($002F, w);
        #Ifnot; w = 0;
        #Endif;
        print "^[Beguile run-time error: the string heap is full; raise the stringHeapSize setting]^";
        #Ifdef DEBUG; _bglStrUsage(); #Endif;
        quit;
    ];

    ! A new block of `cap` chars for `owner`. It never moves another block: it is taken in the
    ! middle of operations that hold buffers by address.
    [ _bglStrAlloc owner cap  buf;
        #Ifdef DEBUG; _bglStrNotePeak(0, 0, _bglStrBlockBytes(cap)); #Endif;
        buf = _bglStrPlace(owner, cap);
        if(buf == 0) _bglStrHeapFull();
        _bglBuf._registerTracked(buf);
        return buf;
    ];

    ! Slide the blocks down over the free ones. Every move updates the owner and the registry. A
    ! free string keeps its text, trimmed to its length, since a freed result is still read until
    ! the pool hands its string out again; with `dropFree`, free strings lose their blocks too (each
    ! takes a new one when it is next used) and live strings give up their spare room. Free temporary buffers lose theirs. A temporary buffer
    ! in use stays put; the gap before it becomes a free block.
    [ _bglStrCompact dropFree  o b step n to owner moved dst keep;
        to = 0;
        for(o = 0 : o < _bglStrHeapTop : o = o + step){
            b = _bglStrHeap + o;
            step = _bglStrBlockBytes(b-->1);
            n = step;
            owner = b-->0;
            ! The second pass trims a live string's spare room too; it grows again when it needs to.
            if(dropFree && owner ~= 0 && owner ofclass _bglString && (owner in _bglObjectHeap) == false
               && _bglStrCapturing(b + 2 * WORDSIZE) == false){   ! not ~~(…) && …: Inform 6 negates the whole chain
                keep = b-->2;
                if(keep < _bglStrStartSize) keep = _bglStrStartSize;
                if(_bglStrBlockBytes(keep) + 3 * WORDSIZE <= n){ b-->1 = keep; n = _bglStrBlockBytes(keep); }
            }
            if(owner ~= 0 && owner in _bglObjectHeap && owner ofclass _bglString){
                if(~~dropFree){
                    keep = b-->2;
                    if(keep < _bglStrStartSize) keep = _bglStrStartSize;
                    if(_bglStrBlockBytes(keep) + 3 * WORDSIZE <= n){ b-->1 = keep; n = _bglStrBlockBytes(keep); }   ! the slack must hold a block
                } else {
                    _bglBuf._unregisterTracked(b + 2 * WORDSIZE);
                    owner._underlyingBuffer = 0;
                    owner = 0;
                }
            }
            if(owner == 0) continue;
            if(owner ofclass _bglBufferWrapper || _bglStrCapturing(b + 2 * WORDSIZE)){
                if(to ~= o){ dst = _bglStrHeap + to; dst-->0 = 0; dst-->1 = o - to - 3 * WORDSIZE; dst-->2 = 0; }
                to = o + n;
                if(n < step){ dst = _bglStrHeap + to; dst-->0 = 0; dst-->1 = step - n - 3 * WORDSIZE; dst-->2 = 0; to = o + step; }
                continue;
            }
            if(to ~= o){
                dst = _bglStrHeap + to;
                moved = dst + 2 * WORDSIZE;
                #Ifdef TARGET_ZCODE;
                    @copy_table b dst n;
                #Ifnot;
                    @mcopy n b dst;
                #Endif;
                _bglStrRetrack(b + 2 * WORDSIZE, moved);
                if(owner ofclass _bglString) owner._underlyingBuffer = moved;
                else owner._bglText_buf = moved;
            }
            to = to + n;
        }
        _bglStrHeapTop = to;
    ];

    ! Move string `s`'s block to the end of the heap, sliding the blocks after it down: the two runs are
    ! swapped in place by three reversals, so no spare room is needed. False when a block after it can't
    ! move (a temporary, or one being captured into).
    [ _bglStrToEnd s  buf b n end o step bb owner moved nb;
        buf = s._bglText_getBuf();
        b = buf - 2 * WORDSIZE;
        n = _bglStrBlockBytes(buf-->(-1));
        end = _bglStrHeap + _bglStrHeapTop;
        if(b + n == end) rtrue;
        for(o = (b + n) - _bglStrHeap : o < _bglStrHeapTop : o = o + step){
            bb = _bglStrHeap + o;
            step = _bglStrBlockBytes(bb-->1);
            owner = bb-->0;
            if(owner ~= 0 && (owner ofclass _bglBufferWrapper || _bglStrCapturing(bb + 2 * WORDSIZE))) rfalse;
        }
        _bglStrReverse(b, b + n);
        _bglStrReverse(b + n, end);
        _bglStrReverse(b, end);
        for(o = b - _bglStrHeap : o < _bglStrHeapTop - n : o = o + step){
            bb = _bglStrHeap + o;
            step = _bglStrBlockBytes(bb-->1);
            owner = bb-->0;
            if(owner == 0) continue;
            moved = bb + 2 * WORDSIZE;
            _bglStrRetrack(moved + n, moved);
            if(owner ofclass _bglString) owner._underlyingBuffer = moved;
            else owner._bglText_buf = moved;
        }
        nb = end - n + 2 * WORDSIZE;
        _bglStrRetrack(buf, nb);
        s._underlyingBuffer = nb;
        rtrue;
    ];
    [ _bglStrReverse from to  t;
        to--;
        while(from < to){ t = from->0; from->0 = to->0; to->0 = t; from++; to--; }
    ];

    ! Room in string `s` for `need` chars: its buffer, which may have moved. Grows by half again,
    ! in place when its block is the last one.
    [ _bglStrEnsure s need compacted  buf b cap newCap len nb from to;
        buf = s._bglText_getBuf();
        cap = buf-->(-1);
        #Ifdef DEBUG; if(need <= cap && need > buf-->0) _bglStrNotePeak(s, need); #Endif;   ! a write is about to lengthen it
        if(need <= cap) return buf;
        newCap = cap + cap / 2;
        if(newCap < need) newCap = need;
        #Ifdef DEBUG; _bglStrNotePeak(0, 0, _bglStrBlockBytes(newCap)); #Endif;   ! the old block is copied into the new one
        b = buf - 2 * WORDSIZE;
        ! The last block may take less than half again: whatever room is left, if that holds `need`.
        if(b + _bglStrBlockBytes(cap) == _bglStrHeap + _bglStrHeapTop
           && (b - _bglStrHeap) + _bglStrBlockBytes(newCap) > bglStringHeapSize
           && (b - _bglStrHeap) + _bglStrBlockBytes(need) <= bglStringHeapSize)
            newCap = (bglStringHeapSize - (b - _bglStrHeap) - 3 * WORDSIZE) / WORDSIZE * WORDSIZE;
        if(b + _bglStrBlockBytes(cap) == _bglStrHeap + _bglStrHeapTop
           && (b - _bglStrHeap) + _bglStrBlockBytes(newCap) <= bglStringHeapSize){
            _bglStrHeapTop = (b - _bglStrHeap) + _bglStrBlockBytes(newCap);
            buf-->(-1) = newCap;
            return buf;
        }
        nb = _bglStrPlace(s, newCap);
        if(nb == 0 && newCap > need) nb = _bglStrPlace(s, need);
        if(nb == 0){
            ! Compacted and still no room for a copy: grow in place, as the last block.
            if(compacted == 2 && _bglStrToEnd(s)) return _bglStrEnsure(s, need, 3);
            if(compacted >= 2) _bglStrHeapFull();
            _bglStrCompact(compacted == 1);   ! a second pass drops free strings' blocks too
            return _bglStrEnsure(s, need, compacted + 1);
        }
        len = buf-->0;
        from = buf + WORDSIZE;
        to = nb + WORDSIZE;
        #Ifdef TARGET_ZCODE;
            @copy_table from to len;
        #Ifnot;
            @mcopy len from to;
        #Endif;
        nb-->0 = len;
        b-->0 = 0;
        _bglStrRetrack(buf, nb);
        s._underlyingBuffer = nb;
        return nb;
    ];

    ! `s += text`: grows s's own block and copies in only the new text.
    [ _bglStrAppendInPlace s text  src lk lk2;
        if(text == s) return s._bglText_setFromStr(s._bglText_append(text));   ! `s += s` reads what it writes
        lk = _bglStr._bglText_ambiguousLock(text);   ! an ephemeral argument must outlive the growth below
        src = _bglStr._bglText_toAmbiguousBuffer(text);
        lk2 = _bglStr._bglText_ambiguousLock(src);
        _bglStrEnsure(s, s._bglText_getLength() + _bglBuf._bglText_length(src));
        if(_bglStrIs(text)) src = text._bglText_getBuf();   ! growing may have moved it
        _bglBuf._bglText_appendBuffer(s._bglText_getBuf(), src);
        _bglStr._bglText_ambiguousFree(src, lk2);
        _bglStr._bglText_ambiguousFree(text, lk);
        return s;
    ];

    [ _bglStrAppendCharInPlace s c  len;
        len = s._bglText_getLength();
        _bglStrEnsure(s, len + 1);
        s._bglText_setChar(len, c);
        s._bglText_setLength(len + 1);
        return s;
    ];

    ! The value-based methods (`_bglStr.left(s, n)` and the rest) read `s` as a string: a string is used
    ! as it is, locked while it is read if it is a freed result, and anything else is made into one.
    Array _bglStrReadLocks --> 16;
    Global _bglStrReadTop = 0;
    [ _bglStrRead s;
        if(_bglStrIs(s) == false) return _bglStr._bglText_new(s);
        _bglStrReadLocks-->_bglStrReadTop = _bglStr._bglText_ambiguousLock(s);
        _bglStrReadTop++;
        return s;
    ];
    [ _bglStrReadDone str s;
        if(str ~= s){ str._bglText_free(); return; }
        _bglStrReadTop--;
        _bglStr._bglText_ambiguousFree(s, _bglStrReadLocks-->_bglStrReadTop);
    ];

    ! The room a literal printed for buffer `buf` would have: to the heap's end from its block when that is
    ! the last one, else the free end.
    [ _bglStrLiteralRoom buf  b;
        b = buf - 2 * WORDSIZE;
        if(b + _bglStrBlockBytes(buf-->(-1)) == _bglStrHeap + _bglStrHeapTop) return bglStringHeapSize - (b - _bglStrHeap) - 3 * WORDSIZE;
        return bglStringHeapSize - _bglStrHeapTop - 3 * WORDSIZE;
    ];

    ! Set string `s` to literal `lit` by printing it into the heap's free end, which a capture's worth
    ! of room makes safe: in place when s's block is the last one, else at the end, then copied or
    ! claimed. False when the free end is too small (the caller renders into a temporary).
    [ _bglStrSetLiteral s lit  buf b cap len n top nb;
        buf = s._bglText_getBuf();
        if(_bglStrCapturing(buf)) rfalse;   ! output is going to its address
        ! A literal's length is known only once it is printed: make the free end roomy first.
        if(_bglStrLiteralRoom(buf) < 4 * bglStringCaptureSize){ _bglStrCompact(true); buf = s._bglText_getBuf(); }
        cap = buf-->(-1);
        b = buf - 2 * WORDSIZE;
        if(b + _bglStrBlockBytes(cap) == _bglStrHeap + _bglStrHeapTop){
            ! A literal runs no code as it prints, so it may use all the room to the end of the heap.
            if((b - _bglStrHeap) + _bglStrBlockBytes(bglStringCaptureSize) > bglStringHeapSize) rfalse;
            buf-->(-1) = bglStringHeapSize - (b - _bglStrHeap) - 3 * WORDSIZE;
            _bglBuf._bglText_setFromLiteral(buf, lit);
            len = buf-->0;
            #Ifdef DEBUG; _bglStrNoteLiteral(s, len, cap); #Endif;
            if(len < cap) len = cap;
            buf-->(-1) = len;
            _bglStrHeapTop = (b - _bglStrHeap) + _bglStrBlockBytes(len);
            rtrue;
        }
        top = _bglStrHeapTop;
        if(top + _bglStrBlockBytes(bglStringCaptureSize) > bglStringHeapSize) rfalse;
        nb = _bglStrHeap + top + 2 * WORDSIZE;
        nb-->(-1) = bglStringHeapSize - top - 3 * WORDSIZE;
        _bglBuf._bglText_setFromLiteral(nb, lit);
        len = nb-->0;
        #Ifdef DEBUG; _bglStrNoteLiteral(s, len, cap); #Endif;
        if(len <= cap){ _bglBuf._bglText_setFromBuffer(buf, nb); rtrue; }
        ! Claim the printed text as s's new block; its old one is free.
        n = _bglStrBlockBytes(len);
        (nb - 2 * WORDSIZE)-->0 = s;
        nb-->(-1) = len;
        _bglStrHeapTop = top + n;
        b-->0 = 0;
        _bglStrRetrack(buf, nb);
        s._underlyingBuffer = nb;
        rtrue;
    ];

    ! How many times `search` occurs in `buf`, each match after the last.
    [ _bglStrCount buf search  n pos slen;
        slen = _bglBuf._bglText_length(search);
        if(slen == 0) return 0;
        pos = _bglBuf._bglText_indexOf(buf, search, 0);
        while(pos ~= -1){ n++; pos = _bglBuf._bglText_indexOf(buf, search, pos + slen); }
        return n;
    ];

    ! Give back what string `s`'s block holds beyond `keep` chars: the free end when the block is the
    ! last one, otherwise a free block of its own.
    [ _bglStrTrim s keep  buf b cap n rest;
        buf = s._bglText_getBuf(1);
        if(buf == 0) return;
        cap = buf-->(-1);
        if(keep < _bglStrStartSize) keep = _bglStrStartSize;
        n = _bglStrBlockBytes(keep);
        rest = _bglStrBlockBytes(cap) - n;
        if(rest < 3 * WORDSIZE) return;
        b = buf - 2 * WORDSIZE;
        buf-->(-1) = keep;
        if(b + n + rest == _bglStrHeap + _bglStrHeapTop){ _bglStrHeapTop = _bglStrHeapTop - rest; return; }
        b = b + n;
        b-->0 = 0; b-->1 = rest - 3 * WORDSIZE; b-->2 = 0;
    ];

    object _bglAllocatedObjects;   ! sentinel — live pool (parent of currently-locked instances)
    object _bglObjectHeap;         ! sentinel — free pool (parent of available instances)

    ! _bglStr was here. Ported to Beguile-native (see string.bgl). I6-side
    ! callers (e.g. _bglString.set, _bglString.equals) still invoke
    ! _bglStr.X(...) — same I6 dispatch surface, just the implementation
    ! moved out.

    ! _bglString class was here. Ported to Beguile-native pooled class (see
    ! string.bgl). I6-side callers (_bglInitializeStringBuffers,
    ! _bglStringPool.allocateString, .freeString, etc.) still see _bglString
    ! as a class with create()/remaining()/.method() dispatch at link time —
    ! the I6 emission of the Beguile-declared class IS a Class _bglString(N).

    ! _bglStringPool provides a pattern to reuse buffers and _bglString instances, somewhat working around
    ! the fact memory cannot be dynamically allocated in the Z-machine
    object _bglStringPool
        private _allocateObj[type  !pick an arbitrary free object, lock it, and return it for use
                o retval;
            objectloop(o in _bglObjectHeap && o ofclass type) {
                retval=o;
                break;
            }
            if(retval==0) {
                #Ifdef TARGET_GLULX;
                    ! At startup no window is open yet to print the error in.
                    if(glk($0048) == 0) glk($002F, glk($0023, 0, 0, 0, 3, 0));
                #Endif;
