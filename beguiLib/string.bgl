            tmpStr = str._bglText_trim();
            str._bglText_free();
        }
        return tmpStr;
    }

    // Print whatever was passed: literal, buffer, _bglString, or a routine
    // address (which is invoked). If prop is supplied, buf is first resolved
    // through that property (dynamic property access — hence the #i6 block).
    void print(var buf, var prop = 0) {
        #i6 {
            if(prop ~= 0){
                if(metaclass(buf.prop) == Routine){ buf.prop(); return; }   ! run as the object's own method
                buf = buf.prop;
            }
            if(buf == 0) return;   ! null prints nothing
            if(buf provides print) {
                buf.print();
                return;
            }
            if(metaclass(buf) == Routine) return buf();
        }
        _bglBuf.print(buf);
    }
}

//==============================================================================
// _bglStringLockStack — holds the temporaries (already-freed results) a call's
// arguments produce, so evaluating one can't reallocate another's. A mark is opened
// before the arguments (Inform 6 evaluates the last argument first, so the compiler
// puts it there), each temporary is locked and pushed, and the drain after the call
// frees back to that mark and closes it. Marks nest with the calls.
//==============================================================================
superposed _bglObject _bglStringLockStack {
    // Lock `s` if it is a freed pool string and remember it; any other value passes through.
    var stackLock(var s) asI6 _bglText_stackLock {
        if(_bglStr.ambiguousLock(s)) {
            #i6 {
                if(_bglStringLockStackTop >= bglStringLockStackSize){
                    print "[ERROR: too many temporary strings in one expression.]";
                    return s;
                }
                _bglStringLockStackSlots-->_bglStringLockStackTop = s;
                _bglStringLockStackTop++;
            }
        }
        return s;
    }
    // Open a mark at the current height; the matching stackDrain releases back to it.
    int stackMark() asI6 _bglText_stackMark {
        #i6 {
            if(_bglStringLockStackMarkTop >= bglStringLockStackSize){
                print "[ERROR: temporary strings nested too deeply.]";
                return 0;
            }
            _bglStringLockStackMarks-->_bglStringLockStackMarkTop = _bglStringLockStackTop;
            _bglStringLockStackMarkTop++;
        }
        return 0;
    }
    // Free what was locked since the most recent mark, close that mark, and pass `result` through.
    var stackDrain(var result, int unused) asI6 _bglText_stackDrain {
        #i6 {
            if(_bglStringLockStackMarkTop == 0) return result;
            _bglStringLockStackMarkTop--;
            while(_bglStringLockStackTop > _bglStringLockStackMarks-->_bglStringLockStackMarkTop){
                _bglStringLockStackTop--;
                _bglStr._bglText_ambiguousFree(_bglStringLockStackSlots-->_bglStringLockStackTop, true);
            }
        }
        return result;
    }
}

//==============================================================================
// _bglString — pooled-instance class. Wraps a sized buffer (lazily allocated
// from _bglStringPool) and exposes the orString surface: lifecycle (lock/free),
// search (equals/indexOf/startsWith/...), mutation (insert/delete/replace),
// transforms (toUpper/toLower/reverse/trim), substring extraction (mid/left/
// right), and format.
//
// Phase 3a port: class declaration and method shapes are Beguile-native; method
// bodies remain verbatim I6 inside #i6 blocks. Phase 3b+ will convert bodies
// one at a time to Beguile-native expressions.
//
// I6 idiom note: `rtrue` / `rfalse` inside #i6 short-circuit the routine
// with `return true` / `return false`. The fall-through Beguile-level return
// after each #i6 is satisfies Beguile's non-void return analysis (the compiler
// can't see through #i6 to know the early-return covered all paths).
//==============================================================================
class _bglString[bglStringPoolReserve] : bglAllocated {
    int _underlyingBuffer = 0;

    // ── Introspection ────────────────────────────────────────────────────────
    int getLength() asI6 _bglText_getLength {
        int retval;
        #i6 { retval = _bglBuf._bglText_length(self._bglText_getBuf()); }
        return retval;
    }

    var getBuf(int suppressAllocation = 0) asI6 _bglText_getBuf {
        var retval;
        #i6 {
            if(self._underlyingBuffer == 0 && suppressAllocation == 0)
                self._underlyingBuffer = _bglStrAlloc(self, _bglStrStartSize);
            retval = self._underlyingBuffer;
        }
        return retval;
    }

    int getChar(int pos) asI6 _bglText_getChar {
        int retval;
        #i6 { retval = self._bglText_getBuf()->(pos + WORDSIZE); }
        return retval;
    }

    int getCharFromRight(int pos) asI6 _bglText_getCharFromRight {
        int retval;
        #i6 { retval = self._bglText_getChar(self._bglText_getLength() - (pos + 1)); }
        return retval;
    }

    bool isEmpty() asI6 _bglText_isEmpty {
        bool retval;
        #i6 { retval = (_bglBuf._bglText_length(self._bglText_getBuf()) == 0); }
        return retval;
    }

    // ── Lifecycle / pool state ───────────────────────────────────────────────
    var clone() asI6 _bglText_clone {
        var retval;
        #i6 { retval = _bglStr._bglText_new(self); }
        return retval;
    }

    bool isLocked() asI6 _bglText_isLocked {
        bool retval;
        #i6 { retval = _bglStringPool._bglText_isLocked(self); }
        return retval;
    }

    bool isBufferLocked() asI6 _bglText_isBufferLocked {
        bool retval;
        #i6 { retval = _bglStringPool._bglText_isLocked(self._underlyingBuffer); }
        return retval;
    }

    var lock() asI6 _bglText_lock {
        #i6 { _bglStringPool._bglText_reclaimString(self); }
        return self;
    }

    var free() asI6 _bglText_free {
        #i6 { _bglStringPool._bglText_freeString(self); }
        return self;
    }

    // ── Mutation (set / setChar / setLength) ─────────────────────────────────
    var set(var unkStr) asI6 _bglText_set {
        var ab;
        bool lckBuf;
        bool lckSelf;
        #i6 {
            ! Order matches orLib exactly: lckSelf first, then ab, then lckBuf.
            ! Reordering surfaced pool-state corruption in stringRuntime.bgl
            ! — the lock order is load-bearing for an edge case Jack hasn't
            ! fully pinned down yet (likely interacts with reclaimString's
            ! object-walk when the string and its underlying buffer are
            ! both ambiguously locked).
            lckSelf = _bglStr._bglText_ambiguousLock(self);
            ab      = _bglStr._bglText_toAmbiguousBuffer(unkStr);
            lckBuf  = _bglStr._bglText_ambiguousLock(ab);
            _bglStrEnsure(self, _bglBuf._bglText_length(ab));
            if(_bglStrIs(unkStr)) ab = unkStr._bglText_getBuf();   ! growing may have moved it
            _bglBuf._bglText_setAny(self._bglText_getBuf(), ab);
            _bglStr._bglText_ambiguousFree(ab, lckBuf);
            _bglStr._bglText_ambiguousFree(self, lckSelf);
        }
        return self;
    }

    // ── Phase B: type-specific setters ───────────────────────────────────────
    // Phase B eliminates the isTracked() heuristic that can false-positive when
    // a Z-machine packed-string address numerically equals a tracked buffer's
    // user-pointer. The caller knows whether they hold a literal or a string
    // (Beguile's operator overloads discriminate at compile time); this passes
    // that knowledge through to the right _bglBuf primitive directly.
    var setFromLit(var lit) asI6 _bglText_setFromLit {
        var tmp;
        #i6 {
            ! A null string (a `?.` chain that stopped) is the empty one.
            if(lit == 0){ _bglBuf._bglText_setLength(self._bglText_getBuf(), 0); return self; }
            if(_bglStrSetLiteral(self, lit)) return self;
            ! Rendered into a temporary first: its length decides how far the string grows.
            tmp = _bglStringPool._bglText_allocateBuffer();
            _bglBuf._bglText_setFromLiteral(tmp, lit);
            _bglStrEnsure(self, _bglBuf._bglText_length(tmp));
            _bglBuf._bglText_setFromBuffer(self._bglText_getBuf(), tmp);
            _bglStringPool._bglText_freeBuffer(tmp);
        }
        return self;
    }
    var setFromStr(var src) asI6 _bglText_setFromStr {
        bool lk;
        var dst; var from;
        #i6 {
            ! A null string (a `?.` chain that stopped) is the empty one.
            if(src == 0){ _bglBuf._bglText_setLength(self._bglText_getBuf(), 0); return self; }
            ! A literal or string passed where a stringObj is expected arrives as packed text.
            if(metaclass(src) == String) return self._bglText_setFromLit(src);
            ! It fits: nothing grows, so nothing moves and the source needs no lock.
            dst = self._bglText_getBuf(); from = src._bglText_getBuf();
            if(from-->0 <= dst-->(-1)){ _bglBuf._bglText_setFromBuffer(dst, from); return self; }
            lk = _bglStr._bglText_ambiguousLock(src);   ! a temporary source must outlive the growth below
            _bglStrEnsure(self, src._bglText_getLength());
            _bglBuf._bglText_setFromBuffer(self._bglText_getBuf(), src._bglText_getBuf());
            _bglStr._bglText_ambiguousFree(src, lk);
        }
        return self;
    }

    var setLength(int newLength) asI6 _bglText_setLength {
        #i6 { _bglStrEnsure(self, newLength); _bglBuf._bglText_setLength(self._bglText_getBuf(), newLength); }
        return self;
    }

    var setChar(int pos, int val) asI6 _bglText_setChar {
        #i6 {
            if(val > 255) val = '?';   ! one byte per character: beyond Latin-1 reads as '?', as captured text does
            _bglStrEnsure(self, pos + 1);
            self._bglText_getBuf()->(pos + WORDSIZE) = val;
        }
        return self;
    }

    // ── Output stream redirection ────────────────────────────────────────────
    // A capture writes into the string's own block, grown to stringCaptureSize first: the block can't
    // move while it is written by address, and a capture made while it is open needs room of its own.
    // Release gives back the room the text didn't use.
    var capture() asI6 _bglText_capture {
        #i6 { _bglStrEnsure(self, bglStringCaptureSize); _bglStrCaptures++; _bglBuf._bglText_capture(self._bglText_getBuf()); }
        return self;
    }

    var release() asI6 _bglText_release {
        int len;
        #i6 {
            _bglBuf._bglText_release();
            _bglStrCaptures--;
            len = _bglBuf._bglText_length(self._bglText_getBuf());
            _bglStrTrim(self, len);
        }
        return self;
    }

    var captureOutput(var o, var r) asI6 _bglText_captureOutput {
        self.capture();
        #i6 { _bglStr.print(o, r); }
        self.release();
        return self;
    }

    var print() {
        #i6 { _bglBuf.print(self._bglText_getBuf()); }
        return self;
    }

    // ── Equality (single + 4-way "oneOf" + CI variants) ──────────────────────
    bool equals(var altBuf, bool caseInsensitive = false) asI6 _bglText_equals {
        bool retval;
        #i6 { retval = _bglBuf._bglText_equals(_bglStr._bglText_toAmbiguousBuffer(altBuf), self._bglText_getBuf(), caseInsensitive); }
        return retval;
    }

    // ── Phase B: type-specific equality ──────────────────────────────────────
    // Caller knows whether the argument is a literal or a string instance;
    // we skip the isTracked-based dispatch in toAmbiguousBuffer entirely.
    bool equalsLit(var lit) asI6 _bglText_equalsLit {
        var ephemeral;
        bool retval;
        #i6 {
            ephemeral = _bglStringPool._bglText_allocateBuffer();
            _bglBuf._bglText_setFromLiteral(ephemeral, lit);
            ephemeral = _bglStringPool._bglText_freeBuffer(ephemeral);
            retval = _bglBuf._bglText_equals(ephemeral, self._bglText_getBuf(), 0);
        }
        return retval;
    }
    bool equalsStr(var other) asI6 _bglText_equalsStr {
        bool retval;
        #i6 { retval = _bglBuf._bglText_equals(other._bglText_getBuf(), self._bglText_getBuf(), 0); }
        return retval;
    }

    bool equalsOneOf(var buf1, var buf2 = 0, var buf3 = 0, var buf4 = 0, bool caseInsensitive = false) asI6 _bglText_equalsOneOf {
        #i6 {
            ! Hidden orLib idiom: if the last positional arg is a boolean,
            ! treat it as the caseInsensitive flag and the slot is empty.
            ! (Lets equalsOneOf("a","b",true) read as a 2-string CI compare.)
            if(buf4 == true or false) caseInsensitive = buf4;
            if(buf3 == true or false) caseInsensitive = buf3;
            if(buf2 == true or false) caseInsensitive = buf2;
            if(self._bglText_equals(buf1, caseInsensitive) == true) rtrue;
            if((~~(buf2 == true or false)) && self._bglText_equals(buf2, caseInsensitive) == true) rtrue;
            if((~~(buf3 == true or false)) && self._bglText_equals(buf3, caseInsensitive) == true) rtrue;
            if((~~(buf4 == true or false)) && self._bglText_equals(buf4, caseInsensitive) == true) rtrue;
        }
        return false;
    }

    bool equalsOneOfCaseInsensitive(var buf1, var buf2 = 0, var buf3 = 0, var buf4 = 0) asI6 _bglText_equalsOneOfCaseInsensitive {
        return self.equalsOneOf(buf1, buf2, buf3, buf4, true);
    }

    // ── Ordering ─────────────────────────────────────────────────────────────
    // Negative when self sorts before `other`, 0 when equal, positive when after.
    // Note the operand order: self is the LEFT side, so `a.compareTo(b) < 0`
    // reads as "a before b" — the same sense the `<` operator gives you.
    int compareTo(var other, bool caseInsensitive = false) asI6 _bglText_compareTo {
        int retval;
        #i6 { retval = _bglBuf._bglText_compare(self._bglText_getBuf(), _bglStr._bglText_toAmbiguousBuffer(other), caseInsensitive); }
        return retval;
    }

    // ── Search ───────────────────────────────────────────────────────────────
    int indexOf(var searchText, int startingIndex = 0) asI6 _bglText_indexOf {
        int retval;
        #i6 { retval = _bglBuf._bglText_indexOf(self._bglText_getBuf(), _bglStr._bglText_toAmbiguousBuffer(searchText), startingIndex); }
        return retval;
    }

    int numOccurances(var searchText, int startingIndex = 0) asI6 _bglText_numOccurances {
        int count = 0;
        int n;
        #i6 {
            n = _bglBuf._bglText_indexOf(self._bglText_getBuf(), _bglStr._bglText_toAmbiguousBuffer(searchText), startingIndex);
            while(n >= 0) {
                count++;
                startingIndex = n;
                n = _bglBuf._bglText_indexOf(self._bglText_getBuf(), _bglStr._bglText_toAmbiguousBuffer(searchText), startingIndex + 1);
            }
        }
        return count;
    }

    bool startsWith(var buf2, bool caseInsensitive = false) asI6 _bglText_startsWith {
        bool retval;
        #i6 { retval = _bglBuf._bglText_startsWith(self._bglText_getBuf(), _bglStr._bglText_toAmbiguousBuffer(buf2), caseInsensitive); }
        return retval;
    }

    bool startsWithOneOf(var buf1, var buf2 = 0, var buf3 = 0, var buf4 = 0, bool caseInsensitive = false) asI6 _bglText_startsWithOneOf {
        #i6 {
            if(buf4 == true or false) caseInsensitive = buf4;
            if(buf3 == true or false) caseInsensitive = buf3;
            if(buf2 == true or false) caseInsensitive = buf2;
            if(self._bglText_startsWith(buf1, caseInsensitive) == true) rtrue;
            if((~~(buf2 == true or false)) && self._bglText_startsWith(buf2, caseInsensitive) == true) rtrue;
            if((~~(buf3 == true or false)) && self._bglText_startsWith(buf3, caseInsensitive) == true) rtrue;
            if((~~(buf4 == true or false)) && self._bglText_startsWith(buf4, caseInsensitive) == true) rtrue;
        }
        return false;
    }

    bool endsWith(var buf2, bool caseInsensitive = false) asI6 _bglText_endsWith {
        bool retval;
        #i6 { retval = _bglBuf._bglText_endsWith(self._bglText_getBuf(), _bglStr._bglText_toAmbiguousBuffer(buf2), caseInsensitive); }
        return retval;
    }

    bool endsWithOneOf(var buf1, var buf2 = 0, var buf3 = 0, var buf4 = 0, bool caseInsensitive = false) asI6 _bglText_endsWithOneOf {
        #i6 {
            if(buf4 == true or false) caseInsensitive = buf4;
            if(buf3 == true or false) caseInsensitive = buf3;
            if(buf2 == true or false) caseInsensitive = buf2;
