//-----------------------------------------------------------------------------
// ui.bgl — the <ui> extension: the opt-in half of the UI namespace
//
// Include <ui> to add the runtime routines (hideCursor, showCursor, waitForKey)
//-----------------------------------------------------------------------------
#once

extend _bglUi {

    /// Move the caret to the status window and return the window to read input from, or 0 for none.
    int hideCursor() asI6 _bglUi_hideCursor {
        int h = bgl.ui.statusBar.height;
    #if TARGET_GLULX
        // The id is 0 until the status window is open
        if(h <= 0 || bgl.ui.statusBar.id == 0) return 0;
        bgl.ui.statusBar.moveCursor(bgl.ui.statusBar.width - 1, h - 1);
        return bgl.ui.statusBar.id;
    #else
        if(h <= 0) return 0;
        bgl.asm.setWindow(1);            // The cursor moves only in the upper window
        bgl.ui.statusBar.moveCursor(bgl.ui.statusBar.width - 1, h - 1);
        return 0;
    #endif
    }

    /// Undo `hideCursor()`, putting input back on the main window.
    void showCursor() asI6 _bglUi_showCursor {
    #if TARGET_GLULX
        ;
    #else
        bgl.asm.setWindow(0);
    #endif
    }

    /// Wait for a key press and return it, printing `separator` first if given.
    char waitForKey(string separator=null) asI6 _bglUi_waitForKey {
    
    if(separator !=null) {
        print(separator);
        print("^^");
    }
    
    #if TARGET_GLULX

        rawArray<int> eventPayload[4];  // Glk event: type, window, val1, val2
        rawArray<int> keyResult[1];     // Key from HandleGlkEvent returning 2

        int inputWin = bgl.ui.hideCursor();
        if(inputWin == 0) inputWin = bgl.ui.mainWin.id;

        bgl.asm.requestCharEvent(inputWin);
        
        while (true) { 
            bgl.asm.select(&eventPayload);

            if(eventPayload[0]==(int)eGlulxEventType.charInput && eventPayload[1] == inputWin)
                return (char)eventPayload[2]; 
            if(HandleGlkEvent(&eventPayload, 1, &keyResult) == 2)   // Other events go to the author's handler
                return (char)keyResult[0];
        }
    #else
        bgl.ui.hideCursor();
        int k = bgl.asm.readChar(1);
        bgl.ui.showCursor();
        return (char)k;
    #endif
    }
    // void setStatusHeight(int height){
    //     #if TARGET_ZCODE;
    //         bgl.asm.splitWindow(height);
    //     #else;
    //         int parwin = glk_window_get_parent(gg_statuswin); //TODO: gg_statuswin is a standard library variable.  It needs to be removed from the BLRT
    //         bgl.asm.glk.window_set_arrangement(parwin, $12, height, 0);
    //     #endif;
    // }
}
