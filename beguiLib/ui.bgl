//-----------------------------------------------------------------------------
// ui.bgl — the <ui> extension: the opt-in half of the UI namespace.
//
// Usage:
//   #include <ui> in your .bgl file to activate these routines.
//
// The bgl.ui namespace and its emitter-based text styles (bgl.ui.style.bold()
// etc.) are always present in core (core/_ui.bgl) and need no include. This
// file adds the *runtime* routines — real property-routines on the _bglUi
// object, so they only exist when a program opts in — via `extend _bglUi`, the
// same shape <array>/<string> use to grow their core-defined type.
//-----------------------------------------------------------------------------
#once

extend _bglUi {
    char waitForKey(){
    
    #if TARGET_GLULX

        rawArray<int> eventPayload[3];  //allocate space for the glk events.

        bgl.asm.requestCharEvent(bgl.ui.mainWin.id); // let glk know we care about the next key press in main
        
        while (true) { 
            bgl.asm.select(&eventPayload); //get the next event in the queue

            if(eventPayload[0]==(int)eGlulxEventType.charInput && eventPayload[1] == bgl.ui.mainWin.id)  //if its a keypress from the main window, return it; otherwise discard it. 
                return (char)eventPayload[2]; 
            else{
                ; //no-op; TODO: add some generic processor to handle background events
            }
        }
    #else
        return bgl.asm.readChar(1);   // read_char is now a value-returning routine; returns cleanly
    #endif
    }
    // void setStatusHeight(int height){
    //     #if TARGET_ZCODE;
    //         bgl.asm.splitWindow(height);
    //     #else;
    //         int parwin = glk_window_get_parent(gg_statuswin); //TODO: gg_statuswin is a standard library variable.  It needs to be removed from the BLRT
    //         bgl.asm.glk.window_set_arrangement(parwin, $12, height, 0);
    //     #endif;
    // }
}
