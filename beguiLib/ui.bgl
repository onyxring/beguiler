//-----------------------------------------------------------------------------
// ui.bgl — the <ui> extension: the opt-in half of the UI namespace.
//
// Usage:
//   #include <ui> in your .bgl file to activate these routines.
//
// The bgl.ui namespace and its emitter-based text styles (bgl.ui.style.bold()
// etc.) are always present in core (core/_ui.bgl) and need no include. This
// file adds the *runtime* routines — real property-routines on the _bglUi
// object, so they only exist when a program opts in — via `extend _bglUi`, the
// same shape <array>/<string> use to grow their core-defined type.
//-----------------------------------------------------------------------------
#once

#if TARGET_GLULX
// Two-word scratch: glk writes [0]=width, [1]=height.
array<int> _bglKeyWinSize[2];
#endif

extend _bglUi {

    // Park the text caret out of the prose, ahead of a key read.
    //
    // The targets need opposite moves because they bind the caret differently:
    //   Glulx  - glk draws it on the window the char request NAMES, and a text-grid window draws it
    //            at that window's own cursor. So this positions the status grid's cursor and hands
    //            back the window the caller must request input on.
    //   Z-code - @read_char draws at the CURRENT window's cursor, so this switches to the upper
    //            window. The caller must call showCursor() once the key has been read.
    //
    // Returns the window to request char input on (Glulx), or 0 when there is no usable status
    // window and the caller should fall back to the main window.
    /// Point keyboard input at the status window and return the window to read from, or 0 when
    /// there is no usable one. Call `showCursor()` afterwards. `waitForKey` does both for you.
    int hideCursor(){
    #if TARGET_GLULX
        // `id` is 0 unless a library binding maps it to a real grid window (core's own _bglStatus
        // tracks its window privately), so both must hold before redirecting the request.
        if(bgl.ui.statusBar.height <= 0 || bgl.ui.statusBar.id == 0) return 0;

        int win = bgl.ui.statusBar.id;
        bgl.asm.windowGetSize(win, ((int)_bglKeyWinSize) + bgl.wordsize, ((int)_bglKeyWinSize) + (2 * bgl.wordsize));
        bgl.asm.windowMoveCursor(win, _bglKeyWinSize[0] - 1, _bglKeyWinSize[1] - 1);
        return win;
    #else
        int h = bgl.ui.statusBar.height;
        int w = bgl.asm.loadb(0, $21);   // header byte $21 - screen width in characters
        if(h <= 0 || w <= 0) return 0;

        bgl.asm.setWindow(1);            // @set_cursor only addresses the upper window
        bgl.asm.setCursor(h, w);         // 1-based: last row, last column
        return 0;
    #endif
    }

    // Undo hideCursor. Z-code: hand the current window back to the main window. Glulx: nothing to
    // undo - the caret belonged to the input request, which has already completed.
    /// Undo `hideCursor()`, putting input back on the main window.
    void showCursor(){
    #if TARGET_GLULX
        ;
    #else
        bgl.asm.setWindow(0);
    #endif
    }

    /// Wait for one key press and return it. Prints `separator` first if given — a "[MORE]" line,
    /// say. Reads from the status window where there is one, so the caret appears in the right place.
    char waitForKey(string separator=null){
    
    if(separator !=null) {
        print(separator);
        print("^^");
    }
    
    #if TARGET_GLULX

        rawArray<int> eventPayload[3];  //allocate space for the glk events.

        int inputWin = bgl.ui.hideCursor();
        if(inputWin == 0) inputWin = bgl.ui.mainWin.id;

        bgl.asm.requestCharEvent(inputWin); // let glk know we care about the next key press
        
        while (true) { 
            bgl.asm.select(&eventPayload); //get the next event in the queue

            if(eventPayload[0]==(int)eGlulxEventType.charInput && eventPayload[1] == inputWin)  //if its a keypress from the window we asked, return it; otherwise discard it. 
                return (char)eventPayload[2]; 
            else{
                ; //no-op; TODO: add some generic processor to handle background events
            }
        }
    #else
        bgl.ui.hideCursor();
        int k = bgl.asm.readChar(1);   // read_char is now a value-returning routine; returns cleanly
        bgl.ui.showCursor();           // put the current window back before handing the key over
        return (char)k;
    #endif
    }
    // void setStatusHeight(int height){
    //     #if TARGET_ZCODE;
    //         bgl.asm.splitWindow(height);
    //     #else;
    //         int parwin = glk_window_get_parent(gg_statuswin); //TODO: gg_statuswin is a standard library variable.  It needs to be removed from the BLRT
    //         bgl.asm.glk.window_set_arrangement(parwin, $12, height, 0);
    //     #endif;
    // }
}
