//===================================================================================================
// transition.bgl — divide story parts: optional centered text, a centered prompt, a key press, then a
// cleared window
//===================================================================================================
#once
#include <ui>
#include <extensions/general/center>

extend _bglOutput {
    /// Print `text` and a prompt centered, wait for a key, then clear the main window unless `skipErase`.
    emitter void transition(string text = null, string prompt = null, bool skipErase = false) { _transition($text, $prompt, $skipErase) }
}

superposed void _transition(string text, string prompt, bool skipErase) {
    print("^^");
    if(text != null) {
        bgl.output.center(text);
        print("^^");
    }
    if(prompt == null) prompt = "Press any key to continue";
    bgl.output.center(prompt);
    bgl.ui.waitForKey();
    if(skipErase) return;
    #if TARGET_GLULX
        bgl.asm.windowClear(bgl.ui.mainWin.id);
    #else
        bgl.asm.eraseWindow(0);
    #endif
}
