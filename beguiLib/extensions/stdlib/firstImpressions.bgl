//===================================================================================================
// firstImpressions.bgl — text shown with a description only the first time the player sees it.
//---------------------------------------------------------------------------------------------------
// An object's or room's `preImpression` prints before its description, and its `postImpression`
// after, until it has `beenSeen` (see <extensions/stdlib/trackSeen>). Each is a string, plain or
// interpolated, or a method that prints. REVIEW shows them again (see <extensions/stdlib/review>).
// A `postImpression` continues the description's line, so a description routine on a thing that
// has one leaves its line unended; this extension ends it, whether or not the impression is shown.
//
// Include it after the library's verblib.
//
// Ported from orLibrary's orFirstImpressions.
//===================================================================================================
#once
#include <extensions/stdlib/trackSeen>

property preImpression;    /// Shown before the description, the first time.
property postImpression;   /// Shown after the description, the first time.

object _firstImpressionsHooks {
    parent = LibraryExtensions;
    bool ext_preDescription()  { _firstImpression((property)preImpression);  rfalse; }
    bool ext_postDescription() {
        _firstImpression((property)postImpression);
        if(noun.provides((property)postImpression) && _firstImpressionEndsLine()) print("^");
        rfalse;
    }
}

// True when a description routine was just printed: the library ends the line only after a string.
superposed bool _firstImpressionEndsLine() {
    #i6 {
        if (noun.#description > WORDSIZE || metaclass(noun.description) ~= Routine) rfalse;
        if (action ~= ##Look or ##Go) rtrue;
        ! LookSub's own test for printing the room's description.
        return lookmode < 3 && visibility_ceiling == location && location.&describe == 0
            && (action == ##Look || lookmode == 2 || location hasnt visited);
    }
}

// The room for LOOK and GO, which describe it; otherwise the object being examined.
superposed void _firstImpression(property impression) {
    if(noun == null || action == Look || action == Go) noun = location;
    if(noun.hasnt(beenSeen) && noun.provides(impression) && noun.impression != 0) {
        var v = noun.impression;
        if(typeof(v) == eType.routine) noun.impression();
        else print((string)v);
    }
}
