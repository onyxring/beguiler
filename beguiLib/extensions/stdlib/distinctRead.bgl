//===================================================================================================
// distinctRead.bgl — READ as its own action, not a synonym for EXAMINE
// READ prints the object's readDescription
//===================================================================================================
#once
#emitAfterI6Include "verblib"
#include <bindings/i6StandardLibrary>

property readDescription;   /// The text READ prints; `description` reads as EXAMINE.

extend Examine { grammar -= { {.read} }; }

verb Read {
    grammar = {.read, NOUN};

    void handler() {
        property text = (property)readDescription;
        if(!noun.provides(text)) {
            print($"{bgl.printRules.cThe(noun)} cannot be read.^");
            return;
        }
        if(noun.text == (property)description) { ExamineSub(); return; }
        PrintOrRun(noun, text);
    }
}

extend Consult { grammar += { {.read, .about, TOPIC, .in, NOUN}, {.read, TOPIC, .in, NOUN} }; }
