//===================================================================================================
// hooks/informLibrary.bgl — hooks in the play loop (InformLibrary.play)
//---------------------------------------------------------------------------------------------------
// informLibrary.patch merges calls to these hooks into the standard library. Including it changes nothing
// until a library extension answers a hook (see <extensions/stdlib/hooks>)
//===================================================================================================
#once
#include <bindings/i6StandardLibrary>

#mergeI6 "informLibrary"

// Declared before the library; guarded in case already made
#emitfirst {
    #Ifndef ext_afterGamePrologueNotify;           Property individual ext_afterGamePrologueNotify;           #Endif;
    #Ifndef ext_playLoopRewriteParsedCommands;     Property individual ext_playLoopRewriteParsedCommands;     #Endif;
    #Ifndef ext_playLoopAssignObjectVariables;     Property individual ext_playLoopAssignObjectVariables;     #Endif;
    #Ifndef ext_playLoopPerformSingleObjectAction; Property individual ext_playLoopPerformSingleObjectAction; #Endif;
    #Ifndef ext_playLoopPerformMultiObjectAction;  Property individual ext_playLoopPerformMultiObjectAction;  #Endif;
}

extern property ext_afterGamePrologueNotify;           /// Told after the game's prologue, before the first turn.
extern property ext_playLoopRewriteParsedCommands;     /// True skips the library's rewriting of the parsed command.
extern property ext_playLoopAssignObjectVariables;     /// True skips setting noun and second from the parsed command.
extern property ext_playLoopPerformSingleObjectAction; /// Performs a single-object action.
extern property ext_playLoopPerformMultiObjectAction;  /// Performs a multiple-object action.
