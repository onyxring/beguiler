//===================================================================================================
// review.bgl — REVIEW: look again, or examine again, without a turn passing.
//---------------------------------------------------------------------------------------------------
// REVIEW describes the room as LOOK would; REVIEW <object> describes an object the player has already
// examined, as EXAMINE would. Neither takes a turn. Each describes the room or object as though for
// the first time, so text kept for the first look (see <extensions/stdlib/firstImpressions>) shows
// again.
//
// Include it after the library's verblib.
//
// Ported from orLibrary's orReview.
//===================================================================================================
#once
#include <extensions/stdlib/trackSeen>

verb Review {
    meta = true;
    grammar = { {.review} };

    void handler() {
        location.ungive(beenSeen);
        LookSub();
        location.give(beenSeen);
    }
}

verb ReviewObj {
    meta = true;
    grammar = { {.review, NOUN} };

    void handler() {
        if(noun.hasnt(beenSeen)) {
            print($"You have not already examined {bgl.printRules.the(noun)}.^");
            return;
        }
        noun.ungive(beenSeen);
        ExamineSub();
        noun.give(beenSeen);
    }
}
