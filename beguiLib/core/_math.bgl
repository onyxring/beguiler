#once
//=============================================================================
// Math — ALWAYS present, no manual include. Both the `superposed` implementation
// routines below AND the nicely-named _bglMath facade (bgl.util.math) that wraps
// them are auto-loaded in core, yet nothing is emitted unless referenced:
//
//   • the facade is emitters — inlined at the call site, zero footprint of its own;
//   • each routine is `superposed` — materialized only when a call site names it.
//
// So the developer can reach for `_bglMath.pow(...)` (or the standalones, for
// other BLR like uint's unsigned operators) anywhere, and a game that never
// touches math pays nothing. There is no `<math>` include — math is always here.
//=============================================================================

// Target-specific mask clearing the sign bit of a word (16-bit Z, 32-bit Glulx).
// Top-level #if because inline ##if is only honored inside emitter bodies.
#if TARGET_GLULX
    #define BGL_SIGN_MASK $7FFFFFFF
#else
    #define BGL_SIGN_MASK $7FFF
#endif

// Compare two int values as if they were unsigned, returning -1 / 0 / 1
// (x<y / x==y / x>y). Ported from the standard library's UnsignedCompare so the
// comparison is target-agnostic and free of parser.h symbols.
superposed int _bglUnsignedCompare(int x, int y){
    if(x == y) return 0;
    if(x < 0 && y >= 0) return 1;
    if(x >= 0 && y < 0) return -1;
    int u = x & BGL_SIGN_MASK;
    int v = y & BGL_SIGN_MASK;
    if(u > v) return 1;
    return -1;
}

// Unsigned division: a / b treating both as unsigned. Fast path for the common
// case (both non-negative uses native /). Sign-bit cases use an algebraic split
// instead of binary long division. At most one recursive call.
superposed int _bglUnsignedDiv(int a, int b){
    if(b == 0) return 0;
    if(a >= 0 && b > 0) return a / b;
    // b has sign bit: b_unsigned >= HIGHBIT, so a/b is 0 or 1.
    // (Plain if/else, not a ternary: ternary lowering allocates a `_bgl_temp`
    // global at parse time that `superposed` does NOT withhold — it would leak
    // into every story file since this routine lives in always-parsed core.)
    if(b < 0){
        if(_bglUnsignedCompare(a, b) >= 0) return 1;
        return 0;
    }
    // a has sign bit, b is positive: split a into lowHalf + HIGHBIT
    int lowHalf = a & BGL_SIGN_MASK;
    int hq = BGL_SIGN_MASK / b;
    int hr = BGL_SIGN_MASK % b + 1;
    if(hr >= b){ hq = hq + 1; hr = hr - b; }
    int combined = lowHalf + hr;
    if(combined >= 0) return hq + combined / b;
    // combined overflowed (sign bit set) — recurse once
    return hq + _bglUnsignedDiv(combined, b);
}

// Unsigned modulo: a % b treating both as unsigned.
superposed int _bglUnsignedMod(int a, int b){
    if(b == 0) return 0;
    if(a >= 0 && b > 0) return a % b;
    return a - _bglUnsignedDiv(a, b) * b;
}

superposed int _bglPow(int i, int p){
    if(p==0) return 1;
    int retval = i;
    if(p<0){
        for(int t=0;t<(-p)-1;t++) retval=retval/i;
        return retval;
    }
    for(int t=0;t < p-1;t++) retval=retval*i;
    return retval;
}

// Plain if/else rather than a ternary — see the note in _bglUnsignedDiv: ternary
// lowering leaks a `_bgl_temp` global that superposition can't withhold.
superposed int _bglAbs(int p){ if(p < 0) return -p; return p; }
superposed int _bglShiftLeft(int i, int numBits){ return i * _bglPow(2, numBits); }
superposed int _bglShiftRight(int i, int numBits){ return i / _bglPow(2, numBits); }

// Logical (zero-fill) right shift — divides as UNSIGNED, so a value with the sign
// bit set does not sign-extend. This is what `uint >>` needs; signed `_bglShiftRight`
// (native `/`) would smear the sign bit. Left shift is bit-identical either way, so
// uint reuses `_bglShiftLeft`.
superposed int _bglUnsignedShiftRight(int i, int numBits){ return _bglUnsignedDiv(i, _bglPow(2, numBits)); }

// Plain if/else, never ternary — see the _bglUnsignedDiv note: ternary lowering leaks
// a `_bgl_temp` global that superposition can't withhold, which would land in every
// story file since this is always-parsed core.
superposed int _bglMin(int a, int b){ if(a < b) return a; return b; }
superposed int _bglMax(int a, int b){ if(a > b) return a; return b; }
superposed int _bglClamp(int v, int lo, int hi){ if(v < lo) return lo; if(v > hi) return hi; return v; }
superposed int _bglSign(int v){ if(v < 0) return -1; if(v > 0) return 1; return 0; }

//=============================================================================
// _bglMath — the nicely-named facade (also reachable as bgl.util.math). Each
// method is an emitter that inlines to its `superposed` implementation above, so
// the facade emits nothing on its own and only the called routines materialize.
// (Emitter bodies can't nest-call other emitters, so BLR code that is itself an
// emitter — e.g. uint's operators — calls the standalone routines directly.)
//=============================================================================
emitter class _bglMath {
    emitter int unsignedCompare(int x, int y){ _bglUnsignedCompare($x, $y) }
    emitter int unsignedDiv(int a, int b)    { _bglUnsignedDiv($a, $b) }
    emitter int unsignedMod(int a, int b)    { _bglUnsignedMod($a, $b) }
    emitter int pow(int i, int p)            { _bglPow($i, $p) }
    emitter int abs(int p)                   { _bglAbs($p) }
    emitter int shiftLeft(int i, int numBits) { _bglShiftLeft($i, $numBits) }
    emitter int shiftRight(int i, int numBits){ _bglShiftRight($i, $numBits) }
    emitter int min(int a, int b)            { _bglMin($a, $b) }
    emitter int max(int a, int b)            { _bglMax($a, $b) }
    emitter int clamp(int v, int lo, int hi) { _bglClamp($v, $lo, $hi) }
    emitter int sign(int v)                  { _bglSign($v) }
}

extend _bglUtil{ emitter auto math = _bglMath; }
