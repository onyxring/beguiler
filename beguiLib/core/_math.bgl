/* -----------------------------------------------------------------------------
    _math.bgl - Integer math
    Integer helpers I6 has no operator for: unsigned comparison and division, powers,
    shifts, min, max and clamp. Reach them as `bgl.util.math`.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

//-- Implementation routines ---------------------------------------------------
// The sign bit of a word is masked off by BGL_SIGN_MASK.
#if TARGET_GLULX
    #define BGL_SIGN_MASK $7FFFFFFF
#else
    #define BGL_SIGN_MASK $7FFF
#endif

superposed int _bglUnsignedCompare(int x, int y){
    if(x == y) return 0;
    if(x < 0 && y >= 0) return 1;
    if(x >= 0 && y < 0) return -1;
    int u = x & BGL_SIGN_MASK;
    int v = y & BGL_SIGN_MASK;
    if(u > v) return 1;
    return -1;
}

superposed int _bglUnsignedDiv(int a, int b){
    if(b == 0) return 0;
    if(a >= 0 && b > 0) return a / b;
    if(b < 0){
        if(_bglUnsignedCompare(a, b) >= 0) return 1;
        return 0;
    }
    int lowHalf = a & BGL_SIGN_MASK;
    int hq = BGL_SIGN_MASK / b;
    int hr = BGL_SIGN_MASK % b + 1;
    if(hr >= b){ hq = hq + 1; hr = hr - b; }
    int combined = lowHalf + hr;
    if(combined >= 0) return hq + combined / b;
    return hq + _bglUnsignedDiv(combined, b);
}

superposed int _bglUnsignedMod(int a, int b){
    if(b == 0) return 0;
    if(a >= 0 && b > 0) return a % b;
    return a - _bglUnsignedDiv(a, b) * b;
}

superposed int _bglPow(int i, int p){
    if(p==0) return 1;
    int retval = i;
    if(p<0){
        for(int t=0;t<(-p)-1;t++) retval=retval/i;
        return retval;
    }
    for(int t=0;t < p-1;t++) retval=retval*i;
    return retval;
}

superposed int _bglAbs(int p){ if(p < 0) return -p; return p; }
superposed int _bglShiftLeft(int i, int numBits){ return i * _bglPow(2, numBits); }
superposed int _bglShiftRight(int i, int numBits){ return i / _bglPow(2, numBits); }

superposed int _bglUnsignedShiftRight(int i, int numBits){ return _bglUnsignedDiv(i, _bglPow(2, numBits)); }

superposed int _bglMin(int a, int b){ if(a < b) return a; return b; }
superposed int _bglMax(int a, int b){ if(a > b) return a; return b; }
superposed int _bglClamp(int v, int lo, int hi){ if(v < lo) return lo; if(v > hi) return hi; return v; }
superposed int _bglSign(int v){ if(v < 0) return -1; if(v > 0) return 1; return 0; }

//-- The math facade -----------------------------------------------------------
/// The `bgl.util.math` helpers: integer operations I6 has no operator for.
emitter class _bglMath {
    /// Compare two words as unsigned, returning -1, 0 or 1; `<` and `>` read ints as signed.
    emitter int unsignedCompare(int x, int y){ _bglUnsignedCompare($x, $y) }
    /// Divide `a` by `b`, reading both as unsigned.
    emitter int unsignedDiv(int a, int b)    { _bglUnsignedDiv($a, $b) }
    /// Return the remainder of `a` divided by `b`, reading both as unsigned.
    emitter int unsignedMod(int a, int b)    { _bglUnsignedMod($a, $b) }
    /// Return `i` raised to the power `p`.
    emitter int pow(int i, int p)            { _bglPow($i, $p) }
    /// Return the absolute value of `p`.
    emitter int abs(int p)                   { _bglAbs($p) }
    /// Shift `i` left by `numBits` bits.
    emitter int shiftLeft(int i, int numBits) { _bglShiftLeft($i, $numBits) }
    /// Shift `i` right by `numBits` bits.
    emitter int shiftRight(int i, int numBits){ _bglShiftRight($i, $numBits) }
    /// Return the smaller of `a` and `b`.
    emitter int min(int a, int b)            { _bglMin($a, $b) }
    /// Return the larger of `a` and `b`.
    emitter int max(int a, int b)            { _bglMax($a, $b) }
    /// Return `v` limited to the range `lo` to `hi`.
    emitter int clamp(int v, int lo, int hi) { _bglClamp($v, $lo, $hi) }
    /// Return -1, 0 or 1 according to the sign of `v`.
    emitter int sign(int v)                  { _bglSign($v) }
}

extend _bglUtil{ emitter auto math = _bglMath; }
