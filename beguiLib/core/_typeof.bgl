/* -----------------------------------------------------------------------------
    _typeof.bgl - Run-time type tests
    Provides `typeof()`, which reports what kind of value a variable holds, for
    telling apart the members of a union.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

/// What `typeof()` reports: a value's kind at run time, not its declared type.
enum eType {
    unknown = 0,   /// Null, or a value whose kind can't be told.
    int,           /// A plain value; bool, char and enum values report this too.
    string,        /// A string.
    routine,       /// A routine.
    object,        /// An object.
    class          /// A class.
}

// Kind tests behind typeof().
emitter bool _bglMcRoutine(var v) { (metaclass($v) == Routine) }
emitter bool _bglMcString(var v)  { (metaclass($v) == String) }
emitter bool _bglMcObject(var v)  { (metaclass($v) == Object) }
emitter bool _bglMcClass(var v)   { (metaclass($v) == Class) }

/// A value declared `int`, `bool` or `char` is plainly an `int`; no run-time test is needed.
emitter eType typeof(int v)  { $i6Expr(eType.int) }
emitter eType typeof(bool v) { $i6Expr(eType.int) }
emitter eType typeof(char v) { $i6Expr(eType.int) }

/// Return what kind of value `v` holds; bool, char and enum values report `int`. A plain number
/// can't be told from the object with that number, so test a union's members, not arbitrary values.
superposed eType typeof(var v) {
    if (v == null)          return eType.unknown;
    if (_bglMcRoutine(v))   return eType.routine;
    if (_bglMcString(v))    return eType.string;
    if (_bglMcClass(v))     return eType.class;   // test Class before Object
    if (_bglMcObject(v))    return eType.object;
    return eType.int;
}
