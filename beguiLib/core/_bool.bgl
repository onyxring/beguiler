   -----------------------------------------------------------------------------*/
#once

/// The two boolean values, written bare as `true` and `false`.
extern enum eBool{
    true,
    false
}

/// A true or false value.
primitive class bool {
    /// Print `true` or `false`.
    replace emitter void print(){
        if($val == true)
            print "true";
        else
            print "false";
    }
    emitter eBool operator == (bool v){ $val == $v }   /// True when the values are equal.
    emitter eBool operator == (eBool v){ $val == $v }  /// True when the values are equal.
    emitter eBool operator != (bool v){ $val ~= $v }   /// True when the values differ.
    emitter eBool operator != (eBool v){ $val ~= $v }  /// True when the values differ.
    emitter bool operator = (bool v){ $target=$v; }    /// Assignment: the variable takes the value.
    emitter bool operator = (eBool v){ $target=$v; }   /// Assignment: the variable takes the value.
    emitter eBool operator && (bool v){ $val && $v }   /// True when both are true.
    emitter eBool operator && (eBool v){ $val && $v }  /// True when both are true.
    emitter eBool operator || (bool v){ $val || $v }   /// True when either is true.
    emitter eBool operator || (eBool v){ $val || $v }  /// True when either is true.
    emitter eBool operator ! (){ ~~$val }              /// True when the value is false.
}

emitter void print(bool b){ if($b == true) print "true"; else print "false"; }   /// Print `true` or `false`.
