/* -----------------------------------------------------------------------------
    _grammar.bgl - Grammar
    Declares the types behind a verb's grammar: the elements of a pattern, a rule
    that pairs a pattern with a verb, and a verb's list of rules.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

/// One element of a grammar pattern: a dictionary word, a grammar token, an attribute or a parsing routine.
primitive class patternElement { }

/// A verb paired with a pattern and an optional priority: `{Take, {.grab, NOUN}, 5}`.
extern emitter class grammarRule {
    verb verb;                      /// The action the rule triggers.
    array<patternElement> pattern;  /// The words and tokens the player's command must match.
    int priority;                   /// The rule's priority: lower matches earlier.
}

/// A verb's grammar: a list of grammar rules.
extern emitter class grammarRuleList {
    grammarRule rule;  // Gives the list its element type.
}
