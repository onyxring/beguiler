/* -----------------------------------------------------------------------------
    _object.bgl - Objects
    Declares `object`, a thing in the game world, with its attributes and its
    place in the world tree.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

/// A thing in the game world: it has a name, attributes, and a place in the world tree.
extern class object:_bglObject{
    typesealed parentProp parent;          /// The object that contains this one; assigning to it moves this object.
    typesealed childrenProp children;      /// The objects directly inside this one.
    typesealed attributeList attributes;   /// The flags this object carries.

    emitter void give(attribute attr){ give $val $attr }      /// Give this object `attr`.
    emitter void ungive(attribute attr){ give $val ~$attr }   /// Take `attr` away from this object.
    /// True when this object has `attr`.
    emitter bool has(attribute attr){
        ($val has $attr)
    }
    /// True when this object does not have `attr`.
    emitter bool hasnt(attribute attr){
        ($val hasnt $attr)
    }
    /// Take this object out of the world tree; assigning `.parent` puts it back.
    emitter void remove(){
        remove $val
    }
    /// This object's first child, or null; iterate `.children` for all of them.
    emitter object child{
        child($val)
    }
    /// The next object with the same parent, or null.
    emitter object sibling{
        sibling($val)
    }
}

/// The type of `object.parent`: assigning to it moves the object.
extern emitter class parentProp{
    /// Move the object into `v`.
    emitter parentProp operator = (object v){
        move $self to $v
    }
    /// True when the parent is `v`; compare with null to test for no parent.
    emitter eBool operator == (_bglObject v){
        parent($self) == $v
    }
    /// True unless the parent is `v`.
    emitter eBool operator != (_bglObject v){
        parent($self) ~= $v
    }
    /// The parent object.
    emitter object operator(){
        parent($self)
    }
}

/// The type of `object.children`: the objects directly inside an object, iterable with `for … in`.
extern emitter class childrenProp{
    emitter int length { children($host) }   /// How many children the object has.
    emitter int size   { children($host) }   /// How many children the object has; the same as `length`.
}
