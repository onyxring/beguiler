/* -----------------------------------------------------------------------------
    _bglAllocated.bgl - Pooled objects
    Declares `bglAllocated`, which adds copying and a free-slot count to a class
    whose instances come from a pool (`class Marble[10] : object, bglAllocated`).

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

/// Adds `copy()` and `remaining()` to a pooled class.
emitter class bglAllocated {
    emitter void copy(var src) { $class.copy($self, $src); }   /// Copy every property of `src` into this object.
    emitter int remaining() { $class.remaining() }             /// Return how many free slots this class's pool has left.
}
