/*=============================================================================
    __beguileCore.bgl
 -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
    The entry point of the Beguile Language Runtime.  This file is included
    automatically by the compiler and is responsible for loading the entirety
    of the core BLR.
 -----------------------------------------------------------------------------*/
#once

//--include the rest of the BLR, starting with base types...
#include <core/_array>
#include <core/_attribute>
#include <core/_beguilerSettings>
#include <core/_bool>
#include <core/_char>
#include <core/_dictionaryWord>
#include <core/_grammar>
#include <core/_int>
#include <core/_object>
#include <core/_property>
#include <core/_string>
#include <core/_uint>
#include <core/_verb>
//--now utilities...
#include <core/_bglAllocated>
#include <core/_bglWorld>
#include <core/_math>
#include <core/_typeof>
#include <core/_mainWindow>
#include <core/_printRules>  
#include <core/_random>
#include <core/_statusBar>
#include <core/_ui>         
//--and platform specific code...
#if TARGET_GLULX
    #include<core/_glulxCore>
#else
    #include<core/_zcodeCore>
#endif

//-- the BLR Namespace ---------------------------------------------------------
_bglObject bgl{ // bgl is root 
    emitter int wordsize {WORDSIZE} //bgl.wordsize value
    alias util = _bglUtil;          //bgl.util - the util namespace to which other extensions will attach
}
superposed _bglObject _bglUtil{}    //actual bgl.util object, defined here so other extensions can hook into it

//-- Base object types ---------------------------------------------------------
// Two roots. A class whose values are I6 objects derives _bglObject; a class with no instances (a
// primitive or emitter class: its value is a word the emitters interpret) derives _bglPrimitive.
// A class declared without a base derives the one that fits its form (spec 8.6).

/// The root of every class with no instances: primitive classes (int, bool, string…) and emitter
/// classes (stringObj, array<T>…).
emitter class _bglPrimitive{
    /// Assignment: the slot takes the value's word.
    emitter _bglPrimitive operator = (_bglPrimitive v){ $target = $v }
}

/// The type of `null`: the empty reference, which fits every type. Compared as an object (`x == null`).
primitive class nullLiteral{
    emitter _bglObject operator();
}

/// The root of every class whose values are I6 objects: what I6 gives any object (identity, class
/// and property tests, its name). `object` (in _object.bgl) adds world-tree citizenship on top.
emitter class _bglObject{
    /// The object's name: what `print(obj)` prints (I6's `(name)`), with or without a library. A
    /// library prints `short_name` instead when the object has one. Set in an object's declaration
    /// body, as a string literal: it is fixed when the program is compiled. Positional, and last:
    /// `object lamp { "brass lamp"; }`; a class that adds positional members of its own can re-list
    /// it (`inline instanceName;`) to put it first.
    inline const string instanceName;

    /// Assignment: the variable refers to the assigned instance (spec 2.10.3). A value class copies
    /// instead, through its own `operator =` taking its own type.
    emitter _bglObject operator = (_bglObject v){ $target = $v }

    emitter eBool operator ?() { $val ~= nothing }
    emitter eBool operator == (_bglObject v){ $val == $v }
    emitter eBool operator != (_bglObject v){ $val ~= $v }

    /// True when this object declares `prop`, so reading it is safe.
    emitter bool provides(property prop){
        $val provides $prop
    }
    /// True when this object is a `cls`, including any class derived from it.
    emitter bool is(bglClass cls){
        ($val ofclass $cls)
    }
    /// Print this object's short name. What `print(obj)` calls.
    emitter void print(){
        print (name)$val;
    }
}
primitive class bglClass{ }   //the base type of all class references, used in cases where the type is checked (e.g. .is(bglClass))

//-- Print routines ---------------------------------------------------------------------------
emitter void print(var val){ print $val; } //the default, which will be used for all data types not defined
emitter void print(_bglObject val){ if($val provides print) $val.print(); else print (name)$val;} //the default, which will be used for all data types not defined
emitter void log(var msg){ ##if DEBUG print $msg; ##endif }
/// Print `val` the way `print(val)` would, then a newline.
emitter void printLine(var val){ $i6Expr(print($val)); print "^"; }
/// Print an interpolated string, then a newline.
emitter void printLine(interpolatedStringLiteral val){ $val; print "^"; }
/// Print a newline.
emitter void printLine(){ print "^"; }

// Articles moved to bgl.printRules (core/_printRules) — a print rule belongs in the print-rule
// namespace now that there is one. Reach them qualified, `bgl.printRules.the(noun)`, or bring the
// short spelling back per file with `#using bgl.printRules;`.
emitter void printName(object o){ print (name)$o; }   // I6 `(name) obj` print rule — bare short name, no article

//-----------------------------------------------------------------------------
// Blorb asset ids, partitioned by resource kind so operations only appear where they apply (an image's
// width()/height() is meaningless on a sound). The blorbifier extends the matching enum for each asset
// (pictures → eImages, sounds → eSounds) when blorbification is enabled; both are empty otherwise.
enum eImages { }        // Pict (image) resource ids.
enum eSounds { }        // Snd  (sound) resource ids.
enum eUnknownAsset { }  // Data resource ids — the open catch-all: any file the blorbifier doesn't
                        // recognize as an image/sound is surfaced here (packaged as generic Data) so
                        // it is never silently dropped. Promote a kind to its own enum when it earns
                        // first-class support (its own operations / a proper blorb usage).
// Umbrella "any asset" type for APIs that genuinely accept any resource — and the extension point as
// the blorb standard grows: add the new first-class enum as another union member here.
union eAssets = eImages | eSounds | eUnknownAsset;
extern void bglInit(); // bglInit() is a special, compiler built routine used to initialize the BLR

// Holds an argument while a parameter of a class with init/deinit is given its own copy (§8.5).
// Emitted only when such a parameter exists (the paramCopyIn.arg builtin template triggers it).
#storedEmitFirst paramCopySupport {
    Global _bglParamArg;
}

//-- Utility types
superposed value class bglSize{
    inline int width=0;
    inline int height=0;
    bglSize operator = (bglSize s){
        self.width=s.width;
        self.height=s.height;
        return self;
    }
}
