/*-----------------------------------------------------------------------------
    __beguileCore.bgl
    The entry point of the Beguile Language Runtime.  This file is included
    automatically by the compiler and is responsible for loading the entirety
    of the core BLR.
 -----------------------------------------------------------------------------*/
#once

//--include the rest of the BLR, starting with base types...
#include <core/_array>
#include <core/_attribute>
#include <core/_beguilerSettings>
#include <core/_bool>
#include <core/_char>
#include <core/_dictionaryWord>
#include <core/_grammar>
#include <core/_int>
#include <core/_object>
#include <core/_property>
#include <core/_string>
#include <core/_uint>
#include <core/_verb>
//--now helpers...
#include <core/_bglAllocated>
#include <core/_bglWorld>
#include <core/_math>
#include <core/_mainWindow>
#include <core/_printRules>  
#include <core/_random>
#include <core/_statusBar>
#include <core/_ui>         
//--and platform specific code...
#if TARGET_GLULX
    #include<core/_glulxCore>
#else
    #include<core/_zcodeCore>
#endif

//-- the BLR Namespace ---------------------------------------------------------
_bglObject bgl{ // bgl is root 
    emitter int wordsize {WORDSIZE} //bgl.wordsize value
    alias util = _bglUtil;          //bgl.util - the util namespace to which other extensions will attach
}
superposed _bglObject _bglUtil{}    //actual bgl.util object

//-- Types ---------------------------------------------------------
emitter class _bglObject{}                      //the base type of all Beguile objects. Intentionally empty.  Note: Beguile is order independent, so this is also the base class of object, which is included above.
extern emitter class bglClass : _bglObject{ }   //the base type of all class references, used in cases where the type is checked (e.g. .is(bglClass))

//-- Print routines ---------------------------------------------------------------------------
emitter void print(var val){ print $val; } //the default, which will be used for all data types not defined
emitter void print(_bglObject val){ if($val provides print) $val.print(); else print (name)$val;} //the default, which will be used for all data types not defined
emitter void log(var msg){ ##if DEBUG print $msg; ##endif }

emitter void a(object o){ print (a)$o; }
emitter void cA(object o){ print (A)$o; }
emitter void the(object o){ print (the)$o; }
emitter void cThe(object o){ print (The)$o; }
emitter void printName(object o){ print (name)$o; }   // I6 `(name) obj` print rule — bare short name, no article

//-----------------------------------------------------------------------------
enum eAssets { }   // A place to land asset ids.  Beguile extends this when blorbification is enabled.
extern void bglInit(); // bglInit() is a special, compiler built routine used to initialize the BLR

