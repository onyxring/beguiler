   -----------------------------------------------------------------------------*/
#once

//-- Core types ----------------------------------------------------------------
#include <core/_array>
#include <core/_attribute>
#include <core/_beguilerSettings>
#include <core/_bool>
#include <core/_char>
#include <core/_dictionaryWord>
#include <core/_grammar>
#include <core/_int>
#include <core/_object>
#include <core/_property>
#include <core/_string>
#include <core/_uint>
#include <core/_verb>

//-- Utilities -----------------------------------------------------------------
#include <core/_bglAllocated>
#include <core/_bglWorld>
#include <core/_math>
#include <core/_typeof>
#include <core/_mainWindow>
#include <core/_printRules>
#include <core/_random>
#include <core/_statusBar>
#include <core/_ui>

//-- Target-specific code ------------------------------------------------------
#if TARGET_GLULX
    #include<core/_glulxCore>
#else
    #include<core/_zcodeCore>
#endif

//-- The bgl namespace ---------------------------------------------------------
/// The root of the runtime's namespaces.
_bglObject bgl{
    emitter int wordsize {WORDSIZE}  /// The size of a word in bytes: 2 on the Z-machine, 4 on Glulx.
    alias util = _bglUtil;           /// General utilities; extensions add their own here.
}
// The object behind bgl.util, where extensions attach their utilities.
superposed _bglObject _bglUtil{}

//-- Base types ----------------------------------------------------------------
/// The root of every class whose values are plain words: primitives such as int, and emitter classes such as array<T>.
emitter class _bglPrimitive{
    /// Assignment: the variable takes the value's word.
    emitter _bglPrimitive operator = (_bglPrimitive v){ $target = $v }
}

/// The type of `null`, the empty reference that fits every type.
primitive class nullLiteral{
    emitter _bglObject operator();  /// Convert null to any object type.
}

/// The root of every class whose values are I6 objects.
emitter class _bglObject{
    /// The object's name, as `print(obj)` shows it, given once in its declaration: `object lamp { "brass lamp"; }`.
    /// With a library, an object's `short_name` takes its place.
    inline const string instanceName;

    /// Assignment: the variable refers to the assigned instance. A value class copies instead.
    emitter _bglObject operator = (_bglObject v){ $target = $v }

    emitter eBool operator ?() { $val ~= nothing }               /// True unless the reference is null.
    emitter eBool operator == (_bglObject v){ $val == $v }       /// True when both refer to the same object.
    emitter eBool operator != (_bglObject v){ $val ~= $v }       /// True when they refer to different objects.

    /// True when this object declares `prop`, so reading it is safe.
    emitter bool provides(property prop){
        $val provides $prop
    }
    /// True when this object is a `cls`, including any class derived from it.
    emitter bool is(bglClass cls){
        ($val ofclass $cls)
    }
    /// Print this object's name. What `print(obj)` calls.
    emitter void print(){
        print (name)$val;
    }
}
/// A reference to a class, as `obj.is(cls)` takes.
primitive class bglClass{ }

//-- Global routines -----------------------------------------------------------
emitter void print(var val){ print $val; }                                                           /// Print a value of a type with no print() of its own.
emitter void print(_bglObject val){ if($val provides print) $val.print(); else print (name)$val;}  /// Print an object: its own print() if it has one, otherwise its name.
/// Print `msg`, but only in a debug build.
emitter void log(var msg){
    ##if DEBUG
    $i6Expr(print($msg));
    ##endif
}
emitter void printLine(var val){ $i6Expr(print($val)); print "^"; }                                  /// Print `val` the way `print(val)` would, then a newline.
emitter void printLine(interpolatedStringLiteral val){ $val; print "^"; }                            /// Print an interpolated string, then a newline.
emitter void printLine(){ print "^"; }                                                               /// Print a newline.
emitter void printName(object o){ print (name)$o; }                                                  /// Print an object's name, with no article.
extern void bglInit();                                                                               /// Start the Beguile runtime; runs before the game's own main.

//-- Blorb assets --------------------------------------------------------------
enum eImages { }                                     /// The images packaged with the game.
enum eSounds { }                                     /// The sounds packaged with the game.
enum eUnknownAsset { }                               /// Other files packaged with the game.
union eAssets = eImages | eSounds | eUnknownAsset;   /// Any packaged asset.

//-- Utility types -------------------------------------------------------------
/// A width and a height.
superposed value class bglSize{
    inline int width=0;    /// The width.
    inline int height=0;   /// The height.
    /// Copy another size.
    bglSize operator = (bglSize s){
        self.width=s.width;
        self.height=s.height;
        return self;
    }
}

//-- General bits of setup -----------------------------------------------------
// Holds an argument while a parameter that owns its value takes its own copy.
#storedEmitFirst paramCopySupport {
    Global _bglParamArg;
}
