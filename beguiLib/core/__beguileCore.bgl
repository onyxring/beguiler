/*-----------------------------------------------------------------------------
    _beguilerCore.bgl - the standard language extensions for the Beguile 
        language, included automatically by the compiler.
 -----------------------------------------------------------------------------*/
#once
//-- Pull in all the core features.
//
// Order matters: primitive types (_int, _bool, _char) need to be loaded
// before higher-level types (_array, _string, _grammar) that use them in
// helper-method bodies. The previous order placed _array first which broke
// once _bglArray gained a setLength helper using `int < int` (the operator
// was declared later in _int.bgl).
#include <core/_beguilerSettings>
#include <core/_int>
#include <core/_bool>
#include <core/_char>
#include <core/_dictionaryWord>
#include <core/_attribute>
#include <core/_property>
#include <core/_class>
#include <core/_bglAllocated>
#include <core/_math>
#include <core/_uint>
#include <core/_array>
#include <core/_charExtended>
#include <core/_string>
#include <core/_grammar>
#include <core/_verb>

#if TARGET_GLULX
    #include<core/_glulxCore> //also includes _glulxOpCodes
    #include<core/_float>     //IEEE 754 float — Glulx-only (needs the float opcodes)
#else
    #include<core/_zcodeCore>
#endif


// Namespace objects derive from _bglObject (the base below `object`, defined further down),
// not from `object` itself — so completion/type-checking see only their own members and not
// the world-tree surface (give/has/parent/remove/…). They still emit as plain I6 objects.
_bglObject _bglUtil{}
_bglObject bgl{
    emitter int wordsize {WORDSIZE} //just a passthrough, I6 defines WORDSIZE natively
    // Exposed as `bgl.util`, but emitted as the I6 property `bglUtil` so it doesn't collide with
    // orLibrary's global `object util` (I6 keeps object + property short-names in one namespace).
    auto util as bglUtil = _bglUtil;
}
// Target-specific platform code is selected automatically above (see the
// TARGET_GLULX branch): _zcodeCore or _glulxCore is pulled in per the active
// target, each providing bgl.asm (+ bglOpCodes, and on Glulx the _glulx
// namespace + __glkHook). There is no user-facing `<zcode>`/`<glulx>` include.

//-----------------------------------------------------------------------------
// _bglScratch — shared scratch buffer for for-in over inline lists.
//
// for(int x in {a, b, c}) { ... } emits push-push-push then make(3) before
// the loop runs. The scratch follows the tracked-array layout above so the
// iteration target is indistinguishable from any other Beguile array.
//
// Layout (`Array _bglScratchStack --> 33` = 34 words):
//   slot 0       = I6 auto-header (33) — drives detection
//   slots 1..31  = data            — written by push
//   slot 32      = length          — set by make
//   slot 33      = magic ($9084)   — set at startup
//
// Single shared buffer; nested literal-list for-in loops would clobber
// each other and are not supported. 31-element cap.
//
// Stored (deferred) — only emitted if `for(x in {literal,list})` syntax is used
// somewhere in the source. The forInList.push / forInList.make built-in templates
// in __builtins.i6b carry ##triggerEmitter scratchSupport annotations that fire
// on invocation, gating this block. Programs that never use the literal-list
// for-in syntax pay zero bytes.
//-----------------------------------------------------------------------------
#storedEmitFirst scratchSupport {
    Array _bglScratchStack table 33;
    Global _bglScratchTop = 0;
    [ _bglScratchPush v;
        if(_bglScratchTop >= 31){
            print "^[Beguile runtime error: for-in literal-list scratch exhausted]^";
            quit;
        }
        _bglScratchTop++;
        _bglScratchStack-->_bglScratchTop = v;
    ];
    [ _bglScratchMake count;
        _bglScratchStack-->(_bglScratchStack-->0) = $9084;     ! magic marker
        _bglScratchStack-->(_bglScratchStack-->0 - 1) = count; ! length
        _bglScratchTop = 0;
        return _bglScratchStack;
    ];
}

//=============================================================================
// _bglObject - the base class for all Beguile objects. Intentionally empty: it is
// the shared type-tree root for both objects (via `object`) and the primitive/type
// wrappers (int/bool/string/…)
emitter class _bglObject{
}

//=============================================================================
// type object
    extern class object:_bglObject{ //--the base I6 object, declared as external because it is defined in the I6 compiler
        typesealed parentProp parent;//--initial parent object; emitted as I6 third positional argument.
                                     //  `typesealed`: writing `object parent = <room>` keeps parent as
                                     //  parentProp (with a warning) so `.parent = X` always emits `move`.
                                     //  Idiomatic form is the bare `parent = <room>` (no type keyword).
        attributeList attributes;  //--initial attribute set; emitted as I6 'has' clause
        string short_name;           //--object's short name (string or routine). Backs the `(name)` print rule
                                     //  used by print() below; the compiler auto-declares it, so it's core, not
                                     //  library. Library-defined variants (short_name_indef, parse_name) and the
                                     //  rest of the property surface live in the i6StandardLibrary binding.

        emitter eBool operator ?() { $val ~= nothing }
        emitter object operator = (object v){
            $target = $v
        }
        emitter eBool operator == (var v){
            $val == $v
        }
        emitter eBool operator != (var v){
            $val ~= $v
        }
        emitter void give(attribute attr){
            give $val $attr
        }
        emitter void ungive(attribute attr){
            give $val ~$attr
        }
        emitter bool has(attribute attr){
            ($val has $attr)
        }
        emitter bool hasnt(attribute attr){
            ($val hasnt $attr)
        }
        emitter void remove(){
            remove $val
        }
        emitter object child{
            child($val)
        }
        emitter int children{
            children($val)
        }
        emitter object sibling{
            sibling($val)
        }
        emitter bool provides(property prop){
            $val provides $prop
        }
        emitter bool is(bglClass cls){
            ($val ofclass $cls)
        }
        replace emitter void print(){
            print (name)$val;
        }
    }
    
    //--setters
    extern emitter class parentProp{   //obj.parent=loc; -> move obj to loc;
        emitter parentProp operator = (object v){
            move $self to $v
        }
        emitter eBool operator == (object v){
            parent($self) == $v
        }
        emitter eBool operator != (object v){
            parent($self) ~= $v
        }
        emitter object operator(){
            parent($self)
        }
    }


//-----------------------------------------------------------------------------

emitter void print(var val){ print $val; } //the default, which will be used for all data types not defined
emitter void print(_bglObject val){ if($val provides print) $val.print(); else print (name)$val;} //the default, which will be used for all data types not defined
emitter void log(var msg){ ##if DEBUG print $msg; ##endif }

emitter void a(object o){ print (a)$o; }
emitter void cA(object o){ print (A)$o; }
emitter void the(object o){ print (the)$o; }
emitter void cThe(object o){ print (The)$o; }
emitter void printName(object o){ print (name)$o; }   // I6 `(name) obj` print rule — bare short name, no article

//=============================================================================
// style emitter namespace.  TODO: add the rest of these.
// emitter style{
//     void italics(){
//         style underline;
//     }
//     void roman(){
//         style roman;
//     }
// }

//=============================================================================
// bglInit() is a special, compiler built routine
extern void bglInit();

//=============================================================================
// bgl.world — object-tree queries (getAll/inParent/instances) are now part of the
// automatic core: every Beguile game gets `bgl.world` with no `#include`. This
// pulls in <array> (the queries return tracked array<object>), so it currently
// carries a real footprint on every program. That's deliberate for now — the plan
// is to decompose it incrementally (superpose the pieces that can be, keep the
// rest opt-in). Included last, after bgl / object / array are all defined.
#include <bglWorld>
