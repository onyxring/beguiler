#once
//=============================================================================
// type int 
    extern emitter class intLiteral:_bglObject{
        emitter int operator();
        int operator auto();
    }

    // Negative integer literals (e.g. -1, -42). Distinguished from intLiteral so the type
    // system can restrict unsigned assignment: negativeIntLiteral converts to int implicitly
    // but requires an explicit cast for uint.
    extern emitter class negativeIntLiteral:_bglObject{
        emitter int operator();
    }

    extern emitter class int : _bglObject { //--Beguile-side type label over I6's word-sized integer slot; instances emit as `global X;`
        emitter char operator();
        emitter int operator = (int v){ $target=$v; }

        // Arithmetic
        emitter int operator + (int v){ $val + $v }
        emitter int operator - (int v){ $val - $v }
        emitter int operator * (int v){ $val * $v }
        emitter int operator / (int v){ $val / $v }
        emitter int operator % (int v){ $val % $v }

        // Comparison
        emitter bool operator == (int v){ $val == $v }
        emitter bool operator != (int v){ $val ~= $v }
        emitter bool operator < (int v){ $val < $v }
        emitter bool operator <= (int v){ $val <= $v }
        emitter bool operator > (int v){ $val > $v }
        emitter bool operator >= (int v){ $val >= $v }

        // Compound assignment
        emitter int operator += (int v){ $val = $val + $v }
        emitter int operator -= (int v){ $val = $val - $v }
        emitter int operator *= (int v){ $val = $val * $v }
        emitter int operator /= (int v){ $val = $val / $v }
        emitter int operator %= (int v){ $val = $val % $v }

        // Increment / decrement
        emitter int operator ++() { $val++ }
        emitter int operator --() { $val-- }

        // Bitwise — I6 supports `&` and `|` natively on both Z-machine and Glulx, so the
        // AND/OR operators are direct passthroughs; XOR is synthesized from and/or. Shifts
        // have no native Z-machine op, so `<<`/`>>` delegate to the core `superposed`
        // routines _bglShiftLeft/_bglShiftRight (core/_math.bgl) — auto-loaded and emitted
        // only when a shift is actually used. (These are emitters, so they call the
        // standalone routines directly rather than the _bglMath facade.)
        emitter int operator & (int v){ $val & $v }
        emitter int operator | (int v){ $val | $v }
        emitter int operator &= (int v){ $val = $val & $v }
        emitter int operator |= (int v){ $val = $val | $v }
        emitter int operator ^  (int v){ ($val | $v) - ($val & $v) }
        emitter int operator ^= (int v){ $val = (($val | $v) - ($val & $v)) }

        emitter int operator <<  (int v){ _bglShiftLeft($val, $v) }
        emitter int operator <<= (int v){ $val = _bglShiftLeft($val, $v) }
        emitter int operator >>  (int v){ _bglShiftRight($val, $v) }
        emitter int operator >>= (int v){ $val = _bglShiftRight($val, $v) }
    }
    
    emitter void print(int c){ print $c; }