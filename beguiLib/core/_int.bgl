   -----------------------------------------------------------------------------*/
#once

//-- Literals ------------------------------------------------------------------
/// The type of a number written literally, before it is assigned or compared.
primitive class intLiteral {
    emitter int operator();      /// Convert to an `int`.
    int operator auto();         /// Convert to an `int` implicitly.
}

/// The type of a negative literal such as `-1`. Behaves as `intLiteral`, but needs an explicit cast to become a `uint`.
primitive class negativeIntLiteral {
    emitter int operator();      /// Convert to an `int`.
}

//-- int -----------------------------------------------------------------------
/// A signed whole number: 16-bit on the Z-machine, 32-bit on Glulx. The default numeric type.
primitive class int {
    emitter char operator();                                 /// Convert to a `char`.
    emitter int operator = (int v){ $target=$v; }            /// Assignment: the variable takes the value.

    //-- Arithmetic ------------------------------------------------------------
    emitter int operator + (int v){ $val + $v }              /// The sum.
    emitter int operator - (int v){ $val - $v }              /// The difference.
    emitter int operator * (int v){ $val * $v }              /// The product.
    emitter int operator / (int v){ $val / $v }              /// The quotient, rounded toward zero.
    emitter int operator % (int v){ $val % $v }              /// The remainder.

    //-- Comparison ------------------------------------------------------------
    emitter bool operator == (int v){ $val == $v }           /// True when the values are equal.
    emitter bool operator != (int v){ $val ~= $v }           /// True when the values differ.
    emitter bool operator < (int v){ $val < $v }             /// True when this is less than `v`.
    emitter bool operator <= (int v){ $val <= $v }           /// True when this is at most `v`.
    emitter bool operator > (int v){ $val > $v }             /// True when this is greater than `v`.
    emitter bool operator >= (int v){ $val >= $v }           /// True when this is at least `v`.

    //-- Compound assignment ---------------------------------------------------
    emitter int operator += (int v){ $val = $val + $v }      /// Add `v` to the variable.
    emitter int operator -= (int v){ $val = $val - $v }      /// Subtract `v` from the variable.
    emitter int operator *= (int v){ $val = $val * $v }      /// Multiply the variable by `v`.
    emitter int operator /= (int v){ $val = $val / $v }      /// Divide the variable by `v`.
    emitter int operator %= (int v){ $val = $val % $v }      /// Set the variable to its remainder after dividing by `v`.

    //-- Increment and decrement -----------------------------------------------
    emitter int operator ++() { $val++ }                     /// Add one to the variable.
    emitter int operator --() { $val-- }                     /// Subtract one from the variable.

    //-- Bitwise ---------------------------------------------------------------
    emitter int operator & (int v){ $val & $v }              /// The bitwise AND.
    emitter int operator | (int v){ $val | $v }              /// The bitwise OR.
    emitter int operator &= (int v){ $val = $val & $v }      /// Set the variable to its bitwise AND with `v`.
    emitter int operator |= (int v){ $val = $val | $v }      /// Set the variable to its bitwise OR with `v`.
    emitter int operator ^  (int v){ ($val | $v) - ($val & $v) }          /// The bitwise exclusive OR.
    emitter int operator ^= (int v){ $val = (($val | $v) - ($val & $v)) } /// Set the variable to its bitwise exclusive OR with `v`.

    emitter int operator <<  (int v){ _bglShiftLeft($val, $v) }           /// The value shifted left by `v` bits.
    emitter int operator <<= (int v){ $val = _bglShiftLeft($val, $v) }    /// Shift the variable left by `v` bits.
    emitter int operator >>  (int v){ _bglShiftRight($val, $v) }          /// The value shifted right by `v` bits.
    emitter int operator >>= (int v){ $val = _bglShiftRight($val, $v) }   /// Shift the variable right by `v` bits.
}

emitter void print(int c){ print $c; }   /// Print `c` as a number.
