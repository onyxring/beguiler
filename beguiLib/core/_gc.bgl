/* -----------------------------------------------------------------------------
    _gc.bgl - The heap and its collector
    Provides `bgl.gc`: the heap that arrays are allocated from, and the
    mark-and-sweep collector that frees the ones nothing refers to.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

//-- Implementation ------------------------------------------------------------
// The heap. Its first words hold its bookkeeping; then a bitmap of block starts (one bit per heap word);
// then blocks back to back. A block is
//     [ size | kind | state ] [ $9084 | length ] [ capacity | elements … ]
// and the array is the address of `capacity`, as every array's is. `size` counts the block's words;
// `kind` is the routine that releases what the block owns (for an array, one element at a time; 0 for none);
// `state` is 0 free, 1 in use, 2 marked, 3 marked and traced; plus 4 once a reference to it is kept anywhere
// but its owner (it is then left to the collector), plus 16 while it is pinned (a root of its own), and plus 8
// while it has no owner and the next local declared from it may take it (a step's result, or an array its owner
// returned); plus 64 when it was made as a result (a step's, or a copy declared from a value), which holds
// pointers to another array's instances rather than instances of its own; plus 32 while a running routine's local
// owns it (the collector can't see locals). Only allocating names the
// storage, so a program that allocates nothing has no heap. Its bookkeeping words:
//     -->0 the first block                                  -->1 bytes from it to the heap's end
//     -->2 words in blocks in use                            -->3 words allocated since the last collection
//     -->4 the array a routine is returning              -->5 the heap's size in words
//     -->6 the most words ever in blocks in use
superposed rawArray<int> _bglHeapStore[#beguilerSettings.heapSize];
// The heap: 0 until it is laid out.
int _bglHeap = 0;
// How much the collector reports in a debug build; 2 also looks for references the roots missed.
superposed rawArray<int> _bglHeapTraceLevel[1];
// Arrays made with no owner (results), newest last, word 0 their count: a routine frees the ones its statements
// made and left unclaimed (_bglHeapSweepFresh). One that doesn't fit is left to the collector.
superposed rawArray<int> _bglFresh[48];
// The routine a library binding runs at each prompt (0 until the heap is first used).
int _bglPromptHook = 0;

// The bit that says heap word `b` starts a block: its byte in the bitmap, and its mask there.
superposed int _bglHeapBitMask(int b){
    int m = 1;
    int k = 0;
    #i6 {
        for(k = ((b - _bglHeap) / WORDSIZE) % 8 : k > 0 : k--) m = m * 2;
        return m;
    }
}
// Whether `b` starts a block.
superposed bool _bglHeapIsStart(int b){
    #i6 {
        if((_bglHeap->(7 * WORDSIZE + (b - _bglHeap) / WORDSIZE / 8)) & _bglHeapBitMask(b)) rtrue;
        rfalse;
    }
}
// Record whether `b` starts a block.
superposed void _bglHeapSetStart(int b, bool on){
    int i = 0;
    #i6 {
        i = 7 * WORDSIZE + (b - _bglHeap) / WORDSIZE / 8;
        if(on) _bglHeap->i = (_bglHeap->i) | _bglHeapBitMask(b);
        else _bglHeap->i = (_bglHeap->i) & ~_bglHeapBitMask(b);
    }
}

// Lay out the heap: the bookkeeping, the bitmap, then one free block holding the rest.
superposed void _bglHeapInit(){
    int words = #beguilerSettings.heapSize;
    int bm = 0;
    int i = 0;
    _bglHeapStore[0] = 0;   // named in Beguile, so the storage is emitted with the routine that lays it out
    #i6 {
        _bglHeap = _bglHeapStore;
        bm = 7 + (words / 8 + WORDSIZE) / WORDSIZE;
        for(i = 0 : i < bm * WORDSIZE : i++) _bglHeap->i = 0;
        _bglHeap-->5 = words;
        _bglHeap-->0 = _bglHeap + bm * WORDSIZE;
        _bglHeap-->1 = (words - bm) * WORDSIZE;
        (_bglHeap-->0)-->0 = words - bm;
        (_bglHeap-->0)-->1 = 0;
        (_bglHeap-->0)-->2 = 0;
        _bglHeapSetStart(_bglHeap-->0, true);
        _bglPromptHook = _bglHeapAtPrompt;
    }
}

// The block of array `a`, or 0 when `a` isn't an array on the heap.
superposed int _bglHeapBlockOf(int a){
    int b = 0;
    int o = 0;
    #i6 {
        if(_bglHeap == 0) return 0;
        b = a - 5 * WORDSIZE;
        o = b - (_bglHeap-->0);
        if(o < 0 || o >= (_bglHeap-->1) || o % WORDSIZE ~= 0) return 0;
        if(_bglHeapIsStart(b) == false || b-->2 == 0) return 0;
        return b;
    }
}

// A new array of capacity `n`, length 0, from the heap. `kind` releases what its elements own when it is freed.
superposed int _bglHeapAlloc(int n, int kind = 0){
    int need = 0;
    int o = 0;
    int b = 0;
    int nb = 0;
    int a = 0;
    int i = 0;
    #i6 {
        if(_bglHeap == 0) _bglHeapInit();
        need = n + 6;
        while(o < (_bglHeap-->1)){
            b = (_bglHeap-->0) + o;
            if(b-->2 == 0){
                ! Merge the free blocks that follow into this one.
                while(o + (b-->0) * WORDSIZE < (_bglHeap-->1)){
                    nb = b + (b-->0) * WORDSIZE;
                    if(nb-->2 ~= 0) break;
                    _bglHeapSetStart(nb, false);
                    b-->0 = b-->0 + nb-->0;
                }
                if(b-->0 >= need){
                    if(b-->0 - need >= 6){
                        nb = b + need * WORDSIZE;
                        nb-->0 = b-->0 - need;
                        nb-->1 = 0;
                        nb-->2 = 0;
                        _bglHeapSetStart(nb, true);
                        b-->0 = need;
                    }
                    b-->1 = kind;
                    b-->2 = 1;
                    a = b + 5 * WORDSIZE;
                    a-->(-2) = $9084;
                    a-->(-1) = 0;
                    a-->0 = n;
                    for(i = 1 : i <= n : i++) a-->i = 0;
                    _bglHeap-->2 = _bglHeap-->2 + b-->0;
                    _bglHeap-->3 = _bglHeap-->3 + b-->0;
                    if(_bglHeap-->2 > _bglHeap-->6) _bglHeap-->6 = _bglHeap-->2;
                    return a;
                }
            }
            o = o + (b-->0) * WORDSIZE;
        }
        if(_bglHeap-->3 > 0){ _bglHeapCollect(true); return _bglHeapAlloc(n, kind); }
        print "^[Beguile run-time error: the heap is full; raise heapSize in #beguilerSettings (it is ", _bglHeap-->5, " words)]^";
        quit;
    }
}

// Free block `b`: what it owns is released, and a stale reference to its array reads as freed.
superposed void _bglHeapRelease(int b){
    int a = 0;
    int i = 0;
    #i6 {
        a = b + 5 * WORDSIZE;
        if(b-->1) for(i = 1 : i <= a-->0 : i++) if(a-->i) (b-->1)(a-->i);
        a-->(-2) = $DEAD;
        b-->2 = 0;
        _bglHeap-->2 = _bglHeap-->2 - b-->0;
    }
}

// Give heap array `a` the capacity of its length (at least 1), and the words it no longer needs back to the heap.
superposed void _bglHeapShrink(var a){
    int b = 0;
    int nb = 0;
    int cap = 0;
    int need = 0;
    #i6 {
        b = _bglHeapBlockOf(a);
        if(b == 0) return;
        cap = a-->(-1);
        if(cap < 1) cap = 1;
        if(cap >= a-->0) return;
        a-->0 = cap;
        need = cap + 6;
        if(b-->0 - need < 6) return;
        nb = b + need * WORDSIZE;
        nb-->0 = b-->0 - need;
        nb-->1 = 0;
        nb-->2 = 0;
        _bglHeapSetStart(nb, true);
        _bglHeap-->2 = _bglHeap-->2 - nb-->0;
        b-->0 = need;
    }
}

// Pin array `a` (it is a root until unpinned or freed), or unpin it.
superposed void _bglHeapPin(int a, bool on){
    int b = 0;
    #i6 {
        b = _bglHeapBlockOf(a);
        if(b == 0) return;
        if(on){ b-->2 = (b-->2 | 20) & ~8; if(a == _bglHeap-->4) _bglHeap-->4 = 0; }
        else b-->2 = b-->2 & ~16;
    }
}

// Record that a reference to array `a` has left the routine that allocated it; returns `a`.
superposed int _bglHeapEscape(int a){
    int b = 0;
    #i6 {
        b = _bglHeapBlockOf(a);
        if(b ~= 0){
            b-->2 = (b-->2 | 4) & ~8;   ! kept somewhere: no longer an unclaimed result, nor one on its way back
            if(a == _bglHeap-->4) _bglHeap-->4 = 0;
        }
        return a;
    }
}
// The same, as an element type's assignment: an array stored into another array's slot has escaped.
superposed int _bglHeapEscapeAssign(int cur, int a){
    #i6 { return _bglHeapEscape(a); }
}

// Whether array `a` is on the heap without instances of its own for elements that are instances (a step's
// result, an array declared from a value): it holds pointers to another array's.
superposed bool _bglHeapBorrows(int a){
    int b = 0;
    #i6 {
        b = _bglHeapBlockOf(a);
        if(b ~= 0 && (b-->2 & 64)) rtrue;
        rfalse;
    }
}
// Whether array `a` is on the heap with no owner yet.
superposed bool _bglHeapIsFresh(int a){
    int b = 0;
    #i6 {
        b = _bglHeapBlockOf(a);
        if(b ~= 0 && (b-->2 & 12) == 8) rtrue;
        rfalse;
    }
}
// A new array with no owner yet (a step's result), room for `n` elements.
superposed int _bglHeapFresh(int n){
    int a = 0;
    #i6 {
        a = _bglHeapAlloc(n);
        (a - 5 * WORDSIZE)-->2 = (a - 5 * WORDSIZE)-->2 | 72;
        _bglHeapNoteFresh(a);
        return a;
    }
}
// Record array `a` as made with no owner. Word 47 counts routines that found no room for their marker.
superposed void _bglHeapNoteFresh(int a){
    #i6 {
        if(_bglFresh-->47 == 0 && _bglFresh-->0 < 46){ _bglFresh-->0 = _bglFresh-->0 + 1; _bglFresh-->(_bglFresh-->0) = a; }
    }
}
// A routine that makes arrays with no owner marks where its own begin (a 0 entry).
superposed void _bglHeapFreshEnter(){
    #i6 {
        if(_bglFresh-->47 == 0 && _bglFresh-->0 < 46){ _bglFresh-->0 = _bglFresh-->0 + 1; _bglFresh-->(_bglFresh-->0) = 0; }
        else _bglFresh-->47 = _bglFresh-->47 + 1;
    }
}
// After a statement: free the arrays this routine made with no owner that nothing claimed, but the one being
// returned. `leave`: the routine is returning, and its marker goes too.
superposed void _bglHeapSweepFresh(bool leave = false){
    int i = 0;
    int a = 0;
    int b = 0;
    #i6 {
        if(_bglFresh-->47){ if(leave) _bglFresh-->47 = _bglFresh-->47 - 1; return; }
        for(i = _bglFresh-->0 : i > 0 && _bglFresh-->i ~= 0 : i--){
            a = _bglFresh-->i;
            b = _bglHeapBlockOf(a);
            if(b ~= 0 && (b-->2 & 60) == 8 && a ~= _bglHeap-->4) _bglHeapRelease(b);
        }
        if(leave && i > 0) i--;
        _bglFresh-->0 = i;
    }
}

// A new array holding a copy of array `src`, with src's capacity (at least 1), and no owner yet.
superposed int _bglHeapCopyOf(int src){
    int a = 0;
    int n = 1;
    #i6 {
        if(src ~= 0 && src-->0 > 0) n = src-->0;
        a = _bglHeapFresh(n);
        if(src ~= 0) _bglArrCopyInto(a, src);
        return a;
    }
}
// A new array holding a copy of the member array `prop` of `obj` (its property's data), with its capacity.
superposed int _bglHeapCopyOfMember(var obj, var prop){
    int a = 0;
    int n = 1;
    #i6 {
        if(obj.#prop / WORDSIZE - 1 > 1) n = obj.#prop / WORDSIZE - 1;
        a = _bglHeapFresh(n);
        _bglArrFromMember(a, obj, prop);
        return a;
    }
}
// A routine's local array of capacity `n`, from the heap. The block is recorded in the frame pool, which the
// routine's exit unwinds with _bglHeapLocalDrop.
superposed int _bglHeapLocal(int n, int kind = 0){
    int a = 0;
    #i6 {
        a = _bglHeapAlloc(n, kind);
        _bglFrameAlloc(1)-->0 = a;
        return a;
    }
}
// Its owner is done with array `a`: freed, unless it is kept elsewhere; when it is what the owner is returning,
// it passes to the caller instead.
superposed void _bglHeapDropOwned(int a){
    int b = 0;
    #i6 {
        b = _bglHeapBlockOf(a);
        if(b == 0) return;
        b-->2 = b-->2 & ~32;
        if((b-->2 & 12) ~= 0) return;
        if(a == _bglHeap-->4){ b-->2 = b-->2 | 8; _bglHeap-->4 = 0; _bglHeapNoteFresh(a); return; }
        _bglHeapRelease(b);
    }
}
// At a routine's exit: the last local array it allocated, as _bglHeapDropOwned.
superposed void _bglHeapLocalDrop(){
    #i6 {
        _bglFrameTop--;
        _bglHeapDropOwned(_bglFramePool-->_bglFrameTop);
        _bglFramePool-->_bglFrameTop = 0;   ! a word left there would keep the array from the collector
    }
}
// A routine returns array `a`: its owner's exit hands it to the caller. Returns `a`.
superposed int _bglHeapReturn(int a){
    #i6 {
        if(_bglHeapBlockOf(a) ~= 0) _bglHeap-->4 = a;
        return a;
    }
}
// A local declared from array `a` takes it when it has no owner; returns what the local now owns (`a`, or 0).
superposed int _bglHeapAdopt(int a){
    int b = 0;
    #i6 {
        b = _bglHeapBlockOf(a);
        if(b == 0 || (b-->2 & 12) ~= 8) return 0;
        b-->2 = (b-->2 & ~8) | 32;
        if(a == _bglHeap-->4) _bglHeap-->4 = 0;   ! a returned array, now taken
        return a;
    }
}
// A local that owned array `own` is given array `a`: it takes `a` as _bglHeapAdopt does, then drops `own`
// (after, so `a` may have been computed from it). Returns what the local now owns.
superposed int _bglHeapReown(int own, int a){
    int n = 0;
    int b = 0;
    #i6 {
        n = _bglHeapAdopt(a);
        ! An array kept elsewhere (a global's) is held while the routine runs, in case that slot lets go meanwhile.
        if(n == 0){ b = _bglHeapBlockOf(a); if(b ~= 0 && (b-->2 & 36) == 4){ b-->2 = b-->2 | 32; n = a; } }
        if(own ~= a) _bglHeapDropOwned(own);
        return n;
    }
}
// The same for a routine whose raw Inform 6 may have kept a reference: the array is left to the collector.
superposed void _bglHeapLocalKeep(){
    #i6 {
        _bglFrameTop--;
        _bglFramePool-->_bglFrameTop = 0;
    }
}

// A row of a local array of arrays, as that array is freed: released unless kept, pinned, unclaimed or owned elsewhere.
superposed void _bglHeapDropRow(int a){
    int b = 0;
    #i6 {
        b = _bglHeapBlockOf(a);
        if(b == 0 || (b-->2 & 60) ~= 0) return;
        ! The row the routine is returning passes to the caller.
        if(a == _bglHeap-->4){ b-->2 = b-->2 | 8; _bglHeap-->4 = 0; _bglHeapNoteFresh(a); return; }
        _bglHeapRelease(b);
    }
}

// Release array `a` now.
superposed void _bglHeapFree(int a){
    int b = 0;
    #i6 {
        b = _bglHeapBlockOf(a);
        if(b ~= 0){ _bglHeapRelease(b); return; }
        if(a ~= 0 && a-->(-2) == $DEAD) print "^[Beguile run-time error: bgl.gc.free(): the array was already freed]^";
        else print "^[Beguile run-time error: bgl.gc.free(): the array isn't on the heap (a file-scope or member array lives as long as the program)]^";
    }
}

// Mark the block of `w` when `w` is the address of an array on the heap.
superposed void _bglHeapMark(int w){
    int b = 0;
    #i6 {
        b = _bglHeapBlockOf(w);
        if(b ~= 0 && (b-->2 & 3) == 1) b-->2 = b-->2 + 1;
    }
}

// Free every heap array that nothing refers to: marked from the roots (the slots whose type can hold an array,
// listed by the compiler in _bglGcRoots, and the pinned arrays), then through the elements of what is marked.
superposed void _bglHeapCollect(bool midRoutine = false){
    int o = 0;
    int b = 0;
    int again = 0;
    int roots = 48;
    #i6 {
        if(_bglHeap == 0) return;
        ! In the middle of a routine an unclaimed result may still be on its way somewhere: it is kept too. One recorded
        ! below every routine's marker was made for Inform 6 code, and no statement's end will free it.
        if(midRoutine){
            roots = 56;
            if(_bglFresh-->47 == 0){
                for(o = 1 : o <= _bglFresh-->0 && _bglFresh-->o ~= 0 : o++){
                    b = _bglHeapBlockOf(_bglFresh-->o);
                    if(b ~= 0 && (b-->2 & 60) == 8 && _bglFresh-->o ~= _bglHeap-->4) _bglHeapRelease(b);
                }
                if(o > 1){
                    for(again = o : again <= _bglFresh-->0 : again++) _bglFresh-->(again - o + 1) = _bglFresh-->again;
                    _bglFresh-->0 = _bglFresh-->0 - o + 1;
                }
                again = false;
            }
        }
        do {
            _bglGcRoots();
            for(o = 0 : o < (_bglHeap-->1) : o = o + (b-->0) * WORDSIZE){
                b = (_bglHeap-->0) + o;
                if(b-->2 & roots) _bglHeapMark(b + 5 * WORDSIZE);
            }
            _bglHeapTrace();
            #Ifdef DEBUG;
                if(_bglHeapTraceLevel-->0 >= 2 && _bglHeapVerify()) _bglHeapTrace();
            #Endif;
            ! A freed array of structs gives its instances back, which let go of what their members held: those
            ! arrays are swept by another pass.
            again = false;
            for(o = 0 : o < (_bglHeap-->1) : o = o + (b-->0) * WORDSIZE){
                b = (_bglHeap-->0) + o;
                if((b-->2 & 3) == 1){ if(b-->1) again = true; _bglHeapRelease(b); }
                else if((b-->2 & 3) == 3) b-->2 = b-->2 - 2;
            }
        } until(again == false);
        _bglHeap-->3 = 0;
    }
}

// Mark what the marked arrays' elements refer to, until nothing new is marked.
superposed void _bglHeapTrace(){
    int o = 0;
    int b = 0;
    int a = 0;
    int i = 0;
    int more = 0;
    #i6 {
        do {
            more = false;
            for(o = 0 : o < (_bglHeap-->1) : o = o + (b-->0) * WORDSIZE){
                b = (_bglHeap-->0) + o;
                if((b-->2 & 3) ~= 2) continue;
                b-->2 = b-->2 + 1;
                more = true;
                a = b + 5 * WORDSIZE;
                for(i = 1 : i <= a-->0 : i++) _bglHeapMark(a-->i);
            }
        } until(more == false);
    }
}

// Debug builds, at trace level 2: before the sweep, read the memory where Inform 6 keeps values for words that
// still refer to an array the roots missed. Each one is reported and kept, since freeing it would leave that reference
// stale. A word that only looks like an address (a stale temporary) is reported too.
superposed bool _bglHeapVerify(){
    int found = 0;
    int p = 0;
    int last = 0;
    int a = 0;
    int o = 0;
    int b = 0;
    int w = 0;
    #i6 {
        ! On the Z-machine Inform 6 holds values in its globals and arrays, which follow the object tables (their
        ! encoded text could pass for an address).
        #Ifdef TARGET_ZCODE;
            p = 0-->6; last = 0-->7;
        #Ifnot;
            p = 0-->2; last = 0-->4;
        #Endif;
        a = (_bglHeap-->0) + 5 * WORDSIZE;
        for(last = last - WORDSIZE : _bglUnsignedCompare(p, last) <= 0 : p++){
            if(p == _bglHeap){ p = _bglHeap + (_bglHeap-->5) * WORDSIZE - 1; continue; }
            w = p-->0;
            o = w - a;
            if(o < 0 || o >= _bglHeap-->1) continue;
            b = _bglHeapBlockOf(w);
            if(b == 0 || (b-->2 & 3) ~= 1) continue;
            print "^[Beguile debug: the array at ", w, " is still referred to from address ", p,
                  ", which the collector doesn't track; it is kept]^";
            _bglHeapMark(w);
            found = true;
        }
        return found;
    }
}

// At a prompt: collect when no routine holding heap arrays is running and enough has been allocated. `now`: collect
// at once, mid-routine (a struct's instances have run out).
superposed void _bglHeapAtPrompt(bool now = false){
    #i6 {
        if(_bglHeap == 0) return;
        if(now){ _bglHeapCollect(true); return; }
        if(_bglHeap-->3 * 4 >= (_bglHeap-->1) / WORDSIZE) _bglHeapCollect();
    }
}

// Words in blocks in use, the most ever in use, and words the heap holds for blocks.
superposed int _bglHeapUsedWords(){
    #i6 {
        if(_bglHeap == 0) return 0;
        return _bglHeap-->2;
    }
}
superposed int _bglHeapPeakWords(){
    #i6 {
        if(_bglHeap == 0) return 0;
        return _bglHeap-->6;
    }
}
superposed int _bglHeapSizeWords(){
    #i6 {
        if(_bglHeap == 0) _bglHeapInit();
        return (_bglHeap-->1) / WORDSIZE;
    }
}

//-- The collector -------------------------------------------------------------
/// The heap that arrays are allocated from, and its collector.
superposed _bglObject _bglGC {
    /// Release an array now instead of at the next collection; a later use through another reference is an error.
    emitter void free(var a)  { _bglHeapFree($a) }
    /// Keep an array for Inform 6 code that holds on to it, until `unpin` or `free`.
    void keep(var a) asI6 _bglGC_keep  { _bglHeapPin(a, true); }
    /// Hand an array kept with `keep` back to the collector, which frees it once nothing refers to it.
    void unpin(var a) asI6 _bglGC_unpin { _bglHeapPin(a, false); }
    /// Free every array that nothing refers to; call it where no local array still needed is held only in a local.
    void collect() asI6 _bglGC_collect    { _bglHeapCollect(true); }
    emitter int used  { _bglHeapUsedWords() }   /// Words of the heap in use.
    emitter int size  { _bglHeapSizeWords() }   /// Words the heap holds for arrays.
    emitter int peak  { _bglHeapPeakWords() }   /// The most words of the heap ever in use: what `heapSize` must hold.
}

extend bgl {
    alias gc = _bglGC;   /// The heap that arrays are allocated from, and its collector.
}
