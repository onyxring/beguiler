/* -----------------------------------------------------------------------------
    _bglWorld.bgl - World queries
    Provides `bgl.world`, which lists the objects in the game world, optionally
    filtered: `for(object o in bgl.world.instances(Animal)) { … }`.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

//-- Implementation ------------------------------------------------------------
// The buffers query results are returned in, used in rotation so queries can nest.
superposed array<object> _bglWorldBuf0[#beguilerSettings.worldBufSize];
superposed array<object> _bglWorldBuf1[#beguilerSettings.worldBufSize];
superposed array<object> _bglWorldBuf2[#beguilerSettings.worldBufSize];
superposed array<object> _bglWorldBuf3[#beguilerSettings.worldBufSize];
// Not superposed: I6 must see this global before the routine that uses it.
int _bglWorldBufIdx = -1;
// Each buffer's capacity: word 0 holds the length when `<array>` isn't included, so it can't say.
const int _bglWorldBufSize = #beguilerSettings.worldBufSize;

// Advance the rotation and hand back the next buffer in the pool.
superposed array<object> _bglWorldNextBuf(){
    _bglWorldBufIdx = (_bglWorldBufIdx + 1) % 4;
    switch(_bglWorldBufIdx){
        case 0: return _bglWorldBuf0;
        case 1: return _bglWorldBuf1;
        case 2: return _bglWorldBuf2;
        case 3: return _bglWorldBuf3;
    }
    return _bglWorldBuf0;
}

// Record a filled buffer's length where `length` reads it: in `<array>`'s trailer when a program
// includes `<array>`, otherwise in word 0. bgl.world depends only on the core's arrays, so it doesn't
// bring `<array>` into every program.
superposed void _bglWorldStamp(array<object> buf, int count){
    #i6 {
        #Ifdef _BGL_TRACKED_ARRAYS;
            buf-->(buf-->0)     = $9084;
            buf-->(buf-->0 - 1) = count;
        #Ifnot;
            buf-->0 = count;
        #Endif;
    }
}

// Collect every object.
superposed array<object> _bglWorldGetAll(var pred){
    array<object> buf = _bglWorldNextBuf();
    object o;
    int n = 0;
    #i6 {
        objectloop(o) {
            if(n >= _bglWorldBufSize) break;
            if(metaclass(o) == Object && parent(o) ~= 0 && metaclass(parent(o)) == Class) continue;   ! a pool slot not yet in use
            if(pred == 0 || indirect(pred, o)) { n++; buf-->n = o; }
        }
    }
    _bglWorldStamp(buf, n);
    return buf;
}

// Collect the objects of a class.
superposed array<object> _bglWorldInstances(var cls, var pred){
    array<object> buf = _bglWorldNextBuf();
    object o;
    int n = 0;
    #i6 {
        objectloop(o ofclass cls) {
            if(n >= _bglWorldBufSize) break;
            if(metaclass(o) == Object && parent(o) ~= 0 && metaclass(parent(o)) == Class) continue;   ! a pool slot not yet in use
            if(pred == 0 || indirect(pred, o)) { n++; buf-->n = o; }
        }
    }
    _bglWorldStamp(buf, n);
    return buf;
}

// Collect the children of `parent`.
superposed array<object> _bglWorldInParent(object parent, var pred){
    array<object> buf = _bglWorldNextBuf();
    object o;
    int n = 0;
    #i6 {
        objectloop(o in parent) {
            if(n >= _bglWorldBufSize) break;
            if(pred == 0 || indirect(pred, o)) { n++; buf-->n = o; }
        }
    }
    _bglWorldStamp(buf, n);
    return buf;
}

//-- Queries -------------------------------------------------------------------
/// Queries that list the objects in the game world; each result is a shared buffer, so copy it to keep it.
superposed _bglObject _bglWorld {
    /// Return every object, optionally filtered: `bgl.world.getAll((object o) => o has light)`.
    array<object> getAll(func<bool, object> pred = 0)            { return _bglWorldGetAll(pred); }
    /// Return the objects directly inside `p`, optionally filtered.
    array<object> inParent(object p, func<bool, object> pred = 0){ return _bglWorldInParent(p, pred); }
    /// Return every object of class `cls`, including subclasses, optionally filtered.
    array<object> instances(var cls, func<bool, object> pred = 0){ return _bglWorldInstances(cls, pred); }
}

extend bgl {
    alias world = _bglWorld;   /// Queries that list the objects in the game world.
}
