/* -----------------------------------------------------------------------------
    _glulxCore.bgl - Glulx platform layer
    Provides `bgl.glulx`, the raw Glulx opcodes as `bgl.asm`, hyperlinks, images
    and the story file header as `bgl.header`. It is included automatically on
    Glulx targets.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

#include<core/_glulxOpCodes>
#include<core/_float>

//-- Namespaces ----------------------------------------------------------------
extend bgl{
    alias glulx = _glulx;   /// Glulx-specific facilities.
}

// The object behind bgl.glulx.
_bglObject _glulx{
    alias eStyleType for eGlulxStyleType;   /// The Glk text styles.
}

/// The Glk text styles; the values match Glk's own, so they pass to Glk unchanged.
enum eGlulxStyleType{
    normal = 0,    /// Plain text.
    emphasized,    /// Emphasized text.
    fixed,         /// Fixed-width text.
    header,        /// A header.
    subheader,     /// A subheader.
    alert,         /// An alert.
    note,          /// A note.
    blockQuote,    /// A block quotation.
    input,         /// The player's input.
    user1,         /// A style the game defines.
    user2          /// A second style the game defines.
}

extend bgl {
    emitter auto asm = bglOpCodes;   /// Raw Glulx assembly opcodes.
}

//-- Hyperlinks ----------------------------------------------------------------
/// Called for each input event: `context` is 0 for line input and 1 for a key; `buffer` is the input buffer.
/// Return 0 to carry on, 2 to end the input with the result in `buffer`, or -1 to keep waiting.
extern default int HandleGlkEvent(var event, var context, var buffer);

// Wrap the game's own HandleGlkEvent so link handlers run first.
#emitfirst {
    Replace HandleGlkEvent _bglAuthorGlkEvent;
}
#emitlast {
    [ HandleGlkEvent event context buffer;
        if (_bglGlkEvent(event, context, buffer)) return -1;
        if (_bglAuthorGlkEvent) return _bglAuthorGlkEvent(event, context, buffer);
        return 0;
    ];
}

// Pause and resume line input around a link handler clicked at the prompt. The library's binding
// replaces these with its own; without one there is no line input to pause.
int  _bglSuspendLineInput(var inputBuf){ return 0; }
void _bglResumeLineInput(var inputBuf, int typed){ }

// The BLR's share of HandleGlkEvent: true when it handled the event.
bool _bglGlkEvent(var event, int context, var inputBuf){
    if(bgl.asm.aload(event, 0) != (int)eGlulxEventType.hyperlink) return false;
    var target = bgl.asm.aload(event, 2);
    bgl.asm.requestHyperlinkEvent(bgl.asm.aload(event, 1));   // a request lasts for one click
    bool known = false;
    int n = 0;
    #i6 { for (n = _bglLinkRoutines-->0 : n > 0 : n--) if (_bglLinkRoutines-->n == target) known = true; }
    if(!known) return false;

    int typed = 0;
    if(context == 0) typed = _bglSuspendLineInput(inputBuf);
    #i6 { target(); }
    if(context == 0) _bglResumeLineInput(inputBuf, typed);
    return true;
}

// The routines printed as link targets: an int or enum target can share a routine's address test,
// so only a value recorded here is called.
#emitlast {
    Array _bglLinkRoutines --> 33;   ! count, then up to 32 routines
}
superposed void _bglNoteLinkRoutine(var v){
    int n = 0;
    #i6 {
        for (n = _bglLinkRoutines-->0 : n > 0 : n--) if (_bglLinkRoutines-->n == v) return;
        if (_bglLinkRoutines-->0 < 32) { _bglLinkRoutines-->0 = _bglLinkRoutines-->0 + 1; _bglLinkRoutines-->(_bglLinkRoutines-->0) = v; }
    }
}

superposed void _bglLink(string text, int value){
    if(bgl.asm.gestalt(11, 0) == 0){ print(text); return; }   // 11: gestalt_Hyperlinks
    int win = _bglCurrentWindow();
    if(win != 0) bgl.asm.requestHyperlinkEvent(win);
    bgl.asm.setHyperlink(value);
    print(text);
    bgl.asm.setHyperlink(0);
}

// The window the current output stream belongs to, or 0 (a file or memory stream).
int _bglCurrentWindow(){
    int stream = bgl.asm.streamGetCurrent();
    int win = bgl.asm.windowIterate(0, 0);
    while(win != 0){
        if(bgl.asm.windowGetStream(win) == stream) return win;
        win = bgl.asm.windowIterate(win, 0);
    }
    return 0;
}

// A window's width in characters, for the core windows' `width`; 80 before the window opens.
superposed array<int> _bglWinSize[1];
superposed int _bglWinWidth(int win){
    if(win == 0) return 80;
    bgl.asm.windowGetSize(win, ((int)_bglWinSize) + bgl.wordsize, 0);
    return _bglWinSize[0];
}
superposed void _bglWinMoveCursor(int win, int col, int line){
    if(win != 0) bgl.asm.windowMoveCursor(win, col, line);
}

extend _bglPrintRules {
    /// Print `text` as a hyperlink that passes an int or enum `target` to HandleGlkEvent when clicked.
    void link(string text, int target) asI6 _bglPR_link {
        _bglLink(text, target);
    }
    /// Print `text` as a hyperlink that calls `target` when clicked.
    /// A lambda target must capture no variables; without hyperlink support the text prints plain.
    void link(string text, literal func<void> target) asI6 _bglPR_link {
        _bglNoteLinkRoutine(target);
        _bglLink(text, (int)target);
    }
}

//-- Images ------------------------------------------------------------------
#if (generateBlorb == true)   // Images exist only in a blorb.
    /// Return `specified` with a zero width or height filled in to keep `imgSize`'s proportions.
    bglSize scaleVectors(bglSize specified, bglSize imgSize){
        float scaleX=1.0;
        float scaleY=1.0;

        if(specified.width==0 || specified.height==0){
            if(specified.width!=0){
                scaleX=(float)specified.width/imgSize.width;
                scaleY=scaleX;
            }
            else if(specified.height!=0){
                scaleY=(float)specified.height/imgSize.height;
                scaleX=scaleY;
            }

            specified.width=(int)(imgSize.width * scaleX);
            specified.height=(int)(imgSize.height * scaleY);
        }
        return specified;
    }
    extend _bglPrintRules {
        /// Draw `image` in the main window, scaled to `width` by `height`; a zero size keeps the image's own.
        void img(eImages image, eGlulxImageAlign align=inlineCenter, int width=0, int height=0) asI6 _bglPR_img {
            bglSize scaledSize = scaleVectors({width, height}, _bglGetImageInfo((int)image));
            bgl.asm.imageDrawScaled(bgl.ui.mainWin.id, image, align, 0, scaledSize.width, scaledSize.height);
        }
    }
    extend _bglUi{
    }
#endif

//-- Story file header ---------------------------------------------------------
/// The story file header: the release number and serial code the game was compiled with.
superposed _bglObject _bglHeader {
    /// The release number.
    auto release asI6 _bglHeader_release = {
        int operator(){ return bgl.asm.aloads($34, 0); }
    }
    /// Character `i` (0-5) of the six-character serial code.
    char serialChar(int i) asI6 _bglHeader_serialChar { return (char)bgl.asm.aloadb($36, i); }
    /// Print the serial code.
    void printSerial() asI6 _bglHeader_printSerial {
        int i = 0;
        for(i = 0; i < 6; i++) print(self.serialChar(i));
    }
}
extend bgl {
    alias header = _bglHeader;   /// The story file header.
}
