//-----------------------------------------------------------------------------
// _glulxCore.bgl — the Glulx platform layer: the `bgl.glulx` namespace, the full
// Glulx assembly opcode emitter class (bglOpCodes, via _glulxOpCodes) aliased as
// `bgl.asm`, and the __glkHook dispatch routine that backs Glk operations.
//
// Included automatically by the compiler (__beguileCore.bgl) when the target is
// Glulx — the counterpart to _zcodeCore.bgl on the Z-machine side. There is no
// user-facing `#include`; the platform core follows the active target. (The
// only opt-in Glulx extension is `<glulxWindow>`.)
//-----------------------------------------------------------------------------
#once

#include<core/_glulxOpCodes>
#include<core/_float>     
//=============================================================================
// _glulx — backing object for the bgl.glulx namespace.
extend bgl{ auto glulx=_glulx; } //extend the bgl namespace object to include glulx-specific things

_bglObject _glulx{
   alias eStyleType for eGlulxStyleType; //bgl.glulx.eStyleType
}

enum eGlulxStyleType{
        normal
   ,    emphasized
   ,    fixed
   ,    header
   ,    subheader
   ,    alert
   ,    note
   ,    blockQuote
   ,    input
   ,    user1
   ,    user2
}

//=============================================================================
// Pull in the full Glulx opcode class. Extends _glulx (above) with additional
// aliases, and defines `emitter class bglOpCodes` + the __glkHook dispatch
// routine that backs glk operations.
#include<core/_glulxOpCodes>

// Glulx-target alias: bgl.asm.<opcode>() → bglOpCodes.<opcode>().
// Symmetric with core/_zcode.bgl's Z-target alias.
extend bgl { emitter auto asm = bglOpCodes; }

// Image print-rules need the `eAssets` enum, which the blorbifier generates into the
// author's `_blorbAssets.bgl` (the author includes it manually). Gate on `generateBlorb`
// so a non-blorb Glulx build neither requires the enum nor fails to resolve `eAssets`.
// A regular (non-emitter) print-rule: used in an interpolated string `$"…{img(eAssets.x)}…"`,
// the segment is CALLED (it draws the image), not printed — interpolation now permits a void call.
#if (generateBlorb == true)
extend _bglPrintRules {
    void img(eAssets image){
        bgl.asm.imageDrawScaled(gg_mainwin, image, eGlulxImageAlign.inlineCenter, 0, 100, 100);
    }
}
#endif