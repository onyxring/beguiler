/* -----------------------------------------------------------------------------
    _char.bgl - Characters
    The `char` type and the `'x'` literal it is built from, with classification
    (isAlpha, isVowel, ...) and case conversion (toUpper, toLower).

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

//-- Character literals --------------------------------------------------------
/// The type of a `'x'` literal, before it is assigned or compared; converts to `char`.
primitive class charLiteral {
    emitter char operator();    /// Convert to a `char`.
    char operator auto();       /// Convert implicitly to a `char`.
    replace emitter void print(){ print (char)$val; }   /// Print the character.
}

//-- The char type -------------------------------------------------------------
/// A single character, held as its ZSCII code (Z-machine) or Unicode code point (Glulx); arithmetic with `int` works, so `c + 1` is the next character.
primitive class char {
    emitter char operator = (char c){ $target=$c; }   /// Assignment: the variable takes the character.

    emitter bool operator == (char c){ $val==$c}    /// True when the characters are equal.
    emitter bool operator != (char c){ $val~=$c}    /// True when the characters differ.
    emitter bool operator < (char c)	{ $val<$c}    /// True when this character's code is lower.
    emitter bool operator > (char c)	{ $val>$c}    /// True when this character's code is higher.
    emitter bool operator <= (char c){ $val<=$c}    /// True when this character's code is lower or equal.
    emitter bool operator >= (char c){ $val>=$c}    /// True when this character's code is higher or equal.

    emitter bool operator == (int i){ $val==$i}     /// True when the character's code equals `i`.
    emitter bool operator != (int i){ $val~=$i}     /// True when the character's code differs from `i`.
    emitter bool operator < (int i)	{ $val<$i}      /// True when the character's code is below `i`.
    emitter bool operator > (int i)	{ $val>$i}      /// True when the character's code is above `i`.
    emitter bool operator <= (int i){ $val<=$i}     /// True when the character's code is at most `i`.
    emitter bool operator >= (int i){ $val>=$i}     /// True when the character's code is at least `i`.

    emitter char operator + (int c){$val+$c}        /// The character `c` codes after this one.
    emitter char operator - (int c){$val-$c}        /// The character `c` codes before this one.
    emitter char operator + (char c){$val+$c}       /// The character whose code is the sum of the two codes.
    emitter char operator - (char c){$val-$c}       /// The character whose code is the difference of the two codes.

    replace emitter void print(){ print (char)$val; }   /// Print the character.
}
/// Print a character.
emitter void print(char c){ print (char)$c; }

//-- Classification and case helpers -------------------------------------------
// Implementation routines behind the char methods below.
superposed array<char> _bglVowels = "aeiouAEIOU\:a\:e\:i\:o\:u\:y\:A\:E\:I\:O\:U\'a\'e\'i\'o\'u\'y\'A\'E\'I\'O\'U\'Y\`a\`e\`i\`o\`u\`A\`E\`I\`O\`U\^a\^e\^i\^o\^u\^A\^E\^I\^O\^U\oa\oA\~a\~o\~A\~O";

superposed bool _bglCharIsLower(char c){
    #if TARGET_GLULX
        // Glulx characters are Unicode: Glk knows the cases.
        if(c >= 'a' && c <= 'z') rtrue;
        if(c < 128) rfalse;
        if(c == 223 || c == 339) rtrue;   // ß (no single upper case), œ
        if(c > 255) rfalse;                // Glk's case tables cover Latin-1 only
        return (char)bgl.asm.charToUpper((int)c) != c;
    #else
        if(c>='a' && c<='z') rtrue;
        if((c>='\:a' && c<='\:u') || (c>='\:e' && c<='\:y')) rtrue;
        if(c>='\'a' && c<='\'y') rtrue;
        if(c>='\`a' && c<='\`u') rtrue;
        if(c>='\^a' && c<='\^u') rtrue;
        if(c=='\oa') rtrue;
        if(c=='\/o') rtrue;
        if(c>='\~a' && c<='\~o') rtrue;
        if(c=='\ae') rtrue;
        if(c=='\cc') rtrue;
        if(c=='\th') rtrue;
        if(c=='\et') rtrue;
        if(c=='\oe') rtrue;
        rfalse;
    #endif
}
superposed bool _bglCharIsUpper(char c){
    #if TARGET_GLULX
        if(c >= 'A' && c <= 'Z') rtrue;
        if(c < 128) rfalse;
        if(c == 338) rtrue;                // Œ
        if(c > 255) rfalse;
        return (char)bgl.asm.charToLower((int)c) != c;
    #else
        if(c>='A' && c<='Z') rtrue;
        if((c>='\:A' && c<='\:O') || (c>='\:E' && c<='\:I')) rtrue;
        if(c>='\:U') rtrue;
        if(c>='\'A' && c<='\'Y') rtrue;
        if(c>='\`A' && c<='\`U') rtrue;
        if(c>='\^A' && c<='\^U') rtrue;
        if(c=='\oA') rtrue;
        if(c=='\/O') rtrue;
        if(c>='\~A' && c<='\~O') rtrue;
        if(c=='\AE') rtrue;
        if(c=='\cC') rtrue;
        if(c=='\TH') rtrue;
        if(c=='\ET') rtrue;
        if(c=='\OE') rtrue;
        rfalse;
    #endif
}
superposed bool _bglCharIsAlpha(char c){
    return _bglCharIsLower(c) || _bglCharIsUpper(c);
}
superposed bool _bglCharIsNumeric(char c){
    return c>='0' && c<='9';
}
superposed bool _bglCharIsAlphaNumeric(char c){
    return _bglCharIsAlpha(c) || _bglCharIsNumeric(c);
}
superposed bool _bglCharIsVowel(char c){
    for(char v in _bglVowels) if(v==c) rtrue;
    rfalse;
}
superposed bool _bglCharIsConsonant(char c){
    return (_bglCharIsAlpha(c) && !_bglCharIsVowel(c));
}
superposed char _bglCharToLower(char c){
    #if TARGET_GLULX
        if(c >= 'A' && c <= 'Z') return c + 32;
        if(c < 128) return c;
        if(c == 338) return c + 1;         // Œ → œ
        if(c > 255) return c;
        return (char)bgl.asm.charToLower((int)c);
    #else
        switch (c) {
            case 'A' to 'Z':                                               return c + 32;
            case '\oA', '\/O', '\AE', '\cC', '\OE':                        return c - 1;
            case '\TH', '\ET':                                             return c - 2;
            case '\:A' to '\:U', '\:E', '\:I', '\~A' to '\~O':             return c - 3;
            case '\`A' to '\`U', '\^A' to '\^U':                           return c - 5;
            case '\'A' to '\'Y':                                           return c - 6;
        }
        return c;
    #endif
}
superposed char _bglCharToUpper(char c){
    #if TARGET_GLULX
        if(c >= 'a' && c <= 'z') return c - 32;
        if(c < 128) return c;
        if(c == 339) return c - 1;         // œ → Œ
        if(c > 255) return c;
        return (char)bgl.asm.charToUpper((int)c);
    #else
        switch (c) {
            case 'a' to 'z':                                               return c - 32;
            case '\oa', '\/o', '\ae', '\cc', '\220':                        return c + 1;
            case '\th', '\et':                                              return c + 2;
            case '\:a' to '\:u', '\:e', '\:i', '\~a' to '\~o':             return c + 3;
            case '\`a' to '\`u', '\^a' to '\^u':                           return c + 5;
            case '\'a' to '\'y':                                           return c + 6;
        }
        return c;
    #endif
}

//-- Char methods --------------------------------------------------------------
extend class char {
    /// This character in upper case, accented letters included; unchanged if it has no upper case.
    emitter char toUpper()          { _bglCharToUpper($self) }
    /// This character in lower case, accented letters included; unchanged if it has no lower case.
    emitter char toLower()          { _bglCharToLower($self) }
    /// True for a lower-case letter.
    emitter bool isLower()          { _bglCharIsLower($self) }
    /// True for an upper-case letter.
    emitter bool isUpper()          { _bglCharIsUpper($self) }
    /// True for a letter of either case.
    emitter bool isAlpha()          { _bglCharIsAlpha($self) }
    /// True for `'0'` to `'9'`.
    emitter bool isNumeric()        { _bglCharIsNumeric($self) }
    /// True for a letter or a digit.
    emitter bool isAlphaNumeric()   { _bglCharIsAlphaNumeric($self) }
    /// True for a vowel, in either case.
    emitter bool isVowel()          { _bglCharIsVowel($self) }
    /// True for a letter that is not a vowel.
    emitter bool isConsonant()      { _bglCharIsConsonant($self) }

    /// Compare two characters ignoring case: `'A' =~ 'a'`.
    emitter bool operator =~ (char c){ _bglCharToLower($self)==_bglCharToLower($c) }
}
