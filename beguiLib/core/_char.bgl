#once
extern emitter class charLiteral:_bglObject{
    emitter char operator();                   //implicitly converts to char type
    char operator auto();
    replace emitter void print(){ print (char)$val; }
}
extern emitter class char : _bglObject{
    emitter char operator = (char c){ $target=$c; }
    //emitter char operator = (int v){ $val=$v; } //we avoid:  char c = 45;  Enforce: char c ='\45';

    emitter bool operator == (char c){ $val==$c}
    emitter bool operator != (char c){ $val~=$c}
    emitter bool operator < (char c)	{ $val<$c}
    emitter bool operator > (char c)	{ $val>$c}
    emitter bool operator <= (char c){ $val<=$c}
    emitter bool operator >= (char c){ $val>=$c}

    //By design, int and char are NOT the same. For example, we don't support an integer test against a character by default (intA == 'c'); however, we do overload character for the reverse test for convenience (charA==64). This also makes a byte array of numeric values (array<char> = {5, 10, ...}) usable: its elements read as chars but compare against int thresholds.
    emitter bool operator == (int i){ $val==$i}
    emitter bool operator != (int i){ $val~=$i}
    emitter bool operator < (int i)	{ $val<$i}
    emitter bool operator > (int i)	{ $val>$i}
    emitter bool operator <= (int i){ $val<=$i}
    emitter bool operator >= (int i){ $val>=$i}

    emitter char operator + (int c){$val+$c}
    emitter char operator - (int c){$val-$c}
    // char + char / char - char: byte-array arithmetic (e.g. summing byte values). Result is a char
    // (byte-wide); accumulate into an int (int + char widens) when a running total may exceed 255.
    emitter char operator + (char c){$val+$c}
    emitter char operator - (char c){$val-$c}

    replace emitter void print(){ print (char)$val; }
}
emitter void print(char c){ print (char)$c; }

//=============================================================================
// Extended char functionality — classification (isAlpha/isVowel/…) and case
// conversion (toUpper/toLower), ALWAYS present, no manual include.
//
// The implementations are free `superposed` routines: emitted only when a call
// site names them, so a game that never classifies characters pays nothing for
// the logic. The `char` type's methods below are emitters that inline to those
// routines directly (an emitter body can't nest-call another emitter, so they
// target the standalones, not a facade).
//
// `_bglVowels` is `superposed` too: a data array gated by the same mechanism as
// the routines, so it's emitted only when isVowel/isConsonant are actually used.
//
// (Formerly core/_charExtended.bgl — merged here now that both are auto-included;
// `array<char>` resolves regardless of include order via the pre-scan forward pass.)
//=============================================================================

superposed array<char> _bglVowels = "aeiouAEIOU\:a\:e\:i\:o\:u\:y\:A\:E\:I\:O\:U\'a\'e\'i\'o\'u\'y\'A\'E\'I\'O\'U\'Y\`a\`e\`i\`o\`u\`A\`E\`I\`O\`U\^a\^e\^i\^o\^u\^A\^E\^I\^O\^U\oa\oA\~a\~o\~A\~O";

superposed bool _bglCharIsLower(char c){
    if(c>='a' && c<='z') rtrue;
    if((c>='\:a' && c<='\:u') || (c>='\:e' && c<='\:y')) rtrue;   // diaeresis: ä ö ü ë ï ÿ
    if(c>='\'a' && c<='\'y') rtrue;                                // acute: á é í ó ú ý
    if(c>='\`a' && c<='\`u') rtrue;                                // grave: à è ì ò ù
    if(c>='\^a' && c<='\^u') rtrue;                                // circumflex: â ê î ô û
    if(c=='\oa') rtrue;                                            // å angstrom
    if(c=='\/o') rtrue;                                            // ø slashed o
    if(c>='\~a' && c<='\~o') rtrue;                                // tilde: ã ñ õ
    if(c=='\ae') rtrue;                                            // æ
    if(c=='\cc') rtrue;                                            // ç cedilla
    if(c=='\th') rtrue;                                            // þ thorn
    if(c=='\et') rtrue;                                            // ð eth
    if(c=='\oe') rtrue;                                            // œ
    rfalse;
}
superposed bool _bglCharIsUpper(char c){
    if(c>='A' && c<='Z') rtrue;
    if((c>='\:A' && c<='\:O') || (c>='\:E' && c<='\:I')) rtrue;   // diaeresis: Ä Ö Ë Ï
    if(c>='\:U') rtrue;                                            // diaeresis: Ü (160, isolated)
    if(c>='\'A' && c<='\'Y') rtrue;                                // acute: Á É Í Ó Ú Ý
    if(c>='\`A' && c<='\`U') rtrue;                                // grave: À È Ì Ò Ù
    if(c>='\^A' && c<='\^U') rtrue;                                // circumflex: Â Ê Î Ô Û
    if(c=='\oA') rtrue;                                            // Å angstrom
    if(c=='\/O') rtrue;                                            // Ø slashed O
    if(c>='\~A' && c<='\~O') rtrue;                                // tilde: Ã Ñ Õ
    if(c=='\AE') rtrue;                                            // Æ
    if(c=='\cC') rtrue;                                            // Ç cedilla
    if(c=='\TH') rtrue;                                            // Þ thorn
    if(c=='\ET') rtrue;                                            // Ð eth
    if(c=='\OE') rtrue;                                            // Œ
    rfalse;
}
superposed bool _bglCharIsAlpha(char c){
    return _bglCharIsLower(c) || _bglCharIsUpper(c);
}
superposed bool _bglCharIsNumeric(char c){
    return c>='0' && c<='9';
}
superposed bool _bglCharIsAlphaNumeric(char c){
    return _bglCharIsAlpha(c) || _bglCharIsNumeric(c);
}
superposed bool _bglCharIsVowel(char c){
    for(char v in _bglVowels) if(v==c) rtrue;
    rfalse;
}
superposed bool _bglCharIsConsonant(char c){
    return (_bglCharIsAlpha(c) && !_bglCharIsVowel(c));
}
superposed char _bglCharToLower(char c){
    switch (c) {
        case 'A' to 'Z':                                               return c + 32;
        case '\oA', '\/O', '\AE', '\cC', '\OE':                        return c - 1;  // Å→å Ø→ø Æ→æ Ç→ç Œ→œ
        case '\TH', '\ET':                                             return c - 2;  // Þ→þ Ð→ð
        case '\:A' to '\:U', '\:E', '\:I', '\~A' to '\~O':             return c - 3;  // diaeresis upper, tilde upper
        case '\`A' to '\`U', '\^A' to '\^U':                           return c - 5;  // grave upper, circumflex upper
        case '\'A' to '\'Y':                                           return c - 6;  // acute upper
    }
    return c;
}
superposed char _bglCharToUpper(char c){
    switch (c) {
        case 'a' to 'z':                                               return c - 32;
        case '\oa', '\/o', '\ae', '\cc', '\220':                        return c + 1;  // å→Å ø→Ø æ→Æ ç→Ç œ→Œ
        case '\th', '\et':                                              return c + 2;  // þ→Þ ð→Ð
        case '\:a' to '\:u', '\:e', '\:i', '\~a' to '\~o':             return c + 3;  // diaeresis lower, tilde lower
        case '\`a' to '\`u', '\^a' to '\^u':                           return c + 5;  // grave lower, circumflex lower
        case '\'a' to '\'y':                                           return c + 6;  // acute lower
    }
    return c;
}

extend class char {
    emitter char toUpper()          { _bglCharToUpper($self) }
    emitter char toLower()          { _bglCharToLower($self) }
    emitter bool isLower()          { _bglCharIsLower($self) }
    emitter bool isUpper()          { _bglCharIsUpper($self) }
    emitter bool isAlpha()          { _bglCharIsAlpha($self) }
    emitter bool isNumeric()        { _bglCharIsNumeric($self) }
    emitter bool isAlphaNumeric()   { _bglCharIsAlphaNumeric($self) }
    emitter bool isVowel()          { _bglCharIsVowel($self) }
    emitter bool isConsonant()      { _bglCharIsConsonant($self) }

    emitter bool operator =~ (char c){ _bglCharToLower($self)==_bglCharToLower($c) }

    //NOTE: other comparisons are part of the char class declared above
}
