//-----------------------------------------------------------------------------
// _zcodeCore.bgl — the Z-machine platform layer: the `bgl.zcode` namespace and
// the Z-machine assembly opcode emitter class (via _zcodeOpCodes), aliased as
// `bgl.asm`.
//
// Included automatically by the compiler (__beguileCore.bgl) when the target is
// Z-code — the counterpart to _glulxCore.bgl on the Glulx side. There is no
// user-facing `#include`; the platform core follows the active target.
//-----------------------------------------------------------------------------
#once

#include<core/_zcodeOpCodes>
//=============================================================================
//
extend bgl{ auto zcode=_zcode; } //extend the bgl namespace object with Z-code-specific things

_bglObject _zcode{
   
}

extend bgl { emitter auto asm = bglOpCodes; }
