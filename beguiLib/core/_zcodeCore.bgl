/* -----------------------------------------------------------------------------
    _zcodeCore.bgl - Z-machine Platform Layer
    Provides `bgl.zcode`, the raw Z-machine opcodes as `bgl.asm`, and the story
    file header as `bgl.header`. It is included automatically on Z-code targets.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

#include<core/_zcodeOpCodes>

//-- Namespaces ----------------------------------------------------------------
extend bgl{
    auto zcode=_zcode;   /// Z-machine-specific facilities.
}

// The object behind bgl.zcode.
_bglObject _zcode{

}

extend bgl {
    emitter auto asm = bglOpCodes;   /// Raw Z-machine assembly opcodes.
}

//-- Story file header ---------------------------------------------------------
/// The story file header: the release number and serial code the game was compiled with.
superposed _bglObject _bglHeader {
    /// The release number.
    auto release = {
        int operator(){ return bgl.asm.loadw($02, 0) & $03ff; }
    }
    /// Character `i` (0-5) of the six-character serial code.
    char serialChar(int i){ return (char)bgl.asm.loadb($12, i); }
    /// Print the serial code.
    void printSerial(){
        int i = 0;
        for(i = 0; i < 6; i++) print(self.serialChar(i));
    }
}
extend bgl {
    alias header = _bglHeader;   /// The story file header.
}
