#once

/// The settings a `#beguilerSettings { … }` block can set.
extern class beguilerSettingsType {
    eTarget      target             = Glulx;       /// The target machine: Glulx (the default), Z5 or Z8.
    string       informPath;                       /// The full path to the Inform 6 compiler; overrides `informName`.
    string       informName         = "inform";    /// The Inform 6 compiler's file name; "none" stops after writing the Inform 6 source.
    string       beguiLibPath       = "beguiLib";  /// The folder that holds the Beguile library.
    string       outputPath         = "output";    /// The folder for compiled files.
    eErrorFormat errorFormat        = E1;          /// The format for error messages: E1 (Microsoft) or E2 (Macintosh).
    int          release            = 0;           /// The story's release number.
    string       serial             = "";          /// The story's serial number: exactly six digits, such as "250328".
    int          framePoolSize      = 64;          /// How many overflow slots the Z-machine has for local variables.
    int          linqScratchSize    = 32;          /// The capacity of each buffer that chained array queries use.
    int          worldBufSize       = 128;         /// The most objects a `bgl.world` query can return; raise it for very large worlds.
    int          forInScratchSize   = 31;          /// The most values a `for(x in {a, b, c})` list can hold; raise it if a list overflows.
    string       includePaths;                     /// Extra folders to search for Beguile and Inform 6 includes, separated by commas.
    bool         rewritePaths       = true;        /// Convert path separators to suit the operating system.
    bool         autoInitialize     = true;        /// Start the Beguile runtime before the game's own main; set it false when another extension already replaces main.
    bool         omitUnusedRoutines = true;        /// Leave routines nothing uses out of the story file; set it false to keep every routine.
    bool         economy            = false;       /// Shrink a Z-machine story by abbreviating common text; skipped when the source has its own abbreviations.
    bool         generateBlorb      = false;       /// Package the story and its assets into a blorb file.
    string       blorbAssetPath     = "assets";    /// The asset folder, relative to the source file.
    string       author             = "";          /// The author's name, for the story's bibliographic data (required).
    string       title              = "";          /// The story's title (required).
    string       headline           = "";          /// The story's subtitle, such as "An Interactive Mystery".
    string       genre              = "";          /// The story's genre, such as "Fantasy" or "Mystery".
    string       description        = "";          /// A blurb describing the story, up to about 2400 characters.
    string       language           = "";          /// The story's language, as an ISO 639 code such as "en" or "en-US".
    string       series             = "";          /// The series the story belongs to.
    int          seriesNumber       = 0;           /// The story's position in its series; needs `series`.
    string       firstPublished     = "";          /// When the story was first published: YYYY or YYYY-MM-DD.
    string       forgiveness        = "";          /// How forgiving the story is: Merciful, Polite, Tough, Nasty or Cruel.
    string       ifid               = "";          /// The story's IFID, a UUID; generated when left empty.
}

/// The machines Beguile can compile for.
extern enum eTarget{
    Glulx,   /// The Glulx virtual machine.
    Z5,      /// The Z-machine, version 5.
    Z8       /// The Z-machine, version 8.
}
/// The formats for compiler error messages.
extern enum eErrorFormat{
    E0,   /// Archimedes style.
    E1,   /// Microsoft style.
    E2    /// Macintosh style.
}