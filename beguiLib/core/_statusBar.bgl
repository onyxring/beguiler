#once
/*-----------------------------------------------------------------------------
    bgl.ui.statusBar - core implementation.

    This is overridden by the i6 Standard Library and puny libraries to map to their
    implementations.
 -----------------------------------------------------------------------------*/
extend _bglUi { alias statusBar = _bglStatus; } //bgl.ui.statusBar

superposed _bglObject _bglStatus {
     auto id  = {   // id  getter/setter 
        int _id   = 0;                 
        int operator() { return _id; }
        void operator = (int newId){
            _id=newId;
        }
    }
    auto height = {   // height  getter/setter 
        int _h   = 0;                 
        #if TARGET_GLULX
            int _win = 0;           
        #endif

        int operator() { return _h; }

        void operator = (int v){
            _h = v;
            #if TARGET_GLULX
                bGlulxWindowMethodFlags winMethod = bGlulxWindowPlacement.above | bGlulxWindowScale.fixed | bGlulxWindowBorder.noBorder;
                if(_win == 0)
                    _win = bgl.asm.windowOpen(bgl.asm.windowGetRoot(), eGlulxWindowType.textGrid, v, winMethod, 0);
                else
                    bgl.asm.windowSetArrangement(bgl.asm.windowGetParent(_win), winMethod, v, _win);
            #else
                bgl.asm.splitWindow(v);
            #endif
        }
    }
}
