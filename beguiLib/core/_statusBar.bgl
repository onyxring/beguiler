   -----------------------------------------------------------------------------*/
#once

extend _bglUi {
    alias statusBar = _bglStatus;   /// The status line at the top of the screen.
}

/// The status line at the top of the screen.
superposed _bglObject _bglStatus {
    /// The status window's handle: a Glk window id on Glulx, 0 on the Z-machine.
    auto id  = {
        int _id   = 0;
        int operator() { return _id; }
        void operator = (int newId){
            _id=newId;
        }
    }
    /// The status bar's height, in lines; setting it opens or resizes the window.
    auto height = {
        int _h   = 0;

        int operator() { return _h; }

        void operator = (int v){
            _h = v;
            #if TARGET_GLULX
                bGlulxWindowMethodFlags winMethod = bGlulxWindowPlacement.above | bGlulxWindowScale.fixed | bGlulxWindowBorder.noBorder;
                int win = bgl.ui.statusBar.id;
                if(win == 0)
                    bgl.ui.statusBar.id = bgl.asm.windowOpen(bgl.asm.windowGetRoot(), eGlulxWindowType.textGrid, v, winMethod, 0);
                else
                    bgl.asm.windowSetArrangement(bgl.asm.windowGetParent(win), winMethod, v, win);
            #else
                bgl.asm.splitWindow(v);
            #endif
        }
    }
}
