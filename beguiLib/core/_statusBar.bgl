/* -----------------------------------------------------------------------------
    _statusBar.bgl - Status bar
    Provides `bgl.ui.statusBar`, the status line at the top of the screen.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

extend _bglUi {
    alias statusBar = _bglStatus;   /// The status line at the top of the screen.
}

/// The status line at the top of the screen.
superposed _bglObject _bglStatus {
    /// The status window's handle: a Glk window id on Glulx, 0 on the Z-machine.
    auto id asI6 _bglStatus_id = {
        int _id   = 0;
        int operator() { return _id; }
        void operator = (int newId){
            _id=newId;
        }
    }
    /// The status bar's width, in characters.
    auto width asI6 _bglStatus_width = {
        int operator() { return _bglWinWidth(outer.id); }
    }
    /// Put the cursor at a cell of the status bar, whose output must be current; counts from 0.
    void moveCursor(int col, int line) asI6 _bglWin_moveCursor { _bglWinMoveCursor(self.id, col, line); }
    /// The status bar's height, in lines; setting it opens or resizes the window.
    auto height asI6 _bglStatus_height = {
        int _h   = 0;

        int operator() { return _h; }

        void operator = (int v){
            _h = v;
            #if TARGET_GLULX
                bGlulxWindowMethodFlags winMethod = bGlulxWindowPlacement.above | bGlulxWindowScale.fixed | bGlulxWindowBorder.noBorder;
                int win = bgl.ui.statusBar.id;
                if(win == 0)
                    bgl.ui.statusBar.id = bgl.asm.windowOpen(bgl.asm.windowGetRoot(), eGlulxWindowType.textGrid, v, winMethod, _bglStatusRock);
                else
                    bgl.asm.windowSetArrangement(bgl.asm.windowGetParent(win), winMethod, v, win);
            #else
                bgl.asm.splitWindow(v);
            #endif
        }
    }
    // After a restore, undo or restart:  take back the status window Glk kept, at the program's height
    void _recover() asI6 _bglStatus_recover {
        #if TARGET_GLULX
            int h = self.height;
            int found = 0;
            int g = bgl.asm.windowIterate(0, 0);
            while(g != 0){
                if(bgl.asm.windowGetRock(g) == _bglStatusRock) found = g;
                g = bgl.asm.windowIterate(g, 0);
            }
            self.id = found;
            if(h > 0) self.height = h;
            else if(found != 0){ bgl.asm.windowClose(found, 0); self.id = 0; }
        #endif
    }
}

#if TARGET_GLULX
    // The rock of the status window opened here; <glulxWindow>'s windows take the rocks above it
    const int _bglStatusRock = $40000000;
#endif
