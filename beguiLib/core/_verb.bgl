/* -----------------------------------------------------------------------------
    _verb.bgl - Verbs
    Declares `verb`, the class every player command derives from.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

/// A player command: declare it with `verb Name { grammar = … }`, give it behavior in `handler()`, and run it with `perform()`.
alias class verb for object{
    grammarRuleList grammar;  /// The patterns that match this verb: `grammar = { {.take, NOUN} }`.
    bool meta;                /// True for an out-of-world command, such as SAVE, that takes no game time.
    int priority = 10;        /// Where this verb's grammar sits among others: lower matches earlier; the default is 10.

    /// What the verb does; override it to give the verb behavior. A library verb runs the library's own routine by default.
    default emitter void handler(){ $selfsub(); }

    emitter void perform()                   { <($action)> }            /// Run this action now, as though the player typed it.
    emitter void perform(object n)           { <($action) $n> }         /// Run this action now on `n`, as though the player typed it.
    emitter void perform(object n, object s) { <($action) $n $s> }      /// Run this action now on `n` and `s`, as though the player typed it.

    emitter eBool operator == (verb v){ $val == $v }     /// True when this is action `v`.
    emitter eBool operator != (verb v){ $val ~= $v }     /// True unless this is action `v`.
    // Emits the verb's action routine, which runs handler().
    emitter void _bglGlobalDeclaration() {
        [$selfsub;
            $self.handler();
        ];
    }
}
