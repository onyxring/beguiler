   -----------------------------------------------------------------------------*/
#once

/// The random-number source.
emitter class _bglRandom {
    emitter int get(int range){ random($range) }   /// Return a whole number from 1 to `range`; `get(6)` rolls a die.

    emitter var get(var a, var b){ random($a, $b) }                                                       /// Return one of the listed values, chosen at random.
    emitter var get(var a, var b, var c){ random($a, $b, $c) }                                            /// Return one of the listed values, chosen at random.
    emitter var get(var a, var b, var c, var d){ random($a, $b, $c, $d) }                                 /// Return one of the listed values, chosen at random.
    emitter var get(var a, var b, var c, var d, var e){ random($a, $b, $c, $d, $e) }                      /// Return one of the listed values, chosen at random.
    emitter var get(var a, var b, var c, var d, var e, var f){ random($a, $b, $c, $d, $e, $f) }           /// Return one of the listed values, chosen at random.
    emitter var get(var a, var b, var c, var d, var e, var f, var g){ random($a, $b, $c, $d, $e, $f, $g) }  /// Return one of the listed values, chosen at random.
    emitter var get(var a, var b, var c, var d, var e, var f, var g, var h){ random($a, $b, $c, $d, $e, $f, $g, $h) }  /// Return one of the listed values, chosen at random.

    /// Seed the generator: 0 re-seeds from the environment; any other value repeats the same sequence every run.
    emitter void seed(int s){
        ##if TARGET_GLULX
        @setrandom $s;
        ##else
        random(-$s);
        ##endif
    }
}

extend _bglUtil {
    emitter auto random = _bglRandom;   /// The random-number source.
}
