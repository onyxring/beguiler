/* ---------------------------------------------------------------------------
   __builtins.i6b
   built-in I6 templates the compiler splices for special-case codegen
   (frame pool, for-in variants, literal-list scratch). This is NOT #included. */

// ---------------------------------------------------------------------------
// framePool — Z-machine frame pool, emitted once when any function overflows 14
// locals. 
template framePool($size) {{{
   Array _bglFramePool --> $size;
   Constant _bglFramePoolWords = $size;
   Global _bglFrameTop = 0;
   Global _bglRetHold = 0;   ! a return value read before the frame it came from is freed
   [ _bglFrameAlloc size r;
      if (_bglFrameTop + size > $size) {
         print "^[Beguile runtime error: frame pool exhausted]^";
         quit;
      }
      r = _bglFrameTop;
      _bglFrameTop = _bglFrameTop + size;
      return _bglFramePool + (r * WORDSIZE);
   ];
   ! A routine's spilled locals start at 0, as real locals do: the pool holds earlier frames' words.
   [ _bglFrameAllocZ size r i;
      r = _bglFrameAlloc(size);
      for (i = 0: i < size: i++) r-->i = 0;
      return r;
   ];
   [ _bglFrameFree size;
      _bglFrameTop = _bglFrameTop - size;
   ];
   ! The marker and the length, then an I6 table of `size` elements; the array is the table.
   [ _bglArrayLocalAlloc size r i;
      r = _bglFrameAlloc(size + 3);
      r-->0 = $9084;
      r-->1 = 0;
      r = r + 2 * WORDSIZE;
      r-->0 = size;
      for (i = 1: i <= size: i++) r-->i = 0;
      return r;
   ];
   Global _bglFrameTaken = 0;
   Global _bglFrameSrc = 0;
   ! A local array with room for src's n elements: `cur` when it has room, else a new block. When src
   ! is a returned local lying in freed frame space at or above the top, its elements are moved down
   ! into the new block (forward, so none is overwritten before it is read) and _bglFrameSrc names
   ! the block to copy from instead.
   [ _bglArrayLocalCopyAlloc n src cur top i;
      _bglFrameTaken = 0;
      _bglFrameSrc = src;
      if (cur ~= 0 && cur-->(-2) == $9084 && cur-->0 >= n) return cur;
      top = _bglFramePool + _bglFrameTop * WORDSIZE;
      if (src - 2 * WORDSIZE < top || src >= _bglFramePool + $size * WORDSIZE) {
         _bglFrameTaken = n + 3;
         return _bglArrayLocalAlloc(n);
      }
      if (_bglFrameTop + n + 3 > $size) {
         print "^[Beguile runtime error: frame pool exhausted]^";
         quit;
      }
      _bglFrameTop = _bglFrameTop + n + 3;
      top-->0 = $9084;
      top-->1 = n;
      top = top + 2 * WORDSIZE;
      for (i = 1: i <= n: i++) top-->i = src-->i;
      top-->0 = n;
      _bglFrameTaken = n + 3;
      _bglFrameSrc = top;
      return top;
   ];
   [ _bglArrayLocalAllocPlain size r i;
      r = _bglFrameAlloc(size + 1);
      r-->0 = size;
      for (i = 1: i <= size: i++) r-->i = 0;
      return r;
   ];
   [ _bglRawArrayLocalAlloc size r i;
      r = _bglFrameAlloc(size);
      for (i = 0: i < size: i++) r-->i = 0;
      return r;
   ];
   [ _bglByteArrayLocalAlloc nbytes words r i;
      words = 2 + ((nbytes + WORDSIZE - 1) / WORDSIZE);
      r = _bglFrameAlloc(words);
      for (i = 0: i < words: i++) r-->i = 0;
      r-->0 = nbytes;
      r-->1 = nbytes;   ! the length: a buffer starts full, as I6's does
      return r + WORDSIZE;
   ];
   [ _bglByteArrayLocalFree nbytes;
      _bglFrameFree(2 + ((nbytes + WORDSIZE - 1) / WORDSIZE));
   ];
   [ _bglByteArrayLocalCopy dst src i;
      for (i = 0: i < src-->0: i++) dst->(WORDSIZE + i) = src->(WORDSIZE + i);
      dst-->0 = src-->0;
   ];
}}}

// ---------------------------------------------------------------------------
// for-in loops: 
template forIn.open($counter, $array, $element, $lengthExpr) {{{
   $counter = 0;
   for (: $counter < $lengthExpr : $counter++) {
      $element = $array-->($counter+1);
}}}

template forIn.close() {{{
   }
}}}

template forIn.openMember($counter, $array, $element, $lengthExpr) {{{
   $counter = 0;
   for (: $counter < $lengthExpr : $counter++) {
      $element = $array-->($counter);
}}}

template forIn.closeMember() {{{
   }
}}}

template forIn.openByte($counter, $array, $element) {{{
   $counter = 0;
   for (: $counter < $array-->0 : $counter++) {
      $element = $array->($counter + WORDSIZE);
}}}

template forIn.closeByte() {{{
   }
}}}

// ---------------------------------------------------------------------------
// paramCopyIn.arg — holds the argument while a parameter of a class with init/deinit gets its own
// instance (`init`) and the argument is copied into it (`operator =`). Declared in
// __beguileCore.bgl's paramCopySupport block.
template paramCopyIn.arg() triggers paramCopySupport {{{
_bglParamArg
}}}

