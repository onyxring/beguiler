/* ---------------------------------------------------------------------------
   __builtins.i6b
   built-in I6 templates the compiler splices for special-case codegen
   (frame pool, for-in variants, literal-list scratch). This is NOT #included. */

// ---------------------------------------------------------------------------
// framePool — Z-machine frame pool, emitted once when any function overflows 14
// locals. 
template framePool($size) {{{
   Array _bglFramePool --> $size;
   Global _bglFrameTop = 0;
   [ _bglFrameAlloc size r;
      if (_bglFrameTop + size > $size) {
         print "^[Beguile runtime error: frame pool exhausted]^";
         quit;
      }
      r = _bglFrameTop;
      _bglFrameTop = _bglFrameTop + size;
      return _bglFramePool + (r * WORDSIZE);
   ];
   [ _bglFrameFree size;
      _bglFrameTop = _bglFrameTop - size;
   ];
   [ _bglArrayLocalAlloc size r i;
      r = _bglFrameAlloc(size + 3);
      r-->0 = size + 2;
      for (i = 1: i <= size: i++) r-->i = 0;
      r-->(size + 1) = 0;
      r-->(size + 2) = $9084;
      return r;
   ];
   [ _bglArrayLocalAllocPlain size r i;
      r = _bglFrameAlloc(size + 1);
      r-->0 = size;
      for (i = 1: i <= size: i++) r-->i = 0;
      return r;
   ];
   [ _bglRawArrayLocalAlloc size r i;
      r = _bglFrameAlloc(size);
      for (i = 0: i < size: i++) r-->i = 0;
      return r;
   ];
   [ _bglByteArrayLocalAlloc nbytes words r i;
      words = 1 + ((nbytes + WORDSIZE - 1) / WORDSIZE);
      r = _bglFrameAlloc(words);
      for (i = 0: i < words: i++) r-->i = 0;
      r-->0 = nbytes;
      return r;
   ];
   [ _bglByteArrayLocalFree nbytes;
      _bglFrameFree(1 + ((nbytes + WORDSIZE - 1) / WORDSIZE));
   ];
}}}

// ---------------------------------------------------------------------------
// for-in loops: 
template forIn.open($counter, $array, $element, $lengthExpr) {{{
   $counter = 0;
   for (: $counter < $lengthExpr : $counter++) {
      $element = $array-->($counter+1);
}}}

template forIn.close() {{{
   }
}}}

template forIn.openMember($counter, $array, $element, $lengthExpr) {{{
   $counter = 0;
   for (: $counter < $lengthExpr : $counter++) {
      $element = $array-->($counter);
}}}

template forIn.closeMember() {{{
   }
}}}

template forIn.openByte($counter, $array, $element) {{{
   $counter = 0;
   for (: $counter < $array-->0 : $counter++) {
      $element = $array->($counter + WORDSIZE);
}}}

template forIn.closeByte() {{{
   }
}}}

template forInList.push($element) triggers scratchSupport {{{
   _bglScratchPush($element);
}}}

template forInList.make($target, $count) triggers scratchSupport {{{
   $target = _bglScratchMake($count);
}}}

