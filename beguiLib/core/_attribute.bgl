/* -----------------------------------------------------------------------------
    _attribute.bgl - Attributes
    Declares `attribute`, an on/off flag an object can carry, and `attributeList`,
    the set of flags in an object's `attributes` member.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

/// An on/off flag an object can carry, such as `light`; set it in `attributes = {…}` and test it with `.has()`.
primitive class attribute {
    emitter attribute operator !() { ~$val }   /// Turn the flag off in an `attributes` list: `{light, !scenery}`.
}

// Backs NO_ATTRIBUTE.
#i6 { Constant NO_ATTRIBUTE 0; }
extern const attribute NO_ATTRIBUTE;   /// No attribute, for leaving an attribute-typed member unset; a bare 0 is not an attribute.

/// The set of flags in an object's `attributes` member.
extern emitter class attributeList{
    /// Add a flag to this set.
    emitter void give(attribute attr){
        give $self $attr
    }
    /// Take a flag out of this set.
    emitter void ungive(attribute attr){
        give $self ~$attr
    }
    /// True when the set contains `attr`.
    emitter bool has(attribute attr){
        ($self has $attr)
    }
    /// True when the set does not contain `attr`.
    emitter bool hasnt(attribute attr){
        ($self hasnt $attr)
    }
}
