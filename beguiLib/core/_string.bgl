/* -----------------------------------------------------------------------------
    _string.bgl - Strings
    The string and string-literal types, and the print and log routines that
    take them. `#include <string>` adds content comparison and run-time text.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

//-- Literals ------------------------------------------------------------------
/// The type of a `"…"` literal. `==` compares addresses, so two identical literals are not equal; `#include <string>` compares content.
primitive class stringLiteral {
    emitter string operator();                                   /// Convert to a `string`.
    emitter void print(){ print (string)$val; }          /// Print the text.

    emitter eBool operator == (stringLiteral v) { $val == $v }   /// True when both are the same string.
    emitter eBool operator == (string v)        { $val == $v }   /// True when both are the same string.
    emitter eBool operator != (stringLiteral v) { $val ~= $v }   /// True when they are different strings.
    emitter eBool operator != (string v)        { $val ~= $v }   /// True when they are different strings.

    emitter eBool operator == (_bglObject v)    { $val == $v }   /// True when the string is null.
    emitter eBool operator != (_bglObject v)    { $val ~= $v }   /// True unless the string is null.
}

/// The type of a `$"…{expr}…"` literal, which prints its text with each expression's value inserted.
primitive class interpolatedStringLiteral{}
/// A routine that prints `$"…"` text: an interpolated string assigned to one becomes it, and its `{ }` expressions are evaluated each time it prints.
primitive class interpolatedString {
    emitter eBool operator ?() { $val ~= 0 }   /// True unless it is null.
}

//-- Strings -------------------------------------------------------------------
/// A string value that refers to text in the story file. Assigning copies the reference, not the text; `#include <string>` adds `stringObj` for text built at run time.
primitive class string {
    /// Assignment: the variable refers to the literal's text.
    emitter string operator = (stringLiteral v){
        $target=$v
    }
    emitter eBool operator ?() { $val ~= 0 }                     /// True unless the string is null.
    emitter void print(){ print (string)$val; }          /// Print the text.

    emitter eBool operator == (string v)        { $val == $v }   /// True when both are the same string.
    emitter eBool operator == (stringLiteral v) { $val == $v }   /// True when both are the same string.
    emitter eBool operator != (string v)        { $val ~= $v }   /// True when they are different strings.
    emitter eBool operator != (stringLiteral v) { $val ~= $v }   /// True when they are different strings.

    emitter eBool operator == (_bglObject v)    { $val == $v }   /// True when the string is null.
    emitter eBool operator != (_bglObject v)    { $val ~= $v }   /// True unless the string is null.
}

//-- Printing ------------------------------------------------------------------
extend _bglOutput {
    emitter void print(string str){ print (string)$str; }                    /// Print `str`.
    emitter void print(interpolatedStringLiteral v){ $v; }                   /// Print an interpolated string.
    emitter void print(interpolatedString v){ if($v) $v(); }                  /// Print an interpolated string's text, its expressions evaluated now.
    emitter void printLine(interpolatedString v){ if($v) $v(); print "^"; }   /// Print an interpolated string's text, then a newline.
    emitter void print(stringLiteral str){ print (string)$str; }             /// Print a string literal.

    /// Print an interpolated string in debug builds only.
    emitter void log(interpolatedStringLiteral v){
        ##if DEBUG
        $v;
        ##endif
    }
    /// Print a string literal in debug builds only.
    emitter void log(stringLiteral msg){
        ##if DEBUG
        print (string)$msg;
        ##endif
    }
    /// Print `msg` in debug builds only.
    emitter void log(string msg){
        ##if DEBUG
        print (string)$msg;
        ##endif
    }
}
