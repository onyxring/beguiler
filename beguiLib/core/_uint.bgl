/* -----------------------------------------------------------------------------
    _uint.bgl - Unsigned integers
    Declares `uint`, a whole number read as unsigned, for addresses and bit
    patterns.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

/// A whole number read as unsigned: the same word as `int`, but comparison, division and remainder treat it as unsigned.
primitive class uint {
    emitter int operator = (uint v){ $target=$v; }                           /// Assignment: the variable takes the value.
    replace emitter void print(){ _bglPrintUint($val); }                     /// Print the value as an unsigned number.

    emitter uint operator + (uint v){ $val + $v }                            /// The sum, wrapping on overflow.
    emitter uint operator - (uint v){ $val - $v }                            /// The difference, wrapping on overflow.
    emitter uint operator * (uint v){ $val * $v }                            /// The product, wrapping on overflow.

    emitter uint operator / (uint v){ _bglUnsignedDiv($val, $v) }            /// The quotient, reading both as unsigned.
    emitter uint operator % (uint v){ _bglUnsignedMod($val, $v) }            /// The remainder, reading both as unsigned.

    emitter bool operator == (uint v){ $val == $v }                          /// True when the values are equal.
    emitter bool operator != (uint v){ $val ~= $v }                          /// True when the values differ.

    emitter bool operator <  (uint v){ _bglUnsignedCompare($val, $v) < 0 }   /// True when this is less than `v`, reading both as unsigned.
    emitter bool operator <= (uint v){ _bglUnsignedCompare($val, $v) <= 0 }  /// True when this is at most `v`, reading both as unsigned.
    emitter bool operator >  (uint v){ _bglUnsignedCompare($val, $v) > 0 }   /// True when this is greater than `v`, reading both as unsigned.
    emitter bool operator >= (uint v){ _bglUnsignedCompare($val, $v) >= 0 }  /// True when this is at least `v`, reading both as unsigned.

    emitter uint operator += (uint v){ $val = $val + $v }                    /// Add `v` to the variable.
    emitter uint operator -= (uint v){ $val = $val - $v }                    /// Subtract `v` from the variable.
    emitter uint operator *= (uint v){ $val = $val * $v }                    /// Multiply the variable by `v`.
    emitter uint operator /= (uint v){ $val = _bglUnsignedDiv($val, $v) }    /// Divide the variable by `v`, reading both as unsigned.
    emitter uint operator %= (uint v){ $val = _bglUnsignedMod($val, $v) }    /// Set the variable to its unsigned remainder after dividing by `v`.

    emitter uint operator ++() { $val++ }                                    /// Add one to the variable.
    emitter uint operator --() { $val-- }                                    /// Subtract one from the variable.

    emitter uint operator & (uint v){ $val & $v }                            /// The bitwise AND.
    emitter uint operator | (uint v){ $val | $v }                            /// The bitwise OR.
    emitter uint operator &= (uint v){ $val = $val & $v }                    /// Set the variable to its bitwise AND with `v`.
    emitter uint operator |= (uint v){ $val = $val | $v }                    /// Set the variable to its bitwise OR with `v`.
    emitter uint operator ^  (uint v){ ($val | $v) - ($val & $v) }           /// The bitwise exclusive OR.
    emitter uint operator ^= (uint v){ $val = (($val | $v) - ($val & $v)) }  /// Set the variable to its bitwise exclusive OR with `v`.

    emitter uint operator <<  (uint v){ _bglShiftLeft($val, $v) }            /// The value shifted left by `v` bits.
    emitter uint operator <<= (uint v){ $val = _bglShiftLeft($val, $v) }     /// Shift the variable left by `v` bits.
    emitter uint operator >>  (uint v){ _bglUnsignedShiftRight($val, $v) }   /// The value shifted right by `v` bits, filling with zeros.
    emitter uint operator >>= (uint v){ $val = _bglUnsignedShiftRight($val, $v) }  /// Shift the variable right by `v` bits, filling with zeros.

    explicit emitter int  operator() { $val }                                /// Convert to an `int`, keeping the bits.
}

extend extern class int {
    explicit emitter uint operator() { $val }   /// Convert to a `uint`, keeping the bits.
}

extend extern class intLiteral {
    emitter uint operator() { $val }   /// Convert a literal to a `uint`.
}

extend extern class negativeIntLiteral {
    explicit emitter uint operator() { $val }   /// Convert a negative literal to a `uint`; it needs an explicit cast.
}

// Prints a value as unsigned.
superposed void _bglPrintUint(int v){
    if(v >= 0){ print(v); return; }
    print(_bglUnsignedDiv(v, 10));
    print(_bglUnsignedMod(v, 10));
}
emitter void print(uint c){ _bglPrintUint($c); }   /// Print `c` as an unsigned number.