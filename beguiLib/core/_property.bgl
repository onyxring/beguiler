/* -----------------------------------------------------------------------------
    _property.bgl - Properties
    Declares `property`, the name of an object property, and the `name`
    property that holds an object's vocabulary.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

extern additive property name;   /// The dictionary words the parser matches for an object.

/// A property name, not its value: the identifier `obj.provides(prop)` tests for.
primitive class property {
    emitter property operator = (property v) { $target = $v; }  /// Assignment: the variable takes the property name.
    emitter bool     operator == (property v){ $val == $v }     /// True when both name the same property.
    emitter bool     operator != (property v){ $val ~= $v }     /// True when they name different properties.
}
