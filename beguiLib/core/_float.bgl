/* -----------------------------------------------------------------------------
    _float.bgl - Floating-point numbers
    Declares `float`, a single-precision floating-point number, and adds float
    forms of the `bgl.util.math` functions. Glulx only.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

//-- The float type ------------------------------------------------------------
/// A single-precision floating-point number, written `1.5`, `.3` or `-2.0`.
primitive class float {
    emitter int operator = (float v){ $target = $v; }                                /// Assignment: the variable takes the value.
    emitter int operator = (int v){ $target = _bglFloatNumtof($v); }                 /// Assignment: the variable takes the int's value as a float.
    emitter int operator = (intLiteral v){ $target = _bglFloatNumtof($v); }          /// Assignment: the variable takes the number as a float.
    emitter int operator = (negativeIntLiteral v){ $target = _bglFloatNumtof($v); }  /// Assignment: the variable takes the number as a float.

    emitter float operator + (float v){ _bglFloatFadd($val, $v) }  /// The sum.
    emitter float operator - (float v){ _bglFloatFsub($val, $v) }  /// The difference.
    emitter float operator * (float v){ _bglFloatFmul($val, $v) }  /// The product.
    emitter float operator / (float v){ _bglFloatFdiv($val, $v) }  /// The quotient.
    emitter float operator % (float v){ _bglFloatFmod($val, $v) }  /// The remainder.

    emitter bool operator == (float v){ $val == $v }  /// True when the values are equal.
    emitter bool operator != (float v){ $val ~= $v }  /// True when the values differ.

    replace emitter void print(){ _bglFloatPrintDecimal($val); }  /// Print the value as a decimal rounded to four places.

    /// Compare two floats for sorting: -1, 0 or 1.
    static int operator <=> (var a, var b) {
        #i6 {
            if(_bglFloatLt(a, b)) return -1;
            if(_bglFloatGt(a, b)) return 1;
            return 0;
        }
    }

    emitter bool operator <  (float v){ _bglFloatLt($val, $v) }  /// True when this is less than `v`.
    emitter bool operator <= (float v){ _bglFloatLe($val, $v) }  /// True when this is at most `v`.
    emitter bool operator >  (float v){ _bglFloatGt($val, $v) }  /// True when this is greater than `v`.
    emitter bool operator >= (float v){ _bglFloatGe($val, $v) }  /// True when this is at least `v`.

    emitter float operator += (float v){ $val = $val + $v }  /// Add `v` to the variable.
    emitter float operator -= (float v){ $val = $val - $v }  /// Subtract `v` from the variable.
    emitter float operator *= (float v){ $val = $val * $v }  /// Multiply the variable by `v`.
    emitter float operator /= (float v){ $val = $val / $v }  /// Divide the variable by `v`.
    emitter float operator %= (float v){ $val = $val % $v }  /// Set the variable to its remainder after dividing by `v`.

    emitter float operator + (int v){ _bglFloatFadd($val, _bglFloatNumtof($v)) }  /// The sum.
    emitter float operator - (int v){ _bglFloatFsub($val, _bglFloatNumtof($v)) }  /// The difference.
    emitter float operator * (int v){ _bglFloatFmul($val, _bglFloatNumtof($v)) }  /// The product.
    emitter float operator / (int v){ _bglFloatFdiv($val, _bglFloatNumtof($v)) }  /// The quotient.
    emitter float operator % (int v){ _bglFloatFmod($val, _bglFloatNumtof($v)) }  /// The remainder.
    emitter bool  operator == (int v){ $val == _bglFloatNumtof($v) }              /// True when the values are equal.
    emitter bool  operator != (int v){ $val ~= _bglFloatNumtof($v) }              /// True when the values differ.
    emitter bool  operator <  (int v){ _bglFloatLt($val, _bglFloatNumtof($v)) }   /// True when this is less than `v`.
    emitter bool  operator <= (int v){ _bglFloatLe($val, _bglFloatNumtof($v)) }   /// True when this is at most `v`.
    emitter bool  operator >  (int v){ _bglFloatGt($val, _bglFloatNumtof($v)) }   /// True when this is greater than `v`.
    emitter bool  operator >= (int v){ _bglFloatGe($val, _bglFloatNumtof($v)) }   /// True when this is at least `v`.
    emitter float operator += (int v){ $val = $val + _bglFloatNumtof($v) }        /// Add `v` to the variable.
    emitter float operator -= (int v){ $val = $val - _bglFloatNumtof($v) }        /// Subtract `v` from the variable.
    emitter float operator *= (int v){ $val = $val * _bglFloatNumtof($v) }        /// Multiply the variable by `v`.
    emitter float operator /= (int v){ $val = $val / _bglFloatNumtof($v) }        /// Divide the variable by `v`.

    explicit emitter int operator(){ _bglFloatFtonumz($val) }  /// Convert to an `int`, truncating toward zero.
}

//-- Conversions and mixed arithmetic ----------------------------------------
extend extern class int {
    explicit emitter float operator(){ _bglFloatNumtof($val) }  /// Convert to a `float`.

    emitter float operator + (float v){ _bglFloatFadd(_bglFloatNumtof($val), $v) }  /// The sum.
    emitter float operator - (float v){ _bglFloatFsub(_bglFloatNumtof($val), $v) }  /// The difference.
    emitter float operator * (float v){ _bglFloatFmul(_bglFloatNumtof($val), $v) }  /// The product.
    emitter float operator / (float v){ _bglFloatFdiv(_bglFloatNumtof($val), $v) }  /// The quotient.
    emitter float operator % (float v){ _bglFloatFmod(_bglFloatNumtof($val), $v) }  /// The remainder.
    emitter bool  operator == (float v){ _bglFloatNumtof($val) == $v }              /// True when the values are equal.
    emitter bool  operator != (float v){ _bglFloatNumtof($val) ~= $v }              /// True when the values differ.
    emitter bool  operator <  (float v){ _bglFloatLt(_bglFloatNumtof($val), $v) }   /// True when this is less than `v`.
    emitter bool  operator <= (float v){ _bglFloatLe(_bglFloatNumtof($val), $v) }   /// True when this is at most `v`.
    emitter bool  operator >  (float v){ _bglFloatGt(_bglFloatNumtof($val), $v) }   /// True when this is greater than `v`.
    emitter bool  operator >= (float v){ _bglFloatGe(_bglFloatNumtof($val), $v) }   /// True when this is at least `v`.
}
extend extern class intLiteral {
    explicit emitter float operator(){ _bglFloatNumtof($val) }  /// Convert to a `float`.
}
extend extern class negativeIntLiteral {
    explicit emitter float operator(){ _bglFloatNumtof($val) }  /// Convert to a `float`.
}

//-- Implementation ------------------------------------------------------------
superposed float _bglFloatFadd(float x, float y){ float r; #i6 { @fadd x y r; } return r; }
superposed float _bglFloatFsub(float x, float y){ float r; #i6 { @fsub x y r; } return r; }
superposed float _bglFloatFmul(float x, float y){ float r; #i6 { @fmul x y r; } return r; }
superposed float _bglFloatFdiv(float x, float y){ float r; #i6 { @fdiv x y r; } return r; }
superposed float _bglFloatFmod(float x, float y){ float r; #i6 { @fmod x y r sp; } return r; }

superposed float _bglFloatNumtof(int n){ float r; #i6 { @numtof n r; } return r; }
superposed int   _bglFloatFtonumz(float f){ int r; #i6 { @ftonumz f r; } return r; }

superposed float _bglFloatSqrt(float v){ float r; #i6 { @sqrt v r; }  return r; }
superposed float _bglFloatExp(float v) { float r; #i6 { @exp v r; }   return r; }
superposed float _bglFloatLog(float v) { float r; #i6 { @log v r; }   return r; }
superposed float _bglFloatPow(float a, float b){ float r; #i6 { @pow a b r; } return r; }
superposed float _bglFloatSin(float v) { float r; #i6 { @sin v r; }   return r; }
superposed float _bglFloatCos(float v) { float r; #i6 { @cos v r; }   return r; }
superposed float _bglFloatTan(float v) { float r; #i6 { @tan v r; }   return r; }
superposed float _bglFloatAsin(float v){ float r; #i6 { @asin v r; }  return r; }
superposed float _bglFloatAcos(float v){ float r; #i6 { @acos v r; }  return r; }
superposed float _bglFloatAtan(float v){ float r; #i6 { @atan v r; }  return r; }
superposed float _bglFloatAtan2(float y, float x){ float r; #i6 { @atan2 y x r; } return r; }
superposed float _bglFloatCeil(float v) { float r; #i6 { @ceil v r; } return r; }
superposed float _bglFloatFloor(float v){ float r; #i6 { @floor v r; } return r; }

superposed float _bglFloatAbs(float v){
    if(_bglFloatLt(v, (float)0)) return (float)0 - v;
    return v;
}

// Comparisons; NaN compares false.
superposed bool _bglFloatLt(float x, float y){
    #i6 { @jflt x y ?yes; rfalse; .yes; rtrue; }
}
superposed bool _bglFloatLe(float x, float y){
    #i6 { @jfle x y ?yes; rfalse; .yes; rtrue; }
}
superposed bool _bglFloatGt(float x, float y){
    #i6 { @jfgt x y ?yes; rfalse; .yes; rtrue; }
}
superposed bool _bglFloatGe(float x, float y){
    #i6 { @jfge x y ?yes; rfalse; .yes; rtrue; }
}

// Prints a float as a decimal rounded to four places.
superposed void _bglFloatPrintDecimal(float v){
    bool isNeg = _bglFloatLt(v, (float)0);
    if(isNeg) v = (float)0 - v;
    v = v + 0.00005;   // round half up at the fourth place

    int ipart = (int)v;
    float frac = v - (float)ipart;
    int fdigits = (int)(frac * (float)10000);
    if(fdigits < 0) fdigits = -fdigits;
    if(fdigits > 9999) fdigits = 9999;

    if(isNeg && (ipart != 0 || fdigits != 0)) print("-");
    print(ipart);
    print(".");
    if(fdigits < 1000) print("0");
    if(fdigits < 100)  print("0");
    if(fdigits < 10)   print("0");
    print(fdigits);
}

//-- Float math ----------------------------------------------------------------
// Float forms of the bgl.util.math helpers.
extend class _bglMath {
    emitter float sqrt(float v)          { _bglFloatSqrt($v) }      /// Return the square root of `v`.
    emitter float exp(float v)           { _bglFloatExp($v) }       /// Return e raised to the power `v`.
    emitter float log(float v)           { _bglFloatLog($v) }       /// Return the natural logarithm of `v`.
    emitter float pow(float a, float b)  { _bglFloatPow($a, $b) }   /// Return `a` raised to the power `b`.
    emitter float sin(float v)           { _bglFloatSin($v) }       /// Return the sine of `v`, in radians.
    emitter float cos(float v)           { _bglFloatCos($v) }       /// Return the cosine of `v`, in radians.
    emitter float tan(float v)           { _bglFloatTan($v) }       /// Return the tangent of `v`, in radians.
    emitter float asin(float v)          { _bglFloatAsin($v) }      /// Return the arcsine of `v`, in radians.
    emitter float acos(float v)          { _bglFloatAcos($v) }      /// Return the arccosine of `v`, in radians.
    emitter float atan(float v)          { _bglFloatAtan($v) }      /// Return the arctangent of `v`, in radians.
    emitter float atan2(float y, float x){ _bglFloatAtan2($y, $x) } /// Return the arctangent of `y/x`, in radians, using both signs to find the quadrant.
    emitter float ceil(float v)          { _bglFloatCeil($v) }      /// Return `v` rounded up to a whole number.
    emitter float floor(float v)         { _bglFloatFloor($v) }     /// Return `v` rounded down to a whole number.
    emitter float abs(float v)           { _bglFloatAbs($v) }       /// Return the absolute value of `v`.
}

emitter void print(float c){ _bglFloatPrintDecimal($c); }  /// Print `c` as a decimal rounded to four places.
