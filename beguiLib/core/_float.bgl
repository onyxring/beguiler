#once
//=============================================================================
// type float — IEEE 754 single-precision, ALWAYS present on Glulx, no include.
//
// Glulx-only (the Z-machine has no float opcodes); this file is pulled into core
// under `#if TARGET_GLULX`. Everything is zero-cost until used: the `float` type
// and its operators/casts are emitters (they emit nothing of their own), and the
// backing routines are `superposed` (emitted only when a call site names them).
// A Glulx game that never touches float pays nothing.
//
// Storage is a single native word, same width as int; the operators reinterpret
// the bits as IEEE 754 single. Conversion to/from int is explicit only —
// (float)i and (int)f — using @numtof / @ftonumz. There is no implicit promotion;
// mixing a bare intLiteral with a float requires the cast (this catches
// `float x = 5;` errors, where the bit pattern of int 5 is a denormal ≈ 7e-45).
//
// The Glulx float opcodes (@fadd, @jflt, …) are statement/branch-form (they need
// a target slot or a branch), so each is wrapped in a `superposed` routine that
// returns a value; that lets the operator emitters be expression-form and compose
// under nested expressions like `(int)(a + b * c)`.
//=============================================================================


extern emitter class float : _bglObject {
    emitter int operator = (float v){ $target = $v; }

    // Arithmetic — call the standalone routines directly (these are emitters and
    // can't nest-call the _bglFloat facade, so they target the routines below).
    emitter float operator + (float v){ _bglFloatFadd($val, $v) }
    emitter float operator - (float v){ _bglFloatFsub($val, $v) }
    emitter float operator * (float v){ _bglFloatFmul($val, $v) }
    emitter float operator / (float v){ _bglFloatFdiv($val, $v) }
    emitter float operator % (float v){ _bglFloatFmod($val, $v) }

    // Equality — bit-equality (I6 `==`/`~=`). The hardware @jfeq opcode takes an
    // epsilon parameter which makes it awkward for strict comparison; bit-compare
    // is correct for the common case of matching a known value.
    emitter bool operator == (float v){ $val == $v }
    emitter bool operator != (float v){ $val ~= $v }

    // Comparison published for generic containers (array<T>.sort()). Without it sort()
    // falls back to a signed-word compare, which is WRONG for IEEE 754: negatives are
    // sign-magnitude, so they order backwards as signed words.
    static int operator <=> (var a, var b) {
        #i6 {
            if(_bglFloatLt(a, b)) return -1;
            if(_bglFloatGt(a, b)) return 1;
            return 0;
        }
        return 0;   // unreachable; satisfies return-check
    }

    // Ordering — Glulx @jflt/@jfle/@jfgt/@jfge are branch-form, so they live in
    // helper routines that return rtrue/rfalse.
    emitter bool operator <  (float v){ _bglFloatLt($val, $v) }
    emitter bool operator <= (float v){ _bglFloatLe($val, $v) }
    emitter bool operator >  (float v){ _bglFloatGt($val, $v) }
    emitter bool operator >= (float v){ _bglFloatGe($val, $v) }

    // Compound assignment — recurses through the scalar operators.
    emitter float operator += (float v){ $val = $val + $v }
    emitter float operator -= (float v){ $val = $val - $v }
    emitter float operator *= (float v){ $val = $val * $v }
    emitter float operator /= (float v){ $val = $val / $v }
    emitter float operator %= (float v){ $val = $val % $v }

    // Explicit cast: (int)f — truncate toward zero via @ftonumz. Use the raw
    // opcode bgl.asm.ftonumn() if nearest-even rounding is wanted instead.
    explicit emitter int operator(){ _bglFloatFtonumz($val) }
}

// Reverse cast: (float)i — @numtof on a regular int variable.
extend extern class int {
    explicit emitter float operator(){ _bglFloatNumtof($val) }
}
// Literal cast: (float)5 — explicit-only so `float x = 5;` errors out.
extend extern class intLiteral {
    explicit emitter float operator(){ _bglFloatNumtof($val) }
}
// Negative literal: (float)-3 — explicit cast required.
extend extern class negativeIntLiteral {
    explicit emitter float operator(){ _bglFloatNumtof($val) }
}

//=============================================================================
// Backing routines — all `superposed`, so each is emitted only when referenced.
// Each returns a value so the operator emitters above stay expression-form. The
// double-semicolon inside #i6 is harmless: the first ends the opcode, the second
// is the implicit statement terminator.
//=============================================================================
superposed float _bglFloatFadd(float x, float y){ float r; #i6 { @fadd x y r; } return r; }
superposed float _bglFloatFsub(float x, float y){ float r; #i6 { @fsub x y r; } return r; }
superposed float _bglFloatFmul(float x, float y){ float r; #i6 { @fmul x y r; } return r; }
superposed float _bglFloatFdiv(float x, float y){ float r; #i6 { @fdiv x y r; } return r; }
superposed float _bglFloatFmod(float x, float y){ float r; #i6 { @fmod x y r sp; } return r; }

superposed float _bglFloatNumtof(int n){ float r; #i6 { @numtof n r; } return r; }
superposed int   _bglFloatFtonumz(float f){ int r; #i6 { @ftonumz f r; } return r; }

superposed float _bglFloatSqrt(float v){ float r; #i6 { @sqrt v r; }  return r; }
superposed float _bglFloatExp(float v) { float r; #i6 { @exp v r; }   return r; }
superposed float _bglFloatLog(float v) { float r; #i6 { @log v r; }   return r; }
superposed float _bglFloatPow(float a, float b){ float r; #i6 { @pow a b r; } return r; }
superposed float _bglFloatSin(float v) { float r; #i6 { @sin v r; }   return r; }
superposed float _bglFloatCos(float v) { float r; #i6 { @cos v r; }   return r; }
superposed float _bglFloatTan(float v) { float r; #i6 { @tan v r; }   return r; }
superposed float _bglFloatAsin(float v){ float r; #i6 { @asin v r; }  return r; }
superposed float _bglFloatAcos(float v){ float r; #i6 { @acos v r; }  return r; }
superposed float _bglFloatAtan(float v){ float r; #i6 { @atan v r; }  return r; }
superposed float _bglFloatAtan2(float y, float x){ float r; #i6 { @atan2 y x r; } return r; }
superposed float _bglFloatCeil(float v) { float r; #i6 { @ceil v r; } return r; }
superposed float _bglFloatFloor(float v){ float r; #i6 { @floor v r; } return r; }

superposed float _bglFloatAbs(float v){
    if(_bglFloatLt(v, (float)0)) return (float)0 - v;
    return v;
}

// Ordering via the Glulx branch opcodes. NaN propagates as false through every branch.
superposed bool _bglFloatLt(float x, float y){
    #i6 { @jflt x y ?yes; rfalse; .yes; rtrue; }
    return false;   // unreachable; satisfies return-check
}
superposed bool _bglFloatLe(float x, float y){
    #i6 { @jfle x y ?yes; rfalse; .yes; rtrue; }
    return false;
}
superposed bool _bglFloatGt(float x, float y){
    #i6 { @jfgt x y ?yes; rfalse; .yes; rtrue; }
    return false;
}
superposed bool _bglFloatGe(float x, float y){
    #i6 { @jfge x y ?yes; rfalse; .yes; rtrue; }
    return false;
}

// Print `v` in decimal: sign, integer part, `.`, then 4 fractional digits. A simple
// display printer (not a full IEEE 754 round-trip); values beyond ±2.1e9 lose
// integer-part precision.
superposed void _bglFloatPrintDecimal(float v){
    bool isNeg = _bglFloatLt(v, (float)0);
    if(isNeg) v = (float)0 - v;

    int ipart = (int)v;
    float frac = v - (float)ipart;
    int fdigits = (int)(frac * (float)10000);
    if(fdigits < 0) fdigits = -fdigits;

    if(isNeg) print("-");
    print(ipart);
    print(".");
    if(fdigits < 1000) print("0");
    if(fdigits < 100)  print("0");
    if(fdigits < 10)   print("0");
    print(fdigits);
}

//=============================================================================
// _bglFloat — the nicely-named facade (float math functions: sqrt/sin/cos/…).
// Each method is an emitter that inlines to its `superposed` routine above, so
// the facade emits nothing on its own and only the called routines materialize.
//=============================================================================
emitter class _bglFloat {
    /// Add two floats (`x + y`). Backs the `+` operator.
    emitter float fadd(float x, float y){ _bglFloatFadd($x, $y) }
    /// Subtract (`x - y`). Backs the `-` operator.
    emitter float fsub(float x, float y){ _bglFloatFsub($x, $y) }
    /// Multiply (`x * y`). Backs the `*` operator.
    emitter float fmul(float x, float y){ _bglFloatFmul($x, $y) }
    /// Divide (`x / y`). Backs the `/` operator.
    emitter float fdiv(float x, float y){ _bglFloatFdiv($x, $y) }
    /// Floating-point remainder of `x / y`. Backs the `%` operator.
    emitter float fmod(float x, float y){ _bglFloatFmod($x, $y) }

    /// Convert an `int` to `float` (Glulx `@numtof`). Backs the `(float)i` cast.
    emitter float numtof(int n){ _bglFloatNumtof($n) }
    /// Convert a `float` to `int`, truncating toward zero (Glulx `@ftonumz`). Backs the `(int)f` cast.
    emitter int ftonumz(float f){ _bglFloatFtonumz($f) }

    /// Square root of `v`.
    emitter float sqrt(float v){ _bglFloatSqrt($v) }
    /// e raised to the power `v` (natural exponential).
    emitter float exp(float v) { _bglFloatExp($v) }
    /// Natural logarithm (base e) of `v`.
    emitter float log(float v) { _bglFloatLog($v) }
    /// `a` raised to the power `b`.
    emitter float pow(float a, float b){ _bglFloatPow($a, $b) }
    /// Sine of `v` (radians).
    emitter float sin(float v) { _bglFloatSin($v) }
    /// Cosine of `v` (radians).
    emitter float cos(float v) { _bglFloatCos($v) }
    /// Tangent of `v` (radians).
    emitter float tan(float v) { _bglFloatTan($v) }
    /// Arcsine of `v`, result in radians.
    emitter float asin(float v){ _bglFloatAsin($v) }
    /// Arccosine of `v`, result in radians.
    emitter float acos(float v){ _bglFloatAcos($v) }
    /// Arctangent of `v`, result in radians.
    emitter float atan(float v){ _bglFloatAtan($v) }
    /// Arctangent of `y/x` using the signs of both arguments to pick the quadrant, in radians.
    emitter float atan2(float y, float x){ _bglFloatAtan2($y, $x) }
    /// Smallest integer-valued float ≥ `v` (rounds up).
    emitter float ceil(float v) { _bglFloatCeil($v) }
    /// Largest integer-valued float ≤ `v` (rounds down).
    emitter float floor(float v){ _bglFloatFloor($v) }
    /// Absolute value of `v`.
    emitter float abs(float v){ _bglFloatAbs($v) }

    /// True if `x < y` (NaN compares false). Backs the `<` operator.
    emitter bool lt(float x, float y){ _bglFloatLt($x, $y) }
    /// True if `x <= y` (NaN compares false). Backs the `<=` operator.
    emitter bool le(float x, float y){ _bglFloatLe($x, $y) }
    /// True if `x > y` (NaN compares false). Backs the `>` operator.
    emitter bool gt(float x, float y){ _bglFloatGt($x, $y) }
    /// True if `x >= y` (NaN compares false). Backs the `>=` operator.
    emitter bool ge(float x, float y){ _bglFloatGe($x, $y) }

    /// Print `v` in decimal (sign, integer part, `.`, 4 fractional digits).
    emitter void printDecimal(float v){ _bglFloatPrintDecimal($v) }
}

// Overload print() for the float type so callers can pass a float directly.
emitter void print(float c){ _bglFloatPrintDecimal($c); }
