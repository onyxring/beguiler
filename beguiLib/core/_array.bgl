/* -----------------------------------------------------------------------------
    _array.bgl - Arrays
    Declares array<T> and rawArray<T>, the wrappers for native arrays. 
    This is installed by default.  #include <array> to add extended array 
    operations.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

/// A fixed-capacity array of `T`: `array<int> a[8]` or `array<int> a = {1,2,3}`.
extern emitter class array<T>{
    replace emitter T    operator[](int i)        { _bglAt($val, $i, 0)-->0 }       /// The element at `i`.
    replace emitter T    operator[]=(int i, T v)  { _bglAt($val, $i, 1)-->0 = $v }  /// Set the element at `i`.
    replace emitter int  size                     { _bglArrSize($val) }    /// How many elements the array can hold.
    typesealed arrayLength length;                                         /// How many elements are in use.
    /// Copy `v`'s elements into this array.
    emitter void operator = (array<T> v)          { _bglArrCopyFrom($self, $v, $opref(=)) }
}

/// An array's `length`: how many elements are in use.
extern emitter class arrayLength {
    emitter int operator()                        { _bglArrLength($self) } /// How many elements are in use.
}

/// A bare block of memory with no length; `rawArray<char>` holds bytes.
extern emitter class rawArray<T> {
    // The char forms must come first
    emitter char operator[](int i)          { $val->$i }        /// The byte at `i`.
    emitter char operator[]=(int i, char v) { $val->$i = $v }   /// Set the byte at `i`.
    emitter T    operator[](int i)          { $val-->$i }       /// The element at `i`.
    emitter T    operator[]=(int i, T v)    { $val-->$i = $v }  /// Set the element at `i`.
}

/// The type of `array<char>`: one byte per element, for text.
extern emitter class byteArray : array {
    replace emitter char operator[](int i)          { _bglByteAt($val, $i, 0)->0 }       /// The character at `i`.
    replace emitter char operator[]=(int i, char v) { _bglByteAt($val, $i, 1)->0 = $v }  /// Set the character at `i`.
    replace emitter int  size                       { (($val) + 0)-->(-1) }               /// How many characters the array can hold.
    replace typesealed byteArrayLength length;                                       /// How many characters the array holds.
    /// assign elements to an array<char>
    replace emitter void operator = (array<char> v) { $self = _bglByteArrAssign($self, $v) }
}

/// An `array<char>`'s `length`: how many characters are in use.
extern emitter class byteArrayLength {
    emitter int operator()  { $self-->0 }                    /// How many characters are in use.
}
//-- Implementation ------------------------------------------------------------
// Check subscripts: out of range prints an error and uses a scratch word
superposed rawArray<int> _bglSink[1];
superposed int _bglOutOfRange(int i, int n, bool isWrite){
    print("\n[Beguile run-time error: array index ", i, " is outside the ", n, " element");
    if(n != 1) print("s");
    print(" it ");
    if(isWrite) print("can hold"); else print("holds");
    print("; the ");
    if(isWrite) print("write"); else print("read");
    print(" is skipped]\n");
    _bglSink[0] = 0;
    return (int)_bglSink;
}
superposed int _bglAt(int arr, int i, bool isWrite){
    int n = _bglArrSize(arr);
    if(i >= 0 && i < n) return arr + (i + 1) * bgl.wordsize;
    return _bglOutOfRange(i, n, isWrite);
}
// Test for a Beguile array, which keeps a marker and its length ahead of its table
superposed bool _bglArrTracked(int arr){
    rawArray<int> a = (rawArray<int>)arr;
    if(arr == 0) return false;
    return a[-2] == $9084 && a[-1] >= 0 && a[-1] <= a[0];
}
superposed int _bglArrSize(int arr){
    return ((rawArray<int>)arr)[0];
}
superposed int _bglArrLength(int arr){
    rawArray<int> a = (rawArray<int>)arr;
    if(arr == 0) return 0;
    if(_bglArrTracked(arr)) return a[-1];
    return a[0];
}
superposed void _bglArrSetLength(int arr, int n){
    if(_bglArrTracked(arr)) ((rawArray<int>)arr)[-1] = n;
}
// Test for a returned local array, which must be copied to be kept
superposed bool _bglArrEphemeral(int arr){
    #i6 {
        #Ifdef _bglFramePoolWords;
            ! Addresses compare unsigned.
            if(_bglUnsignedCompare(arr, _bglFramePool + _bglFrameTop * WORDSIZE) >= 0
               && _bglUnsignedCompare(arr, _bglFramePool + _bglFramePoolWords * WORDSIZE) < 0) rtrue;
        #Endif;
        rfalse;
    }
}
superposed int _bglArrCopyInto(int dst, int src, func<int,int,int> assign = null){
    rawArray<int> d = (rawArray<int>)dst;
    rawArray<int> s = (rawArray<int>)src;
    int n = _bglArrLength(src);
    if(n > d[0]) n = d[0];
    for(int i = 1; i <= n; i++){
        if(assign) d[i] = assign(d[i], s[i]);
        else d[i] = s[i];
    }
    d[-1] = n;
    return dst;
}
// Copy where src may point at dst's own instances
superposed void _bglArrCopyShared(int dst, int src, func<int,int,int> assign){
    rawArray<int> d = (rawArray<int>)dst;
    rawArray<int> s = (rawArray<int>)src;
    int room = d[0];
    int n = _bglArrLength(src);
    int j = 0;
    int k = 0;
    int e = 0;
    int w = 0;
    if(n > room) n = room;
    for(int i = 1; i <= n; i++){
        e = s[i];
        for(j = i; j <= room; j++) if(d[j] == e) break;
        if(j > room){
            for(j = i; j <= room; j++){
                w = d[j];
                if(w == 0) break;
                for(k = i + 1; k <= n; k++) if(s[k] == w) break;
                if(k > n) break;
            }
            if(j > room) j = i;
        }
        w = d[i]; d[i] = d[j]; d[j] = w;
        if(d[i] != e) d[i] = assign(d[i], e);
    }
    d[-1] = n;
}
superposed int _bglArrCopyFrom(int dst, int src, func<int,int,int> assign = null){
    rawArray<int> d = (rawArray<int>)dst;
    rawArray<int> s = (rawArray<int>)src;
    if(dst == 0){ print("\n[Beguile run-time error: copying into an array that is null; bind it with := first]\n"); return 0; }
    if(d[-2] == $DEAD){ print("\n[Beguile run-time error: copying into an array that was freed]\n"); return dst; }
    if(src == 0 || dst == src) return dst;
    if(assign == _bglArrCopyAssign) assign = _bglArrCopyRow;
    if(_bglHeapBorrows(dst)){
        // A view of a struct array: copy into its instances
        if(assign && d[-1] > 0 && _bglMcObject(d[1])){
            int n = _bglArrLength(src);
            if(n > d[-1]) n = d[-1];
            for(int i = 1; i <= n; i++) assign(d[i], s[i]);
            if(_bglHeapIsFresh(src)) _bglHeapFree(src);
            return dst;
        }
        assign = null;   // no instances of its own: take the pointers
    }
    if(assign && _bglHeapBorrows(src)) _bglArrCopyShared(dst, src, assign);
    else _bglArrCopyInto(dst, src, assign);
    if(_bglHeapIsFresh(src)) _bglHeapFree(src);
    return dst;
}
// Assign an array of arrays
superposed int _bglArrCopyAssign(int cur, int src){
    if(cur == 0) return _bglHeapEscape(src);
    return _bglArrCopyFrom(cur, src);
}
// Assign a row of an array of arrays
superposed int _bglArrCopyRow(int cur, int src){
    if(cur != 0) return _bglArrCopyFrom(cur, src);
    if(src == 0 || _bglHeapIsFresh(src)) return _bglHeapEscape(src);
    return _bglHeapEscape(_bglHeapCopyOf(src));
}
superposed int _bglArrRowStore(int arr, int i, int src, func<int,int,int> assign){
    if(assign == _bglArrCopyAssign) assign = _bglArrCopyRow;
    rawArray<int> s = (rawArray<int>)_bglAt(arr, i, true);
    if(s != _bglSink) s[0] = assign(s[0], src);
    return 0;
}
superposed int _bglMemberArrCopy(var obj, var prop, int src, var assign = 0){
    int i = 0;
    int n = 0;
    int room = 0;
    #i6 {
        room = obj.#prop / WORDSIZE - 1;
        n = _bglArrLength(src);
        if(n > room) n = room;
        for(i = 0 : i < n : i++){
            if(assign) obj.&prop-->i = assign(obj.&prop-->i, src-->(i + 1));
            else obj.&prop-->i = src-->(i + 1);
        }
        obj.&prop-->room = n;
        return 0;
    }
}
superposed int _bglMemberArrCopyMember(var obj, var prop, var sobj, var sprop, var assign = 0){
    int i = 0;
    int n = 0;
    int room = 0;
    #i6 {
        room = obj.#prop / WORDSIZE - 1;
        n = sobj.&sprop-->(sobj.#sprop / WORDSIZE - 1);
        if(n > room) n = room;
        for(i = 0 : i < n : i++){
            if(assign) obj.&prop-->i = assign(obj.&prop-->i, sobj.&sprop-->i);
            else obj.&prop-->i = sobj.&sprop-->i;
        }
        obj.&prop-->room = n;
        return 0;
    }
}
superposed int _bglArrFromMember(int dst, var obj, var prop, var assign = 0){
    int i = 0;
    int n = 0;
    #i6 {
        if(dst == 0 || ~~_bglArrTracked(dst)) return dst;
        n = obj.&prop-->(obj.#prop / WORDSIZE - 1);
        if(n > dst-->0) n = dst-->0;
        for(i = 0 : i < n : i++){
            if(assign) dst-->(i + 1) = assign(dst-->(i + 1), obj.&prop-->i);
            else dst-->(i + 1) = obj.&prop-->i;
        }
        dst-->(-1) = n;
        return dst;
    }
}
superposed int _bglByteArrAssign(int dst, int src){
    if(src == 0 || dst == 0 || dst == src || !_bglArrEphemeral(src)) return src;
    return _bglByteArrCopyInto(dst, src);
}
superposed int _bglByteArrStore(int dst, int src){
    #i6 {
        if(src == 0 || dst == 0 || dst == src) return src;
        #Ifdef _bglFramePoolWords;
            if(_bglUnsignedCompare(src, _bglFramePool) >= 0
               && _bglUnsignedCompare(src, _bglFramePool + _bglFramePoolWords * WORDSIZE) < 0)
                return _bglByteArrCopyInto(dst, src);
        #Endif;
        return _bglByteArrAssign(dst, src);
    }
}
superposed int _bglByteArrCopyInto(int dst, int src){
    rawArray<int> d = (rawArray<int>)dst;
    rawArray<int> s = (rawArray<int>)src;
    rawArray<char> db = (rawArray<char>)dst;
    rawArray<char> sb = (rawArray<char>)src;
    int n = s[0];
    if(n > d[-1]) n = d[-1];
    for(int i = 0; i < n; i++) db[bgl.wordsize + i] = sb[bgl.wordsize + i];
    d[0] = n;
    return dst;
}
superposed int _bglByteAt(int arr, int i, bool isWrite){
    int n = ((rawArray<int>)arr)[-1];
    if(i >= 0 && i < n) return arr + bgl.wordsize + i;
    return _bglOutOfRange(i, n, isWrite);
}
// f is 1 for a write, plus 2 when the member keeps its length
superposed int _bglMemberAt(var obj, var prop, int i, int f){
    int n = 0;
    #i6 {
        n = obj.#prop / WORDSIZE;
        if(f & 2) n--;
        if(i >= 0 && i < n) return obj.&prop + i * WORDSIZE;
        return _bglOutOfRange(i, n, f & 1);
    }
}
