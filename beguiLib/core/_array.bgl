/* -----------------------------------------------------------------------------
    _array.bgl - Arrays
    Declares `array<T>`, the fixed-capacity array, and `rawArray<T>`, a bare
    block of memory for passing to and from Inform 6 code. `#include <array>`
    adds appending, sorting and the other array operations.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

/// A fixed-capacity array of `T`, declared sized (`array<int> a[8]`) or from a list (`array<int> a = {1,2,3}`).
extern emitter class array<T>{
    replace emitter T    operator[](int i)        { _bglAt($val, $i, 0)-->0 }       /// The element at `i`.
    replace emitter T    operator[]=(int i, T v)  { _bglAt($val, $i, 1)-->0 = $v }  /// Set the element at `i`.
    replace emitter int  size                     { _bglArrSize($val) }    /// How many elements the array can hold.
    typesealed arrayLength length;                                         /// How many elements are in use.
    /// Refer to `v`'s array. (Taking a function's returned local array copies it into this array's storage.)
    emitter void operator = (array<T> v)          { $self = _bglArrAssign($self, $v, $opref(=)) }
}

/// The type of an array's `length`: how many elements are in use. `<array>` makes it assignable.
extern emitter class arrayLength {
    emitter int operator()                        { _bglArrLength($self) } /// How many elements are in use.
}

/// A bare block of memory with no length, for passing to and from Inform 6 code; `rawArray<char>` holds bytes.
extern emitter class rawArray<T> {
    // The char forms come first: a subscript takes the first operator[] whose result type matches.
    emitter char operator[](int i)          { $val->$i }        /// The byte at `i`.
    emitter char operator[]=(int i, char v) { $val->$i = $v }   /// Set the byte at `i`.
    emitter T    operator[](int i)          { $val-->$i }       /// The element at `i`.
    emitter T    operator[]=(int i, T v)    { $val-->$i = $v }  /// Set the element at `i`.
}

/// The type of `array<char>`: one byte per element, for text.
extern emitter class byteArray : array {
    replace emitter char operator[](int i)          { _bglByteAt($val, $i, 0)->0 }       /// The character at `i`.
    replace emitter char operator[]=(int i, char v) { _bglByteAt($val, $i, 1)->0 = $v }  /// Set the character at `i`.
    replace emitter int  size                       { (($val) + 0)-->(-1) }               /// How many characters the array can hold.
    // Its own type, so byte arrays don't take `<array>`'s length, which suits word arrays only.
    replace typesealed byteArrayLength length;                                       /// How many characters the array holds.
    /// Refer to `v`'s array. (Taking a function's returned local array copies it into this array's storage.)
    replace emitter void operator = (array<char> v) { $self = _bglByteArrAssign($self, $v) }
}

/// The type of an `array<char>`'s `length`. `<buf>` makes it assignable.
extern emitter class byteArrayLength {
    emitter int operator()                          { $self-->0 }                    /// How many characters are in use.
}
//-- Implementation ------------------------------------------------------------
// Subscripts of an array<T> are checked against its size. Out of range, a message is printed and the
// access goes to a scratch word instead.
superposed rawArray<int> _bglSink[1];
superposed int _bglOutOfRange(int i, int n, int w){
    #i6 {
        print "^[Beguile run-time error: array index ", i, " is outside the ", n, " element";
        if(n ~= 1) print "s";
        print " it ";
        if(w) print "can hold"; else print "holds";
        print "; the ";
        if(w) print "write"; else print "read";
        print " is skipped]^";
        _bglSink-->0 = 0;
        return _bglSink;
    }
}
// The address of element `i` of a global or local array; `w` is 1 for a write.
superposed int _bglAt(int arr, int i, int w){
    int n = 0;
    #i6 {
        n = _bglArrSize(arr);
        if(i >= 0 && i < n) return arr + (i + 1) * WORDSIZE;
        return _bglOutOfRange(i, n, w);
    }
}
// A Beguile array is an I6 `table` (word 0 its capacity) preceded by two words: the marker $9084, then
// its length. An array Inform 6 declares has neither, and its length is its size.
superposed bool _bglArrTracked(int arr){
    #i6 {
        if(arr == 0) rfalse;
        if(arr-->(-2) == $9084 && arr-->(-1) >= 0 && arr-->(-1) <= arr-->0) rtrue;
        rfalse;
    }
}
// How many elements a global or local array can hold.
superposed int _bglArrSize(int arr){
    #i6 { return arr-->0; }
}
// How many elements of a global or local array are in use.
superposed int _bglArrLength(int arr){
    #i6 {
        if(_bglArrTracked(arr)) return arr-->(-1);
        return arr-->0;
    }
}
// Set how many elements of a global or local array are in use; an array Inform 6 declares has no length.
superposed void _bglArrSetLength(int arr, int n){
    #i6 { if(_bglArrTracked(arr)) arr-->(-1) = n; }
}
// A returned local array lies in frame space its routine has already given back: anything the program
// keeps of it is copied out. <linq> adds its scratch buffers by replacing this.
superposed bool _bglArrEphemeral(int arr){
    #i6 {
        #Ifdef _bglFramePoolWords;
            if(arr >= _bglFramePool + _bglFrameTop * WORDSIZE && arr < _bglFramePool + _bglFramePoolWords * WORDSIZE) rtrue;
        #Endif;
        rfalse;
    }
}
// `dst = src` on arrays: dst refers to src's array, unless src is ephemeral, when its elements and length
// are copied into dst's own storage (up to its capacity). `assign` is the element type's static
// `operator =` when its elements own instances: each is copied into dst's own slot rather than shared.
superposed int _bglArrAssign(int dst, int src, var assign = 0){
    int i = 0;
    int n = 0;
    #i6 {
        if(src == 0 || dst == 0 || dst == src || ~~_bglArrEphemeral(src) || ~~_bglArrTracked(dst)) return src;
        n = _bglArrLength(src);
        if(n > dst-->0) n = dst-->0;
        for(i = 1 : i <= n : i++){
            if(assign) dst-->i = assign(dst-->i, src-->i);
            else dst-->i = src-->i;
        }
        dst-->(-1) = n;
        return dst;
    }
}
// A whole member array assigned from `src` (until member arrays are references): src's elements and length,
// up to its capacity, copied into the property, whose last word is the length; `assign` as for _bglArrAssign.
superposed int _bglMemberArrCopy(var obj, var prop, int src, var assign = 0){
    int i = 0;
    int n = 0;
    int cap = 0;
    #i6 {
        cap = obj.#prop / WORDSIZE - 1;
        n = _bglArrLength(src);
        if(n > cap) n = cap;
        for(i = 0 : i < n : i++){
            if(assign) obj.&prop-->i = assign(obj.&prop-->i, src-->(i + 1));
            else obj.&prop-->i = src-->(i + 1);
        }
        obj.&prop-->cap = n;
        return 0;
    }
}
// One whole member array assigned from another (until member arrays are references).
superposed int _bglMemberArrCopyMember(var obj, var prop, var sobj, var sprop, var assign = 0){
    int i = 0;
    int n = 0;
    int cap = 0;
    #i6 {
        cap = obj.#prop / WORDSIZE - 1;
        n = sobj.&sprop-->(sobj.#sprop / WORDSIZE - 1);
        if(n > cap) n = cap;
        for(i = 0 : i < n : i++){
            if(assign) obj.&prop-->i = assign(obj.&prop-->i, sobj.&sprop-->i);
            else obj.&prop-->i = sobj.&sprop-->i;
        }
        obj.&prop-->cap = n;
        return 0;
    }
}
// `dst = obj.member` (until member arrays are references): the member's elements and length copied into dst's
// storage, up to its capacity. Returns dst.
superposed int _bglArrFromMember(int dst, var obj, var prop, var assign = 0){
    int i = 0;
    int n = 0;
    #i6 {
        if(dst == 0 || ~~_bglArrTracked(dst)) return dst;
        n = obj.&prop-->(obj.#prop / WORDSIZE - 1);
        if(n > dst-->0) n = dst-->0;
        for(i = 0 : i < n : i++){
            if(assign) dst-->(i + 1) = assign(dst-->(i + 1), obj.&prop-->i);
            else dst-->(i + 1) = obj.&prop-->i;
        }
        dst-->(-1) = n;
        return dst;
    }
}
// The same for an array<char>: its capacity is the word before it, its length word 0, its bytes after.
superposed int _bglByteArrAssign(int dst, int src){
    int i = 0;
    int n = 0;
    #i6 {
        if(src == 0 || dst == 0 || dst == src || ~~_bglArrEphemeral(src)) return src;
        n = src-->0;
        if(n > dst-->(-1)) n = dst-->(-1);
        for(i = 0 : i < n : i++) dst->(WORDSIZE + i) = src->(WORDSIZE + i);
        dst-->0 = n;
        return dst;
    }
}
// The address of character `i` of an array<char>, whose capacity is in the word before it.
superposed int _bglByteAt(int arr, int i, int w){
    int n = 0;
    #i6 {
        n = arr-->(-1);
        if(i >= 0 && i < n) return arr + WORDSIZE + i;
        return _bglOutOfRange(i, n, w);
    }
}
// The address of element `i` of an object's member array; `f` is 1 for a write, plus 2 when the
// member keeps its length in its last word.
superposed int _bglMemberAt(var obj, var prop, int i, int f){
    int n = 0;
    #i6 {
        n = obj.#prop / WORDSIZE;
        if(f & 2) n--;
        if(i >= 0 && i < n) return obj.&prop + i * WORDSIZE;
        return _bglOutOfRange(i, n, f & 1);
    }
}
