/* -----------------------------------------------------------------------------
    _glulxOpCodes.bgl - Glulx opcodes and Glk calls
    Provides the raw Glulx instructions and Glk calls as `bgl.asm`, and the Glk
    window, image and event types.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once
#if TARGET_ZCODE
    #error "ERROR: Glulx assembly binding are not compatible with Z-code."
#endif

// Short names under bgl.glulx.
extend _glulx{
    alias eWinType for eGlulxWindowType;            /// The kinds of Glk window.
    alias eImgAlign for eGlulxImageAlign;           /// Where an image sits in a text window.
    alias eImgDimension for eGlulxImageDimension;   /// Image size markers.
    alias bWinBorder for bGlulxWindowBorder;        /// Whether a new window has a border.
    alias bWinPlacement for bGlulxWindowPlacement;  /// Where a new window goes.
    alias bWinScale for bGlulxWindowScale;          /// How a new window's size is measured.
}

//-- Window, image and event types --------------------------------------------
bnum bGlulxWindowMethodFlags{ }   /// The window flags that combine in `windowOpen()`.

/// The kinds of Glk window.
enum eGlulxWindowType{
    textGrid = 4,     /// A grid of fixed-width characters, such as a status line.
    textBuffer = 3,   /// Flowing text, such as the main window.
    graphics = 5      /// A graphics window.
}
/// Where an image sits in a text window.
enum eGlulxImageAlign{
    inlineUp = 1,       /// In the line, its bottom on the baseline.
    inlineDown = 2,     /// In the line, its top level with the top of the line.
    inlineCenter = 3,   /// In the line, centered on it.
    marginLeft = 4,     /// In the left margin, with text flowing around it.
    marginRight = 5,    /// In the right margin, with text flowing around it.
}

/// Whether a new window has a border.
bnum bGlulxWindowBorder : bGlulxWindowMethodFlags{
    border = 0,       /// A border.
    noBorder = 256    /// No border.
}
/// Where a new window goes, relative to the window it splits.
bnum bGlulxWindowPlacement : bGlulxWindowMethodFlags{
    left = 0,    /// To the left.
    right = 1,   /// To the right.
    above = 2,   /// Above.
    below = 3    /// Below.
}
/// How a new window's size is measured.
bnum bGlulxWindowScale : bGlulxWindowMethodFlags{
    fixed = 16,         /// In lines, characters or pixels.
    proportional = 32   /// As a percentage of the window it splits.
}

/// Image size markers.
enum eGlulxImageDimension{
    original = -1,   /// The image's own size.
    scaled = -2      /// The scaled size.
}
/// The kinds of Glk event.
enum eGlulxEventType{
    none = 0,       /// No event.
    timer,          /// A timer fired.
    charInput,      /// A key was pressed.
    lineInput,      /// A line of input was entered.
    mouseInput,     /// The mouse was clicked.
    arrange,        /// Windows were resized.
    redraw,         /// A graphics window needs redrawing.
    soundNotify,    /// A sound finished.
    hyperlink,      /// A hyperlink was clicked.
    volumeNotify,   /// A volume change finished.
}

/// The raw Glulx instructions and Glk calls, reached as `bgl.asm`.
superposed class bglOpCodes {
    //-- Integer Math ----------------------------------------------------------
    emitter int add(int a, int b){ ($a + $b) }  /// Return `a + b` (`@add`).
    emitter int sub(int a, int b){ ($a - $b) }  /// Return `a - b` (`@sub`).
    emitter int mul(int a, int b){ ($a * $b) }  /// Return `a * b` (`@mul`).
    emitter int div(int a, int b){ ($a / $b) }  /// Return `a / b`, truncating (`@div`).
    emitter int mod(int a, int b){ ($a % $b) }  /// Return the remainder of `a / b` (`@mod`).
    emitter int neg(int a){ (-$a) }             /// Return `-a` (`@neg`).

    //-- Bitwise Operations ----------------------------------------------------
    emitter int bitand(int a, int b){ ($a & $b) }  /// Return the bitwise AND of `a` and `b` (`@bitand`).
    emitter int bitor(int a, int b){ ($a | $b) }   /// Return the bitwise OR of `a` and `b` (`@bitor`).
    static superposed int bitxor(int a, int b){ int result; #i6 { @bitxor a b result; } return result; }  /// Return the bitwise exclusive OR of `a` and `b` (`@bitxor`).
    emitter int bitnot(int a){ (~$a) }             /// Return the bitwise NOT of `a` (`@bitnot`).
    /// Shift `a` left by `b` bits (`@shiftl`). A shift of 32 or more gives 0, not a rotation.
    static superposed int shiftl(int a, int b){ int result; #i6 { @shiftl a b result; } return result; }
    /// Shift `a` right by `b` bits, carrying the SIGN bit down (`@sshiftr`) — arithmetic shift.
    static superposed int sshiftr(int a, int b){ int result; #i6 { @sshiftr a b result; } return result; }
    /// Shift `a` right by `b` bits, filling with ZEROS (`@ushiftr`) — logical shift.
    static superposed int ushiftr(int a, int b){ int result; #i6 { @ushiftr a b result; } return result; }

    //-- Memory Access ---------------------------------------------------------
    /// Read WORD `idx` at `addr` — a byte offset of `idx*4` (`@aload`).
    static superposed int aload(int addr, int idx){ int result; #i6 { @aload addr idx result; } return result; }
    /// Read 16-bit SHORT `idx` at `addr` (`@aloads`). Note the different stride from `aload`.
    static superposed int aloads(int addr, int idx){ int result; #i6 { @aloads addr idx result; } return result; }
    /// Read BYTE `idx` at `addr` (`@aloadb`).
    static superposed int aloadb(int addr, int idx){ int result; #i6 { @aloadb addr idx result; } return result; }
    /// Read BIT `idx` at `addr` (`@aloadbit`). The index may run past one byte, and may be negative.
    static superposed int aloadbit(int addr, int idx){ int result; #i6 { @aloadbit addr idx result; } return result; }
    /// Write word `idx` at `addr` (`@astore`).
    emitter void astore(int addr, int idx, int v) { @astore $addr $idx $v; }
    /// Write 16-bit short `idx` at `addr` (`@astores`).
    emitter void astores(int addr, int idx, int v){ @astores $addr $idx $v; }
    /// Write byte `idx` at `addr` (`@astoreb`).
    emitter void astoreb(int addr, int idx, int v){ @astoreb $addr $idx $v; }
    /// Write bit `idx` at `addr` (`@astorebit`).
    emitter void astorebit(int addr, int idx, int v){ @astorebit $addr $idx $v; }

    //-- Data Movement ---------------------------------------------------------
    emitter int copy(int v)              { @copy $v $target }  /// Return `v` unchanged (`@copy`).
    /// Sign-extend the low 16 bits of `v` to a full word (`@sexs`).
    static superposed int sexs(int v){ int result; #i6 { @sexs v result; } return result; }
    /// Sign-extend the low 8 bits of `v` to a full word (`@sexb`).
    static superposed int sexb(int v){ int result; #i6 { @sexb v result; } return result; }

    //-- Stack Operations ------------------------------------------------------
    /// How many values are on the stack above the current call frame (`@stkcount`).
    static superposed int stkcount(){ int result; #i6 { @stkcount result; } return result; }
    /// Read the stack `idx` values down from the top, without popping (`@stkpeek`).
    static superposed int stkpeek(int idx){ int result; #i6 { @stkpeek idx result; } return result; }
    /// Exchange the top two stack values (`@stkswap`).
    emitter void stkswap()               { @stkswap; }
    /// Rotate the top `count` stack values by `dir` places (`@stkroll`).
    emitter void stkroll(int count, int dir) { @stkroll $count $dir; }
    /// Push a copy of the top `count` stack values (`@stkcopy`).
    emitter void stkcopy(int count)      { @stkcopy $count; }

    //-- Function Calls --------------------------------------------------------
    static superposed int callf(int addr){ int result; #i6 { @callf addr result; } return result; }                                   /// Call the function at `addr` with no arguments and return its result (`@callf`).
    static superposed int callfi(int addr, int a){ int result; #i6 { @callfi addr a result; } return result; }                        /// Call the function at `addr` with `a` and return its result (`@callfi`).
    static superposed int callfii(int addr, int a, int b){ int result; #i6 { @callfii addr a b result; } return result; }             /// Call the function at `addr` with `a` and `b` and return its result (`@callfii`).
    static superposed int callfiii(int addr, int a, int b, int c){ int result; #i6 { @callfiii addr a b c result; } return result; }  /// Call the function at `addr` with `a`, `b` and `c` and return its result (`@callfiii`).

    //-- I/O -------------------------------------------------------------------
    emitter void streamchar(int ch)      { @streamchar $ch; }      /// Print the character `ch` (`@streamchar`).
    emitter void streamchar(char ch)     { @streamchar $ch; }      /// Print the character `ch` (`@streamchar`).
    emitter void streamnum(int n)        { @streamnum $n; }        /// Print `n` as a signed number (`@streamnum`).
    emitter void streamstr(int addr)     { @streamstr $addr; }     /// Print the string at `addr` (`@streamstr`).
    emitter void streamunichar(int ch)   { @streamunichar $ch; }   /// Print the Unicode character `ch` (`@streamunichar`).
    static superposed int getstringtbl(){ int result; #i6 { @getstringtbl result; } return result; }  /// Return the address of the string-decoding table (`@getstringtbl`).
    emitter void setstringtbl(int addr)  { @setstringtbl $addr; }  /// Use the string-decoding table at `addr` (`@setstringtbl`).

    //-- Memory Management -----------------------------------------------------
    /// The current size of memory in bytes (`@getmemsize`).
    static superposed int getmemsize(){ int result; #i6 { @getmemsize result; } return result; }
    /// Grow or shrink memory to `size` bytes (`@setmemsize`). Non-zero on failure. Invalid while `malloc` blocks are live.
    static superposed int setmemsize(int size){ int result; #i6 { @setmemsize size result; } return result; }
    /// Allocate `size` bytes from the heap and return the address, or 0 (`@malloc`).
    static superposed int malloc(int size){ int result; #i6 { @malloc size result; } return result; }
    /// Return a `malloc` block to the heap (`@mfree`).
    emitter void mfree(int addr)         { @mfree $addr; }
    /// Zero `count` bytes starting at `addr` (`@mzero`).
    emitter void mzero(int count, int addr) { @mzero $count $addr; }
    /// Copy `count` bytes from `src` to `dst` (`@mcopy`). Overlapping regions copy correctly.
    emitter void mcopy(int count, int src, int dst) { @mcopy $count $src $dst; }

    //-- Searching -------------------------------------------------------------
    /// Walk an array of fixed-size structures looking for `key` (`@linearsearch`). `keySize` is 1, 2 or 4 bytes; `options` bit 0 says the key is passed by address, bit 1 returns the index instead of the address, bit 2 stops at a zero key.
    static superposed int linearsearch(int key, int keySize, int start, int structSize, int numStructs, int keyOffset, int options){ int result; #i6 { @linearsearch key keySize start structSize numStructs keyOffset options result; } return result; }
    /// As `linearsearch`, but the structures must already be sorted by key (`@binarysearch`).
    static superposed int binarysearch(int key, int keySize, int start, int structSize, int numStructs, int keyOffset, int options){ int result; #i6 { @binarysearch key keySize start structSize numStructs keyOffset options result; } return result; }
    /// Walk a linked list looking for `key`, following the pointer at `nextOffset` (`@linkedsearch`).
    static superposed int linkedsearch(int key, int keySize, int start, int keyOffset, int nextOffset, int options){ int result; #i6 { @linkedsearch key keySize start keyOffset nextOffset options result; } return result; }

    //-- Random Numbers --------------------------------------------------------
    static superposed int random(int range){ int result; #i6 { @random range result; } return result; }  /// Return a random number: 0 to `range`-1 for a positive `range`, any value for 0 (`@random`).
    emitter void setrandom(int seed)     { @setrandom $seed; }                                           /// Seed the random-number generator; 0 seeds it unpredictably (`@setrandom`).

    //-- Game State ------------------------------------------------------------
    emitter void quit()                  { @quit; }     /// End the game immediately (`@quit`).
    emitter void restart()               { @restart; }  /// Restart the game (`@restart`).
    /// Save the game state to a stream (`@save`). 0 on success, 1 on failure, and 2 in the branch that resumes from `restore`.
    static superposed int save(int stream){ int result; #i6 { @save stream result; } return result; }
    /// Restore a saved state from a stream (`@restore`). Does not return here on success — execution resumes inside the `save` that wrote it.
    static superposed int restore(int stream){ int result; #i6 { @restore stream result; } return result; }
    /// Take an undo snapshot (`@saveundo`). Same return convention as `save`.
    static superposed int saveundo(){ int result; #i6 { @saveundo result; } return result; }
    /// Go back to the last snapshot (`@restoreundo`). Does not return here on success.
    static superposed int restoreundo(){ int result; #i6 { @restoreundo result; } return result; }
    /// Mark a range to survive `restore` and `restoreundo` (`@protect`). One range at a time; a length of 0 clears it.
    emitter void protect(int addr, int len) { @protect $addr $len; }
    /// Check the story file against its header checksum (`@verify`). 0 when intact.
    static superposed int verify(){ int result; #i6 { @verify result; } return result; }

    //-- System ----------------------------------------------------------------
    /// Signal the interpreter's debugger (`@debugtrap`). Does nothing in an ordinary interpreter.
    emitter void debugtrap(int val)      { @debugtrap $val; }
    /// Call a Glk function by selector, with `argc` arguments already pushed on the stack (`@glk`). The typed wrappers below are the ones to reach for.
    emitter int glk(int sel, int argc)   { @glk $sel $argc $target }

    //-- I/O System ------------------------------------------------------------
    /// Choose where output goes: 0 null, 1 the interpreter's filter, 2 Glk (`@setiosys`).
    emitter void setiosys(int mode, int rock) { @setiosys $mode $rock; }

    //-- Floating-Point Math ---------------------------------------------------
    /// Convert an integer to a float, preserving its value (`@numtof`).
    static superposed int numtof(int n){ int result; #i6 { @numtof n result; } return result; }
    /// Convert a float to an integer, truncating toward zero (`@ftonumz`).
    static superposed int ftonumz(int f){ int result; #i6 { @ftonumz f result; } return result; }
    /// Convert a float to an integer, rounding to nearest (`@ftonumn`).
    static superposed int ftonumn(int f){ int result; #i6 { @ftonumn f result; } return result; }
    static superposed int fadd(int a, int b){ int result; #i6 { @fadd a b result; } return result; }  /// Return the float sum `a + b` (`@fadd`).
    static superposed int fsub(int a, int b){ int result; #i6 { @fsub a b result; } return result; }  /// Return the float difference `a - b` (`@fsub`).
    static superposed int fmul(int a, int b){ int result; #i6 { @fmul a b result; } return result; }  /// Return the float product `a * b` (`@fmul`).
    static superposed int fdiv(int a, int b){ int result; #i6 { @fdiv a b result; } return result; }  /// Return the float quotient `a / b` (`@fdiv`).
    /// The smallest whole number not less than `f`, still as a float (`@ceil`).
    static superposed int ceil(int f){ int result; #i6 { @ceil f result; } return result; }
    /// The largest whole number not greater than `f`, still as a float (`@floor`).
    static superposed int floor(int f){ int result; #i6 { @floor f result; } return result; }
    static superposed int sqrt(int f){ int result; #i6 { @sqrt f result; } return result; }             /// Return the square root of float `f` (`@sqrt`).
    static superposed int exp(int f){ int result; #i6 { @exp f result; } return result; }               /// Return e raised to float `f` (`@exp`).
    static superposed int log(int f){ int result; #i6 { @log f result; } return result; }               /// Return the natural logarithm of float `f` (`@log`).
    static superposed int pow(int a, int b){ int result; #i6 { @pow a b result; } return result; }      /// Return float `a` raised to the power `b` (`@pow`).
    static superposed int sin(int f){ int result; #i6 { @sin f result; } return result; }               /// Return the sine of float `f`, in radians (`@sin`).
    static superposed int cos(int f){ int result; #i6 { @cos f result; } return result; }               /// Return the cosine of float `f`, in radians (`@cos`).
    static superposed int tan(int f){ int result; #i6 { @tan f result; } return result; }               /// Return the tangent of float `f`, in radians (`@tan`).
    static superposed int asin(int f){ int result; #i6 { @asin f result; } return result; }             /// Return the arcsine of float `f`, in radians (`@asin`).
    static superposed int acos(int f){ int result; #i6 { @acos f result; } return result; }             /// Return the arccosine of float `f`, in radians (`@acos`).
    static superposed int atan(int f){ int result; #i6 { @atan f result; } return result; }             /// Return the arctangent of float `f`, in radians (`@atan`).
    static superposed int atan2(int a, int b){ int result; #i6 { @atan2 a b result; } return result; }  /// Return the arctangent of `a/b`, in radians, using both signs to find the quadrant (`@atan2`).

    //-- Acceleration ----------------------------------------------------------
    /// Ask the interpreter to run its own fast version of the routine at `addr` (`@accelfunc`). A speed-up only; the behaviour must match.
    emitter void accelfunc(int idx, int addr) { @accelfunc $idx $addr; }
    /// Give the accelerated functions a parameter they need, such as the address of a class (`@accelparam`).
    emitter void accelparam(int idx, int val) { @accelparam $idx $val; }





