#once
#if TARGET_ZCODE
    #error "ERROR: Glulx assembly binding are not compatible with Z-code."
#endif

// _glulx is the backing for namespace object bgl.glulx
extend _glulx{      
    alias eWinType for eGlulxWindowType;  
    alias eImgAlign for eGlulxImageAlign; 
    alias eImgDimension for eGlulxImageDimension; 
    alias bWinBorder for bGlulxWindowBorder; 
    alias bWinPlacement for bGlulxWindowPlacement; 
    alias bWinScale for bGlulxWindowScale;  
}

//=============================================================================
// Glulx window/image enums and bnums — referenced by typed bglOpCodes overloads
// (e.g. windowOpen). Kept in core so the typed overloads compile without
// requiring callers to include glulxWindow.bgl.
//=============================================================================
bnum bGlulxWindowMethodFlags{ } //a container to define compatible bnums which can be legally be combined

enum eGlulxWindowType{
    textGrid = 4,
    textBuffer = 3,
    graphics = 5
}
enum eGlulxImageAlign{
    inlineUp = 1,
    inlineDown = 2,
    inlineCenter = 3,
    marginLeft = 4,
    marginRight = 5,
    //marginCenter = 6
}

bnum bGlulxWindowBorder : bGlulxWindowMethodFlags{
    border = 0,
    noBorder = 256
}
bnum bGlulxWindowPlacement : bGlulxWindowMethodFlags{
    left = 0,
    right = 1,
    above = 2,
    below = 3
}
bnum bGlulxWindowScale : bGlulxWindowMethodFlags{
    fixed = 16,
    proportional = 32
}

enum eGlulxImageDimension{
    original = -1,
    scaled = -2
}
enum eGlulxEventType{
    none = 0,
    timer, 
    charInput, 
    lineInput, 
    mouseInput, 
    arrange,
    redraw,
    soundNotify, 
    hyperlink,
    volumeNotify, 
}

superposed class bglOpCodes {
    //── Integer Math ────────────────────────────────────────────────────
    emitter int add(int a, int b){ ($a + $b) }
    emitter int sub(int a, int b){ ($a - $b) }
    emitter int mul(int a, int b){ ($a * $b) }
    emitter int div(int a, int b){ ($a / $b) }
    emitter int mod(int a, int b){ ($a % $b) }
    emitter int neg(int a){ (-$a) }

    //── Bitwise Operations ──────────────────────────────────────────────
    emitter int bitand(int a, int b){ ($a & $b) }
    emitter int bitor(int a, int b){ ($a | $b) }
    static superposed int bitxor(int a, int b){ int result; #i6 { @bitxor a b result; } return result; }
    emitter int bitnot(int a){ (~$a) }
    static superposed int shiftl(int a, int b){ int result; #i6 { @shiftl a b result; } return result; }
    static superposed int sshiftr(int a, int b){ int result; #i6 { @sshiftr a b result; } return result; }
    static superposed int ushiftr(int a, int b){ int result; #i6 { @ushiftr a b result; } return result; }

    //── Memory Access ───────────────────────────────────────────────────
    static superposed int aload(int addr, int idx){ int result; #i6 { @aload addr idx result; } return result; }
    static superposed int aloads(int addr, int idx){ int result; #i6 { @aloads addr idx result; } return result; }
    static superposed int aloadb(int addr, int idx){ int result; #i6 { @aloadb addr idx result; } return result; }
    static superposed int aloadbit(int addr, int idx){ int result; #i6 { @aloadbit addr idx result; } return result; }
    emitter void astore(int addr, int idx, int v) { @astore $addr $idx $v; }
    emitter void astores(int addr, int idx, int v){ @astores $addr $idx $v; }
    emitter void astoreb(int addr, int idx, int v){ @astoreb $addr $idx $v; }
    emitter void astorebit(int addr, int idx, int v){ @astorebit $addr $idx $v; }

    //── Data Movement ───────────────────────────────────────────────────
    emitter int copy(int v)              { @copy $v $target }
    static superposed int sexs(int v){ int result; #i6 { @sexs v result; } return result; }
    static superposed int sexb(int v){ int result; #i6 { @sexb v result; } return result; }

    //── Stack Operations ────────────────────────────────────────────────
    static superposed int stkcount(){ int result; #i6 { @stkcount result; } return result; }
    static superposed int stkpeek(int idx){ int result; #i6 { @stkpeek idx result; } return result; }
    emitter void stkswap()               { @stkswap; }
    emitter void stkroll(int count, int dir) { @stkroll $count $dir; }
    emitter void stkcopy(int count)      { @stkcopy $count; }

    //── Function Calls ──────────────────────────────────────────────────
    static superposed int callf(int addr){ int result; #i6 { @callf addr result; } return result; }
    static superposed int callfi(int addr, int a){ int result; #i6 { @callfi addr a result; } return result; }
    static superposed int callfii(int addr, int a, int b){ int result; #i6 { @callfii addr a b result; } return result; }
    static superposed int callfiii(int addr, int a, int b, int c){ int result; #i6 { @callfiii addr a b c result; } return result; }

    //── I/O ─────────────────────────────────────────────────────────────
    emitter void streamchar(int ch)      { @streamchar $ch; }
    emitter void streamnum(int n)        { @streamnum $n; }
    emitter void streamstr(int addr)     { @streamstr $addr; }
    emitter void streamunichar(int ch)   { @streamunichar $ch; }
    static superposed int getstringtbl(){ int result; #i6 { @getstringtbl result; } return result; }
    emitter void setstringtbl(int addr)  { @setstringtbl $addr; }

    //── Memory Management ───────────────────────────────────────────────
    static superposed int getmemsize(){ int result; #i6 { @getmemsize result; } return result; }
    static superposed int setmemsize(int size){ int result; #i6 { @setmemsize size result; } return result; }
    static superposed int malloc(int size){ int result; #i6 { @malloc size result; } return result; }
    emitter void mfree(int addr)         { @mfree $addr; }
    emitter void mzero(int count, int addr) { @mzero $count $addr; }
    emitter void mcopy(int count, int src, int dst) { @mcopy $count $src $dst; }

    //── Searching ───────────────────────────────────────────────────────
    static superposed int linearsearch(int key, int keySize, int start, int structSize, int numStructs, int keyOffset, int options){ int result; #i6 { @linearsearch key keySize start structSize numStructs keyOffset options result; } return result; }
    static superposed int binarysearch(int key, int keySize, int start, int structSize, int numStructs, int keyOffset, int options){ int result; #i6 { @binarysearch key keySize start structSize numStructs keyOffset options result; } return result; }
    static superposed int linkedsearch(int key, int keySize, int start, int keyOffset, int nextOffset, int options){ int result; #i6 { @linkedsearch key keySize start keyOffset nextOffset options result; } return result; }

    //── Random Numbers ──────────────────────────────────────────────────
    static superposed int random(int range){ int result; #i6 { @random range result; } return result; }
    emitter void setrandom(int seed)     { @setrandom $seed; }

    //── Game State ──────────────────────────────────────────────────────
    emitter void quit()                  { @quit; }
    emitter void restart()               { @restart; }
    static superposed int save(int stream){ int result; #i6 { @save stream result; } return result; }
    static superposed int restore(int stream){ int result; #i6 { @restore stream result; } return result; }
    static superposed int saveundo(){ int result; #i6 { @saveundo result; } return result; }
    static superposed int restoreundo(){ int result; #i6 { @restoreundo result; } return result; }
    emitter void protect(int addr, int len) { @protect $addr $len; }
    static superposed int verify(){ int result; #i6 { @verify result; } return result; }

    //── System ──────────────────────────────────────────────────────────
    //emitter int gestalt(int sel, int val) { @gestalt $sel $val $target }
    emitter void debugtrap(int val)      { @debugtrap $val; }
    emitter int glk(int sel, int argc)   { @glk $sel $argc $target }

    //── I/O System ──────────────────────────────────────────────────────
    emitter void setiosys(int mode, int rock) { @setiosys $mode $rock; }

    //── Floating-Point Math ─────────────────────────────────────────────
    static superposed int numtof(int n){ int result; #i6 { @numtof n result; } return result; }
    static superposed int ftonumz(int f){ int result; #i6 { @ftonumz f result; } return result; }
    static superposed int ftonumn(int f){ int result; #i6 { @ftonumn f result; } return result; }
    static superposed int fadd(int a, int b){ int result; #i6 { @fadd a b result; } return result; }
    static superposed int fsub(int a, int b){ int result; #i6 { @fsub a b result; } return result; }
    static superposed int fmul(int a, int b){ int result; #i6 { @fmul a b result; } return result; }
    static superposed int fdiv(int a, int b){ int result; #i6 { @fdiv a b result; } return result; }
    static superposed int ceil(int f){ int result; #i6 { @ceil f result; } return result; }
    static superposed int floor(int f){ int result; #i6 { @floor f result; } return result; }
    static superposed int sqrt(int f){ int result; #i6 { @sqrt f result; } return result; }
    static superposed int exp(int f){ int result; #i6 { @exp f result; } return result; }
    static superposed int log(int f){ int result; #i6 { @log f result; } return result; }
    static superposed int pow(int a, int b){ int result; #i6 { @pow a b result; } return result; }
    static superposed int sin(int f){ int result; #i6 { @sin f result; } return result; }
    static superposed int cos(int f){ int result; #i6 { @cos f result; } return result; }
    static superposed int tan(int f){ int result; #i6 { @tan f result; } return result; }
    static superposed int asin(int f){ int result; #i6 { @asin f result; } return result; }
    static superposed int acos(int f){ int result; #i6 { @acos f result; } return result; }
    static superposed int atan(int f){ int result; #i6 { @atan f result; } return result; }
    static superposed int atan2(int a, int b){ int result; #i6 { @atan2 a b result; } return result; }

    //── Acceleration ────────────────────────────────────────────────────
    emitter void accelfunc(int idx, int addr) { @accelfunc $idx $addr; }
    emitter void accelparam(int idx, int val) { @accelparam $idx $val; }





