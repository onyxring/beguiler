    emitter void exit(){
        __glkHook(1)
    }

    /// Tell the interpreter a turn has passed, so it can update its display (`@tick`).
    emitter void tick(){
        __glkHook(3)
    }

    /// Ask the interpreter about a capability (`@gestalt`). `a` is the selector, `b` its argument.
    emitter int gestalt(int a, int b){
        __glkHook(4, $a, $b)
    }

    emitter int gestaltExt(int a, int b, int c, int d){
        __glkHook(5, $a, $b, $c, $d)
    }

    emitter int windowIterate(int a, int b){
        __glkHook(32, $a, $b)
    }

    emitter int windowGetRock(int a){
        __glkHook(33, $a)
    }

    /// The window everything else was split from, or 0 before any window is open.
    emitter int windowGetRoot(){
        __glkHook(34)
    }
    emitter int windowOpen(int splitWinId, eGlulxWindowType type, int size, bGlulxWindowMethodFlags winMethod=noBorder, int winRock=0){
        __glkHook(35, $splitWinId, $winMethod, $size, $type, $winRock)
    }

    emitter void windowClose(int a, int b){
        __glkHook(36, $a, $b)
    }

    /// Measure window `a`, writing its width to the address `b` and its height to `c`. Cells for a grid window, pixels for a graphics one.
    emitter void windowGetSize(int a, int b, int c){
        __glkHook(37, $a, $b, $c)
    }

    /// Re-split the PAIR window `a`: `b` is the method flags, `c` the size, `d` which child keeps it.
    emitter void windowSetArrangement(int a, int b, int c, int d){
        __glkHook(38, $a, $b, $c, $d)
    }

    /// Read back a pair window's split: method to address `b`, size to `c`, key child to `d`.
    emitter void windowGetArrangement(int a, int b, int c, int d){
        __glkHook(39, $a, $b, $c, $d)
    }

    emitter int windowGetType(int a){
        __glkHook(40, $a)
    }

    /// The pair window holding `a`, or 0 for the root.
    emitter int windowGetParent(int a){
        __glkHook(41, $a)
    }

    emitter void windowClear(int a){
        __glkHook(42, $a)
    }

    /// Put the cursor of grid window `a` at column `b`, line `c`. Counts from 0 here, unlike the Beguile wrapper.
    emitter void windowMoveCursor(int a, int b, int c){
        __glkHook(43, $a, $b, $c)
    }

    /// The stream that window `a` prints to.
    emitter int windowGetStream(int a){
        __glkHook(44, $a)
    }

    /// Copy everything printed to window `a` into stream `b` as well — a transcript.
    emitter void windowSetEchoStream(int a, int b){
        __glkHook(45, $a, $b)
    }

    emitter int windowGetEchoStream(int a){
        __glkHook(46, $a)
    }

    /// Send later output to window `a` by making its stream current.
    emitter void setWindow(int a){
        __glkHook(47, $a)
    }

    /// The other child of `a`'s parent pair.
    emitter int windowGetSibling(int a){
        __glkHook(48, $a)
    }

    emitter int streamIterate(int a, int b){
        __glkHook(64, $a, $b)
    }

    emitter int streamGetRock(int a){
        __glkHook(65, $a)
    }

    emitter int streamOpenFile(int a, int b, int c){
        __glkHook(66, $a, $b, $c)
    }

    /// Open a stream writing into the buffer at `a`, `b` bytes long. `c` is the file mode, `d` a rock. Printing to it captures text instead of showing it.
    emitter int streamOpenMemory(int a, int b, int c, int d){
        __glkHook(67, $a, $b, $c, $d)
    }

    /// Close stream `a`, writing its read and write counts to the address `b`. For a memory stream, `b` is how you learn how much was written.
    emitter void streamClose(int a, int b){
        __glkHook(68, $a, $b)
    }

    /// Seek in stream `a` to offset `b`, relative to `c`: 0 start, 1 current, 2 end.
    emitter void streamSetPosition(int a, int b, int c){
        __glkHook(69, $a, $b, $c)
    }

    /// The current offset in stream `a`.
    emitter int streamGetPosition(int a){
        __glkHook(70, $a)
    }

    /// Choose which stream plain output goes to.
    emitter void streamSetCurrent(int a){
        __glkHook(71, $a)
    }

    /// The stream plain output currently goes to — save it before redirecting.
    emitter int streamGetCurrent(){
        __glkHook(72)
    }

    emitter int streamOpenResource(int a, int b){
        __glkHook(73, $a, $b)
    }

    emitter int filerefCreateTemp(int a, int b){
        __glkHook(96, $a, $b)
    }

    emitter int filerefCreateByName(int a, int b, int c){
        __glkHook(97, $a, $b, $c)
    }

    emitter int filerefCreateByPrompt(int a, int b, int c){
        __glkHook(98, $a, $b, $c)
    }

    emitter void filerefDestroy(int a){
        __glkHook(99, $a)
    }

    emitter int filerefIterate(int a, int b){
        __glkHook(100, $a, $b)
    }

    emitter int filerefGetRock(int a){
        __glkHook(101, $a)
    }

    emitter void filerefDeleteFile(int a){
        __glkHook(102, $a)
    }

    emitter int filerefDoesFileExist(int a){
        __glkHook(103, $a)
    }

    emitter int filerefCreateFromFileref(int a, int b, int c){
        __glkHook(104, $a, $b, $c)
    }

    emitter void putChar(int a){
        __glkHook(128, $a)
    }

    emitter void putCharStream(int a, int b){
        __glkHook(129, $a, $b)
    }

    emitter void putString(int a){
        __glkHook(130, $a)
    }

    emitter void putStringStream(int a, int b){
        __glkHook(131, $a, $b)
    }

    /// Print `b` characters from the buffer at `a` — the fast path for text already in memory.
    emitter void putBuffer(int a, int b){
        __glkHook(132, $a, $b)
    }

    emitter void putBufferStream(int a, int b, int c){
        __glkHook(133, $a, $b, $c)
    }

    emitter void setStyle(int a){
        __glkHook(134, $a)
    }

    emitter void setStyleStream(int a, int b){
        __glkHook(135, $a, $b)
    }

    /// Read one character from stream `a`, or -1 at the end.
    emitter int getCharStream(int a){
        __glkHook(144, $a)
    }

    /// Read a line from stream `a` into the buffer at `b`, at most `c` bytes.
    emitter int getLineStream(int a, int b, int c){
        __glkHook(145, $a, $b, $c)
    }

    emitter int getBufferStream(int a, int b, int c){
        __glkHook(146, $a, $b, $c)
    }

    emitter int charToLower(int a){
