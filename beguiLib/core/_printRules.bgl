/* -----------------------------------------------------------------------------
    _printRules.bgl - Print rules
    Provides `bgl.printRules`, the text styles and articles used in interpolated
    text: `print($"The troll {italics}hit{roman} the table.")` after
    `#using bgl.printRules;`.

    Copyright (c) 2024-2026 Jim Fisher (OnyxRing). MIT License.
   -----------------------------------------------------------------------------*/
#once

/// Text styles and articles for interpolated text.
superposed _bglObject _bglPrintRules {
    //-- Styles ----------------------------------------------------------------
    emitter void bold      { style bold; }        /// Switch to bold; a style stays on until another rule changes it.
    emitter void roman     { style roman; }       /// Switch back to plain text.
    emitter void italics   { style underline; }   /// Switch to italics, or underline where the interpreter has no italic face.
    emitter void underline { style underline; }   /// Switch to underline, the same style as `italics`.
    emitter void reverse   { style reverse; }     /// Switch to reverse video.
    emitter void fixed     { style fixed; }       /// Switch to a fixed-pitch face.

    //-- Articles --------------------------------------------------------------
    emitter void a   (object o){ print (a)$o;   }   /// Print `o` with an indefinite article: "a lamp", "an apple".
    emitter void cA  (object o){ print (A)$o;   }   /// Print `o` with a capitalized indefinite article: "A lamp".
    emitter void the (object o){ print (the)$o; }   /// Print `o` with a definite article: "the lamp".
    emitter void cThe(object o){ print (The)$o; }   /// Print `o` with a capitalized definite article: "The lamp".
}

extend bgl {
    alias printRules = _bglPrintRules;   /// Text styles and articles for interpolated text.
}
