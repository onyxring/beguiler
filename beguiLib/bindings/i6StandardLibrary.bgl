extern verb Rub       { .rub|.shine|.polish|.sweep|.clean|.dust|.wipe|.scrub }  /// rub noun
extern verb Search    { .search }                                               /// search noun
extern verb Set       { .set|.adjust }                                          /// set noun
extern verb SetTo     { .set|.adjust }                                          /// set noun to second
extern verb Show      { .show|.present|.display }                               /// show noun to second
extern verb Sing      { .sing }                                                 /// sing
extern verb Sleep     { .sleep|.nap }                                           /// sleep
extern verb Smell     { .smell|.sniff }                                         /// smell [noun]
extern verb Sorry     { .sorry }                                                /// apologize
extern verb Squeeze   { .squeeze|.squash }                                      /// squeeze noun
extern verb Strong    { .shit|.fuck|.damn|.sod }                                /// strong swearing
extern verb Swim      { .swim|.dive }                                           /// swim
