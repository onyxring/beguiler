extern verb Open      { .open|.unwrap|.uncover|.undo }                          /// open noun
extern verb Pray      { .pray }                                                 /// pray
extern verb Pull      { .pull|.drag }                                           /// pull noun
extern verb Push      { .push|.move|.shift|.clear|.press }                      /// push noun
extern verb PushDir   { .push|.move|.shift|.clear|.press }                      /// push noun in direction second
extern verb PutOn     { .put }                                                  /// put noun on second
