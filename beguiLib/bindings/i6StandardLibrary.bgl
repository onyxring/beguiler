#once
#declare I6_STANDARD_LIBRARY

//-- Attributes ------------------------------------------
extern attribute light;        /// object is a light source
extern attribute worn;         /// clothing item is currently worn
extern attribute clothing;     /// can be worn
extern attribute scenery;      /// not listed in room descriptions / inventory
extern attribute static;       /// cannot be taken or moved
extern attribute enterable;    /// player can enter this object
extern attribute container;    /// can hold objects inside it
extern attribute supporter;    /// can hold objects on top of it
extern attribute open;         /// container/door is currently open
extern attribute openable;     /// can be opened and closed
extern attribute locked;       /// container/door is locked
extern attribute lockable;     /// can be locked and unlocked
extern attribute transparent;  /// see through even when closed
extern attribute animate;      /// is an NPC or animate object
extern attribute talkable;     /// can be addressed directly
extern attribute proper;       /// name needs no "the" prefix
extern attribute pluralname;   /// object is referred to in the plural ("some keys")
extern attribute female;       /// animate: use she/her pronouns
extern attribute male;         /// animate: use he/him pronouns
extern attribute neuter;       /// animate: use it/its pronouns
extern attribute concealed;    /// hidden from normal room listing
extern attribute visited;      /// room has been entered before
extern attribute general;      /// general-purpose flag
extern attribute moved;        /// set once the player has taken/moved the object
extern attribute edible;       /// can be eaten
extern attribute door;         /// is a door between locations
extern attribute absent;       /// object is currently out of scope

//-- Properties ------------------------------------------
extern property          plural;     /// the name for several identical objects ("three gold coins"); string or routine
extern additive property before;     /// runs before an action on this object; return true to stop the action
extern additive property after;      /// runs after an action on this object; return true to replace the library's report
extern additive property life;       /// handles actions aimed at an animate object (Attack, Kiss, Give, Show, Ask, Tell, Answer…); return true to stop them
extern additive property orders;     /// handles commands given to this character ("bob, go north"); on the player, sees every command; return true to stop it
extern additive property describe;   /// prints the object's paragraph in a room description; return true to replace the default
extern additive property time_out;   /// runs when the object's timer (StartTimer, time_left) reaches zero
extern additive property each_turn;  /// runs at the end of every turn the object is in scope; string or routine

//-- Global constants ---------------------------------------------------------------
extern const string INFORMV__TX;       /// The banner text "Inform v".
extern const string LIBRARYV__TX;      /// The banner text " Library v".
extern const string LibRelease;        /// The library's release, such as "6.12.8".
extern const string story;             /// The story title, from the `title` setting.
extern const string headline;          /// The story headline, from the `headline` setting.
extern const int    START_MOVE;        /// The turn count the game starts from.
extern const int    MAX_TIMERS;        /// How many timers and daemons can run at once.
extern const int    INPUT_BUFFER_LEN;  /// The size of the player's input buffer, in bytes.
extern const int    PRESENT_TENSE;     /// The `narrative_tense` value for present-tense responses.
extern const int    PAST_TENSE;        /// The `narrative_tense` value for past-tense responses.


//-- Global variables  ---------------------------------------------------------------
extern object       location;              /// current room
extern object       real_location;         /// actual location when in darkness
extern object       prev_location;         /// previous real_location
extern object       player;                /// object the human controls
extern object       actor;                 /// who was asked to do something
extern object       actors_location;       /// actor's current location
extern object       visibility_ceiling;    /// highest visible object in tree
extern int          deadflag;              /// 0=alive, 1=dead, 2+=custom death
extern int          lightflag;             /// is there light to see by?
extern int          score;                 /// current score
extern int          last_score;            /// score from last turn
extern int          turns;                 /// number of game turns elapsed
extern int          the_time;              /// time in minutes since midnight
extern int          time_rate;             /// how often time updates
extern int          time_step;             /// time update increment
extern object       noun;                  /// first noun
extern object       second;                /// second noun
extern verb         action;                /// current action being performed (type verb for action constant comparisons)
extern verb         action_to_be;          /// the action about to be performed (set before the before/react_before stage; type verb for constant comparisons)
extern int          inp1;                  /// first input (0, 1, or object)
extern int          inp2;                  /// second input (0, 1, or object)
extern bool         meta;                  /// true if verb is a meta-command (I6 int flag; bool so `meta = true` type-checks)
extern int          multiflag;             /// multiple-object flag
extern int          keep_silent;           /// suppress action output
extern int          reason_code;           /// reason for "life" rule
extern int          receive_action;        /// ##PutOn or ##Insert
extern int          lm_n;                  /// LibraryMessages: message number
extern int          lm_o;                  /// LibraryMessages: message object
extern int          lm_s;                  /// LibraryMessages: message second parameter
extern int          parsed_number;         /// user-supplied parsing result
extern int          consult_from;          /// start word of consult topic
extern int          consult_words;         /// number of words in topic
extern int          special_word;          /// dictionary address for "special" token
extern int          special_number;        /// number typed for "special" token
extern int          verb_word;             /// the verb word (e.g. 'take')
extern int          verb_wordnum;          /// verb position in input
extern int          wn;                    /// word number currently being parsed
extern int          num_words;             /// number of words typed
extern object       itobj;                 /// object currently referred to as "it"
extern object       himobj;                /// object currently referred to as "him"
extern object       herobj;                /// object currently referred to as "her"
extern int          notify_mode;           /// score notification on/off
extern int          lookmode;              /// verbosity: 1=brief, 2=verbose, 3=superbrief
extern int          transcript_mode;       /// game scripting on/off
extern int          pretty_flag;           /// use character graphics for room descriptions
extern int          before_first_turn;     /// true before first LOOK
extern object       thedark;               /// the darkness object (in-scope when no light)
extern object       selfobj;               /// the player self object
extern object       n_obj;                 /// north
extern object       s_obj;                 /// south
extern object       e_obj;                 /// east
extern object       w_obj;                 /// west
extern object       ne_obj;                /// northeast
extern object       nw_obj;                /// northwest
extern object       se_obj;                /// southeast
extern object       sw_obj;                /// southwest
extern object       u_obj;                 /// up
extern object       d_obj;                 /// down
extern int          gg_statuswin_cursize;  /// current status-window height, in lines
extern int          gg_statuswin_size;     /// the height DrawStatusLine restores on every redraw
extern eScopeReason scope_reason;          /// why the parser is searching scope now
extern eListStyle   inventory_style;       /// the style the current inventory listing uses

#if TARGET_GLULX
    extern int gg_mainwin;    /// main window handle
    extern int gg_statuswin;  /// status window handle
    extern int gg_quotewin;   /// quote window handle
#endif
#if DEBUG
    extern eDebugFlags debug_flag;  /// which tracing is on
#endif

//-- Global objects ------------------------------------------------------
extern object informParser;  /// parser object
extern object informLibrary {      /// the main loop of the standard library
    void      play();                                                                                 /// runs the game
    void      end_turn_sequence();                                                                    /// lets a turn pass
    void      begin_action(verb act, var firstNoun = null, var secondNoun = null, int fromCode = 1);  /// performs an action now
    eActorAct actor_act(object person, verb act, var firstNoun = null, var secondNoun = null);        /// has person attempt an action
}
extern object LibraryExtensions {  /// parent of library extension objects; runs their ext_* hooks
    int RunAll(property prop, var a1 = 0, var a2 = 0, var a3 = 0);                 /// the highest value any hook returned
    int RunUntil(property prop, int exitval, var a1 = 0, var a2 = 0, var a3 = 0);  /// exitval if a hook returned it, else ~~exitval
    int RunWhile(property prop, int exitval, var a1 = 0, var a2 = 0, var a3 = 0);  /// the first value other than exitval, else exitval
}

//-- Global routines ------------------------------------------------
extern int  RunRoutines(object obj, property prop);                         /// run obj.prop() and return its value
extern int  PrintOrRun(object obj, property prop);                          /// if obj.prop is a routine, run it; if a string, print it
extern int  PrintOrRunVar(stringOrRoutine v);                               /// if v is a routine, run it; if a string, print it
extern void SetPronoun(dictionaryWord dword, object value);                 /// bind a pronoun word ('it'/'him'/…) to an object
extern void PronounNotice(object obj);                                      /// update the pronoun table so "it"/"him" refers to obj
extern void AddToScope(object obj);                                         /// inside an add_to_scope routine: bring obj into parser scope
extern void MoveFloatingObjects();                                          /// relocate `found_in` backdrops/floating objects for the current location
extern void StartTimer(object obj, int turns);                              /// start obj's timer; its time_out runs after `turns` turns
extern void StopTimer(object obj);                                          /// cancel a running timer on obj
extern void StartDaemon(object obj);                                        /// begin running obj's `daemon` property every turn
extern void StopDaemon(object obj);                                         /// stop running obj's `daemon`
extern void PlayerTo(object obj, int flag = 0);                             /// move the player to obj; flag 0=look, 1=no look, 2=no newline
extern bool TestScope(object obj, object actor = 0);                        /// true if obj is in scope (for the given actor, default the player)
extern void Banner();                                                       /// print the standard game banner (story title/headline/version)
extern void ClearScreen();                                                  /// clear the screen
extern void NotifyTheScore();                                               /// print "[Your score has gone up…]"
extern void ScoreSub();                                                     /// the SCORE action handler
extern void DisplayStatus();                                                /// refresh the status line
extern void StatusLineHeight(int height);                                   /// set the status window height to `height` lines
extern void DrawStatusLine();                                               /// redraws the status line
extern void AfterGameOver();                                                /// post-game-over menu loop: AMUSING/UNDO/etc.
extern void CSubjectVerb(object obj, bool reportage, bool nocaps, string v1, string v2 = null, string v3 = null, string past = null);  /// Prints obj with a verb that agrees with it ("You take", "Bob takes"); unused verb forms are 0.
extern void SetColour(eColor fg, eColor bg, eWindow window = eWindow.all);  /// sets text colors; does nothing unless the COLOUR option is set (#defineI6 COLOUR)
extern bool WriteListFrom(object o, eListStyle style, int depth = 0);       /// lists o and its siblings; false if there was nothing to list

//-- Entry points --------------------------------------------
extern default void           AfterLife();                                     /// player just died, before the death message
extern default void           AfterPrompt();                                   /// after the ">" prompt is printed
extern default void           Amusing();                                       /// the "AMUSING" option after winning
extern default void           BeforeParsing();                                 /// before the parser reads the command
extern default int            ChooseObjects(object obj, int code);             /// disambiguation scoring
extern default void           DarkToDark();                                    /// moved from one dark room to another
extern default void           DeathMessage();                                  /// custom "You have died" text (deadflag ≥ 3)
extern default void           Epilogue();                                      /// end-of-game hook (after the final banner)
extern default bool           GamePostRoutine();                               /// after every action (true = already handled)
extern default bool           GamePreRoutine();                                /// before every action (true = already handled)
extern default bool           InScope(object actor);                           /// add objects to scope (true = handled)
extern default void           LookRoutine();                                   /// extra text after a room description
extern default void           NewRoom();                                       /// player entered a new room
extern default bool           ObjectDoesNotFit(object obj, object container);  /// custom "won't fit" message (true = handled)
extern default int            ParseNumber(rawArray<char> text, int length);    /// parse a game-specific number token
extern default bool           ParserError(eParserError err);                   /// custom parser-error message (true = handled)
extern default void           PrintTaskName(int task);                         /// name a FULL-SCORE task
extern default bool           PrintVerb(dictionaryWord word);                  /// custom verb printing (true = handled)
extern default void           TimePasses();                                    /// each turn, after the action
extern default dictionaryWord UnknownVerb(dictionaryWord word);                /// remap an unknown verb word
extern default int            AfterSave();                                     /// after a SAVE
extern default int            AfterRestore();                                  /// after a RESTORE
#if TARGET_GLULX
    extern default int IdentifyGlkObject(int phase, int type, int ref, int rock);  /// Glk object tracking
    extern default int InitGlkWindow(int rock);                                    /// window setup
#endif

//-- Helpful Enumerations ----------------------------------------------
enum eActorAct {             /// what informLibrary.actor_act returns
    ok                 = 0,  /// done; nothing more to do
    abortNotUnderstood = 1,  /// not understood; perform the pending Answer action
    abortOrder         = 2   /// refused; end the turn
}
enum eParserError {
    stuck      = 1,   /// "I didn't understand that sentence."
    upTo       = 2,   /// "I only understood you as far as…"
    number     = 3,   /// "I didn't understand that number."
    cantSee    = 4,   /// "You can't see any such thing."
    tooLittle  = 5,   /// "You seem to have said too little!"
    notHeld    = 6,   /// "You aren't holding that!"
    multi      = 7,   /// "You can't use multiple objects with that verb."
    multiTwice = 8,   /// "You can only use multiple objects once on a line."
    vague      = 9,   /// "I'm not sure what 'it' refers to."
    except     = 10,  /// "You excepted something not included anyway!"
    notAnimate = 11,  /// "You can only do that to something animate."
    verb       = 12,  /// "That's not a verb I recognize."
    scenery    = 13,  /// "That's not something you need to refer to."
    itGone     = 14,  /// "You can't see 'it' at the moment."
    junkAfter  = 15,  /// "I didn't understand the way that finished."
    tooFew     = 16,  /// "Only … of those are available."
    nothing    = 17,  /// "Nothing to do!"
    askScope   = 18   /// a scope routine reported the error
}

enum eScopeReason {
    parsing       = 0,  /// normal parsing
    talking       = 1,  /// NPC conversation
    eachTurn      = 2,  /// each_turn properties
    reactBefore   = 3,  /// react_before properties
    reactAfter    = 4,  /// react_after properties
    loopOverScope = 5,  /// a LoopOverScope() call
    testScope     = 6   /// a TestScope() call
}

enum eColor {
    current      = 0,  /// keep the current color
    defaultColor = 1,  /// the interpreter's default
    black        = 2,
    red          = 3,
    green        = 4,
    yellow       = 5,
    blue         = 6,
    magenta      = 7,
    cyan         = 8,
    white        = 9,
    purple       = 7,  /// same as magenta
    azure        = 8   /// same as cyan
}

enum eWindow {
    all    = 0,  /// both windows
    status = 1,  /// the status bar
    main   = 2   /// the main window
}

#if DEBUG
    bnum eDebugFlags {
        messages = $0001,  /// trace library messages
        actions  = $0002,  /// trace actions
        timers   = $0004,  /// trace timers and daemons
        changes  = $0008,  /// trace object changes
        verbose  = $0080   /// trace verbosely
    }
#endif

bnum eListStyle {
    newline   = $0001,  /// new line after each entry
    indent    = $0002,  /// indent each entry by depth
    fullInv   = $0004,  /// full inventory information after each entry
    english   = $0008,  /// English sentence style, with commas and "and"
    recurse   = $0010,  /// list contents too, by the usual rules
    always    = $0020,  /// always list contents
    terse     = $0040,  /// terser English style
    partInv   = $0080,  /// brief inventory information after each entry
    defArt    = $0100,  /// use the definite article
    workflag  = $0200,  /// at top level, only objects that have workflag
    isAre     = $0400,  /// print " is" or " are" first
    conceal   = $0800,  /// omit concealed and scenery objects
    noArticle = $1000,  /// print no articles
    id        = $2000   /// print each object's id
}

extern enum grammarToken {
    NOUN,         /// Any in-scope object.
    HELD,         /// An object the actor is currently holding.
    CREATURE,     /// An animate object — one with the `animate` attribute.
    TOPIC,        /// A free-form topic phrase (any sequence of words the player types).
    MULTI,        /// One or more in-scope objects.
    MULTIHELD,    /// One or more held objects.
    MULTIEXCEPT,  /// Multiple in-scope objects, excluding one already matched (commonly used after a preposition).
    MULTIINSIDE,  /// Multiple objects inside a specific container.
    SPECIAL,      /// A number or a single dictionary word.
    ANYNUMBER,    /// Any number typed by the player (no range check).
    NUMBER,       /// A number typed by the player (range-checked to fit a word).
    SCOPE,        /// Placeholder marker — use the `SCOPE(Routine)` form on a real grammar line to set scope.
    REVERSE       /// Pseudo-token: reverse the noun and second variables. If present, it must appear as the LAST element of a grammar line.
}

//-- StdLib actions ----------------------------------------------------
extern verb Answer    { .answer|.say|.shout|.speak }                            /// say a topic to second
extern verb Ask       { .ask }                                                  /// ask noun about a topic
extern verb AskFor    { .ask }                                                  /// ask noun for second
extern verb AskTo     { .ask|.tell }                                            /// ask noun to do something
extern verb Attack    { .attack|.break|.crack|.destroy|.fight|.hit|.kill|.murder|.punch|.smash|.thump|.torture|.wreck }  /// attack noun
extern verb Blow      { .blow }                                                 /// blow noun
