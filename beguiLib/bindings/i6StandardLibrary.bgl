extern verb Lock      { .lock }                                                 /// lock noun with second
extern verb Look      { .look|.l }                                              /// look around
extern verb LookUnder { .look|.l }                                              /// look under noun
extern verb Mild      { .bother|.curses|.drat|.darn }                           /// mild swearing
