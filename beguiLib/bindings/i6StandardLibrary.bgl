extern verb Fill      { .fill }                                                 /// fill noun [from second]
extern verb GetOff    { .get }                                                  /// get off noun
extern verb Give      { .give|.pay|.offer|.feed }                               /// give noun to second
extern verb Go        { .go|.run|.walk }                                        /// go in direction noun
extern verb GoIn      { .enter|.cross|.in|.inside }                             /// go in
extern verb Insert    { .insert }                                               /// put noun in second
