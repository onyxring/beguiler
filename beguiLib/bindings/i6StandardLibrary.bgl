//-- Fake actions (no grammar)
extern verb Receive;  /// runs on second when noun is put on or in it; receive_action says which
extern verb LetGo;    /// runs on the container or supporter when noun is taken from it
extern verb Going;    /// runs on the destination room as the player moves

//-- General bits of I6-to-Beguile setup ----------------------------------------

// stringOrRoutine is a convenience union type, since the stdlib uses this pattern regularly.
union stringOrRoutine = string | func<void> {
    emitter bool isRoutine() { metaclass($val) == Routine }
}
emitter void print(stringOrRoutine v){
    if(metaclass($v) == Routine) $v();
    else print (string)$v;
}
// The stdLib allows all objects to override their instanceName via the short_name property.
extend extern class object {
    stringOrRoutine short_name;
}

// The story title and headline fields in the beguilerSettings block serve Treaty of Babel metadata.  Let's reuse these and keep their definitions all the same.
#emitfirst {
    Constant story    = ##beguilerSettings.title;
    Constant headline = ##beguilerSettings.headline;
}

// Substitute the stdLib's backings for status bar and main window, replacing Beguile's core behavior for this.
#if(TARGET_GLULX)
    extend _bglStatus {
        replace auto id = {
            int operator()        { return gg_statuswin; }
            void operator = (int v){ gg_statuswin=v; }
        }
        replace auto height = {
            int operator()        { return gg_statuswin_cursize; }
            void operator = (int v){ gg_statuswin_size = v; StatusLineHeight(v); }
        }
    }
    extend _bglMainWindow {
        replace auto id = {
            int operator()        { return gg_mainwin; }
            void operator = (int v){ gg_mainwin=v; }
        }
    }
#else // Z-code
    extend _bglStatus {
        replace auto id = null; // Z-code doesn't maintain ids for windows
        replace auto height = {
            int operator()        { return gg_statuswin_cursize; }
            void operator = (int v){ gg_statuswin_size = v; StatusLineHeight(v); }
        }
    }
#endif

// Update the Banner to show that this game is a Beguile game
replace void Banner(){
    print($"^{bgl.printRules.bold}{story}{bgl.printRules.roman}{headline}");
    print($"Release {bgl.header.release} / Serial number {bgl.header.printSerial()}");
    print($"^{bgl.printRules.italics}Written in{bgl.printRules.roman} Beguile v{beguilerMajor}.{beguilerMinor}.{beguilerPatch}");
    print($"^{bgl.printRules.italics}Compiled with{bgl.printRules.roman} Inform v");
    #i6 { inversion; }
    print($" / Library v{LibRelease} ");
    // The library's switch letters: S strict mode, X the Infix debugger, otherwise D a debug build.
    #i6 {
        #Ifdef STRICT_MODE; print "S"; #Endif;
        #Ifdef INFIX; print "X";
        #Ifnot; #Ifdef DEBUG; print "D"; #Endif; #Endif;
    }
    print("^");
}

// Automatically start up the Beguile run-time environment...
#if bglAutoInitialize
    #emitfirst{
        replace main _oldmain;
    }
    #emitlast{
        [main;
            bglInit();
            _oldmain();
        ];
    }
#endif