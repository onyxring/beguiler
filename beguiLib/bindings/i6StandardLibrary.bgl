extern verb Disrobe   { .shed|.doff|.disrobe }                                  /// take off noun
extern verb Drink     { .drink|.swallow|.sip }                                  /// drink noun
extern verb Drop      { .drop|.discard }                                        /// drop noun
extern verb Eat       { .eat }                                                  /// eat noun
