extern verb Turn      { .turn|.rotate|.twist|.unscrew|.screw }                  /// turn noun
extern verb Unlock    { .unlock|.pry|.prise|.prize|.lever|.jemmy|.force }       /// unlock noun with second
extern verb VagueGo   { .go|.walk|.run|.leave }                                 /// go, with no direction given
extern verb Wait      { .wait|.z }                                              /// wait
extern verb Wake      { .wake|.awake|.awaken }                                  /// wake up
extern verb WakeOther { .wake|.awake|.awaken }                                  /// wake noun
extern verb Wave      { .wave }                                                 /// wave noun [at second]
extern verb WaveHands { .wave }                                                 /// wave [at noun]
extern verb Wear      { .wear|.don }                                            /// wear noun
extern verb Yes       { .yes|.y }                                               /// answer yes

//-- Meta actions
extern verb CommandsOff  { .recording }          /// stop recording commands (meta)
extern verb CommandsOn   { .recording }          /// record commands to a file (meta)
extern verb CommandsRead { .replay }             /// replay commands from a file (meta)
extern verb FullScore    { .fullscore|.full }    /// show the full score (meta)
extern verb LMode1       { .brief }              /// brief room descriptions (meta)
extern verb LMode2       { .verbose|.long }      /// verbose room descriptions (meta)
extern verb LMode3       { .superbrief|.short }  /// superbrief room descriptions (meta)
extern verb LModeNormal  { .normal }             /// normal room descriptions (meta)
extern verb NotifyOff    { .notify }             /// turn off score notification (meta)
extern verb NotifyOn     { .notify }             /// turn on score notification (meta)
#if !NO_PLACES
    extern verb Objects     { .objects }  /// list the objects handled (meta)
    extern verb ObjectsTall { .objects }  /// list the objects handled, tall (meta)
    extern verb ObjectsWide { .objects }  /// list the objects handled, wide (meta)
    extern verb Places      { .places }   /// list the places visited (meta)
    extern verb PlacesTall  { .places }   /// list the places visited, tall (meta)
    extern verb PlacesWide  { .places }   /// list the places visited, wide (meta)
#endif
extern verb Pronouns  { .pronouns|.nouns }     /// show what the pronouns refer to (meta)
extern verb Quit      { .q|.quit|.die }        /// quit the game (meta)
extern verb Restart   { .restart }             /// restart the game (meta)
extern verb Restore   { .restore }             /// restore a saved game (meta)
extern verb Save      { .save }                /// save the game (meta)
extern verb Score     { .score }               /// show the score (meta)
extern verb ScriptOff { .noscript|.unscript }  /// stop the transcript (meta)
extern verb ScriptOn  { .script|.transcript }  /// start a transcript (meta)
extern verb Verify    { .verify }              /// verify the story file (meta)
extern verb Version   { .version }             /// show version information (meta)

//-- Debug actions (debug builds only)
#if DEBUG
    extern verb ActionsOff      { .actions }             /// stop tracing actions (meta)
    extern verb ActionsOn       { .actions }             /// trace actions (meta)
    extern verb ChangesOff      { .changes }             /// stop tracing object changes (meta)
    extern verb ChangesOn       { .changes }             /// trace object changes (meta)
    extern verb Glklist         { .glklist }             /// list Glk objects (meta)
    extern verb GoNear          { .gonear }              /// go to noun's location (meta)
    extern verb Goto            { .goto }                /// go to a room by object number (meta)
    extern verb Predictable     { .random }              /// make random numbers predictable (meta)
    extern verb RoutinesOff     { .routines|.messages }  /// stop tracing routines and messages (meta)
    extern verb RoutinesOn      { .routines|.messages }  /// trace routines and messages (meta)
    extern verb RoutinesVerbose { .routines|.messages }  /// trace routines and messages, verbosely (meta)
    extern verb Scope           { .scope }               /// list what is in scope [for noun] (meta)
    extern verb ShowDict        { .showdict|.dict }      /// show the dictionary (meta)
    extern verb ShowObj         { .showobj }             /// show an object's details (meta)
    extern verb ShowVerb        { .showverb }            /// show a verb's grammar (meta)
    extern verb TimersOff       { .timers|.daemons }     /// stop tracing timers and daemons (meta)
    extern verb TimersOn        { .timers|.daemons }     /// trace timers and daemons (meta)
    extern verb TraceLevel      { .trace }               /// set the parser trace level (meta)
    extern verb TraceOff        { .trace }               /// stop tracing the parser (meta)
    extern verb TraceOn         { .trace }               /// trace the parser (meta)
    extern verb XAbstract       { .abstract }            /// move noun to second (meta)
    extern verb XPurloin        { .purloin }             /// take noun from anywhere (meta)
    extern verb XTree           { .tree }                /// show the object tree [of noun] (meta)
#endif

//-- Fake actions (no grammar)
extern verb Receive { }         /// Runs on second when noun is put on or in it; receive_action says which.
extern verb LetGo { }           /// Runs on the container or supporter when noun is taken from it.
extern verb Going { }           /// Runs on the destination room as the player moves.
extern verb ThrownAt { }        /// Runs on second when noun is thrown at it.
extern verb Order { }           /// Runs on a character told to do something it has no orders for.
extern verb TheSame { }         /// Asks parse_name whether two objects can be told apart.
extern verb PluralFound { }     /// Tells parse_name that a plural word matched.
extern verb ListMiscellany { }  /// Prints a library message about lists.
extern verb Miscellany { }      /// Prints a general library message.
extern verb RunTimeError { }    /// Prints a library run-time error.
extern verb Prompt { }          /// Prints the command prompt.
extern verb NotUnderstood { }   /// Runs when a command to a character is not understood.

//-- General bits of I6-to-Beguile setup ----------------------------------------

// stringOrRoutine is a convenience union type, since the stdlib uses this pattern regularly.
union stringOrRoutine = string | func<void> {
    emitter bool isRoutine() { metaclass($val) == Routine }
}
emitter void print(stringOrRoutine v){
    if(metaclass($v) == Routine) $v();
    else print (string)$v;
}
// The stdLib allows all objects to override their instanceName via the short_name property.
extend extern class object {
    stringOrRoutine short_name;
}

// The story title and headline fields in the beguilerSettings block serve Treaty of Babel metadata.  Let's reuse these and keep their definitions all the same.
#emitfirst {
    Constant story    = ##beguilerSettings.title;
    Constant headline = ##beguilerSettings.headline;
}

// Substitute the stdLib's backings for status bar and main window, replacing Beguile's core behavior for this.
#if(TARGET_GLULX)
    superposed array<int> _bglArrangeBuf[1];
    // The library's StatusLineHeight re-arranges the status window's own parent, which is wrong once
    // the status bar has been split: its parent is then the new pair. The height belongs to the first
    // pair above it that splits above or below.
    superposed void _bglStatusSetHeight(int lines){
        if(gg_statuswin == 0 || lines == gg_statuswin_cursize) return;
        int pair = bgl.asm.windowGetParent(gg_statuswin);
        while(pair != 0){
            bgl.asm.windowGetArrangement(pair, ((int)_bglArrangeBuf) + bgl.wordsize, 0, 0);
            int method = _bglArrangeBuf[0] & $0F;
            if(method == 2 || method == 3) break;                       // above or below
            pair = bgl.asm.windowGetParent(pair);
        }
        if(pair == 0) return;
        bgl.asm.windowSetArrangement(pair, ($12), lines, 0);            // above, fixed size, keep the key window
        gg_statuswin_cursize = lines;
    }
    extend _bglStatus {
        replace auto id = {
            int operator()        { return gg_statuswin; }
            void operator = (int v){ gg_statuswin=v; }
        }
        replace auto height = {
            int operator()        { return gg_statuswin_cursize; }
            void operator = (int v){ gg_statuswin_size = v; _bglStatusSetHeight(v); }
        }
    }
    extend _bglMainWindow {
        replace auto id = {
            int operator()        { return gg_mainwin; }
            void operator = (int v){ gg_mainwin=v; }
        }
    }
#else // Z-code
    extend _bglStatus {
        replace auto id = null; // Z-code doesn't maintain ids for windows
        replace auto height = {
            int operator()        { return gg_statuswin_cursize; }
            void operator = (int v){ gg_statuswin_size = v; StatusLineHeight(v); }
        }
    }
#endif

// Update the Banner to show that this game is a Beguile game
replace void Banner(){
    print($"^{bgl.printRules.bold}{story}{bgl.printRules.roman}{headline}");
    print($"Release {bgl.header.release} / Serial number {bgl.header.printSerial()}");
    print($"^{bgl.printRules.italics}Written in{bgl.printRules.roman} Beguile v{beguilerMajor}.{beguilerMinor}.{beguilerPatch}");
    print($"^{bgl.printRules.italics}Compiled with{bgl.printRules.roman} Inform v");
    #i6 { inversion; }
    print($" / Library v{LibRelease} ");
    // The library's switch letters: S strict mode, X the Infix debugger, otherwise D a debug build.
    #i6 {
        #Ifdef STRICT_MODE; print "S"; #Endif;
        #Ifdef INFIX; print "X";
        #Ifnot; #Ifdef DEBUG; print "D"; #Endif; #Endif;
    }
    print("^");
}

