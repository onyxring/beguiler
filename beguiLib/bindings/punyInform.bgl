#once
#declare PUNYINFORM

//-- Attributes ------------------------------------------
extern attribute light;        /// object is a light source
extern attribute edible;       /// can be eaten
extern attribute absent;       /// object is currently out of scope
extern attribute talkable;     /// can be addressed directly
extern attribute supporter;    /// can hold objects on top of it
extern attribute container;    /// can hold objects inside it
extern attribute enterable;    /// player can enter this object
extern attribute transparent;  /// see through even when closed
extern attribute open;         /// container/door is currently open
extern attribute openable;     /// can be opened and closed
extern attribute concealed;    /// hidden from normal room listing
extern attribute moved;        /// object has been taken at least once
extern attribute visited;      /// room has been entered before
extern attribute proper;       /// name needs no "the" prefix
extern attribute scenery;      /// not listed in room descriptions
extern attribute static;       /// cannot be taken or moved
extern attribute animate;      /// is an NPC or animate object
extern attribute clothing;     /// can be worn
extern attribute worn;         /// clothing item is currently worn
extern attribute pluralname;   /// name is grammatically plural
extern attribute female;       /// animate: use she/her pronouns
extern attribute neuter;       /// animate: use it/its pronouns
extern attribute general;      /// general-purpose flag
extern attribute switchable;   /// can be switched on/off
extern attribute on;           /// switchable object is currently on
extern attribute door;         /// is a door between locations
extern attribute locked;       /// container/door is locked
extern attribute lockable;     /// can be locked and unlocked
extern attribute workflag;     /// internal working flag (parser use)
extern attribute reactive;     /// marks objects that run each_turn, react_before, react_after or add_to_scope; set at startup unless OPTIONAL_MANUAL_REACTIVE is defined
extern attribute scored;       /// object/room has been scored

//-- Properties ------------------------------------------
// A direction command sets selected_direction to one of these, and noun to Directions.
extern property n_to;
extern property s_to;
extern property e_to;
extern property w_to;
extern property ne_to;
extern property nw_to;
extern property se_to;
extern property sw_to;
extern property u_to;
extern property d_to;
extern property in_to;
extern property out_to;

//-- Global constants ---------------------------------------------------------------
// Direction values the parser uses before a direction is resolved; most code uses selected_direction.
extern const int FAKE_N_OBJ;
extern const int FAKE_S_OBJ;
extern const int FAKE_E_OBJ;
extern const int FAKE_W_OBJ;
extern const int FAKE_NE_OBJ;
extern const int FAKE_NW_OBJ;
extern const int FAKE_SE_OBJ;
extern const int FAKE_SW_OBJ;
extern const int FAKE_U_OBJ;
extern const int FAKE_D_OBJ;
extern const int FAKE_IN_OBJ;
extern const int FAKE_OUT_OBJ;

//-- Global variables  ---------------------------------------------------------------
extern object   location;                   /// current room
extern object   real_location;              /// actual location when in darkness
extern object   player;                     /// object the human controls
extern object   actor;                      /// who was asked to do something
extern int      deadflag;                   /// 0=alive, 1=dead, 2+=custom death
extern int      score;                      /// current score
extern int      turns;                      /// number of game turns elapsed
extern int      the_time;                   /// time in minutes since midnight
extern int      time_rate;                  /// how often time updates
extern int      lookmode;                   /// verbosity: 1=brief, 2=verbose, 3=superbrief
extern object   noun;                       /// first noun
extern object   second;                     /// second noun
extern verb     action;                     /// current action being performed
extern int      parsed_number;              /// user-supplied number
extern int      consult_from;               /// start word of consult topic
extern int      consult_words;              /// number of words in topic
extern int      special_word;               /// dictionary address for "special" token
extern int      special_number;             /// number typed for "special" token
extern int      verb_word;                  /// the verb word
extern int      verb_wordnum;               /// verb position in input
extern int      wn;                         /// word number currently being parsed
extern int      num_words;                  /// number of words typed
extern int      keep_silent;                /// suppress action output
extern property selected_direction;         /// The direction property a Go action chose; compare it with `(property)n_to` and the like.
extern int      selected_direction_index;   /// 1-based: 1=N, 2=S, 3=E, 4=W, 5=NE, 6=NW, 7=SE, 8=SW, 9=U, 10=D, 11=IN, 12=OUT
extern object   itobj;                      /// object currently referred to as "it"
extern object   himobj;                     /// object currently referred to as "him"
extern object   herobj;                     /// object currently referred to as "her"
extern object   themobj;                    /// object currently referred to as "them"
extern int      notify_mode;                /// score notification on/off
extern int      inventory_style;            /// inventory display style
extern int      screen_width;               /// screen width in characters
extern int      statusline_height;          /// The status-window height the library restores each turn, in lines.
extern int      statusline_current_height;  /// The status window's current height, in lines.
extern int      clr_on;                     /// set to true to enable colors (z5 and later)
extern eColor   clr_bg;                     /// background color
extern eColor   clr_fg;                     /// foreground color
extern eColor   clr_fginput;                /// player input color (PUNY++)
extern eColor   clr_fgstatus;               /// status line color
extern int      things_score;               /// score from picking up scored objects
extern int      places_score;               /// score from visiting scored rooms
extern object   thedark;                    /// the darkness object (in-scope when no light)
extern object   selfobj;                    /// the player self object
extern object   Directions;                 /// shared placeholder bound to `noun` for direction commands

#if DEBUG
    extern eDebugFlags debug_flag;  /// Which tracing is on.
#endif

//-- Global routines ------------------------------------------------
// Routines PunyInform compiles only under an option constant, or only for z5 and later, are noted in their docs.
extern void           _StatusLineHeight(int h);                                                  /// Sets the status window to `h` lines and remembers it.
extern void           Banner();                                                                  /// Prints the game name and serial number.
extern void           ChangeFgColour(eColor colour);                                             /// Changes the foreground color when colors are enabled (z5 and later; a stub on z3).
extern void           ChooseObjectsFinal_Discard(int n);                                         /// Removes option `n` (0 or higher) from within ChooseObjectsFinal.
extern void           ChooseObjectsFinal_Pick(int n);                                            /// Picks option `n` (0 or higher) from within ChooseObjectsFinal.
extern void           ClearScreen(eWindow window);                                               /// Clears the main window, the status window or both (z5 and later).
extern object         CommonAncestor(object a, object b);                                        /// The nearest object that contains both `a` and `b`, or nothing.
extern property       DoorDir(object door);                                                      /// The direction property in which the door lies.
extern object         DoorTo(object door);                                                       /// The room the door leads to, or 1 if its door_to routine already explained why not.
extern void           DrawStatusLine(bool newlines = false);                                     /// Prints the status line, or just as many newlines when `newlines` is true.
extern void           FastSpaces(int n);                                                         /// Prints `n` spaces.
extern bool           ImplicitDisrobeIfWorn(object obj);                                         /// Takes `obj` off if it is worn; false means success.
extern bool           ImplicitGrabIfNotHeld(object obj);                                         /// Takes `obj` if it is not held; false means success.
extern bool           IndirectlyContains(object outer, object inner);                            /// True if `outer` holds `inner` on some level.
extern void           LoopOverScope(func<void, object> routine, object actor = null);            /// Calls `routine` once for each object in scope for `actor` (default the player).
extern void           MoveFloatingObjects();                                                     /// Rechecks which objects with `found_in` are present.
extern dictionaryWord NextWord();                                                                /// The word at `wn`, then advances `wn`; null if empty or not in the dictionary.
extern int            NextWordStopped();                                                         /// As NextWord, but -1 once `wn` is past the end of the input.
extern int            NumberWords();                                                             /// The number of words in the player's input.
extern int            ObjectCapacity(object obj);                                                /// The object's `capacity`, defaulting to DEFAULT_CAPACITY or 100.
extern bool           ObjectIsUntouchable(object item, bool dontPrint = false, bool checkTake = false);  /// True if the player cannot touch `item`; prints why unless `dontPrint` is set.
extern bool           OzmooColoursAvailable();                                                   /// True when played on Ozmoo with its extra colors (z5 and later).
extern int            ParseToken(int tokenType, int tokenData);                                  /// Runs the parser on a grammar token from within a general parsing routine.
extern void           PlaceInScope(object obj);                                                  /// Puts `obj` in scope from within a scope routine, ignoring its children.
extern void           PlayerTo(object dest, int flag = 0);                                       /// Moves the player to `dest`; flag 0=long description, 1=quiet, 2=per lookmode.
extern int            PrintContents(var text, object obj, int style = 0);                        /// Lists the contents of `obj`, preceded by `text` unless it is 0.
extern int            PrintContentsFromR(var text, object obj, int maxCount = 0);                /// Lists `obj` and its siblings with their contents, keeping the current style.
extern void           PrintMsg(int msg, var arg1 = 0, var arg2 = 0);                             /// Prints the library message `msg`.
extern int            PrintOrRun(object obj, property prop, bool noNewline = false);             /// Runs `obj.prop` if it is a routine, or prints it (and a newline) if it is a string.
extern void           PronounNotice(object obj);                                                 /// Makes the pronouns that fit `obj` refer to it.
extern int            RunRoutines(object obj, property prop, int switchValue = 0);               /// Runs the routines in `obj.prop` until one returns non-zero, and returns that value.
extern void           ScopeWithin(object obj);                                                   /// Puts everything within `obj` in scope, searching supporters, transparent objects and open containers.
extern void           SetTime(int minutes, int step = 0);                                        /// Sets the time to `minutes` after midnight; a positive `step` is minutes per turn.
extern void           StartDaemon(object obj);                                                   /// Starts running obj's `daemon` property every turn.
extern void           StartTimer(object obj, int turns);                                         /// Starts obj's timer; its `time_out` runs after `turns` turns.
extern void           StopDaemon(object obj);                                                    /// Stops running obj's `daemon` property.
extern void           StopTimer(object obj);                                                     /// Cancels obj's running timer.
extern bool           TestScope(object obj, object actor = null);                                /// True if `obj` is in scope for `actor` (default the player).
extern int            TryNumber(int wordNum);                                                    /// The number in word `wordNum` of the input (0-10000), or -1000 if it is not a number.
extern int            WordAddress(int wordNum);                                                  /// The memory address of the characters of word `wordNum` of the input.
extern int            WordLength(int wordNum);                                                   /// The number of characters in word `wordNum` of the input.
extern dictionaryWord WordValue(int wordNum);                                                    /// The dictionary word that word `wordNum` of the input matches, or null.
extern bool           YesOrNo();                                                                 /// Waits for the player to answer; true for yes, false for no.
#if OPTIONAL_ALLOW_WRITTEN_NUMBERS
    extern int NumberWord(dictionaryWord word);  /// The number 1-20 a number word such as 'six' stands for, or 0 if it is not one.
#endif
#if OPTIONAL_LANGUAGE_NUMBER
    extern void LanguageNumber(int n);  /// Prints `n` in words.
#endif
#if OPTIONAL_FULL_SCORE && TASKS_PROVIDED
    extern void Achieved(int task);  /// Completes scoring task `task` and awards its points once.
#endif

//-- Helpful Enumerations ----------------------------------------------
enum eColor {
    current         = 0,   /// keep the current color
    defaultColor    = 1,   /// the interpreter's default
    black           = 2,
    red             = 3,
    green           = 4,
    yellow          = 5,
    blue            = 6,
    magenta         = 7,
    cyan            = 8,
    white           = 9,
    ozmooOrange     = 16,  /// Ozmoo (PUNY++)
    ozmooBrown      = 17,  /// Ozmoo (PUNY++)
    ozmooLightRed   = 18,  /// Ozmoo (PUNY++)
    ozmooDarkGray   = 19,  /// Ozmoo (PUNY++)
    ozmooMediumGray = 20,  /// Ozmoo (PUNY++)
    ozmooLightGreen = 21,  /// Ozmoo (PUNY++)
    ozmooLightBlue  = 22,  /// Ozmoo (PUNY++)
    ozmooLightGray  = 23   /// Ozmoo (PUNY++)
}

enum eWindow {
    all    = 0,  /// both windows
    status = 1,  /// the status bar
    main   = 2   /// the main window
}

#if DEBUG
    bnum eDebugFlags {
        messages = $0001,  /// Trace routine and message calls.
        actions  = $0002,  /// Trace actions.
        timers   = $0004   /// Trace timers and daemons.
    }
#endif

extern enum grammarToken {
    NOUN,         /// Any in-scope object.
    HELD,         /// An object the actor is currently holding.
    CREATURE,     /// An animate object — one with the `animate` attribute.
    TOPIC,        /// A free-form topic phrase (any sequence of words the player types).
    MULTI,        /// One or more in-scope objects.
    MULTIHELD,    /// One or more held objects.
    MULTIEXCEPT,  /// Multiple in-scope objects, excluding one already matched (commonly used after a preposition).
    MULTIINSIDE,  /// Multiple objects inside a specific container.
    SPECIAL,      /// A number or a single dictionary word.
    ANYNUMBER,    /// Any number typed by the player (no range check).
    NUMBER,       /// A number typed by the player (range-checked to fit a word).
    SCOPE,        /// Placeholder marker — use the `SCOPE(Routine)` form on a real grammar line to set scope.
    REVERSE       /// Pseudo-token: reverse the noun and second variables. If present, it must appear as the LAST element of a grammar line.
}

