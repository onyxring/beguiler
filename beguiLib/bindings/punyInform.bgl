//-----------------------------------------------------------------------------
//  punyInform.bgl - extern declarations for the PunyInform library.
//  Include this file to get typed access to PunyInform globals and objects:
//      #include <bindings/punyInform>
//
//  Includes bindings for...
//      #includeI6 "globals" 
//      #includeI6 "puny"
//-----------------------------------------------------------------------------
#once

// Advertise the PunyInform library so core/BLR files can detect it regardless of include order
// (see §3.3.3). Its counterpart in the I6 standard library binding is STANDARD_LIBRARY.
#declare PUNYINFORM

//-- PunyInform attributes ------------------------------------------------------
extern attribute light;         // object is a light source
extern attribute edible;        // can be eaten
extern attribute absent;        // object is currently out of scope
extern attribute talkable;      // can be addressed directly
extern attribute supporter;     // can hold objects on top of it
extern attribute container;     // can hold objects inside it
extern attribute enterable;     // player can enter this object
extern attribute transparent;   // see through even when closed
extern attribute open;          // container/door is currently open
extern attribute openable;      // can be opened and closed
extern attribute concealed;     // hidden from normal room listing
extern attribute moved;         // object has been taken at least once
extern attribute visited;       // room has been entered before
extern attribute proper;        // name needs no "the" prefix
extern attribute scenery;       // not listed in room descriptions
extern attribute static;        // cannot be taken or moved
extern attribute animate;       // is an NPC or animate object
extern attribute clothing;      // can be worn
extern attribute worn;          // clothing item is currently worn
extern attribute pluralname;    // name is grammatically plural
extern attribute female;        // animate: use she/her pronouns
extern attribute neuter;        // animate: use it/its pronouns
extern attribute general;       // general-purpose flag
extern attribute switchable;    // can be switched on/off
extern attribute on;            // switchable object is currently on
extern attribute door;          // is a door between locations
extern attribute locked;        // container/door is locked
extern attribute lockable;      // can be locked and unlocked
extern attribute workflag;      // internal working flag (parser use)
extern attribute reactive;      // REQUIRED for objects with before/after/each_turn/react_before/react_after
extern attribute scored;        // object/room has been scored

//-- Game state ---------------------------------------------------------------
extern object location;             // current room
extern object real_location;        // actual location when in darkness
extern object player;               // object the human controls
extern object actor;                // who was asked to do something
extern int    deadflag;             // 0=alive, 1=dead, 2+=custom death
extern int    score;                // current score
extern int    turns;                // number of game turns elapsed
extern int    the_time;             // time in minutes since midnight
extern int    time_rate;            // how often time updates
extern int    lookmode;             // verbosity: 1=brief, 2=verbose, 3=superbrief

//-- Parser results -----------------------------------------------------------
extern object       noun;           // first noun
extern object       second;         // second noun
extern verb         action;         // current action being performed
extern int    parsed_number;        // user-supplied number
extern int    consult_from;         // start word of consult topic
extern int    consult_words;        // number of words in topic
extern int    special_word;         // dictionary address for "special" token
extern int    special_number;       // number typed for "special" token
extern int    verb_word;            // the verb word
extern int    verb_wordnum;         // verb position in input
extern int    wn;                   // word number currently being parsed
extern int    num_words;            // number of words typed
extern int    keep_silent;          // suppress action output
extern property selected_direction; // direction chosen for Go action — holds the
                                    // property slot ID (n_to, s_to, ...). Compare with
                                    // `(property)n_to` to bypass the bare-name lookup
                                    // that would otherwise yield `self.n_to`'s value.
extern int    selected_direction_index; // 1-based: 1=N, 2=S, 3=E, 4=W, 5=NE, 6=NW, 7=SE, 8=SW, 9=U, 10=D, 11=IN, 12=OUT

//-- Direction properties -----------------------------------------------------
// PunyInform diverges from the I6 standard library: there are no `n_obj`,
// `s_obj`, etc. objects. Direction commands set `selected_direction` to the
// matching direction *property* (n_to, s_to, ...), and `noun` to the shared
// `Directions` placeholder. The idiomatic check is:
//   if (selected_direction == n_to) { ... }
// rather than the stdlib `if (noun == n_obj)`.
extern property n_to;
extern property s_to;
extern property e_to;
extern property w_to;
extern property ne_to;
extern property nw_to;
extern property se_to;
extern property sw_to;
extern property u_to;
extern property d_to;
extern property in_to;
extern property out_to;

//-- Fake direction-object constants ------------------------------------------
// Sentinel values used internally by the puny parser to represent
// not-yet-a-real-object direction references. Exposed for advanced parser
// hooks (BeforeParsing etc.); most code uses `selected_direction` instead.
extern const int FAKE_N_OBJ;
extern const int FAKE_S_OBJ;
extern const int FAKE_E_OBJ;
extern const int FAKE_W_OBJ;
extern const int FAKE_NE_OBJ;
extern const int FAKE_NW_OBJ;
extern const int FAKE_SE_OBJ;
extern const int FAKE_SW_OBJ;
extern const int FAKE_U_OBJ;
extern const int FAKE_D_OBJ;
extern const int FAKE_IN_OBJ;
extern const int FAKE_OUT_OBJ;
extern object    Directions;     // shared placeholder bound to `noun` for direction commands

//-- Pronoun tracking ---------------------------------------------------------
extern object itobj;                // object currently referred to as "it"
extern object himobj;               // object currently referred to as "him"
extern object herobj;               // object currently referred to as "her"
extern object themobj;              // object currently referred to as "them"

//-- Notifications and modes --------------------------------------------------
extern int    notify_mode;          // score notification on/off
extern int    inventory_style;      // inventory display style
extern int    debug_flag;           // debug mode flag
extern int    screen_width;         // screen width in characters
extern int    statusline_height;    // status line height

//-- Colour settings (z5+ only) -----------------------------------------------
extern int    clr_on;              // set to true to enable colours
extern int    clr_bg;              // background colour
extern int    clr_fg;              // foreground colour
extern int    clr_fginput;         // player input colour (PUNY++)
extern int    clr_fgstatus;        // status line colour

//-- Colour constants ---------------------------------------------------------
extern const int CLR_BLACK;
extern const int CLR_RED;
extern const int CLR_GREEN;
extern const int CLR_YELLOW;
extern const int CLR_BLUE;
extern const int CLR_MAGENTA;
extern const int CLR_CYAN;
extern const int CLR_WHITE;
extern const int CLR_DEFAULT;
extern const int CLR_CURRENT;

//-- Ozmoo extended colours (PUNY++) ------------------------------------------
extern const int CLR_OZMOO_ORANGE;
extern const int CLR_OZMOO_BROWN;
extern const int CLR_OZMOO_LIGHT_RED;
extern const int CLR_OZMOO_DARK_GREY;
extern const int CLR_OZMOO_MEDIUM_GREY;
extern const int CLR_OZMOO_LIGHT_GREEN;
extern const int CLR_OZMOO_LIGHT_BLUE;
extern const int CLR_OZMOO_LIGHT_GREY;

//-- Window constants ---------------------------------------------------------
extern const int WIN_ALL;
extern const int WIN_STATUS;
extern const int WIN_MAIN;

//-- Scoring ------------------------------------------------------------------
extern int    things_score;         // score from picking up scored objects
extern int    places_score;         // score from visiting scored rooms

//-- Objects ------------------------------------------------------------------
extern object thedark;              // the darkness object (in-scope when no light)
extern object selfobj;              // the player self object

//-- Standard grammar tokens --------------------------------------------------
// Both bare (held) and qualified (grammarToken.held) access work; lexical scope
// wins so a local/param of the same name doesn't collide.
extern enum grammarToken {
    /// Any in-scope object.
    noun,
    /// An object the actor is currently holding.
    held,
    /// An animate object — one with the `animate` attribute.
    creature,
    /// A free-form topic phrase (any sequence of words the player types).
    topic,
    /// One or more in-scope objects.
    multi,
    /// One or more held objects.
    multiheld,
    /// Multiple in-scope objects, excluding one already matched (commonly used after a preposition).
    multiexcept,
    /// Multiple objects inside a specific container.
    multiinside,
    /// A number or a single dictionary word.
    special,
    /// Any number typed by the player (no range check).
    anynumber,
    /// A number typed by the player (range-checked to fit a word).
    number,
    /// Placeholder marker — use the `scope=Routine` form on a real grammar line to set scope.
    scope,
    /// Action-target modifier — must appear as the LAST element of a grammar line literal,
    /// e.g. `{.give, creature, held, reverse}`. Emits I6's `-> Action reverse`, which swaps
    /// `noun` and `second_noun` before the action routine runs (so `give X to Y` and
    /// `give Y X` both land X in `noun`, Y in `second_noun`). Not a pattern token — does
    /// not match user input. Compile error if it appears anywhere other than last.
    reverse
}

//-- Standard game actions ----------------------------------------------------
extern verb Answer { .answer|.say|.speak }                          // answer <topic> to <creature>
extern verb Ask { .ask }                                            // ask <creature> about <topic>
extern verb AskFor { .ask }                                         // ask <creature> for <noun>
extern verb AskTo { .ask|.tell }                                    // ask/tell <creature> to <topic>
extern verb Attack { .attack|.break|.crack|.destroy|.fight|.hit|.kill|.murder|.punch|.smash|.thump|.torture|.wreck }  // attack / hit / kill <noun>
extern verb Blow { .blow }                                          // blow <held>
extern verb Burn { .burn|.light }                                   // burn / light <noun>
extern verb Buy { .buy|.purchase }                                  // buy / purchase <noun>
extern verb Climb { .climb|.scale }                                 // climb / scale <noun>
extern verb Close { .close|.cover|.shut }                           // close / shut <noun>
extern verb Consult { .consult }                                    // consult <noun> about <topic>
extern verb Cut { .cut|.chop|.prune|.slice }                        // cut / chop <noun>
extern verb Dig { .dig }                                            // dig <noun>
extern verb Disrobe { .shed|.disrobe|.doff }                        // shed / doff / disrobe <held>
extern verb Drink { .drink|.sip|.swallow }                          // drink / sip <noun>
extern verb Drop { .drop|.discard|.throw }                          // drop <multiheld> (puny folds 'throw' into the drop verb)
extern verb Eat { .eat }                                            // eat <held>
extern verb Empty { .empty }                                        // empty <noun>
extern verb EmptyT { .empty }                                       // empty <noun> into <noun>
extern verb Enter { .enter|.sit|.lie }                              // enter / sit on / lie on <noun>
extern verb Examine { .examine|.x|.read }                           // examine / x / read <noun>
extern verb Exit { .exit|.leave|.stand }                            // exit / leave / stand up
extern verb Fill { .fill }                                          // fill <noun>
extern verb GetOff { .get }                                         // get off <noun>
extern verb Give { .give|.feed|.offer|.pay }                        // give <held> to <creature>
extern verb Go { .go }                                              // go <direction>
extern verb GoIn { .enter|.in|.inside }                             // go in / enter
extern verb GoNear { .gonear }                                      // (debug) go to/near <object>
extern verb Going;              // synthetic action fired during movement (Fake_Action);
                                // before/after on rooms see selected_direction
extern verb Goto { .goto }                                          // (debug) goto <object>
extern verb Insert { .insert }                                      // insert <noun> into <noun>
extern verb Inv { .inventory|.i }                                   // inventory / i
extern verb Jump { .jump }                                          // jump
extern verb JumpOver { .jump }                                      // jump over <noun>
extern verb Kiss { .kiss|.embrace|.hug }                            // kiss / hug <creature>
extern verb LetGo;              // synthetic; fires on the source when an object
                                // is taken (Fake_Action, counterpart of Receive)
extern verb Listen { .listen }                                      // listen
extern verb Lock { .lock }                                          // lock <noun> with <held>
extern verb Look { .look|.l }                                       // look / l
extern verb Mild { .bother|.curses|.darn|.drat }                    // mild expletive
extern verb No { .no }                                              // no
extern verb Open { .open|.uncover|.unwrap }                         // open <noun>
extern verb Pray { .pray }                                          // pray
extern verb Pull { .pull|.drag }                                    // pull / drag <noun>
extern verb Push { .push|.clear|.move|.press|.shift }               // push / move <noun>
extern verb PushDir { .push|.clear|.move|.press|.shift }            // push <noun> <direction>
extern verb PutOn { .put|.place }                                   // put <noun> on <noun>
extern verb Receive;            // synthetic; fires on the destination when an
                                // object is placed inside or onto it (Fake_Action)
extern verb Remove { .remove }                                      // remove <noun> from <noun>
extern verb Rub { .rub|.clean|.dust|.polish|.scrub|.shine|.sweep|.wipe }  // rub / clean / polish <noun>
extern verb Search { .search }                                      // search <noun>
extern verb Set { .set|.adjust }                                    // set / adjust <noun>
extern verb SetTo { .set|.adjust }                                  // set <noun> to <value>
extern verb Shout { .shout|.scream|.yell }                          // shout
extern verb ShoutAt { .shout|.scream|.yell }                        // shout at <creature>
extern verb Show { .show|.display|.present }                        // show <held> to <creature>
extern verb Sing { .sing }                                          // sing
extern verb Sleep { .sleep|.nap }                                   // sleep / nap
extern verb Smell { .smell|.sniff }                                 // smell / sniff
extern verb Sorry { .sorry }                                        // sorry
extern verb Squeeze { .squeeze|.squash }                            // squeeze / squash <noun>
extern verb Strong { .shit|.damn|.fuck|.sod }                       // strong expletive
extern verb Swim { .swim|.dive }                                    // swim / dive
extern verb Swing { .swing }                                        // swing <noun>
extern verb SwitchOff { .switch|.turn }                             // switch <noun> off / turn off <noun>
extern verb SwitchOn { .switch|.turn }                              // switch <noun> on / turn on <noun>
extern verb Take { .take|.carry|.hold|.get|.pick|.peel }            // take / get / pick up <noun>
extern verb Taste { .taste }                                        // taste <noun>
extern verb Tell { .tell }                                          // tell <creature> about <topic>
extern verb Think { .think }                                        // think
extern verb ThrowAt { .throw }                                      // throw <held> at <noun>
extern verb ThrownAt;           // synthetic; fires on the target after ThrowAt (Fake_Action)
extern verb Tie { .tie|.attach|.fasten|.fix }                       // tie / attach <noun> to <noun>
extern verb Touch { .touch|.feel|.fondle|.grope }                   // touch / feel <noun>
extern verb Transfer { .transfer }                                  // transfer <noun> to <noun>
extern verb Turn { .turn|.rotate|.screw|.twist|.unscrew }           // turn / rotate <noun>
extern verb Unlock { .unlock|.pry|.prise|.prize|.lever|.jemmy|.force }  // unlock / pry open <noun> with <held>
extern verb Wait { .wait|.z }                                       // wait / z
extern verb Wake { .wake|.awake|.awaken }                           // wake / awake
extern verb WakeOther { .wake|.awake|.awaken }                      // wake <creature>
extern verb Wave { .wave }                                          // wave <noun>
extern verb WaveHands { .wave }                                     // wave (no object)
extern verb Wear { .wear }                                          // wear <held>
extern verb Yes { .yes|.y }                                         // yes

//-- Synthetic / parser actions ------------------------------------------------
// These actions are set by the parser itself (not bound to a verb word). They
// surface as `case Again:`/`case Oops:` etc. in user-side action handlers.
extern verb Again { .again|.g }                                     // again / g — repeat last command
extern verb Oops { .oops }                                          // oops <word> — correct a misspelled word
extern verb OopsCorrection;     // synthetic; fired after Oops applies (no verb word of its own)

//-- Meta actions -------------------------------------------------------------
extern verb Quit { .quit|.q }                                       // quit / q
extern verb Restart { .restart }                                    // restart
extern verb Restore { .restore }                                    // restore
extern verb Save { .save }                                          // save
extern verb Score { .score }                                        // score
extern verb FullScore { .fullscore|.full }                          // fullscore / full
extern verb Version { .version }                                    // version
extern verb Verify { .verify }                                      // verify
extern verb ScriptOn { .script|.transcript }                        // script / transcript (on)
extern verb ScriptOff { .noscript|.unscript }                       // noscript / unscript
extern verb Pronouns { .pronoun|.pronouns }                         // pronoun / pronouns
extern verb LookModeNormal { .brief|.normal }                       // brief / normal
extern verb LookModeShort { .superbrief|.short }                    // superbrief / short
extern verb LookModeLong { .verbose|.long }                         // verbose / long
extern verb NotifyOn { .notify }                                    // notify / notify on
extern verb NotifyOff { .notify }                                   // notify off

//-- Debug actions ------------------------------------------------------------
// Available only when the puny debug feature constants are defined; declared
// here so user code can reference them under the same conditional.
extern verb ActionsOn { .actions }                                  // actions / actions on
extern verb ActionsOff { .actions }                                 // actions off
extern verb CommandsOn { .recording }                               // recording / recording on
extern verb CommandsOff { .recording }                              // recording off
extern verb CommandsRead { .replay }                                // replay
extern verb Debug { .debug }                                        // debug
extern verb Forest { .forest }                                      // forest
extern verb Tree { .tree }                                          // tree
extern verb Objects { .objects }                                    // objects
extern verb Places { .places }                                      // places
extern verb Purloin { .purloin }                                    // purloin <noun>
extern verb RandomSeed { .random }                                  // random / random seed <number>
extern verb Rooms { .rooms }                                        // rooms
extern verb RoutinesOn { .routines|.messages }                      // routines / routines on
extern verb RoutinesOff { .routines|.messages }                     // routines off
extern verb Scope { .scope }                                        // scope
extern verb TimersOn { .timers|.daemons }                           // timers / daemons on
extern verb TimersOff { .timers|.daemons }                          // timers / daemons off

//-- Map beguilerSettings metadata to PunyInform constants ----------------------
// Hoisted via #emitfirst so the constants appear ABOVE the user's #includeI6
// "puny" / "globals" directives — PunyInform's library reads Story/Headline
// during its own include processing for the compile-time banner. If declared
// after the include they'd be orphan constants ("declared but not used") and
// the banner would fall back to defaults.
#emitfirst {
    Constant story    = ##beguilerSettings.title;
    Constant headline = ##beguilerSettings.headline;
} 

#emitfirst{
    replace main _oldmain;
}
#emitlast{
    [main; 
        bglInit();
        _oldmain();
    ];
}