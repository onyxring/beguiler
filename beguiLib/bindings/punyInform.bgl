//-- Fake actions (no grammar)
extern verb Going { }          /// Runs on rooms as the player moves; see selected_direction.
extern verb LetGo { }          /// Runs on the container or supporter when noun is taken from it.
extern verb Receive { }        /// Runs on the container or supporter when noun is put on or in it.
extern verb ThrownAt { }       /// Runs on second when noun is thrown at it.
extern verb Order { }          /// Runs on a character told to do something it has no orders for.
extern verb PluralFound { }    /// Tells parse_name that a plural word matched.
extern verb NotUnderstood { }  /// Runs when a command to a character is not understood.
extern verb OopsCorrection;  /// replace the mistyped word with second (meta)

//-- General bits of I6-to-Beguile setup ----------------------------------------

// stringOrRoutine is a convenience union type, since the library uses this pattern regularly.
union stringOrRoutine = string | func<void> {
    emitter bool isRoutine() { metaclass($val) == Routine }
}
emitter void print(stringOrRoutine v){
    if(metaclass($v) == Routine) $v();
    else print (string)$v;
}
// The library lets every object override its instanceName with the short_name property.
extend extern class object {
    stringOrRoutine short_name;
}

// The story title and headline fields in the beguilerSettings block serve Treaty of Babel metadata. Let's reuse these and keep their definitions all the same.
#emitfirst {
    Constant story    = ##beguilerSettings.title;
    Constant headline = ##beguilerSettings.headline;
}

// Substitute the library's backing for the status bar, replacing Beguile's core behavior for this.
extend _bglStatus {
    replace auto id = null;
    replace auto height = {
        int operator()        { return statusline_current_height; }
        void operator = (int v){ statusline_height = v; _StatusLineHeight(v); }
    }
}

// Automatically start up the Beguile run-time environment, unless the program asked to do it itself.
#if bglAutoInitialize
    #emitfirst{
        replace main _oldmain;
    }
    #emitlast{
        [main;
            bglInit();
            _oldmain();
        ];
    }
#endif