//-----------------------------------------------------------------------------
// bglWorld.bgl — object-tree queries that replace I6's `objectloop`.
//
// Auto-included by the core (see __beguileCore.bgl), so `bgl.world` is available
// in every Beguile game with no `#include`.
//
//   for(object o in bgl.world.getAll())            { ... }   // all objects
//   for(object o in bgl.world.inParent(location))  { ... }   // children of a room
//   for(object o in bgl.world.instances(Animal))   { ... }   // objects ofclass
//   for(object o in bgl.world.instances(Animal,
//                       (object o) => o.parent==cage)) { ... } // + inline predicate
//
// Each query walks the tree, fills a scratch buffer, and returns it as a tracked
// `array<object>` — so every <array>/<linq> op works on the result. The optional
// `func<bool, object>` predicate runs INSIDE the walk, so non-matching objects
// never reach the buffer.
//
// Beguile-native: the routine shells, the rotating buffer pool, and the trailer
// stamping are all Beguile. The only I6 left is the `objectloop` core of each
// query — an irreducible primitive (Beguile has no all-objects iterator) — and
// the trailer write (below the array surface). Queries and buffers are
// `superposed`, and `bgl.world` is a compile-time-only alias (no runtime property),
// so the whole thing gates on actual use: a game that never calls bgl.world emits
// none of it.
//
// SHARED rotating scratch (4 buffers, 128 objects each): a nested query inside a
// `for(o in bgl.world…)` loop gets a different buffer than the live outer one.
// Tolerates up to (pool − 1) concurrent live iterations. Don't store a result
// across turns; snapshot into your own `array<object>` for deep nesting or large
// worlds (walks that exceed 128 stop silently).
//-----------------------------------------------------------------------------
#once
#include <array>

// Scratch pool — superposed. (Fixed 128/buffer: a Beguile array size must be a
// literal, so the former #beguilerSettings.worldBufSize knob is gone — edit the
// [128]s to resize.)
superposed array<object> _bglWorldBuf0[128];
superposed array<object> _bglWorldBuf1[128];
superposed array<object> _bglWorldBuf2[128];
superposed array<object> _bglWorldBuf3[128];
// Rotation index: a plain global. A superposed scalar Global can't be forward-referenced
// by the routine that uses it (I6 wants it declared first); arrays forward-reference fine.
int _bglWorldBufIdx = -1;

// Advance the rotation and hand back the next buffer in the pool.
superposed array<object> _bglWorldNextBuf(){
    _bglWorldBufIdx = (_bglWorldBufIdx + 1) % 4;
    switch(_bglWorldBufIdx){
        case 0: return _bglWorldBuf0;
        case 1: return _bglWorldBuf1;
        case 2: return _bglWorldBuf2;
        case 3: return _bglWorldBuf3;
    }
    return _bglWorldBuf0;
}

// Stamp the tracked-array trailer (magic + length) on a freshly-filled buffer.
// Raw #i6 because the length/magic slots live below the user-visible array surface
// (buf-->0 is the allocated size; length at -1, magic at -0).
superposed void _bglWorldStamp(array<object> buf, int count){
    #i6 {
        buf-->(buf-->0)     = $9084;
        buf-->(buf-->0 - 1) = count;
    }
}

// Walk ALL objects. `objectloop(o)` is an irreducible I6 primitive (Beguile has no
// all-objects iterator — child/sibling only reach tree-attached objects).
superposed array<object> _bglWorldGetAll(var pred){
    array<object> buf = _bglWorldNextBuf();
    object o;
    int n = 0;
    #i6 {
        objectloop(o) {
            if(n >= buf-->0 - 2) break;
            if(pred == 0 || indirect(pred, o)) { n++; buf-->n = o; }
        }
    }
    _bglWorldStamp(buf, n);
    return buf;
}

// Walk objects of a class.
superposed array<object> _bglWorldInstances(var cls, var pred){
    array<object> buf = _bglWorldNextBuf();
    object o;
    int n = 0;
    #i6 {
        objectloop(o ofclass cls) {
            if(n >= buf-->0 - 2) break;
            if(pred == 0 || indirect(pred, o)) { n++; buf-->n = o; }
        }
    }
    _bglWorldStamp(buf, n);
    return buf;
}

// Walk children of `parent`.
superposed array<object> _bglWorldInParent(object parent, var pred){
    array<object> buf = _bglWorldNextBuf();
    object o;
    int n = 0;
    #i6 {
        objectloop(o in parent) {
            if(n >= buf-->0 - 2) break;
            if(pred == 0 || indirect(pred, o)) { n++; buf-->n = o; }
        }
    }
    _bglWorldStamp(buf, n);
    return buf;
}

// Public surface — bgl.world.getAll()/inParent()/instances(). Non-emitter because
// `emitter array<T>` is only accepted on `extend extern class array`.
superposed _bglObject _bglWorld {
    array<object> getAll(func<bool, object> pred = 0)            { return _bglWorldGetAll(pred); }
    array<object> inParent(object p, func<bool, object> pred = 0){ return _bglWorldInParent(p, pred); }
    array<object> instances(var cls, func<bool, object> pred = 0){ return _bglWorldInstances(cls, pred); }
}

extend bgl { alias world = _bglWorld; }
