#once
/*============================================================================
  beguiLib / bglStdLib / bglStdLib.bgl

  Umbrella include for the Beguile Standard Library.  A game pulls the whole
  library with `#include <bglStdLib>`.  Files are listed in dependency order,
  the same shape core uses in __beguileCore.bgl (siblings do not cross-include;
  the umbrella orders them).
  ============================================================================*/

#include <bglStdLib/_verdict>     // eVerdict - the outcome every rule returns
#include <bglStdLib/_rulebook>    // runRulebook - the generic rulebook runner
#include <bglStdLib/_gameLoop>    // rootRulebook / gameTurnRulebook + entry point
