//===================================================================================================
// topics.bgl — NPC conversation topics, converted from topics.inf to Beguile.
//---------------------------------------------------------------------------------------------------
// dialogueTopic data for dialogue.bgl. A topic = the words the player types (`name`) + a `quip`
// response (a string, or a `bool quip(object actor, object talkingTo)` routine override). The I6
// `->`/`->->` tree is kept with `parent = <group>`; dialogueTopic resolves context/knownBy up the
// parent tree. Routine quips return false (the engine ignores the return and prints `^^` after); an
// I6 bare-string early-exit (`"msg";` = print_ret) becomes `rtrue("msg^")`.
//
//===================================================================================================
#using bgl.printRules;   // {italics} / {roman} in interpolated text

// (The objects referenced here — monkeys/blindStatue/deafStatue/muteStatue/etchedEar/mama/
// yellowMonkey/cliffWallSouth/grok/keys — are all native Beguile in the world-area files; the
// two-pass compiler resolves them cross-file, so no forward declarations are needed.)

// Game-only properties added to topics by this game.
extend class dialogueTopic {
    string humanTranslation;        // blindStatue translator mechanic: the English version...
    string monkeyTranslation;       // ...and monkey-speak
}

// root of the SAY topics
dialogueTopic knownBySelf { ""; knownBy = selfObj; }

//------------------------------------------------------------------- SAY to the Monkeys ------------
dialogueTopic contextMonkeys { "", knownBySelf; context = monkeys; }

dialogueTopic topSayMonkeyKeys {
    "", contextMonkeys;   // car keys, in monkey-speak
    name = {.jeezee, .otch, .jay, .jar, .jowel};
    bool quip() {
        print("Carefully you repeat the statue’s nonsensical sounds to the hidden monkeys chittering above the jungle canopy: “Jeezee otch, jay jay jar jowel.”^^The screeching monkeys all grow silent, and an upside-down monkey appears from the canopy above. “Jera jera morkta limoth,” it says to you. Another hanging monkey appears, some distance from the other. “Jo martah zerlo tedet haz,” the second monkey says, and points adamantly to the cliff wall.^^You repeat the monkey syllables, memorizing them, as the monkeys disappear into the branches above. The chittering resumes.^");
        achieved(taskSpeakWithMonkeys);
        achieved(taskSayMonkeyWords);
        return false;
    }
}
dialogueTopic topSayMonkeyBanana {
    "", contextMonkeys;   // banana, in monkey-speak
    name = {.hua, .chichi, .bine, .oca, .muwato};
    quip = "You ask about the banana and secret words in monkey-speak. “Hua chichi bine oca muwato.”^^The unseen army grows silent. A single monkey appears from the canopy, a different one from before. “Soopah yaho jheje,” it replies. “Fatha moortha sinjas.”  Then the monkey is gone and the jungle noises resume.";
}
dialogueTopic topSayMonkeyMama {
    "", contextMonkeys;   // Mama Ciedue, in monkey-speak
    name = {.toodas, .bojo};
    quip = "“Bojo toodas,” you say to the canopy.^^The noises above never stop, but you make out the reply: “Cho co da.”";    
}
dialogueTopic topSayMonkeyHello {
    "", contextMonkeys;   // Hello, in english
    name = {.hello, .hi, .greetings, .greeting};
    quip = "“Hello?” you call out to the monkeys above. There’s a momentary pause, as if the monkeys are trying to make sense of you, then they resume ignoring you altogether.";
}
dialogueTopic topSayMonkeyGrok {
    "", contextMonkeys;   // grok, in monkey-speak
    name = {.sparow, .fuptar, .jork, .nar};
    quip = "“Sparow fuptar jork nar!” you cry out to the monkeys above.^^The chittering never stops, but a single monkey lowers itself from the treetops and points at the cliff wall. Then disappears into the canopy.";
}
dialogueTopic topSayMonkeyNest {
    "", contextMonkeys;   // nest of the ancient, in monkey-speak
    name = {.floorp, .juret, .nooxta, .jeeju};
    quip = "“Floorp juret nooxta jeeju!” you say to the monkeys above.^^One monkey lowers itself and points at the cliff wall, then returns to the treetops.";
}
dialogueTopic topSayMonkeyCanopy {
    "", contextMonkeys;   // canopy monkeys, in monkey-speak
    name = {.shazo, .archima};
    quip = "“Shazo archima,” you repeat, asking the canopy monkeys about themselves. A single monkey lowers from the canopy. It points one finger at itself and raises its eyebrows as if surprised by the question.  Then it shrugs and ascends into the treetops without answering.";
}
dialogueTopic topSayMonkeyMurk {
    "", contextMonkeys;   // murk, in monkey-speak
    name = {.filep, .jace, .shatop, .lope};
    quip = "“Filep jace shatop lope,” you say, asking about the baby monkeys. Several monkeys lower from the treetops, each with proud smiles on their faces, but only one speaks. “Thray cha loo tars jhen dayt sootchach.” Then all monkeys disappear into the canopy.";    
}
dialogueTopic topSayMonkeyTranslate {
    "", contextMonkeys;   // to translate 
    name = {.gheezar, .oochap, .bootna};
    quip = "“Gheezar gheezar oochap bootna,” you say to the monkeys.^^There’s an abrupt silence, then a single monkey lowers itself from the treetops with an irritated expression. “Oogok bayjooj yatai noodoach,” it says, then disappears back up into the canopy. The monkey chittering resumes.";    
}
dialogueTopic topSayMonkeyEcho {
    "", contextMonkeys;
    name = {.jera, .morkta, .limoth, .jo, .martah, .zerlo, .tedet, .haz, .soopah, .yaho, .jheje, .fatha, .moortha, .sinjas, .cho, .co, .da, .jajoo, .baha, .hatze};
    quip = "You repeat the monkeys’ own words back to them with perfect pronunciation.  An upside-down monkey drops below the canopy, nods his approval, then retreats.";
}

//------------------------------------------------------------------- SAY to the blindStatue --------
dialogueTopic contextBlindStatue { "", knownBySelf; context = blindStatue; }

dialogueTopic topBlindKeysGrok {
    "", contextBlindStatue;   // to translate monkey-speak: keys are with grok
    name = {.jera, .morkta, .limoth, .jo, .martah, .zerlo, .tedet, .haz};
    bool quip() {
        topBananaSecretWords.knownBy = blindStatue;
        print("You speak the two canopy monkeys’ responses into the statue’s ear. “Jera jera morkta limoth, jo martah zerlo tedet haz.”^^The statue translates:^^“Car keys...? You mean the shinys? Grok took them because he likes shinys. He keeps them in the nest of the ancients. You’ll need Blind Mama Ciedue’s flat banana and secret monkey words if you want your shinys back.”^^You consider this... Grok must be the name of the yellow monkey, but the flat banana? Secret monkey words? Feeling more confident, you speak into the translating statue’s ear: “Where is the flat banana and what are the secret monkey words?”^^The monkey statue pauses for a moment, then replies: “Hua chichi bine oca muwato.”^");
        achieved(taskSayMonkeyWords);
        return false;
    }
}
dialogueTopic topBlindSecretWords {
    "", contextBlindStatue;   // to translate monkey-speak: secret words?
    name = {.soopah, .yaho, .jheje, .fatha, .moortha, .sinjas};
    bool quip() {
        print($"You repeat the monkeys’ words to the statue: “Soopah yaho jheje. Fatha moortha sinjas.”^^It responds: “You’re getting pretty good at talking Monkey, Man,” it translates. “But I can’t say the secret words because they’re {italics}SECRET{roman}. The flat banana knows them, if you can find it. Mama Ciedue can help.”^");
        return false;
    }
}
dialogueTopic topBlindMama {
    "", contextBlindStatue;   // to translate monkey-speak: mama?
    name = {.cho, .co, .da};
    quip = "“Cho co da,” you say.^^“Dunno,” the statue translates. “She’s around. Maybe ask someone else and they’ll show you.”";
}
dialogueTopic topBlindNoUnderstand {
    "", contextBlindStatue;   // to translate monkey-speak: we don’t understand
    name = {.jajoo, .baha, .hatze};
    bool quip() {
        print("You think carefully, recalling the monkey’s nonsensical syllables and repeat them into the statue’s ear: “Jajoo jajoo baha hatze...”^^A moment passes as the statue, hands covering its eyes, considers. Then a string of words flows from its mouth, translating what the canopy monkeys said: “We don’t understand what you’re trying to say. We don’t talk Man. Come back when you talk Monkey.”^");
        achieved(taskSayMonkeyWords);
        return false;
    }
}
dialogueTopic topBlindMoreFun {
    "", contextBlindStatue;   // to translate monkey-speak: whats more fun
    name = {.zachoo, .zaidsho, .nomi};
    quip = "“Zachoo zaidsho nomi nomi,” you say to the statue.^^“What’s more fun than that?” it translates back to you.";
}
dialogueTopic topBlindOpenSesame {
    "", contextBlindStatue;   // to translate monkey-speak: open sesame
    name = {.ayee, .nuka, .bawh};
    quip = "“Ayee ayee nuka bawh,” you say to the statue.^^“Open sesame,” it translates back to you.";
}
dialogueTopic topBlindPrevDeath {
    "", contextBlindStatue;   // to translate monkey-speak: previous death
    name = {.hachh, .ah, .ow, .ack, .hooow};
    bool quip() {
        print($"Some words come to mind and you speak them to the blind monkey statue: “Hachh ow ah ow ack hachh hooow!”^^Dutifully it translates: “Take that Man! That’s what you get for challenging Grok! A beating so hard you’ll remember it in the next life!”^^Beating?  Next life?  A wave of {italics}déjà vu{roman} washes over you. How did you even know the monkey words you asked?  Must be your imagination playing games with you.^");
        return false;
    }
}
dialogueTopic topBlindPrevWin {
    "", contextBlindStatue;   // to translate monkey-speak: previous win
    name = {.eek, .arck, .jarg};
    quip = "I’m pretty sure I’m going to already have had this conversation with you, but you don’t need a translator to know this is bad.  Congratulations on your previous win, though.";
}
dialogueTopic topBlindFullMama {
    "", contextBlindStatue;   // to translate monkey-speak
    name = {.bojo, .toodas};
    quip = "“Where is Mama Ciedue?” translates the statue.";
}
dialogueTopic topBlindFullKeys {
    "", contextBlindStatue;   // to translate monkey-speak
    name = {.jeezee, .otch, .jay, .jar, .jowel};
    quip = "“Where are my car keys?” the statue says, translating your monkey words back into Man-speak.";
}
dialogueTopic topBlindFullOpenSesame {
    "", contextBlindStatue;   // to translate open sesame
    name = {.open, .sesame};
    quip = "“Secret words,” the statue says. Nice try, though.";
}
dialogueTopic topBlindBanana {
    "", contextBlindStatue;   // banana, in monkey-speak
    name = {.hua, .chichi, .bine, .oca, .muwato};
    quip = "You repeat the statue’s words back to it: “Hua chichi bine oca muwato.”^^The statue replies with your own words: “Tell me about the flat banana, and the secret words.”";
}
dialogueTopic topBlindGrok {
    "", contextBlindStatue;   // grok, in monkey-speak
    name = {.sparow, .fuptar, .jork, .nar};
    quip = "“Sparow fuptar jork nar,” you give back to the statue.  It responds: “Where is the yellow monkey?”";
}
dialogueTopic topBlindNest {
    "", contextBlindStatue;   // nest, in monkey-speak
    name = {.floorp, .juret, .nooxta, .jeeju};
    quip = "“Floorp juret nooxta jeeju,” you give back to the statue.  It responds: “Where is the nest of the ancients?”";
}
dialogueTopic topBlindBabies {
    "", contextBlindStatue;   // monkey-babies, in monkey-speak
    name = {.thray, .cha, .loo, .tars, .jhen, .dayt, .sootchach};
    quip = "“Thray cha loo tars jhen dayt sootchach,” you say, repeating the monkey’s words to the statue. It translates: “They are a fine group. When Mama Ciedue is done teaching them, they will join us here in the canopy.”";
}
dialogueTopic topBlindOvaltine {
    "", contextBlindStatue;   // to translate 
    name = {.gheezar, .oochap, .bootna};
    bool quip() {
        print($"“Gheezar gheezar oochap bootna,” you say to the statue.^^It thinks for a moment, then translates: “Be sure to drink your Ovaltine.”^^{italics}A crummy commercial?{roman} you think to yourself.^");
        return false;
    }
}
dialogueTopic topBlindTeasers {
    "", contextBlindStatue;   // to translate 
    name = {.oogok, .bayjooj, .yatai, .noodoach};
    quip = "“Oogok bayjooj yatai noodoach,” you say, repeating to the statue the monkeys’ response to your words.^^After a pause, it translates: “We think you are confused, Man. Monkeys are not teased; they are the teasers.”";
}
dialogueTopic topBlindHello {
    "", contextBlindStatue;   // Hello, in english
    name = {.hello, .hi, .greetings, .greeting};
    quip = "“Hello!” you greet the statue, but it doesn’t respond. Perhaps it considers itself above such conversational fluff.";
}

