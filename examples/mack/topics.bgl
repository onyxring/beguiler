    name = {.jeezee, .otch, .jay, .jar, .jowel, .hua, .chichi, .bine, .oca, .muwato, .toodas, .bojo, .sparow, .fuptar, .jork, .nar, .floorp, .juret, .nooxta, .jeeju, .shazo, .archima, .filep, .jace, .shatop, .lope, .gheezar, .oochap, .bootna};
    quip = "You repeat the words you heard from the blind statue to the deaf statue, but it does not respond. Perhaps it cannot hear you with its paws covering its ears.";
}

//------------------------------------------------------------------- SAY to the muteStatue ---------
dialogueTopic contextMuteStatue { "", knownBySelf; context = muteStatue; }

dialogueTopic topMuteBanana {
    "", contextMuteStatue;   // to translate monkey-speak
    name = {.hua, .chichi, .bine, .oca, .muwato};
    bool quip() {
        if(isAchieved(taskHiddenPathRevealed)) rtrue("You speak the monkey words, but nothing happens. The statue seems content with what it has already shown you.^");
        print("You ask about the banana and secret words in monkey-speak: “Hua chichi bine oca muwato.”^^For a moment, nothing happens, then the statue begins to turn. With a low rumble, it rotates on a hidden pivot point until facing east. Its eyes come to life, shining a beam of light through the greenery and revealing a previously unseen path.^");
        achieved(taskHiddenPathRevealed);
        gameState.setTrue(taskHiddenPathRevealed);
        muteStatue.state = banana;
        muteStatue.name[0] = .beam;
        muteStatue.name[1] = .light;
        return false;
    }
}
dialogueTopic topMuteMama {
    "", contextMuteStatue;   // to translate monkey-speak
    name = {.toodas, .bojo};
    bool quip() {
        if(isAchieved(taskHiddenPathRevealed)) rtrue("You speak the monkey words, but nothing happens. The statue seems content with what it has already shown you.^");
        print("“Bojo toodas,” you say, asking about Mama Ciedue in monkey-speak.^^Somewhere beneath the surface you can feel the turning of unseen workings. The statue seems to come to life and rotates before coming to rest, facing east. From its eyes shines a beam of light through the greenery, revealing a previously unseen path.^");
        achieved(taskHiddenPathRevealed);
        gameState.setTrue(taskHiddenPathRevealed);
        muteStatue.state = mama;
        muteStatue.name[0] = .beam;
        muteStatue.name[1] = .light;
        return false;
    }
}
dialogueTopic topMuteMonkeyWords {
    "", contextMuteStatue;
    name = {.jera, .morkta, .limoth, .jo, .martah, .zerlo, .tedet, .haz, .soopah, .yaho, .jheje, .fatha, .moortha, .sinjas, .cho, .co, .da, .jajoo, .baha, .hatze};
    quip = "You repeat the words you heard from the canopy monkeys to the statue, but it does not respond. Perhaps it has no way to respond to this with only its eyes.";
}
dialogueTopic topMuteBlindWords {
    "", contextMuteStatue;
    name = {.jeezee, .otch, .jay, .jar, .jowel, .sparow, .fuptar, .jork, .nar, .floorp, .juret, .nooxta, .jeeju, .shazo, .archima, .filep, .jace, .shatop, .lope, .gheezar, .oochap, .bootna};
    quip = "You repeat the translation you got from the blind statue, but the mute statue does not respond. Perhaps it has no response to these specific words?";
}

//------------------------------------------------------------------- SAY to the etchedEar ----------
dialogueTopic contextEtchedEar { "", knownBySelf; context = etchedEar; }

dialogueTopic topEarSecretWords {
    "", contextEtchedEar;   // secret words
    name = {.ayee, .nuka, .bawh};
    bool quip() {
        print("“Ayee ayee nuka bawh,” you say into the ear.^^");
        if(gameState.isTrue(stateBananaPlacedOnWall)) {
            print("You step back as the wall lifts outward, swinging up like a garage door and revealing the large yellow monkey holding your car keys. He leaps down from a pile of shiny trinkets and beats on his chest in obvious challenge. Above, the canopy monkeys cheer.^");
            if(tireIron.parent != player){
                print($"^You look at Grok and shudder. {italics}I’d feel more confident if I had some kind of weapon,{roman} you think.^");
            }
            else if(murk.parent != player){
                print("^You ready the tire iron, unsure of how prepared you are.^");
            }
            achieved(taskRevealThroneRoom);
            yellowMonkey.remove();
            cliffWallSouth.remove();
            grok.parent = southOfRockWall;
            keys.parent = southOfRockWall;
            nestOfAncients.parent = southOfRockWall;
            etchedEar.remove();
            etchedEye.remove();
            etchedMouth.remove();
            liftedCarvings.parent = southOfRockWall;
            gameState.setTrue(stateInCombat);
            return false;
        }
        rtrue("Nothing happens. You get the feeling that the monkey ear, just a flat etching in the wall, can’t hear you. Your gaze drifts to the engraved monkey mouth, seemingly laughing at you.^");
    }
}
dialogueTopic topEarMonkeyWords {
    "", contextEtchedEar;
    name = {.jera, .morkta, .limoth, .jo, .martah, .zerlo, .tedet, .haz, .soopah, .yaho, .jheje, .fatha, .moortha, .sinjas, .cho, .co, .da, .jajoo, .baha, .hatze};
    quip = "You repeat the canopy monkeys’ words to the etched ear, but it does nothing. Perhaps it listens for something specific?";
}
dialogueTopic topEarBlindWords {
    "", contextEtchedEar;
    name = {.jeezee, .otch, .jay, .jar, .jowel, .hua, .chichi, .bine, .oca, .muwato, .toodas, .bojo, .sparow, .fuptar, .jork, .nar, .floorp, .juret, .nooxta, .jeeju, .shazo, .archima, .filep, .jace, .shatop, .lope, .gheezar, .oochap, .bootna};
    quip = "You speak the words you heard from the blind statue into the etched ear, but it does not respond. Perhaps it awaits different words.";
}

//------------------------------------------------------------------- ASK the blindStatue -----------
dialogueTopic knownByBlindStatue { ""; knownBy = blindStatue; context = selfObj; }

dialogueTopic topAskBlindMama {
    "", knownByBlindStatue;   // Mama Ciedue
    name = {.mama, .ciedue, .mother};
    adjective = {.blind};
    requireNoun = true;
    quip = "“Where is Mama Ciedue?” you ask the statue.^^“Bojo toodas,” it translates.";
    humanTranslation = "Where is Mama Ciedue?";
    monkeyTranslation = "Bojo toodas";
}
dialogueTopic topAskBlindKeys {
    "", knownByBlindStatue;   // car keys
    name = {.keys, .key, .car, .jeep};
    quip = "“Where are my car keys?” you ask of the blind statue, feeling foolish.^^After a pause, a string of unrecognized syllables comes from the statue’s mouth. “Jeezee otch, jay jay jar jowel.” You repeat the nonsensical sounds to yourself, hoping you will be able to remember them again later.";
    humanTranslation = "Where are my car keys?";
    monkeyTranslation = "Jeezee otch jay jay jar jowel";
}
dialogueTopic topAskBlindGrok {
    "", knownByBlindStatue;   // grok
    name = {.grok, .monkey};
    adjective = {.yellow, .large, .hidden};
    quip = "You ask the statue about the yellow monkey. It responds: “Sparow fuptar jork nar.”";
}
dialogueTopic topAskBlindNest {
    "", knownByBlindStatue;   // nest of the ancients
    name = {.nest, .ancients, .cave, .rock, .wall};
    adjective = {.of, .the};
    quip = "You ask the statue about the ancients and their nest. It responds: “Floorp juret nooxta jeeju.”";
}
dialogueTopic topAskBlindCanopy {
    "", knownByBlindStatue;   // canopy monkeys
    name = {.monkeys};
    adjective = {.canopy, .tree};
    quip = "“Tell me about the canopy monkeys,” you say. “Shazo archima,” the statue translates.";
}
dialogueTopic topAskBlindMurk {
    "", knownByBlindStatue;   // murk
    name = {.murk, .baby, .babies};
    adjective = {.monkeys, .monkey};
    quip = "“Tell me about the baby monkeys,” you say. “Filep jace shatop lope,” replies the statue.";
}
dialogueTopic topAskBlindWeapon {
    "", knownByBlindStatue;   // a weapon
    name = {.weapon, .weapons, .iron, .tire, .reflection, .shiny, .shinys, .club, .bar, .stick};
    adjective = {.thing, .object, .something, .long, .a};
    bool quip() {
        print("“Is there anything around here I could use as a weapon?” you ask the statue.^^");
        if(tireIron.parent != null) rtrue("“You found the long shiny already,” it answers, dropping the monkey-speak for once. “Hold on to it.”^");
        print("For once, it skips the monkey-speak and answers you directly: “Something long and shiny lies on top of the tall rock, where Man can’t climb. Little monkeys climb anything.”^");
        return false;
    }
}
dialogueTopic topBananaSecretWords {
    "", knownByBlindStatue;   // banana secret words
    name = {.words, .secret, .banana, .flat, .carved};
    knownBy = null;
    context = selfObj;
    quip = "“Where is the flat banana and what are the secret monkey words?”^^The statue replies with a phrase you’ve already heard: “Hua chichi bine oca muwato.”";
}

//------------------------------------------------------------------- ASK the monkeys ---------------
dialogueTopic knownByMonkeys { ""; knownBy = monkeys; context = selfObj; }

dialogueTopic topPaMCarKeys {
    "", knownByMonkeys;   // car keys
    name = {.key, .keys};
    adjective = {.car, .jeep};
    bool quip() {
        if(topPaMCarKeys.hasBeenTold() == false)
            print("“Where are my car keys?” you cry out in frustration.^^");
        else
            print("“Where are my car keys?” you ask to the hidden monkeys.^^");
        print((string)bgl.util.loopArray.getNext(topAskMonkeysCatchAll, (property)monkeysSayingJajoo, loopEnd.repeatLast));
        print("^");
        achieved(taskSpeakWithMonkeys);
        return false;
    }
}
dialogueTopic topAskMonkeysCatchAll {
    "", knownByMonkeys;   // various things
    name = {.grok, .monkey, .nest, .ancients, .cave, .wall, .monkeys, .murk, .baby, .babies, .words, .mama, .ciedue, .mother, .trees};
    adjective = {.blind, .yellow, .large, .hidden, .of, .the, .secret, .banana, .flat, .carved, .rock, .tree, .adult, .canopy};
    array<var> monkeysSayingJajoo = {0,
        "At your words, the chittering above ceases and there is silence. A single small monkey slowly lowers itself from the canopy, hanging upside-down by its tail. “Jajoo jajoo baha hatze,” the monkey replies matter-of-factly before disappearing back into the foliage. The chittering of the hidden monkeys resumes.^^You repeat to yourself the sounds the monkey made. “Jajoo jajoo baha hatze... jajoo jajoo baha hatze...” and struggle to keep the words in your mind. Hopefully you will be able to SAY the monkey sounds to someone or something again later (should that need ever come up).",
        "The chittering above continues but you can still make out a reply, hesitant, as though trying to understand why you are still asking questions in Man-speak. “Jajoo jajoo baha hatze.”",
        "An annoyed monkey voice responds: “Jajoo jajoo baha hatze.”",
        "“Jajoo jajoo baha hatze.”"};
    bool quip() {
        print((string)bgl.util.loopArray.getNext(topAskMonkeysCatchAll, (property)monkeysSayingJajoo, loopEnd.repeatLast));
        print("^");
        achieved(taskSpeakWithMonkeys);
        return false;
    }
}

//------------------------------------------------------------------- ASK the muteStatue ------------
dialogueTopic knownByMuteStatue { ""; knownBy = muteStatue; context = selfObj; }

dialogueTopic topAskMuteKeys {
    "", knownByMuteStatue;   // car keys
    name = {.key, .keys};
    adjective = {.car, .jeep};
    quip = "“Where are my car keys?” you ask the statue and, for just a moment, you think it might react.  But it does nothing. Perhaps it doesn’t understand what you are asking.";
}

//------------------------------------------------------------------- ASK Mama Ciedue --------------
dialogueTopic topMamaBanana {
    "";   // banana, in monkey-speak to mama
    name = {.hua, .chichi, .bine, .oca, .muwato};
    context = mama;
    knownBy = selfObj;
    bool quip() {
        print("You call out the memorized sounds, asking about the banana and secret words in monkey-speak. “Hua chichi bine oca muwato.”^");
        if(gameState.isTrue(taskGlassesGivenToCiedue)){
            if(gameState.isFalse(taskGetBanana)) rtrue("^Mama Ciedue steps back and raises her eyebrows, momentarily confused. She looks directly, and intentionally, above at the distant top of the column in silent answer. Then she resumes her imitation of your stance and produces a series of hoots and grunts, perhaps imitating what a human-speaking monkey must sound like to a monkey.^");
            rtrue("^Mama Ciedue ignores the question, seemingly aware that you’ve already gotten the flat banana.^");
        }
        rtrue("^The blind monkey turns her head in your general direction, unable to see who is asking the question, and makes a series of dismissive monkey sounds before turning back to her babies.^");
    }
}
dialogueTopic topMamaMonkeyWords {
    "", topMamaBanana;
    name = {.jera, .morkta, .limoth, .jo, .martah, .zerlo, .tedet, .haz, .soopah, .yaho, .jheje, .fatha, .moortha, .sinjas, .cho, .co, .da, .jajoo, .baha, .hatze};
    bool quip() {
        print("You repeat the canopy monkeys’ words to the adult monkey. ");
        if(gameState.isTrue(taskGlassesGivenToCiedue)){
            if(gameState.isFalse(taskBridgeRestored))
                rtrue("^Mama Ciedue ignores you and watches her babies play on the vine, as if to say your game with her is now over.^");
            rtrue("^Mama Ciedue frowns at you and ignores your words. This is not, her impression tells you, part of the game.^");
        }
        rtrue("^The blind monkey turns her head in your general direction, unable to see who is asking the question, and makes a series of dismissive monkey sounds before turning back to her babies.^");
    }
}
dialogueTopic topMamaBlindWords {
    "", topMamaBanana;
    name = {.jeezee, .otch, .jay, .jar, .jowel, .toodas, .bojo, .sparow, .fuptar, .jork, .nar, .floorp, .juret, .nooxta, .jeeju, .shazo, .archima, .filep, .jace, .shatop, .lope, .gheezar, .oochap, .bootna};
    bool quip() {
        print("You speak the blind statue’s words to the adult monkey.");
        if(gameState.isTrue(taskGlassesGivenToCiedue)){
            if(gameState.isFalse(taskBridgeRestored))
                rtrue("^She ignores you and watches her babies play. Your game with her is now over, it seems.^");
            rtrue("^Mama Ciedue rolls her eyes and ignores your words. This is not part of her game.^");
        }
        rtrue("^The blind monkey turns her head in your general direction, unable to see who is asking the question, and makes a series of dismissive monkey sounds before turning back to her babies.^");
    }
}
