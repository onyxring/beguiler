        {.canopy, .cover, .roof, .treetops, .leaves, .sky, "The canopy, high above, is thin, but still blots out the sky.", bdItsOutOfReach},
        {.clearing, .area, "The clearing is little more than a gap in the trees, open to the thin canopy above.", bdDefault},
        {.dirt, .tracks, .path, .ground, .trail, "The ground is rainforest dirty. Animal tracks in the dirt form a lightly trodden path disappearing around the rock wall in the southeast and southwest directions.", bdDirt}
    };
