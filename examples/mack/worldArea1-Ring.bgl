#using bgl.printRules;   // a() / the() / cA() / cThe() — articles live here now
#using bgl.english;      // they(…) and the other pronouns

// Shared "can't go that way" message, reused across this area's rooms.

const string foliageBlocks = "The dense foliage blocks travel in that direction.";

//------------ Map ------------------------------------------------------------------------------------------------------

place southOfRockWall {
    "South of Rock Wall";
    ne_to = eastOfRockWall;
    nw_to = westOfRockWall;
    n_to = "The cliff wall blocks your way.";
    n_look = "You can’t see further than the rocky cliff wall.";
    s_to = "No. The Jeep is useless without keys. No reason to go that way until you recover them.";
    bool   s_look() { return redirectCommand("x jeep"); }
    bool   d_look() { return redirectCommand("x dirt"); }
    bool   u_look() { return redirectCommand("x canopy"); }
    cant_go = foliageBlocks;
    cant_look = "The greenery is thick in that direction, blocking your view.";
    remoteDescription = "The trail curves in that direction, disappearing around the rock wall.";
    description = "You are at the base of a tall rock wall which disappears into the thick tree cover above. The light is
                dim here; the jungle canopy blocks out the sky and shrouds the ground in shadow. Tracks in the soil create
                a lightly beaten path curving northeast and northwest around the wall. Beyond the thin, southern brush
                line is your Jeep.";
    string postImpression = "^^Although there are no visible monkeys, you can hear them: a constant din of hoots and screeches
                from the jungle canopy far above you. On the air is the musty scent of wildlife.";

    array<array<var>> backdrops = {
        {.canopy, .cover, .roof, .treetops, .leaves, .shadow, .shadows, "The canopy, high above, blots out the sky. From it, you can hear the hoots and growls of wildlife.", bdItsOutOfReach},
        {.dirt, .tracks, .path, .ground, .trail, .soil, "You’re no expert but suspect these to be monkey tracks.", bdDirt},
        {.rock, .wall, .monolith, .tower, "Here, the rock wall is gone, lifted away like an open garage.", "There is nothing to interact with."},
        {.jeep, .car, .brush, .line, .white, "Through the brush you can barely make out your white Jeep. Useless without keys.",
            () => { if(action == WalkTo) { Go.perform(s_obj); return bdRedirected; } rtrue("Your Jeep is out of reach, but rest assured: you won’t forget where it is this time!"); }},
        {.shrubbery, .shrubs, .plants, .greenery, .foliage, "The foliage is pervasive, growing everywhere, from every crevice.", bdDefault},
        {.vines, "Thick vines hang from the trees and drape the incline you climbed on your way in.", bdDefault},
        {.tree, .trees, "The trees are thin, very tall. Not something a human could climb but packed densely together.",
            "Other than blocking off directions, the trees don’t do much for you."},
        {.glove, .box, .compartment, "You can’t see the glove box from here, but remember it hanging open. There was quite a bit of stuff in it which you suspect the monkeys pulled out.", bdItsOutOfReach},
        {.mouth, "Interesting idea. If only you’d seen a mouth around here someplace.", bdDescr},
        {.eye, "Interesting idea. If only you’d seen an eye around here someplace.", bdDescr},
        {.ear, "Interesting idea. If only you’d seen an ear around here someplace.", bdDescr},
        {.monkey, "There is not an individual monkey here to examine.", "There is no single monkey present. Just an army of monkeys above."},
    };
    array<var> grokPreventsYouMessage = {0,  // Loop array
        "Grok blocks your path, grunting aggressively with an angry scowl on his monkey face.",
        "As you turn to run, Grok grabs you by the neck and throws you to the ground, howling.^^You stand.",
        "“I give up!” you cry. “You can keep the keys!” You try running but Grok will have none of it. He bats you across the head with his monstrous paw. Your ears ring and your vision dims."
    };
    array<var> monkeysAboveMessage = {0,
        "From above comes the constant chittering of monkeys.",
        "A tail drops below the tree line, momentarily visible before disappearing again into the canopy.",
        "The treetops above bustle with hidden activity.",
        "There is movement from above. The leaves rustle and you can tell there are monkeys doing things just out of sight.",
        () => {
            if (gameState.isFalse(stateMonkeyEyeSeen))
                print("Ambient monkey sounds come from the trees above.^");
            else
                print("From deep within the rocky cliff wall, you hear a muted clanging, like a pair of cymbals crashing together repeatedly. After a moment, it stops.^");
        },
        "You hear the soft murmur of monkeys casually conversing."
    };
    array<var> seriousHints = {0,
        "From above comes the constant chittering of monkeys. You wonder what they might say if you could speak to them.",
        "The monkeys above chatter incessantly, but you can’t make out what they are saying. If only there was a way to ask them about your car keys.",
        "You can hear the monkeys conversing above. You imagine what it would be like to talk monkey."
    };

    bool before() {
        switch(action) {
            case Listen:
                if(noun == etchedEar && gameState.isTrue(stateBananaPlacedOnWall)) rtrue("You put your ear to the dark ear hole. Faintly, from somewhere behind the wall, comes the jingle of keys. The hole seems made less for listening than for speaking into.^");
                rtrue("The normal jungle sounds, insects and small animals, are drowned out by the active, constant chittering of monkeys, hidden in the treetops above.^");
            case Go:
                if (gameState.isTrue(stateInCombat)) {
                    print((string)bgl.util.loopArray.getNext(self, (property)grokPreventsYouMessage));
                    print("^");
                    rtrue;
                }
                if (noun == u_obj) { Climb.perform(cliffWallSouth); rtrue; }
        }
        rfalse;
    }

    bool each_turn() {
        if(bgl.util.random.get(3) == 1 && gameState.isFalse(stateInCombat)) {
            var msg;
            if(turns > SERIOUS_HINTS_MARK && isAchieved(taskSpeakWithMonkeys) == false)
                msg = bgl.util.loopArray.getNext(self, (property)seriousHints);
            else
                msg = bgl.util.loopArray.getNext(self, (property)monkeysAboveMessage);
            print("^");
            PrintOrRunVar(msg);
            rtrue;
        }
        rfalse;
    }
}

bigThing srwFoliage {
    "foliage", southOfRockWall;
    name = {.foliage, .leaves, .greenery, .plants, .plant, .life, .shrubbery, .shrubs, .bushes, .bush};
    describe = "^The greenery here is thick and lush.";
    string description = "The foliage is pervasive, growing everywhere, from every crevice.";
}

setting cliffWallSouth {
    "wall", southOfRockWall;
    name = {.cliff, .wall, .carvings, .etchings, .engravings, .tower, .monolith, .base};
    adjective = {.rock, .tall, .rocky, .of, .the};
    void description() {
        print("The wall has strange carvings, faded by years of erosion. If you concentrate, you can make
                            out three surviving engravings: ");
        if (gameState.isFalse(stateBananaPlacedOnWall))
            print("a strange monkey mouth, a strange monkey eye, and a not-so-strange monkey ear.");
        else
            print("a not-so-strange monkey mouth, a not-so-strange monkey eye, and a strange monkey ear.");
        if (isAchieved(taskInspectWall) == false) {
            print("^"); achieved(taskInspectWall);
        }
        //give self general;
        etchedEar.parent = southOfRockWall;
        etchedEye.parent = southOfRockWall;
        etchedMouth.parent = southOfRockWall;
    }
    postImpression = $"^{italics}Huh{roman}. You ponder for a moment. The etchings are clearly very old. Several centuries, maybe more. {italics}What people made these and where did they go?{roman}";
    bool before() {
        switch(action) {
            case Climb:  rtrue("It’s far too sheer to climb. At least, for a human.^");
            case Push:   rtrue("You push on the cliff wall, testing it, but it stands in place. Immovable. Like a rock wall.^");
            case Attack: rtrue("You pound on the cliff wall without effect.^");
        }
        rfalse;
    }
}

// Conversation hint: mack uses ASK/TELL/SAY, not SPEAK/TALK/SHOUT. Returns true (callers `return ConvoError()`).
bool ConvoError() {
    print($"[This game doesn’t use SPEAK, TALK, or SHOUT; however, {italics}does{roman} support “ASK {italics}character{roman} ABOUT {italics}topic{roman}”, “TELL {italics}character{roman} ABOUT {italics}topic{roman}”, and “SAY {italics}topic{roman} TO {italics}character{roman}” for conversations. As an example, I’ll do one of these at the next prompt for you...]^");
    rtrue;
}

setting monkeys {
    "monkeys", southOfRockWall;
    attributes = {pluralname, animate};
    name = {.monkeys, .army};
    adjective = {.monkey, .hidden, .unseen, .of, .score, .tree, .brown, .small, .canopy};
    bool requireNoun = true;
    string description = "The monkeys are high above the jungle canopy. You can hear them, a constant chittering, and see an
                    occasional tail drop for a fleeting moment. It is impossible to tell just how many monkeys are up there.";
    bool before() {
        switch(action) {
            case Examine:
                rtrue("The monkeys are high above, not visible.^");
            case Talk:
                playerCommands.pushCommand("ask monkeys about car keys");
                return ConvoError();
            case Take:
                rtrue("You can’t see the monkeys, much less reach them.^");
        }
        rfalse;
    }
    bool orders() {
        rtrue("The monkeys don’t seem particularly inclined to do what you tell them.^");
    }
    bool react_before() {
        switch(action) {
            case Talk, TellTopic, SayTopic, AskTopic, UnrecognizedTopicWords:
                if(gameState.isTrue(stateInCombat)) rtrue("I don’t think you can talk your way out of this now.^");
        }
        rfalse;
    }
    string iDunno = "The monkeys do not respond. They either don’t understand you or aren’t interested in what you have to say.";
}

setting yellowMonkey {
    "yellow monkey";
    attributes = {animate};
    name = {.grok, .monkey, .ape};
    adjective = {.yellow, .large, .big, .huge, .angry, .mean, .scary};
    string description = "The yellow monkey isn’t actually here. You can’t see him without looking through the eye hole in the rock wall.";
    bool react_before() {
        switch(action) {
            case Show:
                if(second == self) rtrue("There doesn’t seem to be a monkey here to show anything to.^");
        }
        rfalse;
    }
    bool before() {
        if(isDialogueAction(action)) rtrue("The yellow monkey doesn’t seem to hear you through the cliff wall.  Perhaps he’s too distracted, playing with your car keys.^");
        if(action != Examine) rtrue("The large yellow monkey is on the other side of the cliff wall.^");
        rfalse;
    }
    bool orders() { rtrue("The yellow monkey doesn’t seem to hear you, or perhaps he just doesn’t care.^"); }
    string iDunno = "The yellow monkey doesn’t seem to hear you, or perhaps he just doesn’t care.";
}

setting etchedEar {
    "monkey ear";
    attributes = {talkable};
    name = {.ear, .hole, .darkness};
    adjective = {.monkey, .etching, .carving, .etched, .engraved, .strange, .very, .not, .so, .dark};
    bool requireNoun = true;
    chooseAnswer chooseobject(chooseCode code) {
        if(code == chooseCode.askingForHint && gameState.isFalse(stateBananaPlacedOnWall) && _isMatched(etchedEye)) return excludeFromChoice(self);
        return chooseAnswer.defer;
    }
    description = $"It is a carving of a monkey ear, {gameState.isFalse(stateBananaPlacedOnWall)
        ? "mostly flat.^^Not so strange."
        : "mostly flat except for an ear hole.^^Very strange."}^";
    bool react_before() {
        if(second != self || noun == ambientThings) rfalse;   // a finger: ambientThings answers
        switch(action) {
            case Insert:
                if(gameState.isTrue(stateBananaPlacedOnWall))
                    print("You can’t put things in the ear. Except maybe words.");
                else
                    print("You can’t put things in the ear, it’s just an etching.");
                print("^");
                rtrue;
        }
        rfalse;
    }
    bool before() {
        switch(action) {
            case Push:
                rtrue("You push on the ear, looking for some hidden button. But no, it’s just an etching.^");
            case Talk:
                playerCommands.pushCommand("ask ear about car keys");
                return ConvoError();
        }
        rfalse;
    }
    bool orders() {
        if(gameState.isFalse(stateBananaPlacedOnWall))
            rtrue("The etched monkey ear doesn’t obey. It’s as though it doesn’t hear you at all.^");
        else
            rtrue("Your words flow into the ear hole and do nothing else.^");
    }
    string iDunno = "You speak to the etched ear, but it doesn’t respond to your words.";
}

setting etchedEye {
    "monkey eye";
    name = {.eye, .circle, .hole};
    adjective = {.monkey, .etching, .carving, .etched, .engraved, .strange, .very, .not, .so};
    bool requireNoun = true;
    object add_to_scope = monkeyLight;
    chooseAnswer chooseobject(chooseCode code) {
        if(code == chooseCode.askingForHint && gameState.isTrue(stateBananaPlacedOnWall) && _isMatched(etchedEar)) return excludeFromChoice(self);
        return chooseAnswer.defer;
    }
    description = $"The eye is a perfectly round {gameState.isTrue(stateBananaPlacedOnWall)
        ? "circle, etched into the stone wall. Light no longer shines from it.^^Not so strange."
        : "hole, carved deep into the stone wall. There seems to be a bit of light, flickering from the eye like there’s movement on the other side.^^Very strange."}^";
    bool before() {
        switch(action) {
            case Search:
                Examine.perform(monkeyLight); rtrue;
            case Push:
                rtrue("You push on the small circle of eye to no effect.^");
        }
        rfalse;
    }
    bool react_before() {
        if(second != self || noun == ambientThings) rfalse;   // a finger: ambientThings answers
        switch(action) {
            case Insert:
                if(gameState.isTrue(stateBananaPlacedOnWall))
                    print("You can’t put things in the eye, it’s just an etching.");
                else
                    print("You can’t put things in the eye, it’s just a hole to look through.");
                print("^");
                rtrue;
        }
        rfalse;
    }
}

setting monkeyLight {
    "light";
    name = {.light, .cave};
    void description() {
        if(gameState.isTrue(stateBananaPlacedOnWall))
            print("You look closely at the eye. It’s just an etched circle.^^Not so strange.^");
        else {
            print("You look through the eye and can clearly make out an inner cave room on the other side of the wall. The large yellow monkey, perched on a pile of shiny items, holds your car keys between his fingers. He jingles them and hoots in an unmistakable monkey laugh.");
            print($" You shudder at how imposing the monkey is. {italics}I wouldn’t want to face him alone,{roman} you think. {italics}Or unarmed.{roman}^");
            gameState.setTrue(stateMonkeyEyeSeen);
            yellowMonkey.parent = southOfRockWall;
        }
    }
    bool before() {
        switch(action) {
            case Search:
                Examine.perform(monkeyLight); rtrue;
        }
        rfalse;
    }
}

// "hole" names both the eye and the ear; it means the eye while light shines through it, the ear once the banana opens it.
bool _isMatched(object obj) {
    for(int i = 0; i < number_matched; i++)
        if(match_list[i] == (int)obj) return true;
    return false;
}

setting etchedMouth {
    "monkey mouth";
    attributes = {container};
    name = {.mouth, .smile, .slot, .carving, .etching};
    adjective = {.monkey, .etched, .engraved, .strange, .very, .not, .so};
    bool requireNoun = true;
    description = $"It is a broad, {gameState.isFalse(stateBananaPlacedOnWall)
        ? "three-dimensional smile, carved into the rock wall, about an inch deep.^^Very strange."
        : "two-dimensional smile, etched into the flat rock wall.^^Not so strange."}^";
    int time_left = 0;
    void time_out() {
        if(gameState.isTrue(stateInCombat)) return;
        if(location == southOfRockWall) print("^After a moment, the stone banana drops away from the wall; there is a rumbling sound and the point of darkness in the ear disappears. A point of light opens in the eye.^");
        banana.parent = southOfRockWall;
        gameState.setFalse(stateBananaPlacedOnWall);
    }
    bool before() {
        switch(action) {
            case Empty:
                if(gameState.isTrue(stateBananaPlacedOnWall))
                    rtrue("It’s just an etching of a monkey mouth. Nothing actually in it.^");
                else
                    rtrue("The engraved monkey mouth is only an inch deep. There’s nothing actually in it.^");
            case Receive:
                if(noun == banana){
                    banana.remove();
                    gameState.setTrue(stateBananaPlacedOnWall);
                    StartTimer(self, 3);
                    rtrue("You put the stone banana on the monkey smile, and it snaps into place. For a moment, you feel a deep rumbling from the rock, like hidden gears turning. The point of light, which had been shining through the eye hole, vanishes. A point of darkness in the ear hole opens.^");
                }
                else rtrue("The engraved monkey mouth is about an inch deep; more indentation than container. It would take an object of a very specific shape to fit into it.^");
            case KissThing:
                rtrue("You kiss the engraved monkey mouth. It does not kiss you back.^");
            case TellTopic, AskTopic, SayTopic, UnrecognizedTopicWords:
                rtrue("Speaking to the monkey mouth does nothing. It is just an engraving, after all.^");
            case Search:
                Examine.perform(etchedMouth); rtrue;
            case Push:
                rtrue("You push on the engraved mouth with your hand. It does nothing.^");
        }
        rfalse;
    }
}

//----------
place westOfRockWall {
    "West of Rock Wall";
    ne_to = northOfRockWall;
    se_to = southOfRockWall;
    e_to = "The immovable rock wall blocks that direction.";
    e_look = "A rocky wall lies that way.";
    bool   u_look() { return redirectCommand("x canopy"); }
    d_look = "The ground is dirt, with a side of monkey droppings.";
    cant_look = "The greenery is thick in that direction, blocking your view.";
    cant_go = foliageBlocks;
    remoteDescription = "The path curves around the rock wall.";
    description = "This area of the jungle lies west of the rock wall, which is covered in greenery. Thick rainforest surrounds you and blocks out
                        the sky. The path disappears into the foliage to the southeast and extends into a clearing to the northeast.^^Just to the
                        side of the trail is a pile of monkey droppings.";
    array<array<var>> backdrops = {
        {.canopy, .cover, .roof, .treetops, .leaves, .sky, "The canopy, high above, blots out the sky.", "The canopy is far above you, too high to interact with."},
        {.dirt, .tracks, .path, .ground, .trail, "The animal tracks in the dirt form a shallow path disappearing around the rock wall in the northeast and southeast directions.", bdDirt},
        {.clearing, "Your view of the clearing is obscured by the foliage. All you can really make out is a space with marginally fewer trees.", ""},
        {.monkeys, .monkey, .army, .canopy, "The monkeys are somewhere high in the canopy, off to the southeast. You can hear their chittering, but you can’t see them from here.", "The monkeys are high in the canopy, well out of reach."}
    };
    bool before() {
        switch(action) {
            case Go: if(noun == u_obj) { Climb.perform(cliffWallEastAndWest); rtrue; }
            case Listen: if(noun == null || noun == self || backdropEngine.getKeyword() == .monkeys) rtrue("The chatter of the canopy monkeys drifts through the trees from somewhere to the southeast.^");
        }
        rfalse;
    }
    array<var> seriousHints = {0,
        "You can hear the chittering of the canopy monkeys coming from the southeast. You wonder what they might say if you could speak to them.",
        "There’s a rustle in the trees above, like things moving around unseen. They seem to be moving toward the area where you first arrived.",
        "You hear a commotion, generally from above, but coming from the southeast.  The monkeys up there seem to be congregating."
    };
    bool each_turn() {
        if(playerInteractingWith == monkeys && blindStatue.parent == self) playerInteractingWith = blindStatue;   // a bare SAY here goes to the statue
        if(bgl.util.random.get(3) == 1 && turns > SERIOUS_HINTS_MARK && isAchieved(taskSpeakWithMonkeys) == false) {
            var msg = bgl.util.loopArray.getNext(self, (property)seriousHints);
            print("^");
            PrintOrRunVar(msg);
            rtrue;
        }
        rfalse;
    }
}

setting monkeyDroppings {
    "droppings", westOfRockWall;
    attributes = {pluralname};
    name = {.droppings, .poo, .poop, .refuse, .pile, .vegetation};
    adjective = {.monkey};
    bool requireNoun = true;
    description = $"It’s a pile of monkey droppings mixed with half-eaten vegetation.{dehydratedBananas.hasnt(moved) ? " Some kind of wrapper protrudes from it, half buried." : ""}";
    string postImpression = "^^You look up at the canopy wondering what it hides. A ridiculous part of your brain imagines a monkey-sized room, with
                a disposal chute dropping refuse into this pile.";
    bool before() {
        switch(action) {
            case Search:
                Examine.perform(monkeyDroppings); rtrue;
            case Take:
                rtrue("Yuck! You consider taking the pile of droppings, then decide against it.^");
            case Smell:
                rtrue("Blech! It’s definitely not a pile of chocolate.^");
            case Taste:
                rtrue("You taste nothing unexpected. That is, it’s terrible. Which is expected. Because it’s monkey poop.^");
            case Eat:
                rtrue("Not a chance.^");
        }
        rfalse;
    }
}

thing dehydratedBananas {
    "pack of dehydrated bananas", westOfRockWall;
    attributes = {concealed};
    name = {.pack, .package, .wrapper, .dried, .dehydrated, .bananas, .candy, .snack, .snacks, .of};
    void description() {
        if(has(concealed))
            print("Looks like a candy wrapper, but it’s hard to tell with it buried in monkey droppings.^");
        else {
            if(hasnt(general)){   // first-impression add-on doesn't work here (it plays out even when concealed)
                print("You are surprised to recognize the pack of snacks. This is yours! Obviously, it was pilfered from your Jeep by the canopy monkeys. ");
                give(general);
            }
            print("It’s unopened, dirty, and a bit smelly. On the side it reads: “Dehydrated Bananas”.^");
        }
    }
    void readDescription() {
        if(has(concealed))
            print("You’re not sure if it can be read, buried in monkey droppings.");
        else
            print("It says, “Dehydrated Bananas.”");
        print("^");
    }
    bool before() {
        switch(action) {
            case Eat, Open:
                rtrue("Eh. On second thought, you’re not really hungry. Better to save it for when you are.^");
            case Rub:
                rtrue("You rub the package, accomplishing nothing more than moving filth around.^");
            case Smell:
                rtrue("Yuck! Perhaps the inside smells good, but the outside is just plain gross.^");
            case Pull, Take:
                if(has(concealed)){
                    ungive(concealed);
                    parent = player;
                    rtrue("You pull the wrapper from the pile of droppings and recognize the familiar package.^");
                }
            case ThrowAt:
                rtrue("No. The snack may be useful. No reason to throw it away.^");
            case Taste:
                rtrue("You touch the outside of the package to your tongue. It’s disgusting.^");
        }
        rfalse;
    }
}

bigThing blindStatue {
    "statue";
    attributes = {concealed, talkable};
    name = {.statue, .statues, .mizaru};
    adjective = {.blind, .stone, .monkey};
    string statueInitial = "A statue of a monkey sits here, cross-legged, paws covering its eyes.";
    string description = "It’s a large, free-standing rock statue of a monkey sitting cross-legged
            with its paws covering its eyes, leaving only its ears and mouth free.";
    string postImpression = "^^You consider the statue for a moment.  It seems to listen, taking sound in, words on the precipice of its stone lips.";
    bool react_before() {
        switch(action) {
            case Show:
                if(second == self) rtrue("It wouldn’t do any good. The statue’s paws cover its eyes.^");
            case Insert, PutOn:
                if(second != self) rfalse;
                if(noun.parent != player) rfalse;
                noun.parent = location;
                print($"You try to balance {the(noun)} on the statue, but {they(noun, "fall", "falls", "fell")} to the ground.^");
                rtrue;
        }
        rfalse;
    }
    bool before() {
        switch(action) {
            case Touch:
                rtrue("The stone the statue is carved from is rough to the touch.^");
            case Talk:
                playerCommands.pushCommand("ask statue about car keys");
                return ConvoError();
            case KissThing:
                rtrue("You do so, then imagine the blind statue might wonder who just kissed it.^");
        }
        rfalse;
    }
    bool orders() {
        rtrue("You command the statue but it does nothing, putting out a you’re-not-the-boss-of-me vibe.^");
    }
    string iDunno = "The blind statue sits quietly, perhaps pondering what you say, but does not answer.";
}

//----------
place eastOfRockWall {
    "East of Rock Wall";
    nw_to = northOfRockWall;
    sw_to = southOfRockWall;
    w_to = "The rock cliff wall blocks your way due west.";
    w_look = "A rocky cliff wall lies that way.";
    place | bool e_to() {
        if(gameState.isTrue(taskHiddenPathRevealed))
            return cliffEdge;
        print(foliageBlocks);
        print("^");
        rtrue;
    }
    bool e_look() {
        if(gameState.isTrue(taskHiddenPathRevealed))
            rtrue("The greenery is thick in that direction, but the statue’s glowing eyes shine through it, revealing a hidden path.^");
        rtrue("The greenery is thick in that direction, blocking your view.^");
    }
    bool   u_look() { return redirectCommand("x canopy"); }
    bool   d_look() { return redirectCommand("x dirt"); }
    cant_look = "The greenery is thick in that direction, blocking your view.";
    cant_go = foliageBlocks;
    remoteDescription = "The path disappears around the rock wall.";
    bool before() {
        switch(action) {
            case Go: if(noun == u_obj) { Climb.perform(cliffWallEastAndWest); rtrue; }
            case Listen: if(noun == null || noun == self || backdropEngine.getKeyword() == .monkeys) rtrue("The chatter of the canopy monkeys drifts through the trees from somewhere to the southwest.^");
        }
        rfalse;
    }
    description = "The canopy above is sparse and bits of blue sky shine through. The towering rock wall, covered in greenery, blocks travel to the west. The path curves northwest in one direction and southwest in the other.";
    array<array<var>> backdrops = {
        {.canopy, .cover, .roof, .treetops, .leaves, .blue, .sky, "The blue sky, far above, peeks through the canopy.", bdItsOutOfReach},
        {.dirt, .tracks, .path, .ground, .trail, "The ground is jungle-level dirty, forming a path disappearing around the rock wall in the northwest and southwest directions.", bdDirt},
        {.monkeys, .monkey, .army, .canopy, "The monkeys are somewhere high in the canopy, off to the southwest. You can hear their chittering, but you can’t see them from here.", "The monkeys are high in the canopy, well out of reach."}
    };
    array<var> seriousHints = {0,
        "You can hear the chittering of the canopy monkeys coming from the southwest. You wonder what they might say if you could speak to them.",
        "There’s a rustle in the trees above, like things moving around unseen. They seem to be moving toward the area where you first arrived.",
        "You hear a commotion, generally from above, but coming from the southwest. The monkeys up there seem to be congregating."
    };
    bool each_turn() {
        if(bgl.util.random.get(3) == 1 && turns > SERIOUS_HINTS_MARK && isAchieved(taskSpeakWithMonkeys) == false) {
            var msg = bgl.util.loopArray.getNext(self, (property)seriousHints);
            print("^");
            PrintOrRunVar(msg);
            rtrue;
        }
        rfalse;
    }
}

bigThing muteStatue {
    "statue";
    attributes = {concealed, talkable};
    name = {.ignore, .ignore, .statue, .iwazaru, .statues};
    adjective = {.of, .mute, .stone, .monkey};
    string iDunno = "The statue doesn’t respond to your words. Maybe it does not understand? Or maybe, with its mouth covered, it can only answer with its eyes? Or maybe both.";
    void statueInitial() {
        print("A statue of a monkey sits here, cross-legged, ");
        if(state == banana || state == mama)
            print("its back to you as it faces the east.");
        else
            print("paws covering its mouth.");
        if(state > 0) {
            print(" The statue’s eyes are ablaze and emit a red beam of light which shines ");
            if(state == banana || state == mama) print("east, illuminating a hard to see path");
            if(state == grok) print("southwest");
            print(".");
        }
        print("^");
    }
    void description() {
        print("It’s a large, free-standing rock statue of a monkey sitting cross-legged with its paws covering its mouth, leaving only its eyes and ears free.");
        if(state > 0) {
            print(" The statue stares ");
            if(state == banana || state == mama) print("east, highlighting an overgrown trail which would otherwise be invisible");
            if(state == grok) print("southwest");
            print(". Its glowing red eyes emit a focused ray of light in the same direction.");
        }
    }
    void postImpression() {
        if(state == 0) noLf("^^You consider the statue for a moment.  It seems to listen, taking sound in, its stone eyes looking meaningfully at nothing.");
    }
    var state = 0;
    bool before() {
        switch(action) {
            case Touch:
                rtrue("The stone the statue is carved from is rough to the touch.^");
            case Talk:
                playerCommands.pushCommand("ask statue about car keys");
                return ConvoError();
            case KissThing:
                rtrue("You start to kiss the monkey statue, but think about it covering its mouth and decide it may not appreciate it.^");
        }
        rfalse;
    }
    bool orders() {
        rtrue("The mute statue doesn’t respond, but something in its meaningful stare makes you think it wants to.^");
    }
    bool react_before() {
        switch(action) {
            case Show:
                if(state > 0)
                    rtrue("The statue is too busy lighting the way with glowing eyes to appreciate what you are trying to show it.^");
                else {
                    print($"The statue seems uninterested in {the(noun)}. You imagine even a little annoyed, like you are blocking its view of the jungle.^");
                    rtrue;
                }
            case Insert, PutOn:
                if(second != self) rfalse;
                if(noun.parent != player) rfalse;
                noun.parent = location;
                print($"You try to balance {the(noun)} on the statue, but {they(noun, "fall", "falls", "fell")} to the ground.^");
                rtrue;
        }
        rfalse;
    }
}

