setting cliffWallNorth {
    "wall", northOfRockWall;
    attributes = {supporter};
    name = {.cliff, .wall, .ivy, .vines, .tower, .monolith};
    adjective = {.rock, .tall, .rocky, .climbing};
    bool description() {
        print("The wall is covered in interweaving vines which climb up the rock. ");
        if(gameState.isFalse(taskVineDetachedFromWall)) {
            if(vine.parent == null){
                print("As you look, you can see a vine of medium thickness, somewhat distinct from the rest. You tug at it, barely, and it pulls away to hang loose from the rest of the vinery.");
                vine.parent = northOfRockWall;
            } else
                print("^^One vine hangs down, larger and separate from the rest, waving loosely whenever the trees above rustle.");
        }
        print("^");
        rfalse;
    }
    bool before() {
        switch(action) {
            case Climb:
                if(gameState.isTrue(taskVineDetachedFromWall))
                    rtrue("Not a chance. With the long vine removed, the cliff is too sheer to climb. At least, for a human.^");
                if(vine.parent == location) { Climb.perform(vine); rtrue; }
                rtrue("The wall is too steep to climb, but maybe with a little preparation?^");
            case Receive:
                return murkClimbsWall();
        }
        rfalse;
    }
}

thing vine {
    "vine";
    name = {.vine, .rope, .knob};
    description = $"{gameState.isFalse(taskVineDetachedFromWall)
        ? "It hangs down, apart from the interweaving mesh of other vines."
        : "It’s a long vine of medium thickness, strong enough to serve as a rope and do rope-specific things with. One end of the vine is thicker than the rest, ending in a somewhat heavy knob."}";
    bool describe() {
        print("^");
        if(gameState.isFalse(taskVineDetachedFromWall)) rtrue("A single vine hangs down from above, seemingly separate from the other vines climbing the rock face.^");
        rtrue("A long, loose vine lies on the ground.^");
    }
    void postImpression() { if(gameState.isFalse(taskVineDetachedFromWall)) print("^^You give it a tug, finding it tightly anchored. It may even be strong enough to climb."); }
    array<var> takeMsg = {0,
        "You pull on the vine, bringing all your weight to bear. It feels strongly anchored, but you think you might feel it stretch, just a bit.^",
        "You pull on the vine a second time with all your strength. No. You’re sure of it this time. You can feel it give.^",
        "With a final jerk, you feel the vine pull free. It falls to the ground, a large, weighted knob at the end hitting the ground with a thump.^"
    };
    bool before() {
        switch(action) {
            case ThrowAt:
                if(second == null) rtrue("There’s no reason to throw the vine away. Maybe at something.^");
                rtrue("You swing the vine around, trying to throw it at something, but it just falls to the ground. You pick it up again.^");
            case Take, Pull:
                if(gameState.isFalse(taskVineDetachedFromWall)) {
                    var msg = bgl.util.loopArray.getNext(self, (property)takeMsg);
                    print((string)msg);
                    if(bgl.util.loopArray.isComplete(self, (property)takeMsg)) {
                        gameState.setTrue(taskVineDetachedFromWall);
                        ungive(concealed);
                    }
                    rtrue;
                } else rfalse;
            case Climb:
                if(gameState.isFalse(taskVineDetachedFromWall)) {
                    print($"You grab hold and pull on the hanging vine, testing against your weight. {italics}It seems strong{roman}, you think. You put your foot into the edges of the cliff
                        rock for added support and, with a bit of effort, begin to hoist yourself up. Gaining confidence, you begin to scale the cliff wall in earnest,
                        rising several feet above the ground.");
                    print("^^With a snap from far above, the vine gives way and you fall. The wind is knocked from you as you hit
                        the dirt. The vine follows, coiling around you, until its thick knobby end bounces off your face. Above, you
                        can just make out monkey laughter mixed with the other sounds of the rainforest.^^You get up, wobbly.^");
                    ungive(concealed);
                    gameState.setTrue(taskVineDetachedFromWall);
                }
                else {
                    if(gameState.isTrue(stateVineIsOverAnchor))
                        print("Although the rope is draped over the anchor, it doesn’t seem like something you can straight up climb. Maybe if you were a monkey.^");
                    else
                        print("You can’t climb the vine, it’s not attached to anything climbable.^");
                }
                rtrue;
            case Cut:
                rtrue("If you were to cut the vine down here, you’d end up with just a short piece, too small to be useful.^");
            case Tie:
                if(second.is(rock)) rtrue("You try looping the vine around a rock, attempting to secure it, but the rock slips easily through the wrap.^");
                switch(second){
                    case ladder: rtrue("That seems like it would probably work, except... you test the weight of the ladder and realize it’s too heavy. There’s no way to pull it up the side of the cliff, even if you could stretch it across the chasm.  There’s got to be another way to realize the fuzzy, half-baked plan you have in your head.^");
                    case barrel, barrelHook: rtrue("Noting the broken hook on the barrel, you consider how you might still tie the vine to it, then give up.^");
                    case bridgeAnchor: rtrue("You can’t reach the anchor to tie the vine to it, but... You heft the vine’s knobby end. Perhaps if your aim were true?^");
                    default: rtrue("You get the feeling that this vine will be useful, but tying it that way doesn’t seem like a good idea.^");
                }
            case Swing:
                if(gameState.isFalse(taskVineDetachedFromWall))
                    rtrue("You try to swing on the vine, but it’s too close to the cliff wall. You end up just pulling on it, testing its strength. It seems strong enough to climb.^");
                rtrue("You swing the vine around, trying to throw it at something, but it just falls to the ground. You pick it up again.^");
        }
        rfalse;
    }
    void detachFromWall() { give(general); ungive(concealed); }
    bool isAttachedToWall() { if(has(general)) rfalse; rtrue; }
}

bigThing deafStatue {
    "statue";
    attributes = {concealed, talkable};
    name = {.statue, .kikazaru, .statues};
    adjective = {.deaf, .stone, .monkey};
    string statueInitial = "A statue of a monkey sits here, cross-legged, paws covering its ears.";
    description = $"It’s a large, free-standing rock statue of a monkey sitting cross-legged with its paws covering its ears, leaving only its eyes and mouth free.{eyeglasses.hasnt(moved)
        ? " A familiar pair of eyeglasses is perched on the statue’s face. With ears hidden by its paws, the glasses hang imperfectly." : ""}";
    string postImpression = "^^You consider the statue for a moment.  It seems to watch, taking the world in, words on the precipice of its stone lips.";
    string iDunno = "You start to speak to the statue, then decide against it. It wouldn’t be able to hear anyway, since its paws cover its ears.";
    bool before() {
        switch(action) {
            case TellTopic, SayTopic, AskTopic, Talk:
                rtrue("You start to speak to the statue, then decide against it. It wouldn’t be able to hear anyway, since its paws cover its ears.^");
            case Touch:
                rtrue("The stone the statue is carved from is rough to the touch.^");
            case KissThing:
                rtrue("You kiss the monkey statue. You imagine that it might appreciate the gesture.^");
        }
        rfalse;
    }
    bool orders() {
        rtrue("You start to speak to the statue, then decide against it. It wouldn’t be able to hear anyway, since its paws cover its ears.^");
    }
    bool react_before() {
        switch(action) {
            case Show:
                if(second != self) rfalse;
                if(noun == banana || noun == symbols) {
                    print("You hold the banana up, in view of the statue’s lifeless eyes. It stares blankly at the etchings in motionless scrutiny.
                    After a moment, it replies: “Ayee ayee nuka bawh.”^");
                    achieved(taskStatueReadSecretWords);
                    rtrue;
                }
                rtrue("Although it never moves, you feel like the statue is considering what you show it. Yet it does nothing.^");
            case Insert, PutOn:
                if(second != self) rfalse;
                if(noun.parent != player) rfalse;
                noun.parent = location;
                print($"You try to balance {the(noun)} on the statue, but {they(noun, "fall", "falls", "fell")} to the ground.^");
                rtrue;
        }
        rfalse;
    }
}


//------------------------------------------------------------------------------------------------------------------------
// Floating objects, or things with no location.
// foliage (the multi-room greenery hiding the statues), grok, the game-over routine, and the two
// backdrop instances (ambientThings, statuesFeatures) are all native Beguile — the backdrops'
// inline handler routines are `array<var>` lambdas.

bigThing foliage {
    "foliage";
    found_in = {westOfRockWall, eastOfRockWall, northOfRockWall};
    name = {.foliage, .leaves, .greenery, .plants, .plant, .life};
    bool describe() {
        object statue = statueFromLocation(location);
        print("^");
        if(statue == null || statue.parent == null)
            rtrue("The greenery here is thick and lush.^");
        PrintOrRun(statue, (property)statueInitial);
        rtrue;
    }
    string description = "The foliage is pervasive, growing everywhere, from every crevice.";
    var statueFromLocation(object loc) {
        if(loc == null) loc = location;
        switch(loc){
            case westOfRockWall: return blindStatue;
            case eastOfRockWall: return muteStatue;
            case northOfRockWall: return deafStatue;
        }
        rfalse;
    }
    array<var> pullAwayMessage = {0,
        "You run your fingers through the foliage and find a rough texture underneath. Grabbing a handful of leaves, you pull it away uncovering a large stone monkey statue.",
        "You probe the greenery and find a rocky shape, similar to what you found before. Pulling the leaves away reveals another stone monkey statue, almost like the last one, but not quite the same.",
        "You tear at the vines, sure you know what’s underneath, and uncover a third stone monkey statue."
    };
    bool before() {
        switch(action) {
            case Examine, Search, Pull:
                object statue = statueFromLocation(location);
                if(statue == null) rfalse;
                if(statue.parent != null) rtrue("You find nothing else hidden in the greenery here.^"); // already revealed
                print((string)bgl.util.loopArray.getNext(self, (property)pullAwayMessage));
                print("^");
                statue.parent = location;
                MoveFloatingObjects();  // bring the things attached to the statue into scope as well
                if(location == northOfRockWall) eyeglasses.parent = northOfRockWall;
                switch(statue) {
                    case blindStatue: achieved(taskBlindStatueRevealed);
                    case muteStatue:  achieved(taskMuteStatueRevealed);
                    case deafStatue:  achieved(taskDeafStatueRevealed);
                }
                rtrue;
        }
        rfalse;
    }
}

// ambientThings — a standalone backdrop (clothes/hair) that's always in scope. Its `backdrops`
// are plain rows (dict-words + string + bdDefault); the react_before body
// (RunRoutines delegation + <<enter>> + topic actions) is native Beguile too.
backdrop ambientThings {
    bool found_in() { rtrue; }
    array<array<var>> backdrops = {
        {.clothes, "Dirty. Like your hair.", bdDefault},
        {.hair, "Dirty. Like your clothes.", bdDefault},
        {.hand, .finger, .fingers, "Dirty. Like the rest of you.", bdDefault}
    };
    bool react_before() {
        // Delegate to the room's own react_before, then its before; if either handled the action, stop.
        var retval = RunRoutines(location, (property)react_before);
        if (retval == false) retval = RunRoutines(location, (property)before);
        if (retval == true) rtrue;

        switch(action) {
            case PutOn, Insert:
                if (noun == actor) { Enter.perform(second); rtrue; }
                if (noun == self && backdropEngine.getKeyword() == .hand) {
                    if (second == etchedMouth) rtrue("You run a finger along the carved smile. It’s about an inch deep and shaped for something very particular. Not a finger.^");
                    if (second == etchedEye) {
                        if (gameState.isFalse(stateBananaPlacedOnWall)) rtrue("You start to poke a finger into the eye hole, then think better of it. Something on the other side is moving around.^");
                        rtrue("It’s just an etched circle now. Your finger finds only stone.^");
                    }
                    if (second == etchedEar) {
                        if (gameState.isTrue(stateBananaPlacedOnWall)) rtrue("You stick a finger into the dark ear hole. Nothing happens. It seems to want words, not fingers.^");
                        rtrue("It’s just a flat etching. There’s nowhere to put a finger.^");
                    }
                }
            case Listen:
                rtrue("All around you is the chittering of jungle life.^");
            case Smell:
                if (noun == monkeyDroppings || noun == dehydratedBananas) rfalse;
                rtrue("You identify the musky odor of animals mingling with the scents of new life and decay.^");
        }
        rfalse;
    }
}

// statuesFeatures — a per-statue backdrop whose per-keyword description handlers are inline
// **lambdas** in the rows (each hoists to an I6 routine the backdrop engine runs); apostrophe
// dict words use `.monkey's` (emits I6 `'monkey^s'`). Each row is
// <dict-words> <description-lambda> <interact-value>, where the interact-value is the
// `ignoreStatueParts` string or (for the mouth) another lambda.
const string ignoreStatueParts = "There is very little you can do with the individually carved parts of the statue.";

backdrop statuesFeatures {
    "statue’s features";
    bool found_in() {
        object statue = foliage.statueFromLocation(location);
        if(statue == null) rfalse;         // in a location with no statue
        if(statue.parent == null) rfalse;  // location has a statue, but not yet revealed
        rtrue;                          // near a visible statue; bring this into scope
    }
    // A bare "monkeys" means the canopy monkeys; "monkeys eye" still means the statue's eye.
    chooseAnswer chooseobject(chooseCode code) {
        if(code == chooseCode.askingForHint && match_length == 1 && (dictionaryWord)WordValue(match_from) == .monkeys) return excludeFromChoice(self);
        return chooseAnswer.defer;
    }
    array<array<var>> backdrops = {
        {.eyes, .eye, .monkey's, .statue's, .monkeys, .statues, .statue, .monkey,
            $"{location == westOfRockWall ? "The statue’s eyes are covered by its paws. Only its ears and mouth are visible."
             : location == eastOfRockWall ? (muteStatue.state == 0 ? "The statue’s eyes gaze pointedly at nothing, but you get the impression they want to."
                                                                   : "The statue’s eyes glow, emitting the focused beam of light.")
             : location == northOfRockWall ? "The empty eyes gaze at nothing, waiting to see." : ""}",
            ignoreStatueParts},
        {.ears, .ear, .monkey's, .statue's, .monkeys, .statues, .statue, .monkey,
            $"{location == eastOfRockWall ? "The monkey statue’s ears listen, perhaps for a monkey question."
             : location == westOfRockWall ? "The monkey statue’s ears listen, attuned to the sounds of the jungle."
             : location == northOfRockWall ? "The monkey statue’s ears are hidden, covered by its paws. Only its eyes and mouth are visible." : ""}",
            ignoreStatueParts},
        {.mouth, .may, .lips, .teeth, .monkey's, .monkeys, .statues, .statue's, .statue, .monkey,
            $"{location == northOfRockWall || location == westOfRockWall ? "The statue’s mouth was carved in a particular shape, giving the impression the monkey is on the verge of saying something."
             : location == eastOfRockWall ? "The mouth is hidden, covered by the statue’s paws. Only its eyes and ears are visible." : ""}",
            () => {
                switch(action){
                    case KissThing: return redirectCommand("kiss statue");
                    default:
                        print(ignoreStatueParts); print("^");
                        return true;
                }
            }},
        {.paw, .paws, .hands, .arms, .arm, .monkey's, .statue's, .statue, .monkey,
            $"The paws of the monkey statue cover its {location == westOfRockWall ? "eyes" : location == northOfRockWall ? "ears" : location == eastOfRockWall ? "mouth" : ""}.",
            ignoreStatueParts}
    };
    bool react_before() {
        if(second != self) rfalse;
        if(action_to_be == Insert && backdropEngine.getKeyword() == .mouth){
            if(location == eastOfRockWall) rtrue("The statue has no mouth; its paws are covering it.^");
            if(noun == banana) rtrue("The statue’s mouth isn’t the right shape to take the flat banana, which is curved and about an inch thick.^");
            rtrue("The particular shape of the statue’s carved mouth isn’t suitable for putting things in.^");
        }
        rfalse;
    }
}

bigThing grok {
    "Grok";
    attributes = {proper, animate};
    name = {.grok, .yellow, .monkey, .ape, .primate, .large};
    string description = "The larger yellow monkey stands just a few inches shorter than you, but he is quite a bit wider and looks seventy pounds heavier.";
    bool describe() { print("^"); rtrue("Grok is here, fists raised like a professional boxer, standing between you and the open cave.^"); }
    int damageSelf = 0;
    int damagePlayer = 0;
    array<var> attackGrokSuccess = {0,
        "You swat at Grok with the tire iron, connecting in the ribs. Grok grunts and staggers back, shaken.^^The booing of dozens of canopy monkeys drifts down.",
        "You swing the tire iron and land a solid blow. Grok reels.^^Sounds of monkey outrage filter down.",
        "You strike with the tire iron, putting all of your weight into it, and connect with a solid “THWACK” across Grok’s noggin. Grok shakes his head."
    };
    array<var> attackGrokFail = {0,
        "You swing with your fist as hard as you can, landing a solid blow. Grok laughs at you.",
        "You jump at the ape, hoping to force him to the ground. Grok sidesteps and you land in the dirt. You stand to the sounds of monkey cheers from the canopy.",
        "You throw a solid punch which the ape bats away. Grok smiles, evilly, and gives you a knowing eyebrow flash.^^The canopy monkeys laugh."
    };
    array<var> grokAttack = {0,
        "Hopping lightly between his feet, Grok raises his paws like a professional boxer. Lightning quick, he jabs, striking you in the face. You lurch back, fireworks momentarily filling your vision.^^“Oooooo!” comes an appreciative murmur from above.",
        "Foregoing any finesse, Grok springs forward and delivers a one-two: his left paw boxing you in the ear followed by his right paw smacking you in the nose. You stumble to your knees but get back to your feet.^^Hoots and jeers come from the canopy.",
        "The monkeys’ hoots crescendo and Grok lifts his head, roaring. With one, angry leap he grabs you by the throat and slaps you, open paw, then backhands you. He repeats this twice more before pushing you away. The world spins and your ears ring."
    };
    bool orders() {
        rtrue("You try to assert authority by telling Grok what to do. He laughs dismissively.^");
    }
    bool before() {
        switch(action) {
            case Take:
                rtrue("Even if Grok weren’t seventy pounds larger than you, you don’t suppose he would care for that.^");
            case Attack:
                if(second != tireIron)
                    print((string)bgl.util.loopArray.getAny(self, (property)attackGrokFail));
                else {
                    print((string)bgl.util.loopArray.getNext(self, (property)attackGrokSuccess));
                    damageSelf = damageSelf + 1;
                    if(damageSelf >= 3) {
                        storyEnds(true);
                    }
                }
                print("^");
                rtrue;
        }
        rfalse;
    }
    void each_turn() {
        print("^");
        if(damagePlayer >= 2) {
            if(grok.hasnt(general) && murk.parent == player) {
                print("The large monkey winds his arm, as if preparing the Twisker Sock from a Popeye cartoon. For an instant, you see your life flash before your eyes and know this is it,
                but at the last moment, Murk leaps from your shoulders onto Grok’s face. You feel the whoosh as his ape fist just misses your nose.^^Murk hops back to your shoulder and chitters at Grok in defiance.^");
                grok.give(general);
                return;
            } else {
                print((string)bgl.util.loopArray.getNext(self, (property)grokAttack));
                storyEnds(false);
                return;
            }
        }
        print((string)bgl.util.loopArray.getNext(self, (property)grokAttack));
        print("^");
        damagePlayer = damagePlayer + 1;
    }
}

void storyEnds(bool didWin) {
    if(didWin) {
        print("^^He steps back, clearly disoriented, and sits down hard on the ground. You imagine a ring of birds circling his head as your car keys slip from his paw and land, jingling at your feet.  “Yes!” you cry out victoriously and snatch them up.^");
        achieved(taskDefeatGrok);
        print("^But your triumph is short lived.^^The screeching from above escalates with harsh tones and dozens of angry monkeys rain down from the canopy and begin advancing
        on you ominously. “Arck arck eek jarg jarg!” the monkeys chant and you don’t need a translator to know this is bad.^^
        “Enough of this monkey business!” you exclaim as you turn and run south toward your car, gripping your keys victoriously.^^
        “Murk! Murk!” you can hear in the distance behind you.");
        deadflag = 2;
    }
    else {
        print("^^You fall to the ground, consciousness fading, and the trees erupt in cheering monkey howls. Above you, you see Grok, jingling your car keys
                mockingly and dancing a victory dance.^");
        if(tireIron.parent != player) print($"^{italics}If only,{roman} you think, {italics}I’d had a weapon...{roman}^");
        else if(murk.parent != player) print($"^{italics}If only,{roman} you think, {italics}I’d had someone to help...{roman}^");
        print($"^Hundreds of excited screeches erupt from above, a swarm of invisible monkeys cheering hysterically. They rain down, laughing and beating their chests with their little fists. One climbs
                on you and points a finger at your nose.^^{bold}“Hachh ow ah ow ack hachh hooow!”{roman} it screams.^^Your vision tunnels to blackness.^");
        deadflag = 1;
    }
}

//=================================================================== converted objects (Beguile) ===
// The rooms (south/west/east/northOfRockWall), the etched* carvings, the statues, foliage, vine,
// and grok are now real Beguile objects above — their forward-decls are gone. Only cross-file I6
// objects still referenced from Beguile code need declaring here.
// cliffEdge/ledge/ladder/barrel/bridgeAnchor/rock (worldArea2) and symbols (worldArea3) are all
// native Beguile now; the two-pass compiler resolves them cross-file, so no externs are needed here.
extern verb   Swing;    // game action (##Swing) — no grammar here; used only in switch(action)

// tireIron — first I6→Beguile conversion (was worldArea1-Ring.inf:874). Pure data: name +
// impression/description strings. `~` (I6 quote) and `^` (I6 newline) pass through regular strings.
thing tireIron {
    "tire iron";
    name           = {.bar, .tire, .iron, .club, .baton};   // type inferred from `thing.name`
    preImpression  = "You recognize the bar. It’s the tire iron from your jeep. Clearly your glasses and snacks weren’t the only thing the monkeys took. “Well I’ll be a monke...” you start to exclaim, then trail off, glancing up at the canopy self-consciously.^^";
    description    = "It’s a solid piece of metal, about three feet long, with a heavy, flat end.";
    postImpression = " Might serve as a weapon, if you need one.";
}

// keys — Tier 1: a `before()` that refuses Take. The I6 `before[; take: "msg"; ]` becomes a
// Beguile `switch(action)`; the bare-string print becomes `rtrue("msg")` (print + return true).
setting keys {
    "car keys";
    attributes  = {pluralname};
    description = "You can’t really see them. Grok is keeping them clutched tightly in his paw.";
    bool before() {
        switch(action) {
            case Take:
                rtrue("Grok is keeping a tight grip on them. You think you may need to win them back in victorious battle.^");
        }
        rfalse;
    }
}

// The opened wall: the cave Grok came out of, placed by the ear's secret words (topics.bgl).
bigThing nestOfAncients {
    "nest of the ancients";
    name = {.nest, .ancients, .cave, .opening, .trinkets, .pile, .hoard, .items, .shinys,
            .treasure, .bottle, .caps, .cap, .buttons, .button, .hubcap, .spoon};
    adjective = {.of, .shiny, .open, .bent};
    bool describe() { print("^"); rtrue("Where the rock wall stood, an opening gapes into the nest of the ancients: a shallow cave with a pile of shiny trinkets heaped at the back.^"); }
    string description = "Bottle caps, buttons, a hubcap, a bent spoon: a monkey’s idea of treasure, heaped at the back of the cave. Nothing in the pile matters as much as the keys in Grok’s paw.";
    bool before() {
        switch(action) {
            case Examine, ExamineMulti, Search: rfalse;
            case Take, Touch, Pull, Push, Turn, Rub, Remove: rtrue("The treasure is out of reach, with Grok standing between you and the nest.^");
        }
        rtrue("Not with Grok standing between you and the nest.^");
    }
}

// The carvings went up with the wall; they stand in for the ear, eye, mouth and light once it lifts.
setting liftedCarvings {
    "carvings";
    name = {.ear, .eye, .mouth, .smile, .slot, .hole, .light, .darkness, .circle,
            .carving, .carvings, .etching, .etchings, .engravings};
    adjective = {.monkey, .etched, .engraved, .carved};
    attributes = {pluralname};
    bool before() {
        rtrue("The carvings went up with the wall, which is flipped up like a garage door, out of reach.^");
    }
}
// trees — Tier 1: `found_in` object-list scenery + a two-case `before()`.
setting trees {
    "trees";
    found_in    = {southOfRockWall, eastOfRockWall, northOfRockWall, westOfRockWall};
    description = "The trees are tall and thin. Collectively, they form a thick canopy above.";
    name        = {.tree, .trees, .forest, .rainforest, .jungle};
    bool before() {
        switch(action) {
            case Take:
                rtrue("What are you, a lumberjack?^");
            case Climb:
                rtrue("The trees, while tall, are too thin for a human to climb. Perhaps if you were a monkey.^");
        }
        rfalse;
    }
}

// eyeglasses — clothing item the monkeys stole; the multi-action `before()` is the interesting part.
// I6→Beguile idiom map:  `has clothing concealed` → attributes list;  `self in player` → self.parent
// == player;  `give self ~concealed` → self.ungive(concealed);  `move self to player` → self.parent =
// player;  `remove eyeglasses` → eyeglasses.remove();  `give, throwAt:` (shared label) → `case Give,
// ThrowAt:`.  Bare-string-in-before → rtrue("…").
thing eyeglasses {
    "pair of glasses";
    attributes     = {clothing, concealed, pluralname};
    string article = "a";
    name           = {.glasses, .spectacles, .pair, .eyeglasses, .sunglasses};
    adjective      = {.eye, .of};
    preImpression  = "These are yours! Stolen from your Jeep by the canopy monkeys. ";
    description    = "One of the lenses is cracked but they are still functional.";
    postImpression = " You don’t need them anymore, though. LASIK surgery made them useless for you but you never bothered to throw them away.";
    bool before() {
        switch(action) {
            case Wear:
                if(parent == player)
                    rtrue("You put your glasses on and everything becomes blurry. You take them off again.^");
            case Take:
                if(has(concealed)) {
                    ungive(concealed);
                    parent = player;
                    rtrue("You take the familiar pair of glasses off the statue.^");
                }
            case Give, ThrowAt:
                if(second == mama || (second == null && location == ledge)) {
                    eyeglasses.remove();
                    print("You throw the glasses, and they sail through the air toward the far ledge. Mama Ciedue snaps to attention as they land at her feet. She looks down at them, then out from her ledge, squinting as though searching for something far away and seeing nothing. She scoops them up, scrutinizes them closely, and begins to open and close the arms experimentally. Through trial and error, she fits them on her face. When she sees you, her eyes go wide.^^She fixes her gaze at you and ignores her cartwheeling children. Her posture changes to match your own.^");
                    achieved(taskGlassesGivenToCiedue);
                    rtrue;
                }
        }
        rfalse;
    }
}


// cliffWallEastAndWest — floating supporter scenery (found_in two rooms). Putting Murk on it triggers
// murkClimbsWall(). `has supporter` → attributes; `receive:` → `case Receive:` (fake action, now in
// the i6StandardLibrary binding).
setting cliffWallEastAndWest {
    "wall";
    attributes  = {supporter};
    name        = {.cliff, .wall, .ivy, .tower, .monolith};
    adjective   = {.rock, .tall, .climbing, .rocky};
    description = "The wall is covered in ivy which climbs up the rock.";
    found_in    = {westOfRockWall, eastOfRockWall};
    bool before() {
        switch(action) {
            case Receive:
                return murkClimbsWall();
            case Climb:
                rtrue("It’s too steep, and the ivy could never hold your weight.^");
        }
        rfalse;
    }
}

// murkClimbsWall — helper for the wall's `receive`: putting Murk on the wall fetches the tire iron the
// first time.
bool murkClimbsWall() {
    if(noun != murk)
        rtrue("You’re not sure how to put things on the wall. A monkey might be able to climb it.^");
    if(tireIron.parent == null) {
        tireIron.parent = location;
        murk.parent = location;
        murk.give(general);
        print("“Murk!” The baby monkey climbs swiftly up the cliff wall and disappears into the treetops. You wait, remembering how tall the rock monolith looked.^^Time passes, and just as you are about to move on, a long heavy bar falls through the leaves and lands at your feet making you jump in surprise.^^Shortly, the baby monkey reappears from above, hanging on the wall with a big smile on his face, and extends both arms out for you.^");
        achieved(taskGetTireIron);
    }
    else {
        murk.parent = player;
        rtrue("You put Murk on the wall again but he leaps immediately off, not wanting to go back, and climbs back up your shoulder.^");
    }
    rtrue;
}
